@namespace ScoreTracker.Web.Pages.OfficialLeaderboards
@using MediatR
@using ScoreTracker.OfficialMirror.Contracts
@using ScoreTracker.OfficialMirror.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.Web.Services.Contracts
@inject IMediator Mediator
@inject IUiSettingsAccessor UiSettings

@* The Official Leaderboards section chrome, shared by every page in the section:
   title, last-updated stamp, the page nav, and the mix/chart context the views
   consume. Each page is its own route and circuit — the nav links are real
   document loads, which is the site's post-flip navigation model anyway.

   Import health is deliberately NOT here: a failed sweep's diagnostics (the raw
   exception, stage and all) belong to /Admin/OfficialLeaderboards. A player sees
   only the last-updated stamp, which already says the data is stale. *@

<PageTitle>@L[ActiveLabel] · @L["Official Leaderboards"]</PageTitle>

<style>
    .olb-subtitle { color: var(--mix-ink-muted); }

    .olb-section-nav {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 10px;
    }

    /* The reading switch closes the nav row. Its own colour is the palette's secondary,
       which carries no other meaning on these boards, so it never competes with the
       primary the active page chip already wears. */
    .olb-reading {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
    }

    .olb-reading .mud-switch { margin: 0; }

    .olb-folder-first {
        border: 1px solid var(--plate-pg);
        border-radius: 10px;
        box-shadow: 0 0 14px var(--mix-glow);
    }

    .olb-spark polyline {
        fill: none;
        stroke: var(--mix-secondary);
        stroke-width: 1.6;
    }

    .olb-spark circle { fill: var(--mix-secondary); }

    .olb-mover-lead { background: color-mix(in srgb, var(--mix-primary) 8%, transparent); border-radius: 9px; }

    /* World firsts: the chart banner leads, the claimant closes. */
    .olb-first-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        flex-wrap: wrap;
    }

    .olb-chartlink { display: inline-flex; align-items: center; gap: 8px; min-width: 0; }

    .olb-first-tail {
        margin-left: auto; flex: 0 0 auto;
        display: flex; align-items: center; justify-content: flex-end; gap: 8px;
    }

    /* A frozen header keeps the grade columns labelled down the full ladder. */
    .olb-tier-table thead th {
        position: sticky;
        top: 0;
        z-index: 3;
        background: var(--mix-surface);
    }

    /* The compact row vocabulary every ranked collection wears — .olb-rank-card,
       .olb-board-table, the row glows, the responsive tiers — lives in site.css:
       the Communities boards share this section's look. */
</style>

<MudText Typo="Typo.h4">@L["Official Leaderboards"]</MudText>
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1 flex-wrap">
    <MudText Typo="Typo.body2" Class="olb-subtitle">
        @L["Last Updated"] · @(_lastImported?.ToLocalTime().ToString("g") ?? "—")
    </MudText>
</MudStack>

<nav class="olb-section-nav" aria-label="@L["Official Leaderboards"]">
    @foreach (var (key, href, label) in Links)
    {
        @* What It Takes reads cutlines off the real board, so it has no supplemented
           reading and comes out of the nav rather than showing an inert chip. Reaching
           it by URL still works and simply shows the official answer. *@
        @if (key != TakesKey || !_supplemented)
        {
            <MudButton Href="@href" Size="Size.Small" Color="Color.Primary"
                       Variant="@(key == Active ? Variant.Filled : Variant.Outlined)">
                @L[label]
            </MudButton>
        }
    }
    <div class="olb-reading">
        <MudSwitch T="bool" Value="_supplemented" ValueChanged="SetSupplemented" Color="Color.Secondary"
                   Size="Size.Small" Label="@L["PIU Scores Supplemented"]"/>
    </div>
</nav>

@if (_supplemented && _summary is { Players: > 0 })
{
    <MudText Typo="Typo.body2" Class="olb-subtitle mt-2">
        @L["{0} players added · {1} scores, rolled up {2}", _summary.Players, _summary.Rows,
            _summary.AsOf?.ToLocalTime().ToString("d") ?? "—"]
    </MudText>
}

<div class="pt-4">
    @if (_loaded)
    {
        @Body(new SectionContext(_mix, _charts, _supplemented))
    }
    else
    {
        <MudSkeleton Height="400px" SkeletonType="SkeletonType.Rectangle"/>
    }
</div>

@code {
    public sealed record SectionContext(MixEnum Mix, IDictionary<Guid, Chart> Charts, bool Supplemented);

    /// <summary>
    ///     Remembered per browser rather than per account: the section is readable signed out,
    ///     and UiSettings falls back to browser storage for anonymous visitors.
    /// </summary>
    private const string SupplementedSetting = "OfficialLeaderboards__Supplemented";

    private const string TakesKey = "takes";

    private static readonly (string Key, string Href, string Label)[] Links =
    {
        ("week", "/OfficialLeaderboards", "This Week"),
        ("rankings", "/OfficialLeaderboards/Rankings", "Rankings"),
        ("players", "/OfficialLeaderboards/Players", "Players"),
        ("popularity", "/OfficialLeaderboards/Popularity", "Popularity"),
        ("takes", "/OfficialLeaderboards/WhatItTakes", "What It Takes")
    };

    [Parameter] [EditorRequired] public string Active { get; set; } = "week";

    [Parameter] [EditorRequired] public RenderFragment<SectionContext> Body { get; set; } = null!;

    // The What It Takes view reads only rating boards — skipping the chart pull there
    // keeps that page's circuit start light.
    [Parameter] public bool RequiresCharts { get; set; } = true;

    private bool _loaded;
    private bool _supplemented;
    private SupplementedSummaryRecord? _summary;
    private MixEnum _mix = MixEnum.Phoenix2;
    private DateTimeOffset? _lastImported;
    private IDictionary<Guid, Chart> _charts = new Dictionary<Guid, Chart>();

    private string ActiveLabel => Links.First(l => l.Key == Active).Label;

    protected override async Task OnInitializedAsync()
    {
        _mix = await UiSettings.GetSelectedMix();
        // These are the official site's own boards, and it publishes them for the current
        // generation only — there is no Prime 2 ranking to mirror and never will be. XX has
        // clamped to Phoenix here since the section was built; every older mix does the same,
        // because a board that exists beats a refusal on a page that is about someone else's
        // numbers anyway.
        if (_mix.UsesLegacyScoring()) _mix = MixEnum.Phoenix;
        _supplemented = await UiSettings.GetSetting(SupplementedSetting) == bool.TrueString;
        _summary = await Mediator.Send(new GetSupplementedSummaryQuery(_mix));

        _lastImported = await Mediator.Send(new GetLastLeaderboardImportTimestampQuery(_mix));
        if (RequiresCharts)
            _charts = (await Mediator.Send(new ScoreTracker.Catalog.Contracts.Queries.GetChartsQuery(_mix)))
                .ToDictionary(c => c.Id);
        _loaded = true;
    }

    private async Task SetSupplemented(bool supplemented)
    {
        _supplemented = supplemented;
        _summary = await Mediator.Send(new GetSupplementedSummaryQuery(_mix));
        await UiSettings.SetSetting(SupplementedSetting, supplemented.ToString());
    }
}
