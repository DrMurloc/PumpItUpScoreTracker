@using ApexCharts
@using MediatR
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.OfficialMirror.Contracts
@using ScoreTracker.OfficialMirror.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services.Theming
@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser

<MudAutocomplete T="string" Value="_selected" ValueChanged="SelectPlayer" Clearable="true"
                 Label="@L["Search any board player"]" AdornmentIcon="@Icons.Material.Filled.Search"
                 ResetValueOnEmptyText="true" CoerceText="true" Class="mb-3" MaxItems="15"
                 SearchFunc="(s, c) => Task.FromResult(_names.Where(n => n.Contains(s ?? string.Empty, StringComparison.OrdinalIgnoreCase)))"/>

@if (_loadingProfile)
{
    <MudSkeleton Height="300px" SkeletonType="SkeletonType.Rectangle"/>
}
else if (_profile == null && !string.IsNullOrWhiteSpace(_selected))
{
    <MudAlert Severity="Severity.Info">@L["No board history for that tag."]</MudAlert>
}
else if (_profile == null)
{
    <MudText Typo="Typo.body2">@L["Pick a player to see their boards, history, and PUMBILITY over time - departed tags stay searchable."]</MudText>
}
else
{
    <MudPaper Class="pa-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
            @* The one place the full TAG#1234 belongs — this page is that account. *@
            <HubPlayerChip Player="_profile.Player" ShowTag="true"/>
            @if (_profile.PlayerType != null)
            {
                <PlayerTypeChip Type="_profile.PlayerType.Value"/>
            }
        </MudStack>

        <MudGrid Class="mt-1">
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-2" Outlined="true">
                    <MudText Typo="Typo.overline">PUMBILITY</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary">
                        <b>@(_profile.Pumbility?.ToString("N2") ?? "—")</b>
                    </MudText>
                    @if (_profile.PumbilityRank != null)
                    {
                        <MudText Typo="Typo.caption">
                            @L["rank #{0}", _profile.PumbilityRank]
                            @if (_profile.PumbilityRankDelta is > 0)
                            {
                                <span class="olb-delta-up"> ▲@_profile.PumbilityRankDelta</span>
                            }
                            else if (_profile.PumbilityRankDelta is < 0)
                            {
                                <span class="olb-delta-down"> ▼@Math.Abs(_profile.PumbilityRankDelta.Value)</span>
                            }
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-2" Outlined="true">
                    <MudText Typo="Typo.overline">@L["chart boards"]</MudText>
                    <MudText Typo="Typo.h5"><b>@_profile.BoardsInTop</b></MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-2" Outlined="true">
                    <MudText Typo="Typo.overline">@L["Chart Board #1s"]</MudText>
                    <MudText Typo="Typo.h5"><b>@_profile.NumberOnes</b></MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-2" Outlined="true">
                    <MudText Typo="Typo.overline">@L["Best place"]</MudText>
                    <MudText Typo="Typo.h5"><b>@(_profile.BoardsInTop == 0 ? "—" : $"#{_profile.BestPlace}")</b></MudText>
                    <MudText Typo="Typo.caption">@_profile.TopTens @L["in the top ten"]</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (_pumbilityHistory.Length > 1)
        {
            <MudGrid Class="mt-1">
                <MudItem xs="12" md="7">
                    <MudText Typo="Typo.overline">@L["PUMBILITY over time"]</MudText>
                    <div class="@ApexChartTheming.WrapperClass">
                        <ApexChart TItem="HistoryPoint" Options="_lineOptions" Height="220">
                            <ApexPointSeries TItem="HistoryPoint"
                                             Items="_pumbilityHistory"
                                             Name="PUMBILITY"
                                             Color="@MixThemes.PaletteFor(Mix).Primary"
                                             SeriesType="SeriesType.Line"
                                             XValue="@(p => p.Label)"
                                             YValue="@(p => p.Value)"/>
                        </ApexChart>
                    </div>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudText Typo="Typo.overline">@L["PUMBILITY rank - lower is better"]</MudText>
                    <div class="@ApexChartTheming.WrapperClass">
                        <ApexChart TItem="HistoryPoint" Options="_rankOptions" Height="220">
                            <ApexPointSeries TItem="HistoryPoint"
                                             Items="_rankHistory"
                                             Name="@L["Rank"]"
                                             Color="@MixThemes.PaletteFor(Mix).Secondary"
                                             SeriesType="SeriesType.Line"
                                             XValue="@(p => p.Label)"
                                             YValue="@(p => p.Value)"/>
                        </ApexChart>
                    </div>
                </MudItem>
            </MudGrid>
        }

        @* Only for a player holding a single or a double the catalog knows: co-op rows alone
           are no PUMBILITY pool, and would leave the section an empty grid. *@
        @if (HasPool(AllPools))
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3 flex-wrap">
                <MudText Typo="Typo.overline">@L["Top 50"]</MudText>
                @* The board select only where the snapshot publishes per-type PUMBILITY boards.
                   Co-op is not offered: it is not PUMBILITY. A board the player holds no charts
                   on is greyed out rather than offered as an empty list. *@
                @if (SplitsByType)
                {
                    <MudSelect T="string" Value="_pool" ValueChanged="SetPool" Label="@L["Board"]" Dense="true"
                               Style="max-width:180px">
                        <MudSelectItem T="string" Value="@("All")">@L["All"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Singles")"
                                       Disabled="@(!HasPool("Singles"))">@L["Singles"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Doubles")"
                                       Disabled="@(!HasPool("Doubles"))">@L["Doubles"]</MudSelectItem>
                    </MudSelect>
                }
            </MudStack>
            <div class="olb-player-top50">
                <HubRankingsTopCharts Profile="_profile" TypeFilter="@_pool" Charts="Charts" OnOpen="OpenChart"/>
            </div>
        }

        <MudText Typo="Typo.overline" Class="mt-3 d-block">
            @L["Chart board placements"] · @_profile.BoardsInTop
        </MudText>

        @* The rail is the only thing on this table that needs explaining, so it explains itself
           where it appears rather than in a key somewhere else on the page. It shows up only
           when there is a marked row to explain. *@
        @if (_profile.Placements.Any(r => r.IsSupplemented))
        {
            <div class="olb-supp-legend">
                <span class="olb-supp-legend-rail"></span>
                <span>@L["Rows with this edge come from the player's PIU Scores account, not the official board."]</span>
            </div>
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2 flex-wrap">
            <MudTextField T="string" @bind-Value="_placementFilter" Label="@L["Find a song"]" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true" Style="max-width:260px"/>
            @* piugame publishes chart boards for level 20 and up, so a lower folder can never
               hold a placement — the grid greys those out and the ◄ ► steppers skip past them.
               Co-op is exempt: its folder number is how many players a chart takes, not a
               difficulty, so every co-op folder is 2 through 5 and all of them have boards. *@
            <FolderPicker Category="_folder" Mix="Mix" Level="_folderLevel" FolderChanged="SetFolder"
                          IsMissing="Unboarded"></FolderPicker>
            @if (_folderLevel != null)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="ClearFolder"
                               aria-label="@L["All Folders"]"></MudIconButton>
            }
        </MudStack>

        <MudTable T="OfficialPlayerChartRecord" Items="FilteredPlacements" Dense="true" Elevation="0"
                  Breakpoint="Breakpoint.None" RowsPerPage="25"
                  RowClassFunc="@((r, _) => r.IsSupplemented ? "olb-row-supp" : string.Empty)"
                  Class="olb-board-table olb-sticky-first olb-pager-tight">
            <HeaderContent>
                <MudTh Style="text-align:right">
                    <MudTableSortLabel T="OfficialPlayerChartRecord" SortBy="e => (object)(e.Place ?? int.MaxValue)">@L["Place"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="OfficialPlayerChartRecord" SortBy="e => (object)(e.PlaceDelta ?? int.MinValue)">Δ</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="OfficialPlayerChartRecord" SortBy="e => SongName(e)">@L["Chart"]</MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align:right">
                    <MudTableSortLabel T="OfficialPlayerChartRecord" SortBy="e => (object)e.Score">@L["Score"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="OfficialPlayerChartRecord" SortBy="e => (object)e.Score">@L["Letter Grade"]</MudTableSortLabel>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="text-align:right"><b>#@context.Place</b></MudTd>
                <MudTd>
                    @if (context.PlaceDelta is > 0)
                    {
                        <span class="olb-delta-up">▲@context.PlaceDelta</span>
                    }
                    else if (context.PlaceDelta is < 0)
                    {
                        <span class="olb-delta-down">▼@Math.Abs(context.PlaceDelta.Value)</span>
                    }
                    else if (context.PlaceDelta != null)
                    {
                        <span class="olb-delta-flat">—</span>
                    }
                </MudTd>
                <MudTd>
                    @if (Charts.TryGetValue(context.ChartId, out var chart))
                    {
                        <MudLink title="@L["Chart Details"]" Class="olb-chartlink" Style="cursor:pointer;gap:4px"
                                 Underline="Underline.None" OnClick="() => OpenChart(chart.Id)">
                            <DifficultyBubble Chart="chart" Small="true"/>
                            <SongImage Song="chart.Song" Small="true"/>
                            <MudText Typo="Typo.body2">@chart.Song.Name</MudText>
                        </MudLink>
                    }
                </MudTd>
                <MudTd Style="text-align:right"><b>@context.Score.ToString("N0")</b></MudTd>
                <MudTd><LetterGradeIcon Grade="PhoenixScore.From(context.Score).LetterGradeFor(Mix)"/></MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager HideRowsPerPage="true"/>
            </PagerContent>
        </MudTable>
    </MudPaper>
}

<ChartDetailsDialog @bind-Visible="_detailsOpen" Chart="_detailsChart" Mix="Mix"
                    BoardScope="ChartLeaderboardScopes.LeaderboardScope.Official"
                    BoardSupplemented="Supplemented"></ChartDetailsDialog>

@code {
    [Parameter] public MixEnum Mix { get; set; }
    [Parameter] public bool Supplemented { get; set; }
    [Parameter] public IDictionary<Guid, Chart> Charts { get; set; } = new Dictionary<Guid, Chart>();

    // Two-way selection: the hub preselects (Boards links, ?player= deep links) and hears
    // every change back, so the choice survives the tab being disposed and re-created.
    [Parameter] public string? Selected { get; set; }
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }

    private string _selected = string.Empty;
    private string[] _names = Array.Empty<string>();
    private bool _loadingProfile;
    private bool _detailsOpen;
    private Chart? _detailsChart;
    private string _pool = AllPools;
    private OfficialPlayerProfileRecord? _profile;
    private HistoryPoint[] _pumbilityHistory = Array.Empty<HistoryPoint>();
    private HistoryPoint[] _rankHistory = Array.Empty<HistoryPoint>();

    private ApexChartOptions<HistoryPoint> _lineOptions = new();
    private ApexChartOptions<HistoryPoint> _rankOptions = new();

    // Frozen, whisper-grid canvases in the popularity-page vocabulary: no zoom or drag
    // capture, no vertical gridlines, no crosshair — these charts are glances.
    private ApexChartOptions<HistoryPoint> GlanceOptions()
    {
        var options = ApexChartTheming.BaseOptions<HistoryPoint>(MixThemes.PaletteFor(Mix));
        options.Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 };
        options.Grid.Xaxis = new GridXAxis { Lines = new Lines { Show = false } };
        options.Xaxis = new XAxis
        {
            AxisTicks = new AxisTicks { Show = false },
            Crosshairs = new AxisCrosshairs { Show = false }
        };
        return options;
    }

    protected override async Task OnInitializedAsync()
    {
        _lineOptions = GlanceOptions();
        _rankOptions = GlanceOptions();
        _rankOptions.Yaxis = new List<YAxis> { new() { Reversed = true, DecimalsInFloat = 0 } };
        _names = (await Mediator.Send(new GetOfficialPlayerNamesQuery(Mix, Supplemented))).ToArray();

        // Nothing picked yet: land on your own board tag when the account is linked,
        // otherwise on whoever tops the combined ranking board.
        if (string.IsNullOrWhiteSpace(Selected))
        {
            var defaultTag = CurrentUser.IsLoggedIn
                ? await Mediator.Send(new GetLinkedOfficialPlayerTagQuery(Mix, CurrentUser.User.Id))
                : null;
            defaultTag ??= (await Mediator.Send(new GetOfficialRankingsQuery(Mix, "All", Supplemented)))
                ?.Rankings.FirstOrDefault()?.Player.Username;
            if (!string.IsNullOrWhiteSpace(defaultTag)) await SelectPlayer(defaultTag);
        }
    }

    private const string AllPools = "All";

    /// <summary>
    ///     Whether the snapshot publishes PUMBILITY boards per chart type, so the Top 50 can be
    ///     read pool by pool. The profile says which pools exist; the mix is never asked.
    /// </summary>
    private bool SplitsByType => _profile?.Pools?.Any(p => p.Type != AllPools) == true;

    /// <summary>Whether the player holds any chart the named board's Top 50 can show.</summary>
    private bool HasPool(string pool) =>
        _profile != null && HubRankingsTopCharts.HasPool(_profile, Charts, pool);

    private void SetPool(string pool)
    {
        _pool = pool;
    }

    private void OpenChart(Guid chartId)
    {
        if (!Charts.TryGetValue(chartId, out var chart)) return;
        _detailsChart = chart;
        _detailsOpen = true;
    }

    private bool? _loadedSupplemented;

    protected override async Task OnParametersSetAsync()
    {
        // Flipping the reading re-reads the same player rather than resetting the page:
        // the point of the switch is to see what changes about THEM.
        if (_loadedSupplemented != null && _loadedSupplemented != Supplemented)
        {
            _loadedSupplemented = Supplemented;
            _names = (await Mediator.Send(new GetOfficialPlayerNamesQuery(Mix, Supplemented))).ToArray();
            if (!string.IsNullOrWhiteSpace(_selected)) await SelectPlayer(_selected);
            return;
        }

        _loadedSupplemented = Supplemented;
        if (!string.IsNullOrWhiteSpace(Selected) && Selected != _selected)
            await SelectPlayer(Selected);
    }

    internal async Task SelectPlayer(string username)
    {
        // A new player starts on the combined pool: the last one's Singles pick is not a
        // question this player was asked.
        if (username != _selected) _pool = AllPools;
        _selected = username;
        _profile = null;
        await SelectedChanged.InvokeAsync(username);
        if (string.IsNullOrWhiteSpace(username))
        {
            _pumbilityHistory = Array.Empty<HistoryPoint>();
            _rankHistory = Array.Empty<HistoryPoint>();
            return;
        }

        _loadingProfile = true;
        _profile = await Mediator.Send(new GetOfficialPlayerProfileQuery(Mix, username, Supplemented));
        // A re-read can empty the chosen board (switching Supplemented off takes the PIU Scores
        // rows away), and a greyed-out board cannot stay selected.
        if (!HasPool(_pool)) _pool = AllPools;
        _pumbilityHistory = _profile?.History
                                .Where(h => h.Pumbility != null)
                                .Select(h => new HistoryPoint(h.At.ToLocalTime().ToString("MMM d"),
                                    h.Pumbility!.Value))
                                .ToArray()
                            ?? Array.Empty<HistoryPoint>();
        _rankHistory = _profile?.History
                           .Where(h => h.PumbilityRank != null)
                           .Select(h => new HistoryPoint(h.At.ToLocalTime().ToString("MMM d"),
                               h.PumbilityRank!.Value))
                           .ToArray()
                       ?? Array.Empty<HistoryPoint>();
        _loadingProfile = false;
        StateHasChanged();
    }

    private string SongName(OfficialPlayerChartRecord record)
    {
        return Charts.TryGetValue(record.ChartId, out var chart) ? (string)chart.Song.Name : string.Empty;
    }

    /// <summary>
    ///     The lowest difficulty piugame ranks. Its chart boards are the "20 and above" window,
    ///     so nothing below this has a board to place on in either reading.
    /// </summary>
    private const int FirstBoardedLevel = 20;

    /// <summary>
    ///     Folders with no board behind them. Co-op is never one: its folder number counts
    ///     players (2–5), not difficulty, so comparing it against a difficulty floor would
    ///     disable the whole tab.
    /// </summary>
    private static bool Unboarded(ScoreTracker.SharedKernel.Enums.ChartTypeCategory category, int level) =>
        category != ScoreTracker.SharedKernel.Enums.ChartTypeCategory.CoOp && level < FirstBoardedLevel;

    private string _placementFilter = string.Empty;
    private ScoreTracker.SharedKernel.Enums.ChartTypeCategory _folder =
        ScoreTracker.SharedKernel.Enums.ChartTypeCategory.Single;
    private int? _folderLevel;

    /// <summary>
    ///     Search matches the song, not the chart: a player looking for "Bee" wants both its
    ///     singles and its doubles rows, and the difficulty is already a column they can sort.
    ///     A chart the catalog has no entry for keeps its row while the box is empty and drops
    ///     out of a search rather than matching everything.
    /// </summary>
    private IEnumerable<OfficialPlayerChartRecord> FilteredPlacements =>
        (_profile?.Placements ?? Array.Empty<OfficialPlayerChartRecord>())
        .Where(r => string.IsNullOrWhiteSpace(_placementFilter)
                    || SongName(r).Contains(_placementFilter, StringComparison.OrdinalIgnoreCase))
        .Where(r => _folderLevel == null
                    || (Charts.TryGetValue(r.ChartId, out var chart)
                        && chart.Type.Category() == _folder && chart.Level == _folderLevel));

    private void SetFolder((ScoreTracker.SharedKernel.Enums.ChartTypeCategory Category, int Level) folder)
    {
        _folder = folder.Category;
        _folderLevel = folder.Level;
    }

    private void ClearFolder()
    {
        _folderLevel = null;
    }

    private sealed record HistoryPoint(string Label, decimal Value);
}
