    // so the lens has nothing to say on CoOp folders and is not offered there — no explanation,
    // same as Chabala on folders without links.
    private bool PumbilityAvailable => _chartType != ChartType.CoOp;

    // Personalization is a VIEW now, not a switch riding on top of one (owner, 2026-08-11) —
    // except on the two views that don't section by the lens, where the Shown Difficulty picker
    // names the personalized reading outright rather than a hidden modifier deciding it.
    private bool PersonalizedActive => CanPersonalize && _tierListType is "Score" or "PUMBILITY"
                                       && (_groupBy == "Personalized"
                                           || ((IsMyProgress || IsSkillView) && _shownPersonalized));

    /// <summary>The Shown Difficulty picker's value: a lens, or a lens read personally.</summary>
    private string ShownDifficultyValue => _shownPersonalized && _tierListType is "Score" or "PUMBILITY"
        ? $"Personalized {_tierListType}"
        : _tierListType;

    /// <summary>
    ///     Personalized Score has one source, so "the projection said nothing" and "the list is
    ///     empty" are the same state. Pass still blends, so it can never land here — its
    ///     community source carries the folder whatever the personal ones do.
    /// </summary>
    /// <summary>
    ///     Players at this level who have actually scored something in this folder, below which
    ///     the personalized Score list is not offered. Three, excluding the reader: two peers
    ///     cannot describe a folder, and the standard deviation the tiers are cut from means
    ///     nothing at that size. Null when the personalized blend has not run or cleared the bar.
    /// </summary>
    private int? _thinCohort;

    private const int MinCohortPeers = 3;

    private string BreakdownUrl => $"/TierLists/{_chartType}/{_level}/Breakdown?Lens={_tierListType}";

    private bool Passed(Guid chartId) => _scores.TryGetValue(chartId, out var s) && !s.IsBroken;

    private int PassedCount => _charts.Keys.Count(Passed);

    private string? GroupStat(IReadOnlyCollection<SongTierListEntry> visible, TierGroup group)
    {
        var cleared = CurrentUser.IsLoggedIn
            ? L["{0} / {1} cleared", visible.Count(e => Passed(e.ChartId)), visible.Count].ToString()
            : null;
        return string.Join(" · ", new[] { group.Stat, cleared }.Where(s => !string.IsNullOrEmpty(s)));
    }

    // --- Toolbar interactions --------------------------------------------------------------

    /// <summary>
    ///     The compact View select's value: the four views, with every My Scores grouping
    ///     reading as the one entry — the same derivation the desktop buttons use for
    ///     their filled state.
    /// </summary>
    private string ViewValue => IsMyProgress ? "MyProgress" : _groupBy;

    private Task ChangeView(string view)
    {
        // "MyProgress" is a select sentinel, not a grouping — it maps to the same default
        // the My Scores button uses BEFORE reaching ChangeGrouping, so it can never be
        // saved and the ViewPersistenceTests vocabulary stays real groupings only.
        var grouping = view == "MyProgress"
            ? CurrentUser.IsLoggedIn ? "Score" : "Scoring Level"
            : view;
        return ChangeGrouping(grouping);
    }

    private async Task ChangeFolder((ChartType Type, int Level) folder)
    {
        _chartType = folder.Type;
        _level = folder.Level;
        _thinCohort = null;
        if (_chartType == ChartType.CoOp && _level is < 2 or > 5)
        {
            _level = 2;
        }
        if (_tierListType == "Chabala" && !ChabalaAvailable)
        {
            _tierListType = "Pass";
        }
        if (_tierListType == "PUMBILITY" && !PumbilityAvailable)
        {
            _tierListType = "Pass";
        }
        await SetQueryString();
        await Recalculate();
    }

    private async Task ChangeLens(string lens)
    {
        _tierListType = lens;
        _thinCohort = null;
        await SetQueryString();
        await Recalculate();
    }

    private async Task ChangeShownDifficulty(string value)
    {
        const string prefix = "Personalized ";
        _shownPersonalized = value.StartsWith(prefix, StringComparison.Ordinal);
        _tierListType = _shownPersonalized ? value[prefix.Length..] : value;
        await UiSettings.SetSetting("TierLists__ShownPersonalized", _shownPersonalized.ToString());
        await SetQueryString();
        await Recalculate();
    }

    // Grouping changes re-group in memory. Crossing between Community and Personalized is the
    // exception: those are different blends, so that one refetches.
    private async Task ChangeGrouping(string newGrouping)
    {
        if (newGrouping == _groupBy)
        {
            return;
        }
        // Compared on the EFFECTIVE state, not on the button. Personalization has two switches —
        // the Personalized view, and the saved Shown Difficulty preference that applies on My
        // Scores and Skill Breakdown — and this only watched the first. Crossing between a tier
        // view and My Scores with that preference saved on flipped the data personalization
        // without a refetch, so Community rendered the personalized entries under the
        // community's label. The saved value seeds the page; after that a switch is what changes
        // it, and a switch always refetches and saves.
        var wasPersonalized = PersonalizedActive;
        _groupBy = newGrouping;
        // The Ranked-by list is not the same on every view — Personalized offers only the two
        // lenses that personalize — so carrying a lens across can leave the picker showing a
        // value it does not contain, which MudSelect renders as blank. Fall to the view's first
        // option instead (owner, 2026-08-13).
        if (!LensesFor(_groupBy).Contains(_tierListType))
        {
            _tierListType = LensesFor(_groupBy).First();
            await UiSettings.SetSetting("TierLists__ListType", _tierListType);
            await UiSettings.SetSetting("TierLists__GroupBy", _groupBy);
            // The URL must follow the coerced lens, or a refresh/share of this page re-applies
            // the old one through the query override at init and re-breaks the picker.
            await SetQueryString();
            await Recalculate();
            return;
        }

        if (PersonalizedActive != wasPersonalized)
        {
            await UiSettings.SetSetting("TierLists__GroupBy", _groupBy);
            await Recalculate();
            return;
        }

        await ApplyGroupingChange();
    }

    private async Task ApplyGroupingChange()
    {
        RegroupEntries();
        await UiSettings.SetSetting("TierLists__GroupBy", _groupBy);
        StateHasChanged();
    }

    // C3: the canonical folder URL is path-based; the lens rides as a query param. Written
    // straight into history rather than navigated to — under the static router, NavigateTo
    // re-fetches and re-initializes the whole page, and this component already updates itself
    // in place. Push for a user step (Back walks folders); replace for init canonicalizing
    // the entry URL (Back leaves the page).
    private async Task SetQueryString(bool replace = false)
    {
        var url = NavManager.GetUriWithQueryParameters(
            $"/TierLists/{_chartType}/{_level}",
            new Dictionary<string, object?> { { "TierListType", _tierListType } });
        await JSRuntime.InvokeVoidAsync(replace ? "history.replaceState" : "history.pushState", null, "", url);
    }

    private async Task ToggleTitles()
    {
        _titlesCollapsed = !_titlesCollapsed;
        await UiSettings.SetSetting("TierLists__TitlesCollapsed", _titlesCollapsed.ToString());
    }

    private async Task SetTierCollapsed(string key, bool collapsed)
    {
        if (collapsed)
        {
            _collapsedTiers.Add(key);
        }
        else
        {
            _collapsedTiers.Remove(key);
        }
        await UiSettings.SetSetting("TierLists__CollapsedTiers", JsonSerializer.Serialize(_collapsedTiers));
    }

    public async Task ToggleToDo(Guid chartId)
    {
        if (!_todos.Contains(chartId))
        {
            await Mediator.Send(new SaveChartToListCommand(ChartListType.ToDo, chartId));
            Snackbar.Add(L["Added to ToDo List!"], Severity.Success);
            _todos.Add(chartId);
        }
        else
        {
            await Mediator.Send(new RemoveChartFromListCommand(ChartListType.ToDo, chartId));
            Snackbar.Add(L["Removed from ToDo List!"], Severity.Success);
            _todos.Remove(chartId);
        }
        StateHasChanged();
    }

    // --- Reload pipeline: coalesced + cancel-previous ---------------------------------------

    private async Task Recalculate()
    {
        _reloadCts?.Cancel();
        _reloadCts = new CancellationTokenSource();
        var cancellationToken = _reloadCts.Token;
        try
        {
            await LoadFolder(cancellationToken);
        }
        catch (OperationCanceledException)
        {
            // A newer folder/lens selection superseded this load.
        }
    }

    public void Dispose()
    {
        _reloadCts?.Cancel();
        _reloadCts?.Dispose();
    }

    private void ComputeFolderFilterRanges(Chart[] charts)
    {
        _lowestBpm = charts.Any(c => c.Song.Bpm != null) ? charts.Where(c => c.Song.Bpm != null).Min(c => c.Song.Bpm!.Value.Min) : 0;
        _settings.MinBpm = null;
        _highestBpm = charts.Any(c => c.Song.Bpm != null) ? charts.Where(c => c.Song.Bpm != null).Max(c => c.Song.Bpm!.Value.Max) : 0;
        _settings.MaxBpm = null;
        _lowestNoteCount = charts.Any(c => c.NoteCount != null) ? charts.Where(c => c.NoteCount != null).Min(c => c.NoteCount!.Value) : 0;
        _settings.MinNoteCount = null;
        _highestNoteCount = charts.Any(c => c.NoteCount != null) ? charts.Where(c => c.NoteCount != null).Max(c => c.NoteCount!.Value) : 0;
        _settings.MaxNoteCount = null;
        _availableStepArtists = charts.Select(c => c.StepArtist ?? "Unknown").Distinct().OrderBy(s => s).ToArray();
        _availableSongArtists = charts.Select(c => c.Song.Artist).Distinct().OrderBy(s => s).ToArray();
    }

    private async Task LoadFolder(CancellationToken cancellationToken)
    {
        _isLoading = true;
        // The share-only reads are per-folder answers; a folder (or mix) change makes them
        // stale, and the next dialog open re-fetches what its toggles actually need.
        _top50TypeIds = null;
        _top50CombinedIds = null;
        _shareGains = null;
        StateHasChanged();

        // The PUMBILITY lens only answers for a band of folders around the peer group, and the
        // routes for the others still exist and are crawlable. Land on the nearest folder that
        // has an answer rather than on a dead page — silently, per the owner: an explanation
        // for a folder the reader may not have chosen deliberately is noise.
        await LoadPumbilityFolders(cancellationToken);
        if (!PumbilityFolderHasData(_chartType, _level))
        {
            var nearest = NearestPumbilityFolder(_chartType, _level);
            if (nearest != null && nearest.Value.Level != _level)
            {
                _level = nearest.Value.Level;
                // Replace, never push: this corrects an address the reader typed or followed,
                // so Back must return to wherever they came from — a pushed entry leaves the
                // URL and the rendered folder disagreeing after one Back press, since the
                // static router handles no popstate.
                await SetQueryString(replace: true);
            }
        }

        await UiSettings.SetSetting("TierLists__Level", _level.ToString(), cancellationToken);
        await UiSettings.SetSetting("TierLists__ChartType", _chartType.ToString(), cancellationToken);
        // The view toggle is a real choice on every mix, so it persists on every mix.
        await UiSettings.SetSetting("TierLists__GroupBy", _groupBy, cancellationToken);
        if (!IsLegacy)
        {
            // "Community" is forced for legacy mixes, never a saved preference — a later
            // Phoenix session should restore whatever lens the player actually chose. Same
            // for personalization, which has no meaning without scoring levels.
            await UiSettings.SetSetting("TierLists__ListType", _tierListType, cancellationToken);
        }

        _charts = _allCharts.Values
            .Where(c => c.Level == _level && c.Type == _chartType)
            .ToDictionary(c => c.Id);
        _folderScores = _scores.Where(kv => _charts.ContainsKey(kv.Key)).ToDictionary(kv => kv.Key, kv => kv.Value);

        // The folder's identity chips — read against THIS folder, which is why the mix goes
        // with the ids. Empty until an ingestion has banked step analysis and baselines.
        _identity = await Mediator.Send(new GetChartIdentityQuery(_charts.Keys.ToArray(), _currentMix),
            cancellationToken);
        // Per-badge presence for the Folder Stats drawer's ability rows: every badge a chart
        // really carries, not the handful the cards had room for.
        _badgePresence = await Mediator.Send(new GetChartBadgePresenceQuery(_charts.Keys.ToArray(), _currentMix),
            cancellationToken);

        _archivedTags = ChabalaLensActive
            ? await Mediator.Send(new GetArchivedSkillTagsQuery(_charts.Keys.ToArray()), cancellationToken)
            : new Dictionary<Guid, IReadOnlyList<string>>();
        // The Speed list is stored per mix for every folder at once; this folder's slice is
        // what Group By Speed sections on.
        // Read WITH the fallback flag and then refuse the fallback. A band is a chart's speed
        // relative to the folder it was banded in, and a chart's folder changes between mixes —
        // so Phoenix's bands standing in for an unbuilt Phoenix 2 list would be measuring
        // against company the chart does not keep there. Better to offer no Speed view at all.
        var speed = await Mediator.Send(new GetTierListWithFallbackQuery(SpeedBandLabels.ListName, _currentMix), cancellationToken);
        _speedBands = speed.IsProvisionalFallback
            ? new Dictionary<Guid, SongTierListEntry>()
            : speed.Entries
                .Where(e => _charts.ContainsKey(e.ChartId))
                .GroupBy(e => e.ChartId)
                .ToDictionary(g => g.Key, g => g.First());

        // Group By Speed answers to the folder, so its fallback runs once the folder's data is
        // known — the init guard runs before any chart is loaded and would strip a legitimate
        // saved grouping. Also covers folder-hopping into one with nothing banked.
        if (_groupBy == "Speed" && !FolderHasSpeed)
        {
            _groupBy = "Difficulty";
        }

        // Phoenix 2's folder-title track — recomputed for THIS folder on every change (the full
        // load runs once, so it can't live there). Null for Phoenix/legacy and signed-out.
        _titleTrack = CurrentUser.IsLoggedIn
            ? FolderTitleTrack.Compute(_currentMix, _chartType, _level, _allCharts, _scores)
            : null;

        // Folder standing, recomputed per folder alongside the title track. Signed-out visitors
        // have no standing to show.
        if (CurrentUser.IsLoggedIn)
        {
            var passed = FolderLevelRecord.PassedScores(_folderScores.Values);
            _folderLevel = FolderLevelRecord.For(_currentMix, _chartType, _level, _charts.Values, passed);
            _folderGrades = _charts.Values
                .Select(c => passed.TryGetValue(c.Id, out var score) ? score : (int?)null)
                .Where(s => s != null)
                .Select(s => PhoenixScore.From(s!.Value).LetterGradeFor(_currentMix))
                .OrderByDescending(g => g)
                .ToArray();
        }
        else
        {
            _folderLevel = null;
            _folderGrades = Array.Empty<PhoenixLetterGrade>();
        }
        if (IsLegacy)
        {
            // Community lens only: entries were fetched whole-mix at init; the folder
            // just filters. No popularity flags, no personal overlay phases.
            _finalEntries = _communityEntries.Where(e => _charts.ContainsKey(e.ChartId)).ToArray();
            _isProvisionalFallback = false;
            _chartDifficulties = _finalEntries.ToDictionary(e => e.ChartId, e => e.Category);
            ComputeFolderFilterRanges(_finalEntries.Select(e => _charts[e.ChartId]).ToArray());
            RegroupEntries();
            _isLoading = false;
            StateHasChanged();
            return;
        }

        // Population phase — works logged-out, renders as soon as it lands.
        var blended = await Mediator.Send(new GetBlendedTierListQuery(_chartType, _level, _tierListType,
            PersonalizedActive, Mix: _currentMix), cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();

        // A folder only a couple of players at this level have touched cannot rank anything, so
        // the personalized view is not offered for it: the button greys with a reason and the
        // reader lands on the community list rather than on a screen of Not Rated. Only judged
        // when the personalized blend actually ran — the community path computes no cohort, and
        // its zero would grey the button on every folder.
        // Only overwritten when the personalized blend RAN. Clearing it whenever it did not
        // would un-grey the button on the very reload the fallback triggers, since that reload
        // is on the community list by definition — the warning would flash and vanish. The
        // folder and lens changes clear it instead, because those are what make it stale.
        if (PersonalizedActive && _tierListType == "Score")
        {
            _thinCohort = blended.PeerCount < MinCohortPeers ? blended.PeerCount : null;
        }

        if (_thinCohort != null && _groupBy == "Personalized")
        {
            _groupBy = "Difficulty";
            await UiSettings.SetSetting("TierLists__GroupBy", _groupBy, cancellationToken);
            await LoadFolder(cancellationToken);
            return;
        }

        // Only when the switch asks for it: this is a peer sweep, and no other part of the page
        // needs it. SetShowProjectedScore backfills when it comes back on inside a folder.
        _projectedScores = _settings.ShowProjectedScore && CurrentUser.IsLoggedIn && _chartType != ChartType.CoOp
            ? await Mediator.Send(new GetProjectedScoresQuery(_chartType, _level, _currentMix), cancellationToken)
            : new Dictionary<Guid, PhoenixScore>();

        // The blank-page guard is dead (rule 9): render every chart we can resolve and
        // silently drop entries whose chart no longer exists.
        _finalEntries = blended.Entries.Where(e => _charts.ContainsKey(e.ChartId)).ToArray();
        _appearances = blended.Appearances ?? new Dictionary<Guid, int>();
        _peerCount = blended.PeerCount;
        _isProvisionalFallback = blended.IsProvisionalFallback;
        _chartDifficulties = _finalEntries.ToDictionary(e => e.ChartId, e => e.Category);

        ComputeFolderFilterRanges(_finalEntries.Select(e => _charts[e.ChartId]).ToArray());

        RegroupEntries();
        _isLoading = false;
        StateHasChanged();

        if (!CurrentUser.IsLoggedIn)
        {
            return;
        }

        // Personal phase — the overlay streams in after the population paint.
        var rankingsTask = Mediator.Send(new GetPlayerScoreQualityQuery(_level, _chartType, _currentMix), cancellationToken);
        // Nobody's looking at the cross-mix outline when it's switched off, so don't pay
        // for it; SetShowOtherMixPasses backfills when it comes back on.
        var crossMixTask = _settings.ShowOtherMixPasses
            ? Mediator.Send(new GetCrossMixPassesQuery(_currentMix), cancellationToken)
            : Task.FromResult<IReadOnlySet<Guid>>(new HashSet<Guid>());
        var competitiveTask = Mediator.Send(new GetCompetitivePlayersQuery(_chartType, _currentMix), cancellationToken);
        // Round 7: pass standing among similar players, from the folder's materialized
        // cohort histograms. CoOp has no cohort data (the rebuild covers S/D only).
        var cohortTask = _chartType == ChartType.CoOp
            ? Task.FromResult<FolderCohortSummaryRecord?>(null)
            : Mediator.Send(new GetFolderCohortStatsQuery(_currentMix, _chartType, _level,
                _chartType == ChartType.Single ? _singlesCompetitive : _doublesCompetitive, PassedCount),
                cancellationToken);
        _scoreRankings = await rankingsTask;
        _otherMixPasses = await crossMixTask;
        _otherMixPassesLoaded = _settings.ShowOtherMixPasses;
        _competitivePlayerCount = (await competitiveTask).Count();
        _cohortSummary = await cohortTask;
        cancellationToken.ThrowIfCancellationRequested();

        var baseRating = DifficultyLevel.From(_level).BaseRating;
        if (_chartType == ChartType.CoOp)
        {
            baseRating = 2000;
        }
        _averageRating = _folderScores.Any(kv => !kv.Value.IsBroken && kv.Value.Score > 0)
            ? (int)_folderScores.Where(kv => !kv.Value.IsBroken && kv.Value.Score > 0).Average(s => s.Value.Score!.Value.LetterGradeFor(_currentMix).GetModifier() * baseRating)
            : baseRating;

        BuildLamps();
        StateHasChanged();
    }

    private void BuildLamps()
    {
        var lamps = new List<LampStrip.Lamp>
        {
            new("Pass", _charts.Count(kv => _scores.TryGetValue(kv.Key, out var b) && !b.IsBroken))
        };
        for (var grade = PhoenixLetterGrade.AA; grade <= PhoenixLetterGrade.SSSPlus; grade++)
        {
            var lampGrade = grade;
            lamps.Add(new LampStrip.Lamp(lampGrade.GetName(),
                _charts.Count(kv => _scores.TryGetValue(kv.Key, out var s) && s.Score?.LetterGradeFor(_currentMix) >= lampGrade)));
        }
        lamps.Add(new LampStrip.Lamp("PG", _charts.Count(kv => _scores.TryGetValue(kv.Key, out var s) && s.Score == PhoenixScore.Max)));
        _lamps = lamps;
    }

    // --- Grouping: pure in-memory --------------------------------------------------------

    private const string NeutralSectionColor = "var(--mud-palette-text-secondary)";

