    protected override async Task OnInitializedAsync()
    {
        _currentMix = await UiSettings.GetSelectedMix();
        if (IsLegacy)
        {
            // Legacy mixes load ONLY the Community lens surface — the Phoenix loads
            // below range from quietly empty to throwing (TitleSaga has no title list
            // for old mixes). Coming-soon renders when no vote data exists yet.
            _tierListType = "Community";
            var legacyChartsTask = Mediator.Send(new GetChartsQuery(_currentMix));
            var communityTask = Mediator.Send(new GetCommunityTierListQuery(_currentMix));
            var legacyLevelTask = UiSettings.GetSetting("TierLists__Level");
            var legacyTypeTask = UiSettings.GetSetting("TierLists__ChartType");
            var legacyGroupByTask = UiSettings.GetSetting("TierLists__GroupBy");

            if (CurrentUser.IsLoggedIn)
            {
                // Legacy bests live in the XX store, keyed per mix. Nothing read them here, so
                // a player who had recorded on Prime 2 saw a folder of unplayed charts and a
                // "0 passed" bar over scores the site already had.
                var legacyBests = await Mediator.Send(
                    new GetXXBestChartAttemptsQuery(CurrentUser.User.Id, _currentMix));
                var attempts = legacyBests.Where(b => b.BestAttempt != null).ToArray();
                _legacyGrades = attempts.ToDictionary(b => b.Chart.Id, b => b.BestAttempt!.LetterGrade);
                // Projected into the Phoenix-shaped score map WITHOUT a score: everything on
                // this page that asks "passed?" then works unchanged, and everything that asks
                // for a number correctly finds none — an era score is not out of 1,000,000 and
                // would be read as a catastrophic Phoenix result by every consumer here.
                _scores = attempts.ToDictionary(b => b.Chart.Id,
                    b => new RecordedPhoenixScore(b.Chart.Id, null, null, b.BestAttempt!.IsBroken,
                        b.BestAttempt.RecordedOn));
                _todos = (await Mediator.Send(new GetSavedChartsQuery()))
                    .Where(c => c.ListType == ChartListType.ToDo).Select(c => c.ChartId).Distinct().ToHashSet();
            }

            _allCharts = (await legacyChartsTask).ToDictionary(c => c.Id);
            _communityEntries = (await communityTask).ToArray();
            _hasCommunityData = _communityEntries.Any(e => e.Category != TierListCategory.Unrecorded);
            if (!_hasCommunityData || !_allCharts.Any())
            {
                _isLoading = false;
                return;
            }

            if (Enum.TryParse<ChartType>(await legacyTypeTask, out var savedLegacyType)) _chartType = savedLegacyType;
            if (int.TryParse(await legacyLevelTask, out var savedLegacyLevel)) _level = savedLegacyLevel;
            // The Tier List / My Progress toggle is remembered here too. Only the LENS stays
            // unremembered on a legacy mix, because it is forced to Community rather than
            // chosen; the view a player picked is a real preference.
            _groupBy = await legacyGroupByTask ?? "Difficulty";
            // Old catalogs don't cover every modern folder — land on the mix's
            // fullest folder when the remembered one doesn't exist here.
            if (!_allCharts.Values.Any(c => c.Type == _chartType && c.Level == _level))
            {
                var biggest = _allCharts.Values
                    .Where(c => c.Type is ChartType.Single or ChartType.Double)
                    .GroupBy(c => (c.Type, Level: (int)c.Level))
                    .OrderByDescending(g => g.Count())
                    .First().Key;
                _chartType = biggest.Type;
                _level = biggest.Level;
            }

            await LoadFolder(CancellationToken.None);
            return;
        }

        // Kick off every independent async fetch in parallel — wall clock is bounded by
        // the slowest single query, not the sum.
        var chartsTask = Mediator.Send(new GetChartsQuery(_currentMix));
        var scoringLevelsTask = Mediator.Send(new GetChartScoringLevelsQuery(_currentMix));
        var titleProgressTask = Mediator.Send(new GetTitleProgressQuery(_currentMix));
        var userSettingsTask = UiSettings.GetSetting(UserSettingsKey);
        var showAgeSettingTask = UiSettings.GetSetting("TierLists__ShowAge");
        var levelSettingTask = UiSettings.GetSetting("TierLists__Level");
        var chartTypeSettingTask = UiSettings.GetSetting("TierLists__ChartType");
        var listTypeSettingTask = UiSettings.GetSetting("TierLists__ListType");
        var shownPersonalizedTask = UiSettings.GetSetting("TierLists__ShownPersonalized");
        var groupBySettingTask = UiSettings.GetSetting("TierLists__GroupBy");
        var densitySettingTask = UiSettings.GetSetting(DensitySettingKey);
        var legacyTextViewTask = UiSettings.GetSetting("TierLists__TextView");
        var titlesCollapsedSettingTask = UiSettings.GetSetting("TierLists__TitlesCollapsed");
        var collapsedTiersSettingTask = UiSettings.GetSetting("TierLists__CollapsedTiers");

        if (CurrentUser.IsLoggedIn)
        {
            var userId = CurrentUser.User.Id;
            var scoresTask = Mediator.Send(new GetPhoenixRecordsQuery(userId, _currentMix));
            var statsTask = Mediator.Send(new GetPlayerStatsQuery(userId, _currentMix));
            var todosTask = Mediator.Send(new GetSavedChartsQuery());

            _scores = (await scoresTask).ToDictionary(c => c.ChartId);
            var stats = await statsTask;
            _singlesCompetitive = stats.SinglesCompetitiveLevel;
            _doublesCompetitive = stats.DoublesCompetitiveLevel;
            if (stats.DoublesCompetitiveLevel > 1)
            {
                _level = (int)Math.Round(stats.DoublesCompetitiveLevel);
            }
            if (stats.SinglesCompetitiveLevel > 1 && stats.SinglesCompetitiveLevel > stats.DoublesCompetitiveLevel)
            {
                _chartType = ChartType.Single;
                _level = (int)Math.Round(stats.SinglesCompetitiveLevel);
            }
            _todos = (await todosTask).Where(c => c.ListType == ChartListType.ToDo).Select(c => c.ChartId).Distinct().ToHashSet();
        }

        _allCharts = (await chartsTask).ToDictionary(c => c.Id);
        _scoringLevels = await scoringLevelsTask;
        _titleProgress = (await titleProgressTask).ToArray();

        var settingsString = await userSettingsTask;
        if (!string.IsNullOrWhiteSpace(settingsString))
        {
            _settings = JsonSerializer.Deserialize<FilterSettings>(settingsString) ?? new FilterSettings();
        }

        _showAge = bool.TryParse(await showAgeSettingTask, out var showAge) && showAge;
        // One-time migration: Text View retires into its successor, the Table density.
        _density = Enum.TryParse<UiDensity>(await densitySettingTask, out var density) ? density :
            bool.TryParse(await legacyTextViewTask, out var legacyTextView) && legacyTextView
                ? UiDensity.Table
                : UiDensity.Comfortable;
        // Unset (or unparseable) means collapsed — the round-6 default.
        _titlesCollapsed = !bool.TryParse(await titlesCollapsedSettingTask, out var titlesCollapsed) || titlesCollapsed;
        var collapsedTiersJson = await collapsedTiersSettingTask;
        if (!string.IsNullOrWhiteSpace(collapsedTiersJson))
        {
            try
            {
                _collapsedTiers = JsonSerializer.Deserialize<HashSet<string>>(collapsedTiersJson) ?? new HashSet<string>();
            }
            catch (JsonException)
            {
                _collapsedTiers = new HashSet<string>();
            }
        }

        // Saved settings refine the competitive-level smart default; when unset they fall
        // through to the stats-derived folder instead of clobbering it with 18/Double.
        _level = int.TryParse(await levelSettingTask, out var savedLevel) ? savedLevel : _level;
        _chartType = Enum.TryParse<ChartType>(await chartTypeSettingTask, out var savedType) ? savedType : _chartType;
        var savedLens = await listTypeSettingTask;
        _tierListType = LensKeys.FirstOrDefault(k => string.Equals(k, savedLens, StringComparison.OrdinalIgnoreCase)) ?? "Pass";
        // No migration from TierLists__UsePersonalized, which defaulted ON: nobody chose that,
        // and everyone lands on Community now (owner). The key simply stops being read.
        _shownPersonalized = (await shownPersonalizedTask ?? false.ToString()) == true.ToString();
        _groupBy = await groupBySettingTask ?? "Difficulty";

        // Legacy query params, then the canonical C3 path route, win over saved state.
        if (DifficultyFilter is >= 1 and <= 29)
        {
            _level = DifficultyFilter.Value;
        }
        if (Enum.TryParse<ChartType>(ChartTypeFilter, out var chartTypeParam))
        {
            _chartType = chartTypeParam;
        }
        if (Enum.TryParse<ChartType>(ChartTypeRoute, true, out var routeType))
        {
            _chartType = routeType;
        }
        if (LevelRoute is >= 1 and <= 29)
        {
            _level = LevelRoute.Value;
        }
        var queryLens = TierListType == null
            ? null
            : LensKeys.FirstOrDefault(k => string.Equals(k, TierListType, StringComparison.OrdinalIgnoreCase));
        if (queryLens != null)
        {
            _tierListType = queryLens;
        }

        // Guards: CoOp folders are 2-5 players; folders without Chabala data fall back to
        // the default lens; retired or login-gated groupings fall back to the tier-list view.
        if (_chartType == ChartType.CoOp && _level is < 2 or > 5)
        {
            _level = 2;
        }
        if (_tierListType == "Chabala" && !ChabalaAvailable)
        {
            _tierListType = "Pass";
        }
        if (_tierListType == "PUMBILITY" && !PumbilityAvailable)
        {
            _tierListType = "Pass";
        }
        // "Speed" is deliberately not checked here: whether it is available depends on the
        // folder's charts, which are not loaded yet. Its fallback runs after the folder does.
        if (!ValidGroupings.Contains(_groupBy) || (!CurrentUser.IsLoggedIn && _groupBy is "Score" or "Age" or "Score Ranking")
            || (_groupBy == "Personalized" && !CanPersonalize))
        {
            _groupBy = "Difficulty";
        }

        // The ChangeGrouping guard, applied to restored state too: a saved or bookmarked lens
        // the restored view no longer offers (every pre-PUMBILITY Personalized-Pass user has
        // exactly GroupBy=Personalized + ListType=Pass saved) would leave the Ranked-by select
        // holding a value it does not list — which MudSelect renders blank — over a community
        // blend wearing the Personalized button. Runs after every groupBy guard above so it
        // normalizes against the view that will actually render; Recalculate re-saves the
        // corrected lens and the canonical replace below rewrites the URL that carried it.
        if (!LensesFor(_groupBy).Contains(_tierListType))
        {
            _tierListType = LensesFor(_groupBy).First();
        }

        await SetQueryString(replace: true);
        await Recalculate();
    }
}
