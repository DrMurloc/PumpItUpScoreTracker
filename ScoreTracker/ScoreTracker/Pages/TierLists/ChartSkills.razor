@page "/TierLists"
@page "/TierLists/{ChartTypeRoute}/{LevelRoute:int}"
@rendermode RenderModes.Interactive
@using MediatR
@using ScoreTracker.Web.Enums
@using ScoreTracker.Catalog.Contracts
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.ScoreLedger.Contracts.Queries
@using ScoreTracker.PlayerProgress.Contracts
@using ScoreTracker.PlayerProgress.Contracts.Queries
@using ScoreTracker.ChartIntelligence.Contracts
@using ScoreTracker.ChartIntelligence.Contracts.Queries
@using ScoreTracker.Domain.Services
@using ScoreTracker.Domain.Services.Contracts
@using ScoreTracker.Application.Commands
@using ScoreTracker.Application.Queries
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Domain.Models
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.Domain.Models.Titles
@using ScoreTracker.Domain.Models.Titles.Phoenix
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Components
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@using ScoreTracker.Domain.Records
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Contracts
@using ScoreTracker.Web.Services.Theming
@using ScoreTracker.Application.Queries
@using System.Text.Json
@implements IDisposable
<PageTitle>@L["PIU Tier List"]</PageTitle>
<HeadContent>
    <meta name="description" content="PIU Charts organized by difficulty with optional personalization based on individual skill."/>
    <meta property="og:title" content="PIU Tier List">
    <meta property="og:description" content="PIU Charts organized by difficulty with optional personalization based on individual skill." >
</HeadContent>
@if (_currentMix.UsesLegacyScoring() && !_hasCommunityData)
{
    @* Legacy mixes render the Community Rating lens once vote data exists (S4 backfill
       seeds it; docs/design/legacy-mixes.md). Until then: the round-5 coming-soon state
       — the old silent Phoenix-data masquerade (ListMix) stays retired. *@
    <div class="tier-list-cta">
        <MudIcon Icon="@Icons.Material.Filled.Construction"></MudIcon>
        <MudText Typo="Typo.h5">@L["Tier lists for XX and older coming soon"]</MudText>
    </div>
}
else
{
    <div class="tier-page">
    @* 1 — sticky toolbar: the whole "what list am I looking at" choice — folder, view,
       lens, grouping — in one place at every width. Desktop reads as one line (the row
       flattens via display:contents); under 960 the view buttons take the second line
       whole, keeping all four glanceable; under 500 they hand over to the View select
       and the lens controls take their own line. The presentation tools live in the
       content bar below. *@
    <div class="tier-toolbar">
        <div class="tier-toolbar-row">
            @* CoOp folders are never marked missing: the lens is not offered there, so picking
               one swaps the lens (Chabala precedent) rather than dead-ending on a greyed grid. *@
            <FolderPicker Type="_chartType" Level="_level" Disabled="_isLoading" FolderChanged="ChangeFolder"
                          IsMissing="@((t, l) => t != ChartType.CoOp && !PumbilityFolderHasData(t, l))"></FolderPicker>
            @* Four views, one visible answer to "what am I looking at". Personalized was a
               switch riding on top of this group until 2026-08-11, which meant the state was
               spread across two controls and one of them was invisible in screenshots. *@
            <MudButtonGroup OverrideStyles="false" Class="tier-views-group">
                <MudButton Variant="@(_groupBy == "Difficulty" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ChangeGrouping("Difficulty"))">@L["Community"]</MudButton>
                @if (CanPersonalize)
                {
                    <MudButton Variant="@(_groupBy == "Personalized" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                               Disabled="@(_thinCohort != null)"
                               title="@(_thinCohort != null ? L["Not enough players in range to provide results"].ToString() : null)"
                               OnClick="@(() => ChangeGrouping("Personalized"))">@L["Personalized"]</MudButton>
                }
                <MudButton Variant="@(IsMyProgress ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ChangeGrouping(CurrentUser.IsLoggedIn ? "Score" : "Scoring Level"))">@L["My Scores"]</MudButton>
                @if (FolderHasSpeed)
                {
                    <MudButton Variant="@(_groupBy == "Speed" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ChangeGrouping("Speed"))">@L["Speed"]</MudButton>
                }
            </MudButtonGroup>
            @* The same four views as one control under 500 — on a portrait phone even a
               dedicated row can't hold the buttons in every locale (French needs ~460px). *@
            <MudSelect T="string" Class="tier-toolbar-select tier-view-select" Label="@L["View"]" Disabled="_isLoading" Value="ViewValue" ValueChanged="ChangeView">
                <MudSelectItem T="string" Value="@("Difficulty")">@L["Community"]</MudSelectItem>
                @if (CanPersonalize)
                {
                    <MudSelectItem T="string" Value="@("Personalized")" Disabled="_thinCohort != null">@L["Personalized"]</MudSelectItem>
                }
                <MudSelectItem T="string" Value="@("MyProgress")">@L["My Scores"]</MudSelectItem>
                @if (FolderHasSpeed)
                {
                    <MudSelectItem T="string" Value="@("Speed")">@L["Speed"]</MudSelectItem>
                }
            </MudSelect>
            <div class="tier-lens-wrap">
                @* A legacy mix gets no lens control at all. It has exactly one — Community Rating,
                   off the vote aggregates — so the picker was a disabled dropdown with a single
                   option, which is a control that looks broken rather than one that explains itself.
                   It comes back when voting does; the lens itself is unchanged (owner, 2026-08-10). *@
                @if (!IsLegacy)
                {
                @* Three shapes, because the lens means three different things. On the tier views it
                   RANKS, so Community offers every community list and Personalized offers only the two
                   that have a personalized recipe. On My Scores and Skill Breakdown something else does
                   the sectioning and the lens only annotates each card — so it is labelled for what it
                   does there, and it can name a personalized reading outright, which is the one place
                   those are reachable from. *@
                @if (_groupBy == "Personalized")
                {
                    <MudSelect T="string" Class="tier-toolbar-select" Label="@L["Ranked by"]" Disabled="_isLoading" Value="_tierListType" ValueChanged="ChangeLens">
                        <MudSelectItem T="string" Value="@("PUMBILITY")">PUMBILITY</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Score")">@L["Score Difficulty"]</MudSelectItem>
                    </MudSelect>
                }
                else if (IsTierView)
                {
                    <MudSelect T="string" Class="tier-toolbar-select" Label="@L["Ranked by"]" Disabled="_isLoading" Value="_tierListType" ValueChanged="ChangeLens">
                        @if (PumbilityAvailable)
                        {
                            <MudSelectItem T="string" Value="@("PUMBILITY")">PUMBILITY</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@("Pass")">@L["Pass Difficulty"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Score")">@L["Score Difficulty"]</MudSelectItem>
                        @if (ChabalaAvailable)
                        {
                            <MudSelectItem T="string" Value="@("Chabala")">Chabala</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@("PG")">PG</MudSelectItem>
                    </MudSelect>
                }
                else
                {
                    <MudSelect T="string" Class="tier-toolbar-select" Label="@L["Shown Difficulty"]" Disabled="_isLoading" Value="ShownDifficultyValue" ValueChanged="ChangeShownDifficulty">
                        @if (PumbilityAvailable)
                        {
                            <MudSelectItem T="string" Value="@("PUMBILITY")">PUMBILITY</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@("Pass")">@L["Pass Difficulty"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Score")">@L["Score Difficulty"]</MudSelectItem>
                        @if (CanPersonalize)
                        {
                            <MudSelectItem T="string" Value="@("Personalized PUMBILITY")">@L["Personalized PUMBILITY"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Personalized Score")">@L["Personalized Score"]</MudSelectItem>
                        }
                        @if (ChabalaAvailable)
                        {
                            <MudSelectItem T="string" Value="@("Chabala")">Chabala</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@("PG")">PG</MudSelectItem>
                    </MudSelect>
                }
                }
                @if (IsMyProgress)
                {
                    <MudSelect T="string" Class="tier-toolbar-select" Label="@L["Grouped by"]" Value="_groupBy" ValueChanged="ChangeGrouping">
                        @if (CurrentUser.IsLoggedIn)
                        {
                            <MudSelectItem T="string" Value="@("Score")">@L["Score"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Age")">@L["Age"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Score Ranking")">@L["Score Ranking"]</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@("Scoring Level")">@L["Scoring level"]</MudSelectItem>
                    </MudSelect>
                }
            </div>
        </div>
    </div>
    @* The context caption: the one chip that is a warning, and who the personalized list
       ranked you against — a note under the controls, not a headline. The lens-naming
       chips died with the Advanced drawer: the selects are visible at every width now. *@
    @if (_isProvisionalFallback || (PersonalizedActive && _peerCount > 0))
    {
        <div class="tier-context-line">
            @if (_isProvisionalFallback)
            {
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Construction">@L["Provisional — based on Phoenix data"]</MudChip>
            }
            @* Same slot on every personalized lens; only the peer group differs. On Phoenix 2
               both lenses read PUMBILITY peers — the projection behind the Score lens draws them
               too (D23, D55): the players whose pool of the type sits within the window around
               yours (D53) — while Phoenix 1 keeps the difficulty-title level on PUMBILITY and the
               competitive band on Score. *@
            @if (PersonalizedActive && _peerCount > 0)
            {
                <span>
                    @(_currentMix == MixEnum.Phoenix2
                        ? L["Ranked against {0} PUMBILITY peers whose pool sits within {1} below and {2} above yours", _peerCount,
                            PeerGroup.PumbilityWindowBelow.ToString("N0"), PeerGroup.PumbilityWindowAbove.ToString("N0")]
                        : _tierListType == "PUMBILITY"
                            ? L["Ranked against {0} players on your difficulty title level", _peerCount]
                            : L["Ranked against {0} players of similar competitive level", _peerCount])
                </span>
                @* Score only: the Breakdown page explains the Score projection and coerces any
                   other lens to it, so linking it from Personalized PUMBILITY would answer a
                   different question than the one on screen. A PUMBILITY breakdown mode is
                   deferred (design doc §10) — deferring means no link, not a rerouted one. *@
                @if (_groupBy == "Personalized" && _tierListType == "Score")
                {
                    <MudTooltip Text="@L["How is this personalized?"]">
                        <MudIconButton Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Href="@BreakdownUrl"
                                       aria-label="@L["How is this personalized?"]"></MudIconButton>
                    </MudTooltip>
                }
            }
        </div>
    }
    @* 3 — folder progress (logged in) or the rule-9 import CTA (anonymous).
       Piucenter round 5: folder progress lives ONLY in the Folder Stats drawer at
       every width — the fold belongs to the tier sections (rule 1). *@
    @if (CurrentUser.IsLoggedIn)
    {
        RenderFragment folderStatsCore = @<text>
            @* The "N / M passed" summary that used to head this drawer is gone: the folder bar on
               the page states it, and repeating it in a drawer you have to open is worse than
               not saying it twice. What stays here is everything the bar cannot say — the lamp
               ladder's exact counts, where you sit against similar players, and your skills. *@
            <LampStrip Lamps="_lamps" Total="_charts.Count"></LampStrip>
            @* Round 7: cohort standing as labeled bars — fill + hue from the rarity ramp,
               with the percentage always printed beside it (rule 8). *@
            @if (_competitivePlayerCount > 0 && _finalEntries.Any(e => _scoreRankings.ContainsKey(e.ChartId)))
            {
                var rating = _finalEntries.Where(e => _scoreRankings.ContainsKey(e.ChartId)).Average(e => _scoreRankings[e.ChartId].Ranking);
                <div class="tier-cohort-bar">
                    <span class="tier-cohort-bar-label">@L["Score in Folder"]</span>
                    <span class="tier-cohort-bar-meter">
                        <span class="tier-cohort-bar-fill" style="width:@((100.0 * rating).ToString("0"))%;background:@ThemeScales.CssVar(ThemeScales.BandFor(rating))"></span>
                    </span>
                    <span class="tier-cohort-bar-value @ThemeScales.RarityClass(ThemeScales.BandFor(rating))" style="@ThemeScales.RarityStyle(rating)">@((100.0 * rating).ToString("N1"))%</span>
                    <span class="tier-cohort-bar-note">@L["of {0} similar players in this folder", _competitivePlayerCount]</span>
                </div>
            }
            @if (_cohortSummary != null)
            {
                <div class="tier-cohort-bar">
                    <span class="tier-cohort-bar-label">@L["Passes in Folder"]</span>
                    <span class="tier-cohort-bar-meter">
                        <span class="tier-cohort-bar-fill" style="width:@((100.0 * _cohortSummary.PassPercentile).ToString("0"))%;background:@ThemeScales.CssVar(ThemeScales.BandFor(_cohortSummary.PassPercentile))"></span>
                    </span>
                    <span class="tier-cohort-bar-value @ThemeScales.RarityClass(ThemeScales.BandFor(_cohortSummary.PassPercentile))" style="@ThemeScales.RarityStyle(_cohortSummary.PassPercentile)">@((100.0 * _cohortSummary.PassPercentile).ToString("N0"))%</span>
                    <span class="tier-cohort-bar-note">@L["You: {0} · similar players average {1}", PassedCount, _cohortSummary.AveragePasses.ToString("N1")]</span>
                </div>
            }
            @* Piucenter round 3: the personal skill distribution, at a glance — your
               ability per skill in this folder, weakest first (the By-Skill grouping
               is this same data rendered as sections). Shared with the Personalized
               Breakdown page via FolderSkillList. *@
            @if (CurrentUser.IsLoggedIn)
            {
                <FolderSkillList Charts="_charts.Values" BadgePresence="_badgePresence" Scores="_scores"
                                 Title="@L["Your Skills in Folder"]"></FolderSkillList>
            }
            @if (_unpassedTodos.Any())
            {
                <MudText Typo="Typo.caption">@L.GetString("Unpassed ToDos", _unpassedTodos.Count(), _level)</MudText>
            }
        </text>;

        @* Piucenter round 5: the inline desktop strip died — the folder-skills block
           regrew it past the fold, so the Folder Stats drawer is now folder progress's
           ONE home at every width (the button shows everywhere). The border legend moved
           into the content bar (between the lens and density switch). *@
        @* Each drawer brings its own MudLayout container — the layout stopped hosting one. *@
        <MudLayout>
        <MudDrawer @bind-Open="_statsOpen" Anchor="Anchor.Right" Variant="@DrawerVariant.Temporary" Width="320px">
            <div class="tier-filter-drawer">
                <div class="tier-drawer-head">
                    <MudText Typo="Typo.h6">@L["Folder Stats"]</MudText>
                    <MudSpacer></MudSpacer>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _statsOpen = false"
                                   aria-label="@L["Close"]"></MudIconButton>
                </div>
                @folderStatsCore
                <BorderLegend ShowOtherMix="_settings.ShowOtherMixPasses"></BorderLegend>
                @* Phoenix's difficulty-title bars. Phoenix 2 replaces these with the PUMBILITY
                   title track above the tier sections, so they're skipped there. *@
                @if (!IsLegacy && _currentMix != MixEnum.Phoenix2)
                {
                    <MudText Typo="Typo.overline">@L["Folder Levels"]</MudText>
                    <MudGrid>
                        <TitleProgressBar AverageRating="_averageRating" Titles="_titleProgress.Where(t => (t.Title is PhoenixDifficultyTitle pdt && pdt.Level == _level) || (_chartType == ChartType.CoOp && t.Title is PhoenixCoOpTitle))"></TitleProgressBar>
                    </MudGrid>
                }
            </div>
        </MudDrawer>
        </MudLayout>
    }
    else
    {
        <div class="tier-list-cta">
            <MudText Typo="Typo.h6">@L["Import your scores to light this folder up"]</MudText>
            <div class="tier-list-cta-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/Login">@L["Login"]</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/UploadPhoenixScores">@L["Import Scores"]</MudButton>
            </div>
        </div>
    }
    @if (_tierListType == "Chabala" && ChabalaAvailable)
    {
        <MudLink Href="@_chabalaLinks[(_chartType, _level)]" Target="_blank">@L["Original Chabala Tier List"]</MudLink>
    }
    @if (_groupBy == "Score Ranking")
    {
        <MudText Typo="Typo.body2">@L["Score Ranking: What percent of players of comparable (+/- .5 competitive level) your score is on a chart."]</MudText>
    }
    @if (IsSkillView)
    {
        @* Skill sections sort weakest-first — the radar charts' information, placed
           where it's actionable (round 4). Attribution per the round-3 agreement. *@
        <MudText Typo="Typo.caption" Class="tier-attribution">@L["Skill data: PIU Center — maintained by aesthete"]</MudText>
    }
    @* Phoenix 2 folder-title track: the glowy bar toward your next PUMBILITY title + one
       folder-aware line, above the fold, above the tier sections (not in Folder Stats). Phoenix
       and legacy keep the difficulty-title bars in the drawer. *@
    @if (_titleTrack != null)
    {
        <PumbilityTitleTrack Result="_titleTrack"></PumbilityTitleTrack>
    }
    @* Folder standing: one line and the bar, nothing else. No difficulty ball (you are already
       on this folder's page) and no chart counts — the segments, the tier ticks and the lamp
       flag carry the rest (docs/design/folder-level-progression.md §3.3). *@
    @if (_folderLevel is { Size: > 0 })
    {
        <div class="fl-header">
            <div class="fl-header-line">
                @if (_folderLevel.IsLamped)
                {
                    <span>@L["Folder Lamp"]</span>
                }
                else
                {
                    <span>@L["{0}% complete", _folderLevel.CompletionPercent]</span>
                }
                @if (_folderLevel.Grade != null)
                {
                    <span class="fl-header-dot">·</span>
                    <span class="@FolderGradeGlow" style="color:@MixThemes.GradeVar(_folderLevel.Grade.Value)">
                        @_folderLevel.Grade.Value.GetName()
                    </span>
                }
            </div>
            <FolderSpectrum GradesDescending="_folderGrades" Size="_folderLevel.Size"
                            Height="FolderSpectrumSize.Chunky"></FolderSpectrum>
        </div>
    }
    @* 2 — content bar: how the list PRESENTS (lens ordering, grouping, density,
       Download, Filters). Sits with the list it affects, not in the sticky toolbar. *@
    <div class="tier-content-bar">
        @if (CurrentUser.IsLoggedIn)
        {
            @* One home at every width; the name rides the tooltip and aria-label. *@
            <MudTooltip Text="@L["Folder Stats"]">
                <MudIconButton Icon="@Icons.Material.Filled.QueryStats" Color="Color.Primary" Variant="Variant.Outlined"
                               OnClick="() => _statsOpen = true" aria-label="@L["Folder Stats"]"></MudIconButton>
            </MudTooltip>
        }
        <MudSpacer></MudSpacer>
        @* The card-outline legend rides the middle of the bar — it explains the borders
           on the cards below (desktop only). *@
        <div class="tier-desktop-only">
            <BorderLegend ShowOtherMix="_settings.ShowOtherMixPasses"></BorderLegend>
        </div>
        <MudSpacer></MudSpacer>
        <MudButtonGroup OverrideStyles="false">
            <MudTooltip Text=@L["Comfortable"]>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ViewComfy"
                               Color="@(_density == UiDensity.Comfortable ? Color.Primary : Color.Default)"
                               OnClick="() => SetDensity(UiDensity.Comfortable)" aria-label="@L["Comfortable"]"></MudIconButton>
            </MudTooltip>
            <MudTooltip Text=@L["Compact"]>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.GridView"
                               Color="@(_density == UiDensity.Compact ? Color.Primary : Color.Default)"
                               OnClick="() => SetDensity(UiDensity.Compact)" aria-label="@L["Compact"]"></MudIconButton>
            </MudTooltip>
            <MudTooltip Text=@L["Table"]>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.TableRows"
                               Color="@(_density == UiDensity.Table ? Color.Primary : Color.Default)"
                               OnClick="() => SetDensity(UiDensity.Table)" aria-label="@L["Table"]"></MudIconButton>
            </MudTooltip>
        </MudButtonGroup>
        @* The Filters icon + drawer are width-independent (round 9 refinement) —
           filtering always lives here, never inside Advanced. *@
        <MudTooltip Text=@L["Filters and Columns"]>
            <MudBadge Content="ActiveFilterCount" Visible="HasActiveFilters" Color="Color.Primary" Overlap="true">
                <MudIconButton Icon="@Icons.Material.Filled.FilterList" Color="Color.Primary" Variant="Variant.Outlined"
                               OnClick="() => _filtersOpen = true" aria-label="@L["Filters and Columns"]"></MudIconButton>
            </MudBadge>
        </MudTooltip>
        @if (_isBuildingImage)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small"></MudProgressCircular>
        }
        else
        {
            <MudTooltip Text="@L["Download"]">
                <MudIconButton Icon="@Icons.Material.Filled.FileDownload" Color="Color.Primary" Variant="Variant.Outlined"
                               OnClick="() => _downloadOpen = true" Disabled="_isLoading" aria-label="@L["Download"]"></MudIconButton>
            </MudTooltip>
        }
    </div>
    @* Active-filter chips: labeled so it's obvious what the chips are (round 6). *@
    @if (HasActiveFilters)
    {
        <div class="tier-filter-chips">
            <span class="tier-filter-chips-label">@L["Applied filters"]:</span>
            @if (!string.IsNullOrWhiteSpace(_songFilter))
            {
                <MudChip T="string" Size="Size.Small" OnClose="ClearSongNameFilter">@L["Song Name"]: @_songFilter</MudChip>
            }
            @if (_settings.SongTypes.Any())
            {
                <MudChip T="string" Size="Size.Small" OnClose="ClearSongTypeFilter">@L["Song Type"]: @string.Join(", ", _settings.SongTypes)</MudChip>
            }
            @if (_settings.ToDo != null)
            {
                <MudChip T="string" Size="Size.Small" OnClose="ClearToDoFilter">@L["To Do"]</MudChip>
            }
            @if (_settings.Completion != null)
            {
                <MudChip T="string" Size="Size.Small" OnClose="ClearCompletionFilter">@L["Stage Pass"]</MudChip>
            }
            @if (_settings.MinLetterGrade != null || _settings.MaxLetterGrade != null)
            {
                <MudChip T="string" Size="Size.Small" OnClose="ClearLetterGradeFilter">@L["Letter Grade"]</MudChip>
            }
            @if (_settings.MinBpm != null || _settings.MaxBpm != null)
            {
                <MudChip T="string" Size="Size.Small" OnClose="ClearBpmFilter">@L["BPM"]</MudChip>
            }
            @if (_settings.MinNoteCount != null || _settings.MaxNoteCount != null)
            {
                <MudChip T="string" Size="Size.Small" OnClose="ClearNoteCountFilter">@L["Note Count"]</MudChip>
            }
            @if (_settings.StepArtists.Any())
            {
                <MudChip T="string" Size="Size.Small" OnClose="ClearStepArtistFilter">@L["Step Artist"]</MudChip>
            }
            @if (_settings.SongArtists.Any())
            {
                <MudChip T="string" Size="Size.Small" OnClose="ClearSongArtistFilter">@L["Song Artist"]</MudChip>
            }
        </div>
    }
    @* 5/6/7 — the answer: tier sections, a loading state that says so, honest empty state. One
       loader for both waits (owner, 2026-08-11) — a page that changes what it shows you while it
       loads is stranger than either loader on its own. *@
    @if (_isLoading)
    {
        <PatienceCard Explanation="@L["Compiling your personalized tier list."]"></PatienceCard>
    }
    else if (_groups.All(g => !g.Entries.Any(ShouldChartShow)))
    {
        <div class="tier-list-cta">
            <MudText>@L["No charts match your filters"]</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ClearFilters">@L["Clear Filters"]</MudButton>
        </div>
    }
    else
    {
        @foreach (var group in _groups)
        {
            var visible = group.Entries.Where(ShouldChartShow).ToArray();
            if (visible.Length == 0)
            {
                continue;
            }
            <TierSection Name="@group.Name" Color="@group.Color" Count="visible.Length" Stat="@GroupStat(visible, group)"
                         Collapsed="_collapsedTiers.Contains(group.Key)" CollapsedChanged="c => SetTierCollapsed(group.Key, c)">
                @if (_density == UiDensity.Table)
                {
                    <div class="tier-table-wrap">
                        <table class="tier-table">
                            <thead>
                            <tr>
                                <th class="tier-table-jacket-cell"></th>
                                <th>@L["Song Name"]</th>
                                <th>@L["Chart"]</th>
                                @if (ShowLensAnnotation)
                                {
                                    <th>@LensDisplayName(_tierListType)</th>
                                }
                                @if (_settings.ShowStepArtist)
                                {
                                    <th>@L["Step Artist"]</th>
                                }
                                @if (_settings.ShowSkills)
                                {
                                    <th>@L["Skills"]</th>
                                }
                                @if (CurrentUser.IsLoggedIn)
                                {
                                    @if (_showAge)
                                    {
                                        <th>@L["Age"]</th>
                                    }
                                    <th>@L["My Score"]</th>
                                    <th>@L["Better Than"]</th>
                                    <th></th>
                                }
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var entry in visible)
                            {
                                var chart = _charts[entry.ChartId];
                                var score = _scores.TryGetValue(chart.Id, out var rowScore) ? rowScore : null;
                                <tr class="@RowClass(chart.Id, score)">
                                    <td class="tier-table-jacket-cell">
                                        <div class="tier-table-jacket" role="button" tabindex="0"
                                             @onclick="() => OpenDetails(chart.Id)"
                                             style="background-image:url('@chart.Song.ImagePath')"></div>
                                    </td>
                                    <td>@chart.Song.Name</td>
                                    <td>@chart.DifficultyString</td>
                                    @if (ShowLensAnnotation)
                                    {
                                        <td><span style="color:@TierColor(entry.Category)">@L[TierName(entry.Category)]</span></td>
                                    }
                                    @if (_settings.ShowStepArtist)
                                    {
                                        <td>@chart.StepArtist</td>
                                    }
                                    @if (_settings.ShowSkills)
                                    {
                                        <td class="tier-table-skills">
                                            @foreach (var chip in SkillChipsFor(chart) ?? Array.Empty<TierListChartCard.CardSkillChip>())
                                            {
                                                <span class="tier-chart-card-skill @chip.CategoryClass">@chip.Label@(chip.Metric == null ? null : $" {chip.Metric}")</span>
                                            }
                                        </td>
                                    }
                                    @if (CurrentUser.IsLoggedIn)
                                    {
                                        @if (_showAge)
                                        {
                                            <td>
                                                @if (score != null)
                                                {
                                                    @L["{0} days ago", (int)(_now - score.RecordedDate).TotalDays]
                                                }
                                            </td>
                                        }
                                        <td>
                                            @if (score?.Score != null)
                                            {
                                                <ScoreBreakdown Score="score.Score.Value" IsBroken="score.IsBroken" Mix="_currentMix" OneLine="true" ShowScore="true" Plate="score.Plate"></ScoreBreakdown>
                                            }
                                            else if (_legacyGrades.TryGetValue(chart.Id, out var rowGrade))
                                            {
                                                <LetterGradeIcon LegacyGrade="rowGrade" IsBroken="score?.IsBroken ?? false" Height="18"></LetterGradeIcon>
                                            }
                                        </td>
                                        <td>
                                            @if (_scoreRankings.TryGetValue(chart.Id, out var rowRank))
                                            {
                                                <span style="@ThemeScales.RarityStyle(rowRank.Ranking)">@((100.0 * rowRank.Ranking).ToString("N1"))%</span>
                                            }
                                        </td>
                                        <td>
                                            <MudIconButton Size="Size.Small"
                                                           Icon="@(_todos.Contains(chart.Id) ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                                                           Color="@(_todos.Contains(chart.Id) ? Color.Info : Color.Default)"
                                                           OnClick="() => ToggleToDo(chart.Id)" aria-label="@L["To Do"]"></MudIconButton>
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Info"
                                                           OnClick="() => OpenDetails(chart.Id)" aria-label="@L["Details"]"></MudIconButton>
                                        </td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="@(_density == UiDensity.Compact ? "tier-card-grid tier-card-grid-compact" : "tier-card-grid")">
                        @foreach (var entry in visible)
                        {
                            var chart = _charts[entry.ChartId];
                            var score = _scores.TryGetValue(chart.Id, out var scr) ? scr : null;
                            <TierListChartCard Chart="chart"
                                               Score="score"
                                               LegacyGrade="_legacyGrades.TryGetValue(chart.Id, out var legacyGrade) ? legacyGrade : null"
                                               Ranking="_scoreRankings.TryGetValue(chart.Id, out var rank) ? rank : null"
                                               Passed="score is { IsBroken: false }"
                                               IsToDo="_todos.Contains(chart.Id)"
                                               PassedInAnotherMix="IsOtherMixPass(chart.Id)"
                                               ShowName="_settings.ShowSongName"
                                               ShowToDo="CurrentUser.IsLoggedIn"
                                               Density="_density"
                                               TierLabel="@TierCardLabel(entry)"
                                               TierColor="@(ShowLensAnnotation ? TierColor(entry.Category) : null)"
                                               StepArtist="@(_settings.ShowStepArtist ? chart.StepArtist?.ToString() : null)"
                                               Skills="@(_settings.ShowSkills ? SkillChipsFor(chart) : null)"
                                               AgeDays="@(_showAge && score != null ? (int)(_now - score.RecordedDate).TotalDays : null)"
                                               ShowProjectedScore="@(_settings.ShowProjectedScore && _density != UiDensity.Compact)"
                                               ProjectedScore="@(_projectedScores.TryGetValue(chart.Id, out var projected) ? projected : null)"
                                               OnToDo="ToggleToDo"
                                               OnOpen="OpenDetails"></TierListChartCard>
                        }
                    </div>
                }
            </TierSection>
        }
    }
    @* Filters drawer — the full panel (rule 6). Round 9: the panel is one shared
       fragment so the desktop Filters drawer and the compact Advanced drawer can't
       drift apart. *@
    @{
        RenderFragment filterPanel = @<text>
        <MudAutocomplete T="string" Label=@L["Song Name"] AdornmentIcon="@Icons.Material.Filled.Search" @bind-Value="_songFilter" SearchFunc="(s,c)=>FilterSongName(s)" CoerceText="false" CoerceValue="true"></MudAutocomplete>
            <MudSelect T="SongType" Clearable="true" MultiSelection="true" SelectedValues="_settings.SongTypes" SelectedValuesChanged="SetSongTypeFilter" Label=@L["Song Type"]>
                @foreach (var type in Enum.GetValues<SongType>())
                {
                    <MudSelectItem T="SongType" Value="type">@type</MudSelectItem>
                }
            </MudSelect>
            @if (CurrentUser.IsLoggedIn)
            {
                <MudCheckBox T="bool?" Value="_settings.ToDo" ValueChanged="SetTodoFilter" TriState="true" Label=@L["To Do"]></MudCheckBox>
                <MudCheckBox T="bool?" TriState="true" Value="_settings.Completion" ValueChanged="SetCompletionFilter" Label=@L["Stage Pass"]></MudCheckBox>
                <MudSelect T="PhoenixLetterGrade?" Label=@L["Min Letter Grade"] Value="_settings.MinLetterGrade" ValueChanged="SetMinLetterGrade" Clearable="true">
                    @foreach (var letterGrade in Enum.GetValues<PhoenixLetterGrade>().Reverse())
                    {
                        <MudSelectItem T="PhoenixLetterGrade?" Value="letterGrade">@letterGrade.GetName()</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="PhoenixLetterGrade?" Label=@L["Max Letter Grade"] Value="_settings.MaxLetterGrade" ValueChanged="SetMaxLetterGrade" Clearable="true">
                    @foreach (var letterGrade in Enum.GetValues<PhoenixLetterGrade>().Reverse())
                    {
                        <MudSelectItem T="PhoenixLetterGrade?" Value="letterGrade">@letterGrade.GetName()</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_lowestBpm != _highestBpm)
            {
                <MudNumericField T="decimal?" Clearable="true" Value="_settings.MinBpm" ValueChanged="SetSelectedMinBpm" Label=@L["Min BPM"] Min="_lowestBpm" Max="_highestBpm" HelperText="Not All BPMS Labeled Yet" HideSpinButtons="true"></MudNumericField>
                <MudNumericField T="decimal?" Clearable="true" Value="_settings.MaxBpm" ValueChanged="SetSelectedMaxBpm" Label=@L["Max BPM"] Min="_lowestBpm" Max="_highestBpm" HelperText="Not All BPMS Labeled Yet" HideSpinButtons="true"></MudNumericField>
            }
            @if (_lowestNoteCount != _highestNoteCount)
            {
                <MudNumericField T="int?" Clearable="true" Value="_settings.MinNoteCount" ValueChanged="SetMinNoteCount" Label=@L["Min Note Count"] Min="_lowestNoteCount" Max="_highestNoteCount" HelperText="Not All Note Counts Labeled Yet" HideSpinButtons="true"></MudNumericField>
                <MudNumericField T="int?" Clearable="true" Value="_settings.MaxNoteCount" ValueChanged="SetMaxNoteCount" Label=@L["Max Note Count"] Min="_lowestNoteCount" Max="_highestNoteCount" HelperText="Not All Note Counts Labeled Yet" HideSpinButtons="true"></MudNumericField>
            }
            <MudSelect T="string" SelectedValues="_settings.StepArtists" SelectedValuesChanged="SetSelectedStepArtists" Label=@L["Step Artist"] HelperText="Not All Step Artists Labeled Yet" MultiSelection="true" Clearable="true">
                @foreach (var artist in _availableStepArtists)
                {
                    <MudSelectItem T="string" Value="@artist">@artist</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" SelectedValues="_settings.SongArtists" SelectedValuesChanged="SetSelectedSongArtists" Label=@L["Song Artist"] MultiSelection="true" Clearable="true">
                @foreach (var artist in _availableSongArtists)
                {
                    <MudSelectItem T="string" Value="@artist">@artist</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ClearFilters">@L["Clear Filters"]</MudButton>
            <MudDivider></MudDivider>
            @* Columns: extra info on Comfortable cards / as Table columns. Compact is the
               jacket sticker sheet — nothing fits, so the switches disable there (round 7).
               "Show Difficulty" retired: the lens annotation is always on since round 6. *@
            <MudText Typo="Typo.subtitle1">@L["Display"]</MudText>
            @if (_density == UiDensity.Compact)
            {
                <MudText Typo="Typo.caption">@L["Not available in Compact view"]</MudText>
            }
            <MudSwitch T="bool" Color="Color.Primary" Value="_settings.ShowSongName" ValueChanged="SetShowName"
                       Disabled="_density != UiDensity.Comfortable" Label=@L["Show Song Name"]></MudSwitch>
            <MudSwitch T="bool" Color="Color.Primary" Value="_settings.ShowStepArtist" ValueChanged="SetShowStepArtist"
                       Disabled="_density == UiDensity.Compact" Label=@L["Show Step Artist"]></MudSwitch>
            <MudSwitch T="bool" Color="Color.Primary" Value="_settings.ShowSkills" ValueChanged="SetShowSkills"
                       Disabled="_density == UiDensity.Compact" Label=@L["Show Skills"]></MudSwitch>
            <MudSwitch T="bool" Color="Color.Primary" Value="_settings.ShowSkillMetric" ValueChanged="SetShowSkillMetric"
                       Disabled="_density == UiDensity.Compact || !_settings.ShowSkills" Label=@L["Show Skill Metric"]></MudSwitch>
            @if (CurrentUser.IsLoggedIn)
            {
                <MudSwitch T="bool" Color="Color.Primary" Value="_showAge" ValueChanged="SetShowAge"
                           Disabled="_density == UiDensity.Compact" Label=@L["Show Age"]></MudSwitch>
                @* A border fits on a jacket where a column never would, so — unlike the
                   switches above — this one stays live in every density. *@
                <MudSwitch T="bool" Color="Color.Primary" Value="_settings.ShowOtherMixPasses" ValueChanged="SetShowOtherMixPasses"
                           Label=@L["Show Passed in Other Mixes"]></MudSwitch>
                @if (!IsLegacy && _chartType != ChartType.CoOp)
                {
                    <MudSwitch T="bool" Color="Color.Primary" Value="_settings.ShowProjectedScore" ValueChanged="SetShowProjectedScore"
                               Disabled="_density == UiDensity.Compact" Label=@L["Show Projected Score"]></MudSwitch>
                }
            }
        </text>;
    }
    <MudLayout>
    <MudDrawer @bind-Open="_filtersOpen" Anchor="Anchor.Right" Variant="@DrawerVariant.Temporary" Width="320px">
        <div class="tier-filter-drawer">
            <div class="tier-drawer-head">
                <MudText Typo="Typo.h6">@L["Filters"]</MudText>
                <MudSpacer></MudSpacer>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _filtersOpen = false"
                               aria-label="@L["Close"]"></MudIconButton>
            </div>
            @filterPanel
        </div>
    </MudDrawer>
    </MudLayout>
    <ChartDetailsDialog @bind-Visible="_detailsOpen" Chart="_detailsChart" Mix="_currentMix"
                        Score="_detailsChart != null && _scores.TryGetValue(_detailsChart.Id, out var detailsScore) ? detailsScore : null"
                        Ranking="_detailsChart != null && _scoreRankings.TryGetValue(_detailsChart.Id, out var detailsRank) ? detailsRank : null"
                        IsToDo="_detailsChart != null && _todos.Contains(_detailsChart.Id)"
                        ScoreAgeDays="@(_detailsChart != null && _scores.TryGetValue(_detailsChart.Id, out var detailsAge) ? (int)(_now - detailsAge.RecordedDate).TotalDays : null)"
                        OnToDo="ToggleToDo" OnScoreRecorded="RefreshScores"></ChartDetailsDialog>
    <ShareCardSettingsDialog @bind-Visible="_downloadOpen" SignedIn="CurrentUser.IsLoggedIn"
                             PhoenixScoring="!IsLegacy" OffersPumbility="PumbilityAvailable && !IsLegacy"
                             SampleBuilder="BuildSampleCard" OnDownload="DownloadImage"
                             FileName="@DownloadFileName"></ShareCardSettingsDialog>
    </div>
}
<style>
    /* One clamp for 4K, one 960px breakpoint (matches the shell's bottom nav) where
       the view buttons take the toolbar's second line, and a 500px line where they
       hand over to the View select and the lens controls take their own row. Folder
       progress lives behind the Folder Stats drawer at every width (piucenter round 5). */
    .tier-page {
        max-width: 1680px;
        margin: 0 auto;
    }

    .tier-toolbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        margin-top: 12px;
        padding: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    /* Desktop: the row (and the lens wrapper inside it) flattens away so the
       toolbar reads as a single line. */
    .tier-toolbar-row,
    .tier-lens-wrap {
        display: contents;
    }

    .tier-view-select {
        display: none;
    }

    @@media (max-width: 959.98px) {
        .tier-desktop-only {
            display: none;
        }

        /* The view buttons keep their at-a-glance row by taking the toolbar's second
           line whole — order pushes them behind the folder + lens line. */
        .tier-views-group {
            order: 3;
            flex-basis: 100%;
        }

        .tier-toolbar {
            display: block;
        }

        .tier-toolbar-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }

    }

    /* Under 500px the buttons hand over to the View select — even a dedicated row
       can't hold them in every locale there — and the lens controls take their own
       full-width line: folder + View above, Ranked-by (and Grouped-by) below. */
    @@media (max-width: 499.98px) {
        .tier-views-group {
            display: none;
        }

        .tier-view-select {
            display: inline-flex;
            flex: 1 1 0;
            max-width: none;
        }

        .tier-lens-wrap {
            display: flex;
            flex-basis: 100%;
            min-width: 0;
            gap: 8px;
        }

        .tier-lens-wrap .tier-toolbar-select {
            flex: 1 1 0;
            max-width: none;
        }
    }

    .tier-toolbar-select {
        max-width: 190px;
    }

    .tier-content-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin: 8px 0 4px;
    }

    .tier-filter-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        align-items: center;
        margin-bottom: 4px;
    }

    .tier-filter-chips-label {
        font-size: .75rem;
        color: var(--mud-palette-text-secondary);
    }

    .tier-context-line {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        margin: 6px 0;
        font-size: .75rem;
        color: var(--mud-palette-text-secondary);
    }

    .tier-progress-strip-summary {
        display: flex;
        align-items: baseline;
        gap: 8px;
    }

    .tier-cohort-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin: 6px 0;
    }

    .tier-cohort-bar-label {
        font-size: .8rem;
        color: var(--mud-palette-text-secondary);
        min-width: 220px;
    }

    .tier-cohort-bar-meter {
        width: 160px;
        height: 6px;
        background: var(--mud-palette-lines-default);
        border-radius: 3px;
        overflow: hidden;
        display: inline-block;
    }

    .tier-cohort-bar-fill {
        display: block;
        height: 100%;
    }

    .tier-cohort-bar-value {
        font-size: .85rem;
        font-weight: 600;
    }

    .tier-cohort-bar-note {
        font-size: .75rem;
        color: var(--mud-palette-text-secondary);
    }

    @* Section / card / lamp / legend / folder-picker styles live in wwwroot/css/site.css —
       they belong to the shared components, not this page. The table shell itself moved
       there too once the chart SRP's table density started borrowing it. *@
    .tier-table-jacket-cell {
        width: 36px;
    }

    .tier-table-jacket {
        width: 32px;
        height: 32px;
        border-radius: 4px;
        background-size: cover;
        background-position: center;
        cursor: pointer;
    }

    .tier-table-skills {
        font-size: .8rem;
        color: var(--mud-palette-text-secondary);
    }

    .tier-row-pass td:first-child {
        border-left: 3px solid var(--mud-palette-success);
    }

    .tier-row-todo td:first-child {
        border-left: 3px dashed var(--mud-palette-info);
    }

    .tier-row-other-mix td:first-child {
        border-left: 3px dashed var(--mud-palette-success);
    }

    .tier-list-cta {
        border: 1px dashed var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 16px;
        margin: 12px 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-start;
    }

    .tier-list-cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .tier-filter-drawer {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    /* Round 12: every drawer gets an explicit close — the click-away overlay is
       unreliable on mobile. */
    .tier-drawer-head {
        display: flex;
        align-items: center;
    }

    .tier-attribution {
        color: var(--mud-palette-text-secondary);
        display: block;
        margin: 4px 0;
    }
</style>
@inject ICurrentUserAccessor CurrentUser;
@inject IMediator Mediator;
@inject NavigationManager NavManager;
@inject IUiSettingsAccessor UiSettings;
@inject ISnackbar Snackbar;
@inject IJSRuntime JSRuntime;
@code
{

    [Parameter]
    [SupplyParameterFromQuery(Name = "Difficulty")]
    public int? DifficultyFilter { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "ChartType")]
    public string? ChartTypeFilter { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "TierListType")]
    public string? TierListType { get; set; } = string.Empty;

    [Parameter] public string? ChartTypeRoute { get; set; }

    [Parameter] public int? LevelRoute { get; set; }

    private DateTimeOffset _now = DateTimeOffset.Now;

    private IDictionary<Guid, RecordedPhoenixScore> _scores = new Dictionary<Guid, RecordedPhoenixScore>();
    private IDictionary<Guid, RecordedPhoenixScore> _folderScores = new Dictionary<Guid, RecordedPhoenixScore>();

    /// <summary>
    ///     Legacy bests, where the letter grade IS the score. Held beside _scores rather than
    ///     inside it: _scores carries the pass/clear state (so lamps, borders and filters work
    ///     unchanged), and this carries the one datum that has no Phoenix equivalent.
    /// </summary>
    private IDictionary<Guid, XXLetterGrade> _legacyGrades = new Dictionary<Guid, XXLetterGrade>();
    private IDictionary<Guid, Chart> _charts = new Dictionary<Guid, Chart>();

    private IReadOnlyDictionary<Guid, ChartIdentityRecord> _identity =
        new Dictionary<Guid, ChartIdentityRecord>();

    /// <summary>
    ///     The retired hand tags, loaded only while the Chabala lens is showing — the one
    ///     surface that still speaks his vocabulary (docs/design/nuke-old-skill-categories.md §7).
    /// </summary>
    private IReadOnlyDictionary<Guid, IReadOnlyList<string>> _archivedTags =
        new Dictionary<Guid, IReadOnlyList<string>>();

    /// <summary>Every badge each chart carries, with its evidence weight — the drawer's input.</summary>
    private IReadOnlyDictionary<Guid, IReadOnlyList<ChartBadgePresenceRecord>> _badgePresence =
        new Dictionary<Guid, IReadOnlyList<ChartBadgePresenceRecord>>();

    /// <summary>
    ///     The folder's Speed band per chart, from the stored Speed tier list. Empty until an
    ///     ingestion has built it, which is what makes Group By Speed offer itself only when it
    ///     can answer.
    /// </summary>
    private IReadOnlyDictionary<Guid, SongTierListEntry> _speedBands =
        new Dictionary<Guid, SongTierListEntry>();

    /// <summary>
    ///     What a card wears. Every lens shows the chart's identity chips; the Chabala lens
    ///     swaps in his archived tags, because on his list his words belong. They map to
    ///     nothing and are deliberately uncoloured.
    /// </summary>
    private IReadOnlyList<TierListChartCard.CardSkillChip>? SkillChipsFor(Chart chart)
    {
        if (ChabalaLensActive)
        {
            var archived = IdentityChips.ToArchivedChips(
                _archivedTags.TryGetValue(chart.Id, out var tags) ? tags : null);
            return archived.Count > 0 ? archived : null;
        }

        // No NPS chip on a card: the raw number means nothing at a glance (owner, 2026-08-26),
        // so it lives on the chart page and dialog where there is room to explain it. Speed
        // still reaches the card as a claim — the Very Fast / Very Slow chip — because a WORD
        // is readable where a figure is not.
        var chips = IdentityChips.ToCardChips(
            _identity.TryGetValue(chart.Id, out var identity) ? identity : null,
            _settings.ShowSkillMetric, L);
        // Except when the page is grouped BY speed, where the section heading over the card
        // already says it — a chip that repeats its own heading spends the card's loudest slot
        // on the one thing the reader cannot fail to know.
        if (_groupBy == "Speed") chips = chips.Where(c => !IdentityChips.IsSpeedChip(c)).ToArray();
        return chips.Count > 0 ? chips : null;
    }

    private bool ChabalaLensActive => _tierListType == "Chabala" && ChabalaAvailable;
    private IDictionary<Guid, double> _scoringLevels = new Dictionary<Guid, double>();
    private IDictionary<Guid, Chart> _allCharts = new Dictionary<Guid, Chart>();
    private IReadOnlySet<Guid> _otherMixPasses = new HashSet<Guid>();
    private bool _otherMixPassesLoaded = false;

    private bool IsOtherMixPass(Guid chartId) => _settings.ShowOtherMixPasses && _otherMixPasses.Contains(chartId);
    private bool _isBuildingImage = false;
    private FilterSettings _settings = new FilterSettings();
    private const string UserSettingsKey = @"ChartSkills__Settings";

    private async Task SaveSettings()
    {
        await UiSettings.SetSetting(UserSettingsKey, JsonSerializer.Serialize(_settings));
    }

    private sealed class FilterSettings
    {
        public HashSet<SongType> SongTypes { get; set; } = new HashSet<SongType>();
        public bool? ToDo { get; set; }
        public bool? Completion { get; set; }
        public PhoenixLetterGrade? MinLetterGrade { get; set; }
        public PhoenixLetterGrade? MaxLetterGrade { get; set; }
        public decimal? MinBpm { get; set; }
        public decimal? MaxBpm { get; set; }
        public bool ShowStepArtist { get; set; }
        public bool ShowSongName { get; set; } = true;
        public bool ShowSkills { get; set; } = true;
        public bool ShowSkillMetric { get; set; }
        // Defaults on, so an existing player's folder looks the same until they turn it off.
        public bool ShowOtherMixPasses { get; set; } = true;
        public bool ShowProjectedScore { get; set; }
        public int? MinNoteCount { get; set; }
        public int? MaxNoteCount { get; set; }
        public HashSet<string> StepArtists { get; set; } = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        public HashSet<string> SongArtists { get; set; } = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    }
    // Color is the on-screen CSS token reference; ShareHex is the same hue resolved to a
    // raw hex for the share-card renderer (which can't read CSS custom properties).
    // Stat is the section's own note — the Speed bands' real NPS range — printed before the
    // cleared count so a folder-relative band name never reads as an absolute claim.
    private sealed record TierGroup(string Key, string Name, string Color, string ShareHex,
        IReadOnlyList<SongTierListEntry> Entries, string? Stat = null);

    private IEnumerable<TitleProgress> _titleProgress = Array.Empty<TitleProgress>();
    private FolderTitleTrackResult? _titleTrack;

    // This folder's standing, computed from the scores the page already holds rather than read
