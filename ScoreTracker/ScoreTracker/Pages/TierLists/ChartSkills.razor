    // The share-only reads, fetched when a toggle first asks for them (the page's own
    // backfill shape) and dropped on every folder change — membership and gains are
    // per-mix, per-type answers.
    private IReadOnlySet<Guid>? _top50TypeIds;
    private IReadOnlySet<Guid>? _top50CombinedIds;
    private PumbilityProjection? _shareGains;

    private async Task EnsureShareData(ShareCardOptions options, CancellationToken cancellationToken = default)
    {
        if (!CurrentUser.IsLoggedIn || IsLegacy) return;
        if (options.BoundaryOtherMixes && !_otherMixPassesLoaded)
        {
            _otherMixPasses = await Mediator.Send(new GetCrossMixPassesQuery(_currentMix), cancellationToken);
            _otherMixPassesLoaded = true;
        }

        if (_chartType == ChartType.CoOp) return;
        if (options.BoundaryTop50 && _top50TypeIds == null)
        {
            _top50TypeIds = (await Mediator.Send(
                    new GetTop50ForPlayerQuery(CurrentUser.User.Id, _chartType, 50, _currentMix), cancellationToken))
                .Select(s => s.ChartId).ToHashSet();
            _top50CombinedIds = (await Mediator.Send(
                    new GetTop50ForPlayerQuery(CurrentUser.User.Id, null, 50, _currentMix), cancellationToken))
                .Select(s => s.ChartId).ToHashSet();
        }

        if (options.Pumbility && options.ExpectedGains && _shareGains == null)
            _shareGains = await Mediator.Send(
                new ProjectPumbilityGainsQuery(CurrentUser.User.Id, _currentMix, _chartType), cancellationToken);
    }

    private ShareCardComposer.TileFacts FactsFor(SongTierListEntry entry, ShareCardOptions options)
    {
        var chart = _charts[entry.ChartId];
        var score = _scores.TryGetValue(chart.Id, out var s) ? s : null;
        double? gain = _shareGains != null && _shareGains.ProjectedGains.TryGetValue(chart.Id, out var g)
            ? g
            : null;
        PhoenixScore? expected = _shareGains != null && _shareGains.ExpectedScores.TryGetValue(chart.Id, out var e)
            ? e
            : null;
        var current = options.Pumbility && !options.ExpectedGains
            ? ShareCardComposer.CurrentPumbility(chart, score?.Score, score?.Plate, score?.IsBroken ?? false,
                _currentMix)
            : null;
        return new ShareCardComposer.TileFacts(chart, score?.Score, score?.Plate,
            Passed: score is { IsBroken: false },
            Broken: score is { IsBroken: true },
            IsToDo: _todos.Contains(chart.Id),
            PassedInOtherMix: _otherMixPasses.Contains(chart.Id),
            InTop50Type: _top50TypeIds?.Contains(chart.Id) ?? false,
            InTop50Combined: _top50CombinedIds?.Contains(chart.Id) ?? false,
            gain, expected, current,
            options.Skills ? SkillChipsFor(chart) : null,
            // One folder feeds this list, so its bubble rides the header, not the tiles
            // (design doc §5).
            BubbleUrl: null);
    }

    private TierListShareCard BuildCard(IReadOnlyList<TierListShareCard.Row> rows, ShareCardOptions options)
    {
        var palette = MixThemes.PaletteFor(_currentMix);
        var title = _chartType == ChartType.CoOp
            ? $"{L["CoOp"]} ×{_level}"
            : $"{L[_chartType == ChartType.Single ? "Singles" : "Doubles"]} {_level}";
        var stamp = PersonalizedActive
            ? L["Personalized for {0}", CurrentUser.User.GameTag ?? CurrentUser.User.Name].ToString()
            : L["Community"].ToString();
        var linkUrl = $"https://piuscores.arroweclip.se/TierLists/{_chartType}/{_level}";
        // The mix rides the card itself: with 31 selectable mixes, a shared
        // "Singles 18" screenshot is meaningless without it. GetName, not
        // ToString — "The Perfect Collection", never "PerfectCollection".
        return new TierListShareCard(
            title,
            $"{LensDisplayName(_tierListType)} · {_currentMix.GetName()} · {_now:yyyy-MM-dd}",
            stamp,
            palette.Primary,
            palette.Background,
            palette.Surface,
            palette.Ink,
            palette.InkMuted,
            linkUrl,
            DifficultyBubblePath(_chartType, _level),
            rows,
            // Anonymous downloads carry no personal state, so a legend would be
            // explaining borders that are not in the picture.
            CurrentUser.IsLoggedIn
                ? ShareCardComposer.Legend(options, _currentMix, palette, key => L[key].Value)
                : null);
    }

    /// <summary>
    ///     The dialog's example: the folder's first six jackets wearing the scripted states
    ///     (design doc §10), composed under the same options the download will use. Stage
    ///     props rather than the player's record, so every option shows in the example at
    ///     once — and no personal read runs for a preview. The renderer ingests every jacket
    ///     it is handed, so the sample stays small (§6) and the full folder is only paid for
    ///     by Download itself.
    /// </summary>
    private Task<TierListShareCard?> BuildSampleCard(ShareCardOptions options)
    {
        var charts = _groups
            .SelectMany(g => g.Entries.Where(ShouldChartShow))
            .Select(e => e.ChartId)
            .Where(_charts.ContainsKey)
            .Distinct()
            .Take(ShareCardSample.Size)
            .Select(id => _charts[id])
            .ToArray();
        if (charts.Length == 0) return Task.FromResult<TierListShareCard?>(null);
        var palette = MixThemes.PaletteFor(_currentMix);
        var facts = ShareCardSample.Facts(charts, _currentMix,
            c => options.Skills ? SkillChipsFor(c) : null,
            _ => null);
        var rows = new[]
        {
            new TierListShareCard.Row(L["Example"], palette.Primary, facts
                .Select(f => ShareCardComposer.Compose(f, options, _currentMix, palette))
                .ToArray())
        };
        return Task.FromResult<TierListShareCard?>(BuildCard(rows, options));
    }

    private async Task DownloadImage(ShareCardDownloadRequest request)
    {
        _isBuildingImage = true;
        try
        {
            var options = request.Options;
            await EnsureShareData(options, request.Token);
            var palette = MixThemes.PaletteFor(_currentMix);
            var rows = _groups
                .Select(g => (Group: g,
                    Entries: g.Entries.Where(ShouldChartShow).Where(e => _charts.ContainsKey(e.ChartId)).ToArray()))
                .Where(g => g.Entries.Any())
                .Select(g => new TierListShareCard.Row(g.Group.Name, g.Group.ShareHex, g.Entries
                    .Select(e => ShareCardComposer.Compose(FactsFor(e, options), options, _currentMix, palette))
                    .ToArray()))
                .ToArray();
            var card = BuildCard(rows, options);

            // The slow phase, driven from here so the dialog's bar counts real images
            // (design doc §8): warm the card's art in batches, then render against the
            // warm cache. The token is the dialog's Cancel — and any close of it.
            var urls = ShareCardArt.CollectUrls(card);
            var done = 0;
            request.Progress(new ShareCardFetchProgress(0, urls.Count, false));
            foreach (var batch in urls.Chunk(ShareCardArt.FetchBatch))
            {
                await Mediator.Send(new PrefetchShareCardArtCommand(batch), request.Token);
                done += batch.Length;
                request.Progress(new ShareCardFetchProgress(done, urls.Count, false));
            }

            request.Progress(new ShareCardFetchProgress(urls.Count, urls.Count, true));
            var bytes = await Mediator.Send(new GetTierListShareCardQuery(card), request.Token);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/helpers.js");
            await module.InvokeVoidAsync("downloadFileFromStream", DownloadFileName, streamRef);
        }
        catch (OperationCanceledException)
        {
            // The dialog's Cancel (or its close) stopped the download; nothing to deliver.
        }
        finally
        {
            _isBuildingImage = false;
        }
    }

    // --- Filtering ---------------------------------------------------------------------

    private bool ShouldChartShow(SongTierListEntry entry)
    {
        var score = _scores.TryGetValue(entry.ChartId, out var scr) ? scr : null;
        if (_settings.MinLetterGrade != null && (score?.Score == null || score.Score.Value.LetterGradeFor(_currentMix) < _settings.MinLetterGrade))
        {
            return false;
        }
        if (_settings.MaxLetterGrade != null && (score?.Score == null || score.Score.Value.LetterGradeFor(_currentMix) > _settings.MaxLetterGrade))
        {
            return false;
        }
        if (_settings.Completion != null && _settings.Completion != (_scores.TryGetValue(entry.ChartId, out var s) && !s.IsBroken))
        {
            return false;
        }
        if (_settings.ToDo != null && _settings.ToDo != _todos.Contains(entry.ChartId))
        {
            return false;
        }
        var chart = _charts[entry.ChartId];
        if (_settings.SongTypes.Any() && !_settings.SongTypes.Contains(chart.Song.Type))
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_songFilter) && !chart.Song.Name.ToString().Contains(_songFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_settings.MaxBpm != null && (chart.Song.Bpm == null || chart.Song.Bpm.Value.Max > _settings.MaxBpm))
        {
            return false;
        }
        if (_settings.MinBpm != null && (chart.Song.Bpm == null || chart.Song.Bpm.Value.Min < _settings.MinBpm))
        {
            return false;
        }
        if (_settings.StepArtists.Any() && !_settings.StepArtists.Contains(chart.StepArtist?.ToString() ?? "Unknown"))
        {
            return false;
        }
        if (_settings.SongArtists.Any() && !_settings.SongArtists.Contains(chart.Song.Artist.ToString()))
        {
            return false;
        }
        if (_settings.MinNoteCount != null && (chart.NoteCount == null || chart.NoteCount < _settings.MinNoteCount))
        {
            return false;
        }
        if (_settings.MaxNoteCount != null && (chart.NoteCount == null || chart.NoteCount > _settings.MaxNoteCount))
        {
            return false;
        }
        return true;
    }

