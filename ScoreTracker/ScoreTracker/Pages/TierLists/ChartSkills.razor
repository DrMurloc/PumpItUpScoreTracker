    /// <summary>
    ///     Re-reads the viewer's bests after the details dialog records one — from whichever
    ///     store this mix uses, so a legacy save lights up its card the same way.
    /// </summary>
    private async Task RefreshScores()
    {
        if (!CurrentUser.IsLoggedIn) return;
        if (IsLegacy)
        {
            var attempts = (await Mediator.Send(
                    new GetXXBestChartAttemptsQuery(CurrentUser.User.Id, _currentMix)))
                .Where(b => b.BestAttempt != null)
                .ToArray();
            _legacyGrades = attempts.ToDictionary(b => b.Chart.Id, b => b.BestAttempt!.LetterGrade);
            _scores = attempts.ToDictionary(b => b.Chart.Id,
                b => new RecordedPhoenixScore(b.Chart.Id, null, null, b.BestAttempt!.IsBroken,
                    b.BestAttempt.RecordedOn));
        }
        else
        {
            _scores = (await Mediator.Send(new GetPhoenixRecordsQuery(CurrentUser.User.Id, _currentMix)))
                .ToDictionary(c => c.ChartId);
        }

        await Recalculate();
    }

