    private void RegroupEntries()
    {
        _groups = _groupBy switch
        {
            "Score" => GroupByScore(),
            "Age" => GroupByAge(),
            "Score Ranking" => GroupByScoreRanking(),
            "Scoring Level" => GroupByScoringLevel(),
            "Speed" => GroupBySpeed(),
            _ => GroupByTier()
        };
    }

    /// <summary>
    ///     Whether the PUMBILITY lens has anything to say about a folder. Always true for every
    ///     other lens, so the picker gate only bites where a folder really is unanswerable —
    ///     below your range nothing can reach your top 50, above it nobody at your level has
    ///     played these (design doc §6).
    /// </summary>
    private bool PumbilityFolderHasData(ChartType type, int level) =>
        // An EMPTY set means the PUMBILITY lists have not been built for this mix, not that
        // every folder is unanswerable — gating on it would disable the whole picker and
        // strand the reader.
        _pumbilityFolders == null || _pumbilityFolders.Count == 0
        || _pumbilityFolders.Contains((type, level));

    /// <summary>
    ///     The nearest folder of the same type the lens can answer for, or null when it can
    ///     answer for none. Ties break downward: a folder below you is one you have outgrown,
    ///     which is a gentler landing than one you cannot play yet.
    /// </summary>
    private (ChartType Type, int Level)? NearestPumbilityFolder(ChartType type, int level) =>
        _pumbilityFolders?
            .Where(f => f.Type == type)
            .OrderBy(f => Math.Abs(f.Level - level))
            .ThenBy(f => f.Level)
            .Select(f => ((ChartType, int)?)f)
            .FirstOrDefault();

    private async Task LoadPumbilityFolders(CancellationToken cancellationToken)
    {
        if (_tierListType != "PUMBILITY")
        {
            _pumbilityFolders = null;
            return;
        }

        _pumbilityFolders = (await Mediator.Send(new GetPumbilityFoldersQuery(PersonalizedActive,
                    PersonalizedActive ? CurrentUser.User.Id : null, _currentMix), cancellationToken))
            .Select(f => (f.ChartType, f.Level)).ToHashSet();
    }

    /// <summary>
    ///     The Ranked-by options a view actually offers, first one first. Mirrors the markup
    ///     above; the two must agree or the picker can hold a value it never lists.
    /// </summary>
    private IReadOnlyList<string> LensesFor(string grouping)
    {
        if (grouping == "Personalized") return new[] { "PUMBILITY", "Score" };
        var lenses = new List<string>();
        if (PumbilityAvailable) lenses.Add("PUMBILITY");
        lenses.Add("Pass");
        lenses.Add("Score");
        if (ChabalaAvailable) lenses.Add("Chabala");
        lenses.Add("PG");
        return lenses;
    }

    private string TierName(TierListCategory category) =>
        _tierListType == "Chabala" && category == TierListCategory.Unrecorded ? "Subjective" :
        _tierListType == "PUMBILITY" ? PumbilityTierNames.NameOf(category) :
        _tierNames[category];

    /// <summary>
    ///     What a card prints under its jacket: the lens's word for it, where the section is
    ///     not already saying it.
    ///     <para>
    ///         The peer count used to ride along on the PUMBILITY lens. It went (owner,
    ///         2026-08-26): the tier name already says where the chart sits, and the raw count
    ///         beside it was a second way of saying the same thing. A chart no peer pools says
    ///         nothing at all rather than "Not in anyone's PUMBILITY · 0 peers" — an empty
    ///         state dressed up as a reading is worse than an empty line.
    ///     </para>
    /// </summary>
    private string? TierCardLabel(SongTierListEntry entry)
    {
        if (!ShowLensAnnotation) return null;
        if (_tierListType == "PUMBILITY" && entry.Category == TierListCategory.Unrecorded) return null;
        return L[TierName(entry.Category)];
    }

    /// <summary>The lens's ramp: rarity for PUMBILITY, difficulty for everything else.</summary>
    private string TierColor(TierListCategory category) =>
        _tierListType == "PUMBILITY" ? ThemeScales.PumbilityColor(category) : ThemeScales.DifficultyColor(category);

    /// <summary>
    ///     The same ramp resolved to raw hex for the share card, which cannot read CSS custom
    ///     properties — the two must pick the same ramp or the downloaded image contradicts the
    ///     page it was downloaded from.
    /// </summary>
    private string TierShareHex(TierListCategory category) =>
        _tierListType == "PUMBILITY"
            ? MixThemes.PumbilityHex(_currentMix, category)
            : MixThemes.DifficultyHex(category);

    // Round 7: the lens always orders cards within a section, in every view — easiest first,
    // scoring level as the tiebreaker, blend order as the final stabilizer. Unrecorded sinks
    // to the bottom. The category enum already runs easiest to hardest, so this is its own
    // order.
    private IEnumerable<SongTierListEntry> LensOrdered(IEnumerable<SongTierListEntry> entries)
    {
        return entries
            .OrderBy(e => e.Category == TierListCategory.Unrecorded ? int.MaxValue : (int)e.Category)
            .ThenBy(e => _scoringLevels.TryGetValue(e.ChartId, out var sl) ? sl : 0)
            .ThenBy(e => e.Order);
    }

    private IReadOnlyList<TierGroup> GroupByTier()
    {
        var groups = LensOrdered(_finalEntries)
            .GroupBy(e => e.Category);
        // Easiest first (owner, 2026-08-11), which the popularity lens already read as
        // most-popular first. Not Rated always sinks to the bottom.
        var ordered = groups
            .OrderBy(g => g.Key == TierListCategory.Unrecorded ? int.MaxValue : (int)g.Key);
        return ordered
            .Select(g =>
            {
                var name = TierName(g.Key);
                return new TierGroup(name, L[name], TierColor(g.Key),
                    TierShareHex(g.Key), g.ToArray());
            })
            .ToArray();
    }

    private TierGroup ToNeutralGroup(IGrouping<string, SongTierListEntry> group) =>
        ToNeutralGroup(group.Key, group);

    private TierGroup ToNeutralGroup(string key, IEnumerable<SongTierListEntry> entries) =>
        new(key, L[key], NeutralSectionColor, MixThemes.PaletteFor(_currentMix).InkMuted, entries.ToArray());

    /// <summary>
    ///     Sections for a My Scores bucketing, ordered by the bucket's own rank rather than by
    ///     whichever chart happened to sort first. Both dictionaries run best-to-worst with the
    ///     enum — Amazing to "Why Don't You Get Up and Dance, Man?", Ancient to Most Recent —
    ///     so ascending is the order in both cases, with the unrecorded bucket last.
    /// </summary>
    private IReadOnlyList<TierGroup> ByCategoryBuckets(
        IEnumerable<SongTierListEntry> ordered, Func<SongTierListEntry, TierListCategory> bucket,
        IDictionary<TierListCategory, string> names) =>
        ordered.GroupBy(bucket)
            .OrderBy(g => g.Key == TierListCategory.Unrecorded ? int.MaxValue : (int)g.Key)
            .Select(g => ToNeutralGroup(names[g.Key], g))
            .ToArray();

    private IReadOnlyList<TierGroup> GroupByScore()
    {
        var tierList = TierListProcessor
            .ProcessIntoTierList("Score", _folderScores.Where(kv => kv.Value.Score != null).ToDictionary(kv => kv.Key, kv => (int)kv.Value.Score!.Value))
            .ToDictionary(e => e.ChartId);
        return ByCategoryBuckets(LensOrdered(_finalEntries),
            e => tierList.TryGetValue(e.ChartId, out var t) ? t.Category : TierListCategory.Unrecorded,
            _scoreNames);
    }

    private IReadOnlyList<TierGroup> GroupByAge()
    {
        if (_folderScores.Values.Select(s => s.RecordedDate).Distinct().Count() < 5)
        {
            return LensOrdered(_finalEntries)
                .GroupBy(_ => _ageNames[TierListCategory.Unrecorded])
                .Select(ToNeutralGroup)
                .ToArray();
        }
        var tierList = TierListProcessor
            .ProcessIntoTierList("Score", _folderScores.Where(kv => kv.Value.Score != null).ToDictionary(kv => kv.Key, kv => (_now - kv.Value.RecordedDate).TotalDays))
            .ToDictionary(e => e.ChartId);
        // Oldest first (owner): the stale end of the folder is the actionable one.
        return ByCategoryBuckets(LensOrdered(_finalEntries),
            e => _scores.ContainsKey(e.ChartId) && tierList.TryGetValue(e.ChartId, out var t)
                ? t.Category
                : TierListCategory.Unrecorded,
            _ageNames);
    }

    // Best percentile first, unrecorded last. The bands are ordered explicitly because they
    // are strings — grouping alone emits them in order of first appearance, which followed the
    // lens and reshuffled the page whenever the lens changed.
    private static readonly string[] RankingBands =
    {
        "The Best", "90% -> 99.9%", "75% -> 90%", "50% -> 75%", "25% -> 50%", "10% -> 25%",
        "0 -> 10%", "Last Place", "Not Recorded"
    };

    private IReadOnlyList<TierGroup> GroupByScoreRanking()
    {
        return LensOrdered(_finalEntries)
            .GroupBy(e => _scoreRankings.TryGetValue(e.ChartId, out var r) ?
                (r.Ranking <= 0.01 ?
                    "Last Place" :
                    r.Ranking <= 0.10 ?
                        "0 -> 10%" :
                        r.Ranking <= 0.25 ?
                            "10% -> 25%" :
                            r.Ranking <= .5 ?
                                "25% -> 50%" :
                                r.Ranking <= .75 ?
                                    "50% -> 75%" :
                                    r.Ranking <= .9 ?
                                        "75% -> 90%" :
                                        r.Ranking > .99 ?
                                            "The Best" :
                                        "90% -> 99.9%"
                    )
                : "Not Recorded")
            .OrderBy(g => Array.IndexOf(RankingBands, g.Key))
            .Select(ToNeutralGroup)
            .ToArray();
    }

    private IReadOnlyList<TierGroup> GroupByScoringLevel()
    {
        return LensOrdered(_finalEntries)
            .GroupBy(e => _scoringLevels.TryGetValue(e.ChartId, out var sl) ? sl.ToString("0.0") : "Not Enough Data")
            .OrderBy(g => double.TryParse(g.Key, out var d) ? d : 10000)
            .Select(g => new TierGroup(g.Key, double.TryParse(g.Key, out _) ? g.Key : L[g.Key], NeutralSectionColor,
                MixThemes.PaletteFor(_currentMix).InkMuted, g.ToArray()))
            .ToArray();
    }

    // --- By-Skill view (round 4: the radar charts' information, placed where it's
    // actionable — one section per skill, sorted weakest-first) ---------------------------

    /// <summary>
    ///     Group By Speed: the folder banded against its own notes-per-second spread, slow to
    ///     fast (docs/design/chart-identity.md §2). Ordered by the band rather than by pass
    ///     rate — this is a map of the folder, and its heat is honestly not monotone: slow
    ///     charts at high levels are hard for reasons that have nothing to do with speed.
    ///     <para>
    ///         Its sections wear the SPEED ramp rather than the pass-rate heat every other
    ///         grouping wears (owner, 2026-08-26). Heat made the whole list one shade of red —
    ///         a hard folder is hard at every tempo, so the colour said nothing about speed
    ///         while looking exactly like it did. Cool to hot, matching the chips.
    ///     </para>
    /// </summary>
    private IReadOnlyList<TierGroup> GroupBySpeed()
    {
        var entryByChart = _finalEntries.ToDictionary(e => e.ChartId);
        var groups = _speedBands
            .Where(kv => entryByChart.ContainsKey(kv.Key))
            .GroupBy(kv => kv.Value.Category)
            .OrderBy(g => g.Key)
            .Select(g => BuildHeatGroup($"Speed:{g.Key}", SpeedBandName(g.Key), g.Select(kv => kv.Key),
                    entryByChart, NpsRange(g.Select(kv => kv.Value))).Group
                with
                {
                    Color = ThemeScales.SpeedColor(SpeedBandLabels.IndexOf(g.Key)),
                    ShareHex = MixThemes.SpeedBandHex(SpeedBandLabels.IndexOf(g.Key))
                })
            .ToList();

        var unmeasured = _finalEntries.Where(e => !_speedBands.ContainsKey(e.ChartId))
            .OrderBy(e => e.Order)
            .ToArray();
        if (unmeasured.Any())
            groups.Add(new TierGroup("Speed:None", L["Speed not measured"], NeutralSectionColor,
                MixThemes.PaletteFor(_currentMix).InkMuted, unmeasured));

        return groups;
    }

    /// <summary>
    ///     A section whose colour is how you do in it — shared by both groupings so the two
    ///     read alike. Logged out there is no heat to show, and the section stays neutral.
    /// </summary>
    private (TierGroup Group, IReadOnlyList<SongTierListEntry> Entries, double PassRate, int? Average)
        BuildHeatGroup(string key, string name, IEnumerable<Guid> chartIds,
            IReadOnlyDictionary<Guid, SongTierListEntry> entryByChart, string? stat = null)
    {
        var entries = LensOrdered(chartIds.Distinct()
                .Where(entryByChart.ContainsKey)
                .Select(id => entryByChart[id]))
            .ToArray();
        var scored = entries
            .Where(e => _scores.TryGetValue(e.ChartId, out var s) && s is { Score: not null, IsBroken: false })
            .Select(e => (int)_scores[e.ChartId].Score!.Value)
            .ToArray();
        var passRate = entries.Length == 0 ? 0.0 : (double)entries.Count(e => Passed(e.ChartId)) / entries.Length;
        var heat = SkillHeatCategory(passRate);
        return (new TierGroup(key, name,
            heat == null ? NeutralSectionColor : ThemeScales.DifficultyColor(heat.Value),
            heat == null ? MixThemes.PaletteFor(_currentMix).InkMuted : MixThemes.DifficultyHex(heat.Value),
            entries, stat), entries, passRate, scored.Any() ? (int?)scored.Average() : null);
    }

    /// <summary>
    ///     Band names are folder-relative labels, and the range beside them is what makes that
    ///     concrete — "Fast" alone invites reading it as an absolute.
    /// </summary>
    /// <remarks>
    ///     The middle band is keyed "Mid Tempo" rather than the obvious "Moderate": that key is
    ///     already the comment-moderation button, so the band would have rendered 관리 ("manage")
    ///     in Korean and its equivalent elsewhere. English is the key text, which is why nothing
    ///     looked wrong here.
    /// </remarks>
    private string SpeedBandName(TierListCategory band) => L[SpeedBandLabels.KeyOf(band)].Value;

    /// <summary>The band's real NPS span, recovered from the Order the Speed list stored it in.</summary>
    private string NpsRange(IEnumerable<SongTierListEntry> entries)
    {
        var values = entries.Select(e => e.Order / 100.0).OrderBy(v => v).ToArray();
        return values.Length == 0
            ? string.Empty
            : L["{0}–{1} NPS", values[0].ToString("0.#"), values[^1].ToString("0.#")].Value;
    }

    private TierListCategory? SkillHeatCategory(double passRate)
    {
        return !CurrentUser.IsLoggedIn ? null :
            passRate < .4 ? TierListCategory.VeryHard :
            passRate < .65 ? TierListCategory.Hard :
            passRate < .85 ? TierListCategory.Medium :
            TierListCategory.VeryEasy;
    }

