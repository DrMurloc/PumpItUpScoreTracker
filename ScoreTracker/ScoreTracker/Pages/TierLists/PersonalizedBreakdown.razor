@inject ICurrentUserAccessor CurrentUser;
@inject IMediator Mediator;
@inject NavigationManager NavManager;
@inject IJSRuntime JSRuntime;
@inject IUiSettingsAccessor UiSettings;
@code {

    [Parameter] public string? ChartTypeRoute { get; set; }

    [Parameter] public int? LevelRoute { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Lens")]
    public string? LensParam { get; set; }

    // Score alone personalizes now; Pass stopped when its two personal sources went
    // (docs/design/pumbility-tier-list.md). A bookmarked ?Lens=Pass falls through to Score
    // rather than reaching a handler that would reject it.
    private static readonly string[] ValidLenses = { "Score" };

    private MixEnum _currentMix = MixEnum.Phoenix;
    private ChartType _chartType = ChartType.Double;
    private int _level = 18;
    private string _lens = "Score";
    private bool _isLoading = true;

    private PersonalizedTierListBreakdown? _breakdown;
    private IDictionary<Guid, Chart> _charts = new Dictionary<Guid, Chart>();
    private IDictionary<Guid, Chart> _allCharts = new Dictionary<Guid, Chart>();
    private IDictionary<Guid, RecordedPhoenixScore> _scores = new Dictionary<Guid, RecordedPhoenixScore>();

    private string TierListUrl => $"/TierLists/{_chartType}/{_level}?TierListType={_lens}";

    // --- Verdict + movers buckets --------------------------------------------------------

    // A chart with no recorded vote from either personal source cannot move — that's
    // the honest "not enough data" bucket, distinct from "agrees with the community".
    /// <summary>
    ///     Charts the projection could not answer for — the honest "not enough data" bucket,
    ///     distinct from "agrees with the community".
    ///     <para>
    ///         Keyed on the projection, because the projection is the whole recipe on the only
    ///         lens this page renders. It used to ask whether Skill and Similar Players had
    ///         anything to say; neither is in the Score recipe, so both come back Unrecorded for
    ///         every chart, and the page counted the entire folder as dataless — which drove
    ///         UnchangedCount negative and told the reader that charts drawn on the spread
    ///         directly above had nobody near their level scoring them.
    ///     </para>
    /// </summary>
    private IReadOnlyList<BreakdownChartRecord> BuildNoDataCharts() => _breakdown == null
        ? Array.Empty<BreakdownChartRecord>()
        : _breakdown.Charts.Where(c => c.ProjectedScore == null).ToArray();

    private IReadOnlyList<BreakdownChartRecord> BuildHarderMovers() => MoversWhere(c => c.PersonalizedCategory > c.CommunityCategory);

    private IReadOnlyList<BreakdownChartRecord> BuildEasierMovers() => MoversWhere(c => c.PersonalizedCategory < c.CommunityCategory);

    private IReadOnlyList<BreakdownChartRecord> MoversWhere(Func<BreakdownChartRecord, bool> direction)
    {
        return _breakdown == null
            ? Array.Empty<BreakdownChartRecord>()
            : _breakdown.Charts
                .Where(c => c.CommunityCategory != TierListCategory.Unrecorded &&
                            c.PersonalizedCategory != TierListCategory.Unrecorded)
                .Where(direction)
                .OrderByDescending(c => Math.Abs(c.PersonalizedCategory - c.CommunityCategory))
                .ThenBy(c => _charts.TryGetValue(c.ChartId, out var chart) ? chart.Song.Name.ToString() : "")
                .ToArray();
    }

    private int MovedCount => _harderMovers.Count + _easierMovers.Count;

    private int UnchangedCount => _breakdown == null
        ? 0
        : _breakdown.Charts.Count - MovedCount - _noDataCharts.Count;

    // --- Movers ------------------------------------------------------------------------

    private const int InitialMoversShown = 8;
    private readonly HashSet<Guid> _expandedCharts = new();
    private readonly HashSet<string> _showAllGroups = new();
    private bool _showNoData;

    private Chart? _detailsChart;
    private bool _detailsOpen;

    /// <summary>
    ///     What the spread is ordered by: "Projected" or "Mine". Persisted like the tier list's
    ///     own controls — it is a reading preference, and a reading preference that resets every
    ///     visit is one the reader has to re-make every visit.
    /// </summary>
    private string _spreadSort = "Projected";

    private const string SpreadSortKey = "Breakdown__SpreadSort";

    private static readonly string[] ValidSpreadSorts = { "Projected", "Mine" };

    private async Task SetSpreadSort(string sort)
    {
        if (sort == _spreadSort) return;

        _spreadSort = sort;
        _spreadRows = BuildSpreadRows();
        await UiSettings.SetSetting(SpreadSortKey, sort);
    }

    private void OpenChart(Chart chart)
    {
        _detailsChart = chart;
        _detailsOpen = true;
    }

    // Friendly tier names — raw enum names never render; the unlocalized string is
    // the key, L[...] localizes at render (same table as the tier list page).
    private static readonly IDictionary<TierListCategory, string> TierNames = new Dictionary<TierListCategory, string>
    {
        { TierListCategory.Overrated, "1+ Level Easier" },
        { TierListCategory.VeryEasy, "Very Easy" },
        { TierListCategory.Easy, "Easy" },
        { TierListCategory.Medium, "Medium" },
        { TierListCategory.Hard, "Hard" },
        { TierListCategory.VeryHard, "Very Hard" },
        { TierListCategory.Underrated, "1+ Level Harder" },
        { TierListCategory.Unrecorded, "Not Rated" }
    };

    /// <summary>
    ///     The spread's rows: charts with a projection, hardest first. A chart no peer has played
    ///     has no position on that axis and belongs in the not-enough-data line instead.
    /// </summary>
    private IReadOnlyList<ProjectionSpread.SpreadRow> BuildSpreadRows()
    {
        if (_breakdown == null) return Array.Empty<ProjectionSpread.SpreadRow>();

        var rows = _breakdown.Charts
            .Where(c => c.ProjectedScore != null && _charts.ContainsKey(c.ChartId))
            .Select(c => new ProjectionSpread.SpreadRow(
                _charts[c.ChartId],
                (int)c.ProjectedScore!.Value,
                _scores.TryGetValue(c.ChartId, out var mine) ? mine.Score : null));

        // Ascending either way, so the top of the list is always the hard end — by what this
        // level scores, or by what you actually did. An unplayed chart has nothing to sort on
        // and goes last rather than pretending to be a zero at the top.
        return (_spreadSort == "Mine"
                ? rows.OrderBy(r => r.Mine == null).ThenBy(r => r.Mine == null ? 0 : (int)r.Mine.Value)
                : rows.OrderBy(r => r.Projected))
            .ToArray();
    }

    // Built once per load rather than per read. Each of these was a property returning a fresh
    // array, and the markup reads them several times apiece — _gaps alone through Count,
    // AheadCount, WidestGap and its own loop, each rebuild walking the whole folder.
    private IReadOnlyList<BreakdownChartRecord> _noDataCharts = Array.Empty<BreakdownChartRecord>();
    private IReadOnlyList<BreakdownChartRecord> _harderMovers = Array.Empty<BreakdownChartRecord>();
    private IReadOnlyList<BreakdownChartRecord> _easierMovers = Array.Empty<BreakdownChartRecord>();
    private IReadOnlyList<GapRow> _gaps = Array.Empty<GapRow>();
    private IReadOnlyList<NotPlayedRow> _notPlayed = Array.Empty<NotPlayedRow>();
    private IReadOnlyList<ProjectionSpread.SpreadRow> _spreadRows = Array.Empty<ProjectionSpread.SpreadRow>();

    private void RebuildViews()
    {
        _noDataCharts = BuildNoDataCharts();
        _harderMovers = BuildHarderMovers();
        _easierMovers = BuildEasierMovers();
        _gaps = BuildGaps();
        _notPlayed = BuildNotPlayed();
        _spreadRows = BuildSpreadRows();
    }

    private sealed record GapRow(Chart Chart, int Delta, int Mine, int Projected);

    /// <summary>
    ///     Your score against the projection, furthest behind first. Comparison only — these
    ///     numbers never enter the ranking, which is the projection alone.
    /// </summary>
    private IReadOnlyList<GapRow> BuildGaps() => _breakdown == null
        ? Array.Empty<GapRow>()
        : _breakdown.Charts
            .Where(c => c.ProjectedScore != null && _charts.ContainsKey(c.ChartId)
                        && _scores.TryGetValue(c.ChartId, out var s) && s.Score != null)
            .Select(c => new GapRow(_charts[c.ChartId],
                (int)_scores[c.ChartId].Score!.Value - (int)c.ProjectedScore!.Value,
                (int)_scores[c.ChartId].Score!.Value,
                (int)c.ProjectedScore!.Value))
            .OrderBy(g => g.Delta)
            .ToArray();

    private int AheadCount => _gaps.Count(g => g.Delta > 0);

    // The bar is scaled to the widest gap on the page, so the shape reads as this folder's
    // spread rather than an absolute one. Never zero: every row would divide by it.
    private int WidestGap => Math.Max(1, _gaps.Count == 0 ? 1 : _gaps.Max(g => Math.Abs(g.Delta)));

    private sealed record NotPlayedRow(Chart Chart, int Projected);

    private IReadOnlyList<NotPlayedRow> BuildNotPlayed() => _breakdown == null
        ? Array.Empty<NotPlayedRow>()
        : _breakdown.Charts
            .Where(c => c.ProjectedScore != null && _charts.ContainsKey(c.ChartId)
                        && (!_scores.TryGetValue(c.ChartId, out var s) || s.Score == null))
            .OrderByDescending(c => (int)c.ProjectedScore!.Value)
            .Select(c => new NotPlayedRow(_charts[c.ChartId], (int)c.ProjectedScore!.Value))
            .ToArray();

    /// <summary>
    ///     A number bound for a CSS declaration, always with a dot — see ProjectionSpread.Css.
    ///     The app switches formatting culture, so a raw double emits a comma here and the bar
    ///     silently loses its width on five of the nine locales.
    /// </summary>
    private static string Css(double value) => value.ToString("0.####", CultureInfo.InvariantCulture);

    private int? MyScoreOn(Guid chartId) =>
        _scores.TryGetValue(chartId, out var s) && s.Score != null ? (int)s.Score.Value : null;

    // Mix-required: a score resolves to a different letter under Phoenix 2's floors, and there
    // is deliberately no mix-less way to ask.
    private PhoenixLetterGrade GradeOf(int score) => ((PhoenixScore)score).LetterGradeFor(_currentMix);

    /// <summary>"17,110 – 17,860": the pools of the type a Phoenix 2 peer may hold, whole (the precision rule).</summary>
    private static string PoolWindow(PeerGroup peers)
    {
        return $"{Math.Max(0, peers.Lowest):N0} – {peers.Highest:N0}";
    }

    private string BandLow => Math.Max(1, _breakdown!.CompetitiveLevel - _breakdown.CompetitiveWindow)
        .ToString("N1");

    private string BandHigh => (_breakdown!.CompetitiveLevel + _breakdown.CompetitiveWindow).ToString("N1");

    private RenderFragment NameCell(Chart chart) =>
        @<span class="bd-gap-name" role="button" tabindex="0" @onclick="() => OpenChart(chart)">
            <span class="bd-jacket-sm" style="background-image:url('@chart.Song.ImagePath')"></span>
            <span class="bd-gap-title">@chart.Song.Name</span>
        </span>;

    private static string TierNameFor(TierListCategory category)
    {
        return TierNames[category];
    }

    private RenderFragment? SourceSegment(string label, double weight, TierListCategory category)
    {
        // A source with no vote does not render, and neither does one carrying no weight.
        // Community is populated on Score — it is the column the diff is against — but its
        // weight is zero by design, so printing it read as "Community ×0" listed among the
        // inputs, which is precisely what the recipe says it is not.
        if (category == TierListCategory.Unrecorded || weight <= 0) return null;
        return @<span class="bd-src">@label <span class="bd-src-w">×@weight</span>
            <span style="color:@ThemeScales.DifficultyColor(category)">@L[TierNameFor(category)]</span></span>;
    }

    private IReadOnlyList<(string Key, string Title, string CssClass, IReadOnlyList<BreakdownChartRecord> Movers)> MoverGroups => new[]
    {
        ("Harder", (string)L["Harder for you"], "bd-count-harder", _harderMovers),
        ("Easier", (string)L["Easier for you"], "bd-count-easier", _easierMovers)
    };

    private void ToggleExpanded(Guid chartId)
    {
        if (!_expandedCharts.Add(chartId))
        {
            _expandedCharts.Remove(chartId);
        }
    }

    private void ToggleShowAll(string groupKey)
    {
        if (!_showAllGroups.Add(groupKey))
        {
            _showAllGroups.Remove(groupKey);
        }
    }

    private IReadOnlyList<string> NoDataChartNames => _noDataCharts
        .Select(c => _charts.TryGetValue(c.ChartId, out var chart) ? chart.Song.Name.ToString() : null)
        .Where(n => n != null)
        .Select(n => n!)
        .OrderBy(n => n)
        .ToArray();

    // --- Contribution chips ---------------------------------------------------------------

    // --- Navigation ----------------------------------------------------------------------

    private async Task ChangeFolder((ChartType Type, int Level) folder)
    {
        // CoOp doesn't personalize — hand the folder back to the tier list page.
        if (folder.Type == ChartType.CoOp)
        {
            NavManager.NavigateTo($"/TierLists/{folder.Type}/{folder.Level}");
            return;
        }

        _chartType = folder.Type;
        _level = folder.Level;
        await SetQueryString();
        await LoadFolder();
    }

    private async Task ChangeLens(string lens)
    {
        _lens = lens;
        await SetQueryString();
        ResetMoverViewState();
        // Only the blend depends on the lens — charts, scores, chips, and rankings
        // are folder-scoped and stay.
        _isLoading = true;
        StateHasChanged();
        _breakdown = await Mediator.Send(new GetPersonalizedTierListBreakdownQuery(_chartType, _level, _lens, Mix: _currentMix));
        RebuildViews();
        _isLoading = false;
        StateHasChanged();
    }

    // Pushed straight into history rather than navigated to — under the static router,
    // NavigateTo re-fetches and re-initializes the whole page, and both callers already
    // reload exactly the slice that changed.
    private async Task SetQueryString()
    {
        var url = NavManager.GetUriWithQueryParameters(
            $"/TierLists/{_chartType}/{_level}/Breakdown",
            new Dictionary<string, object?> { { "Lens", _lens } });
        await JSRuntime.InvokeVoidAsync("history.pushState", null, "", url);
    }

    // --- Load ----------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        _currentMix = await UiSettings.GetSelectedMix();
        // The lenses that personalize don't exist for legacy mixes; CoOp never
        // personalizes. Soft-land those on the tier list instead of a dead page.
        if (_currentMix.UsesLegacyScoring())
        {
            NavManager.NavigateTo("/TierLists");
            return;
        }

        _chartType = Enum.TryParse<ChartType>(ChartTypeRoute, true, out var routeType) ? routeType : ChartType.Double;
        if (LevelRoute is >= 1 and <= 29)
        {
            _level = LevelRoute.Value;
        }

        if (_chartType == ChartType.CoOp)
        {
            NavManager.NavigateTo($"/TierLists/{_chartType}/{_level}");
            return;
        }

        _lens = ValidLenses.FirstOrDefault(l => string.Equals(l, LensParam, StringComparison.OrdinalIgnoreCase)) ?? "Score";

        if (!CurrentUser.IsLoggedIn)
        {
            _isLoading = false;
            return;
        }

        var chartsTask = Mediator.Send(new GetChartsQuery(_currentMix));
        var scoresTask = Mediator.Send(new GetPhoenixRecordsQuery(CurrentUser.User.Id, _currentMix));
        var sortTask = UiSettings.GetSetting(SpreadSortKey);
        _allCharts = (await chartsTask).ToDictionary(c => c.Id);
        _scores = (await scoresTask).ToDictionary(s => s.ChartId);
        // Validated on the way in rather than trusted: a saved value that no longer names a sort
        // would otherwise fall through to the projection while the menu ticks nothing.
        var savedSort = await sortTask;
        _spreadSort = ValidSpreadSorts.Contains(savedSort) ? savedSort! : "Projected";

        await LoadFolder();
    }

    private void ResetMoverViewState()
    {
        _expandedCharts.Clear();
        _showAllGroups.Clear();
        _showNoData = false;
    }

    private async Task LoadFolder()
    {
        _isLoading = true;
        ResetMoverViewState();
        StateHasChanged();

        _charts = _allCharts.Values
            .Where(c => c.Level == _level && c.Type == _chartType)
            .ToDictionary(c => c.Id);

        // The skill chips and the score-quality rankings went with the skill profile: both only
        // ever fed it, and this page is read on every "how is this personalized?" click.
        _breakdown = await Mediator.Send(
            new GetPersonalizedTierListBreakdownQuery(_chartType, _level, _lens, Mix: _currentMix));

        RebuildViews();
        _isLoading = false;
        StateHasChanged();
    }
}
