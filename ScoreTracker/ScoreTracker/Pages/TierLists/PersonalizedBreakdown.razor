@page "/TierLists/{ChartTypeRoute}/{LevelRoute:int}/Breakdown"
@rendermode RenderModes.Interactive
@using MediatR
@using ScoreTracker.Catalog.Contracts
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.ChartIntelligence.Contracts
@using ScoreTracker.ChartIntelligence.Contracts.Queries
@using ScoreTracker.Domain.Models
@using ScoreTracker.Domain.Records
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.PlayerProgress.Contracts.Queries
@using ScoreTracker.ScoreLedger.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Contracts
@using ScoreTracker.Web.Services.Theming
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType

<PageTitle>@L["Personalized Breakdown"]</PageTitle>
<HeadContent>
    <meta name="description" content="How your personalized PIU tier list is computed for this folder."/>
</HeadContent>

@if (!CurrentUser.IsLoggedIn)
{
    <div class="tier-list-cta">
        <MudText Typo="Typo.h6">@L["Import your scores to light this folder up"]</MudText>
        <div class="tier-list-cta-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/Login">@L["Login"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/UploadPhoenixScores">@L["Import Scores"]</MudButton>
        </div>
    </div>
}
else
{
    <div class="bd-page">
        @* Header: where you are (folder + lens) and the way back. The folder picker and
           lens select stay live so folder-hopping doesn't bounce through the tier list. *@
        <div class="bd-toolbar">
            <MudLink Href="@TierListUrl" Typo="Typo.caption">← @L["Back to Tier List"]</MudLink>
            <div class="bd-toolbar-row">
                <MudText Typo="Typo.h4" Class="bd-title">@L["Personalized Breakdown"]</MudText>
                <FolderPicker Type="_chartType" Level="_level" Disabled="_isLoading" FolderChanged="ChangeFolder"></FolderPicker>
                <MudSelect T="string" Class="bd-lens-select" Label="@L["Ranked by"]" Disabled="_isLoading" Value="_lens" ValueChanged="ChangeLens">
                    <MudSelectItem T="string" Value="@("Pass")">@L["Pass Difficulty"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Score")">@L["Score Difficulty"]</MudSelectItem>
                </MudSelect>
                <MudSpacer></MudSpacer>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Bolt">@L["Personalized for {0}", CurrentUser.User.GameTag ?? CurrentUser.User.Name]</MudChip>
            </div>
        </div>

        @* Always the card here: this page only exists for a signed-in player on a personalizing
           lens, so its wait is the slow one every time. *@
        @if (_isLoading)
        {
            <PatienceCard Explanation="@L["Compiling your personalized breakdown."]"></PatienceCard>
        }
        else if (_breakdown == null)
        {
            <div class="tier-list-cta">
                <MudText>@L["No charts match your filters"]</MudText>
            </div>
        }
        else if (_lens != "Score")
        {
            @* Pass is on hold (owner, 2026-08-11). Its personal half — the skill estimate and
               the similar-players read — is being reworked, and everything this page says about
               Pass explains the version that is going away. Better to say nothing than to
               explain a blend nobody is keeping. *@
            <div class="tier-list-cta">
                <MudText Typo="Typo.h6">@L["A breakdown for Pass Difficulty is coming."]</MudText>
                <MudText Typo="Typo.caption">@L["The way Pass personalizes is being reworked, so this page waits for it rather than explaining the version being replaced."]</MudText>
                <div class="tier-list-cta-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ChangeLens("Score"))">@L["See the Score breakdown"]</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@TierListUrl">@L["Back to Tier List"]</MudButton>
                </div>
            </div>
        }
        else
        {
            @* The verdict: what personalization actually did to this folder, in numbers
               that always print (rule 8). *@
            <div class="bd-verdict">
                <span>@L["Your personalized list moves {0} of {1} charts away from the community's.", MovedCount, _breakdown.Charts.Count]</span>
                <span class="bd-verdict-detail">
                    <span class="bd-harder-text">@L["{0} harder for you", HarderMovers.Count]</span>
                    <span class="bd-dot">·</span>
                    <span class="bd-easier-text">@L["{0} easier for you", EasierMovers.Count]</span>
                    <span class="bd-dot">·</span>
                    <span>@L["{0} match the community tier", UnchangedCount]</span>
                    @if (NoDataCharts.Any())
                    {
                        <span class="bd-dot">·</span>
                        <span>@L["{0} don't have enough data to move", NoDataCharts.Count]</span>
                    }
                </span>
                <MudText Typo="Typo.caption" Class="bd-caption">@L["Recalculated every few hours"]</MudText>
            </div>

            @* The recipe. One source, so there is no weighing to show — what matters is what
               it is and how much of the folder it could reach. *@
            <section class="bd-block">
                <MudText Typo="Typo.h5">@L["What goes into your list"]</MudText>
                <div class="bd-recipe-cards">
                    <div class="bd-card">
                        <div class="bd-card-head">
                            <MudText Typo="Typo.subtitle1">@L["What Players at Your Level Score"]</MudText>
                            <span class="bd-weight bd-w-projection">@L["the whole list"]</span>
                        </div>
                        @* The honest claim and the limit of it: what players at this level score
                           here, never that a chart suits you. The estimator takes no argument
                           describing the player it predicts for. *@
                        <MudText Typo="Typo.body2" Class="bd-caption">@L["Everyone within half a competitive level of you who has played these charts. Each score counts for less the more that player has improved since setting it. Nothing else votes: the community score lists are built from the same scores this reads, so blending them in would count the same evidence twice."]</MudText>
                        @if (_breakdown.ProjectedChartCount >= 3)
                        {
                            <div class="bd-status">
                                <span class="bd-status-ok">●</span>
                                <span>@L["Active — {0} / {1} charts covered", _breakdown.ProjectedChartCount, _breakdown.FolderChartCount]</span>
                            </div>
                        }
                        else
                        {
                            <div class="bd-status">
                                <span class="bd-status-off">●</span>
                                <span>@L["Silent — players at your level have only scored {0} of these charts. Your list currently matches the community's.", _breakdown.ProjectedChartCount]</span>
                            </div>
                        }
                    </div>
                </div>
            </section>

            @* The spread the tiers were cut from — the section carrying this page's whole
               reason for existing. With the blend gone it is not one input among several, it
               IS the list. *@
            @if (SpreadRows.Count > 0)
            {
                <section class="bd-block">
                    <MudText Typo="Typo.h5">@L["What players at your level score here"]</MudText>
                    <MudText Typo="Typo.caption" Class="bd-caption">@L["Every chart placed on what you would be expected to score. The tiers are cut from the spread of these numbers, which is why the bands sit where they do."]</MudText>
                    <ProjectionSpread Rows="SpreadRows" Mix="_currentMix"></ProjectionSpread>
                    <div class="bd-spread-legend">
                        <span><span class="bd-legend-dot"></span> @L["projected for your level"]</span>
                        <span><span class="bd-legend-diamond"></span> @L["Your Score"]</span>
                        <span><span class="bd-legend-hollow"></span> @L["Not played yet"]</span>
                    </div>
                </section>
            }

            @* Charts that moved — the reason this page exists. Simple rows (jacket,
               movement in ramp-colored words, top contribution chips); tapping a row
               expands the full source strip (owner: simple view, tap for more data). *@
            <section class="bd-block">
                <MudText Typo="Typo.h5">@L["Charts that moved"]</MudText>
                <MudText Typo="Typo.caption" Class="bd-caption">@L["Where your list disagrees with the community's, and the number behind it."]</MudText>
                @if (!HarderMovers.Any() && !EasierMovers.Any())
                {
                    <div class="bd-quiet">@L["Your list currently matches the community's on every rated chart."]</div>
                }
                @foreach (var group in MoverGroups)
                {
                    if (!group.Movers.Any())
                    {
                        continue;
                    }
                    var shown = _showAllGroups.Contains(group.Key)
                        ? group.Movers
                        : group.Movers.Take(InitialMoversShown).ToArray();
                    <div class="bd-mover-group">
                        <div class="bd-group-head">
                            <MudText Typo="Typo.subtitle1">@group.Title</MudText>
                            <span class="bd-count @group.CssClass">@group.Movers.Count</span>
                        </div>
                        @foreach (var mover in shown)
                        {
                            if (!_charts.TryGetValue(mover.ChartId, out var chart))
                            {
                                continue;
                            }
                            var expanded = _expandedCharts.Contains(mover.ChartId);
                            <div class="bd-mover" role="button" tabindex="0" @onclick="() => ToggleExpanded(mover.ChartId)">
                                <span class="bd-jacket" style="background-image:url('@chart.Song.ImagePath')"></span>
                                <span class="bd-mover-song">
                                    <DifficultyBubble Chart="chart"></DifficultyBubble>
                                    <span class="bd-mover-name">@chart.Song.Name</span>
                                </span>
                                <span class="bd-move">
                                    <span style="color:@ThemeScales.DifficultyColor(mover.CommunityCategory)">@L[TierNameFor(mover.CommunityCategory)]</span>
                                    <span class="bd-move-arrow">→</span>
                                    <span style="color:@ThemeScales.DifficultyColor(mover.PersonalizedCategory)">@L[TierNameFor(mover.PersonalizedCategory)]</span>
                                </span>
                                <span class="bd-mover-chips">
                                    @if (mover.ProjectedScore != null)
                                    {
                                        <span class="bd-mover-why">@L["Players at your level score {0}", ((int)mover.ProjectedScore.Value).ToString("N0")]</span>
                                    }
                                </span>
                                @if (expanded)
                                {
                                    @* Sources with no vote don't render at all (a dangling "—"
                                       read as a stray dash — owner field-test), and the final
                                       flows inline instead of floating right. *@
                                    <div class="bd-source-strip">
                                        @SourceSegment(L["Community"], _breakdown.CommunityWeight, mover.CommunityCategory)
                                        @SourceSegment(L["Players Like You"], _breakdown.SimilarPlayersWeight, mover.SimilarPlayersCategory)
                                        @SourceSegment(L["Your skills"], _breakdown.SkillWeight, mover.SkillCategory)
                                        @SourceSegment(L["Players at your level"], _breakdown.ProjectionWeight, mover.ProjectionCategory)
                                        <span class="bd-src-final">= <span style="color:@ThemeScales.DifficultyColor(mover.PersonalizedCategory)">@L[TierNameFor(mover.PersonalizedCategory)]</span></span>
                                    </div>
                                }
                            </div>
                        }
                        @if (group.Movers.Count > InitialMoversShown)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       OnClick="() => ToggleShowAll(group.Key)">
                                @(_showAllGroups.Contains(group.Key) ? L["Show fewer"] : L["Show all {0} charts", group.Movers.Count])
                            </MudButton>
                        }
                    </div>
                }
                <div class="bd-quiet">
                    <span>@L["{0} charts match the community tier", UnchangedCount]</span>
                    @if (NoDataCharts.Any())
                    {
                        <span class="bd-dot">·</span>
                        <span>@L["{0} have no projection yet — nobody near your level has scored them:", NoDataCharts.Count]</span>
                        <span class="bd-nodata-names">@string.Join(" · ", NoDataChartNames.Take(_showNoData ? NoDataCharts.Count : 3))</span>
                        @if (NoDataCharts.Count > 3)
                        {
                            <MudLink Typo="Typo.caption" OnClick="() => _showNoData = !_showNoData">@(_showNoData ? L["Show fewer"] : L["+{0} more", NoDataCharts.Count - 3])</MudLink>
                        }
                    }
                </div>
            </section>

            <section class="bd-block">
                <MudText Typo="Typo.h5">@L["How you're doing against your level"]</MudText>
                <MudText Typo="Typo.caption" Class="bd-caption">@L["Shown for comparison only — your own scores are not an input to the ranking above. The charts you sit furthest below are the ones with the most left in them."]</MudText>
                @* The note that stops a column of red reading as a verdict on the player. *@
                <MudText Typo="Typo.body2" Class="bd-shifting-bar">@L["Nobody is above the line on every chart in their folder. If you were, your competitive level would climb and you would be measured against stronger scores instead — the bar moves with you."]</MudText>
                @if (Gaps.Count > 0)
                {
                    <div class="bd-gaps">
                        @foreach (var gap in Gaps)
                        {
                            <div class="bd-gap-row">
                                <span class="bd-gap-name">@gap.Name</span>
                                <span class="bd-gap-num" style="color:@ThemeScales.DifficultyColor(gap.Delta < 0 ? TierListCategory.VeryHard : TierListCategory.VeryEasy)">
                                    @(gap.Delta > 0 ? "+" : "−")@Math.Abs(gap.Delta).ToString("N0")
                                </span>
                            </div>
                        }
                    </div>
                }
                @if (NotPlayed.Count > 0)
                {
                    @* The projection does not need the player to have played a chart — it is
                       drawn from the peers who have — so these have a number and no comparison. *@
                    <MudText Typo="Typo.subtitle2" Class="bd-gap-head">@L["Not played yet"]</MudText>
                    <div class="bd-gaps">
                        @foreach (var row in NotPlayed)
                        {
                            <div class="bd-gap-row">
                                <span class="bd-gap-name">@row.Name</span>
                                <span class="bd-gap-num bd-gap-projected">@row.Projected.ToString("N0")</span>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
}
<style>
    .bd-page {
        max-width: 1240px;
        margin: 0 auto;
        padding-bottom: 24px;
    }

    .bd-toolbar {
        margin-top: 12px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .bd-toolbar-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .bd-title {
        margin-right: 4px;
    }

    .bd-lens-select {
        max-width: 190px;
    }

    .bd-caption {
        color: var(--mud-palette-text-secondary);
        display: block;
    }

    .bd-verdict {
        margin: 16px 0 4px;
        padding: 12px 16px;
        border-left: 3px solid var(--mud-palette-primary);
        background: var(--mud-palette-surface);
        border-radius: 0 8px 8px 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .bd-verdict-detail {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        font-size: .85rem;
        color: var(--mud-palette-text-secondary);
    }

    .bd-harder-text {
        color: var(--diff-veryhard);
    }

    .bd-easier-text {
        color: var(--diff-veryeasy);
    }

    .bd-dot {
        opacity: .6;
    }

    .bd-block {
        margin-top: 28px;
    }

    .bd-weightbar {
        display: flex;
        height: 8px;
        border-radius: 4px;
        overflow: hidden;
        max-width: 520px;
        margin: 10px 0 14px;
    }

    .bd-weightbar span {
        display: block;
    }

    .bd-w-community {
        background: var(--mud-palette-text-secondary);
    }

    .bd-w-skill {
        background: var(--mud-palette-primary);
    }

    .bd-w-similar {
        background: var(--mix-secondary);
    }

    .bd-w-projection {
        background: var(--mix-accent);
    }

    span.bd-weight {
        font-size: .68rem;
        letter-spacing: .1em;
        border-radius: 4px;
        padding: 1px 6px;
        font-weight: 700;
        background: transparent;
    }

    .bd-weight.bd-w-community {
        background: color-mix(in srgb, var(--mud-palette-text-secondary) 25%, transparent);
        color: var(--mud-palette-text-primary);
    }

    .bd-weight.bd-w-skill {
        background: color-mix(in srgb, var(--mud-palette-primary) 25%, transparent);
        color: var(--mud-palette-primary);
    }

    .bd-weight.bd-w-similar {
        background: color-mix(in srgb, var(--mix-secondary) 25%, transparent);
        color: var(--mix-secondary);
    }

    .bd-recipe-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 12px;
    }

    .bd-card {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 10px;
        padding: 14px 16px;
    }

    .bd-card-head {
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: space-between;
    }

    .bd-status {
        margin-top: 8px;
        display: flex;
        gap: 6px;
        align-items: baseline;
        font-size: .82rem;
    }

    .bd-status-ok {
        color: var(--mud-palette-success);
    }

    .bd-status-off {
        color: var(--mud-palette-warning);
    }

    .bd-status.bd-age-note {
        color: var(--mud-palette-text-secondary);
        margin-top: 4px;
        align-items: center;
    }

    .bd-age-icon {
        font-size: 1rem;
    }

    .bd-skills-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        margin-top: 12px;
    }

    @@media (min-width: 900px) {
        .bd-skills-grid {
            grid-template-columns: 7fr 5fr;
        }
    }

    .bd-dev-head, .bd-dev-row {
        display: grid;
        grid-template-columns: minmax(88px, 110px) 1fr 56px 62px 74px;
        gap: 10px;
        align-items: center;
    }

    .bd-dev-head {
        font-size: .64rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--mud-palette-text-secondary);
        margin: 10px 0 6px;
    }

    .bd-dev-row {
        font-size: .82rem;
        padding: 3px 0;
    }

    .bd-dev-row.bd-dim {
        opacity: .45;
    }

    .bd-dev-label {
        color: color-mix(in srgb, var(--skill-chip) 60%, var(--mix-ink));
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .bd-dev-track {
        position: relative;
        height: 8px;
        border-radius: 4px;
        background: color-mix(in srgb, var(--mud-palette-text-secondary) 16%, transparent);
    }

    .bd-dev-track::before {
        content: "";
        position: absolute;
        left: 50%;
        top: -2px;
        bottom: -2px;
        width: 1px;
        background: var(--mud-palette-lines-default);
    }

    .bd-dev-fill {
        position: absolute;
        top: 0;
        bottom: 0;
        border-radius: 4px;
        background: var(--skill-chip);
    }

    .bd-dev-val, .bd-dev-ev, .bd-dev-peer {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .bd-dev-val {
        font-weight: 600;
    }

    .bd-dev-ev {
        color: var(--mud-palette-text-secondary);
    }

    .bd-footnote {
        margin-top: 8px;
        max-width: 70ch;
    }

    .bd-bridge {
        margin-top: 12px;
        padding: 10px 12px;
        background: var(--mix-surface-muted);
        border-radius: 8px;
        font-size: .8rem;
        color: var(--mud-palette-text-secondary);
    }

    .bd-attribution {
        color: var(--mud-palette-text-secondary);
        display: block;
        margin-top: 6px;
    }

    .bd-mover-group {
        margin-top: 16px;
    }

    .bd-group-head {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
    }

    .bd-count {
        font-size: .72rem;
        border-radius: 999px;
        padding: 1px 8px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .bd-count-harder {
        background: color-mix(in srgb, var(--diff-veryhard) 22%, transparent);
        color: var(--diff-veryhard);
    }

    .bd-count-easier {
        background: color-mix(in srgb, var(--diff-veryeasy) 22%, transparent);
        color: var(--diff-veryeasy);
    }

    .bd-mover {
        display: grid;
        grid-template-columns: 40px minmax(150px, 240px) minmax(200px, 260px) 1fr;
        gap: 12px;
        align-items: center;
        padding: 8px 12px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 10px;
        margin-bottom: 6px;
        background: var(--mud-palette-surface);
        cursor: pointer;
    }

    .bd-mover:focus-visible {
        outline: 2px solid var(--mud-palette-primary);
    }

    .bd-jacket {
        width: 40px;
        height: 40px;
        border-radius: 6px;
        background-size: cover;
        background-position: center;
    }

    .bd-mover-song {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .bd-mover-name {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .bd-move {
        font-size: .84rem;
        white-space: nowrap;
        font-weight: 600;
    }

    .bd-move-arrow {
        color: var(--mud-palette-text-secondary);
        padding: 0 4px;
        font-weight: 400;
    }

    .bd-mover-chips {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .bd-chip-dev {
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    .bd-source-strip {
        grid-column: 1 / -1;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px 18px;
        border-top: 1px solid var(--mud-palette-lines-default);
        margin-top: 4px;
        padding-top: 8px;
        font-size: .8rem;
        color: var(--mud-palette-text-secondary);
    }

    .bd-src-w {
        font-size: .68rem;
        letter-spacing: .05em;
        opacity: .8;
    }

    .bd-src-final {
        color: var(--mud-palette-text-primary);
        font-weight: 600;
    }

    .bd-quiet {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px;
        padding: 10px 12px;
        border: 1px dashed var(--mud-palette-lines-default);
        border-radius: 10px;
        margin-top: 14px;
        color: var(--mud-palette-text-secondary);
        font-size: .84rem;
    }

    .bd-nodata-names {
        color: var(--diff-unrecorded);
    }

    @@media (max-width: 700px) {
        .bd-mover {
            grid-template-columns: 40px 1fr;
        }

        .bd-move, .bd-mover-chips {
            grid-column: 2;
            justify-content: flex-start;
        }

        /* One source per line on phones — the wrapping row read as compressed noise. */
        .bd-source-strip {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }
    }
    .bd-shifting-bar {
        border-left: 3px solid var(--mud-palette-lines-default);
        padding-left: 12px;
        max-width: 68ch;
        color: var(--mud-palette-text-primary);
    }

    .bd-gaps {
        display: flex;
        flex-direction: column;
        max-width: 520px;
    }

    .bd-gap-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 6px 0;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        font-size: .85rem;
    }

    .bd-gap-row:last-child {
        border-bottom: 0;
    }

    .bd-gap-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .bd-gap-num {
        font-variant-numeric: tabular-nums;
        flex: none;
    }

    .bd-gap-projected {
        color: var(--mix-accent);
    }

    .bd-gap-head {
        margin-top: 10px;
    }

    .bd-spread-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
        font-size: .75rem;
        color: var(--mud-palette-text-secondary);
        align-items: center;
    }

    .bd-spread-legend > span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .bd-legend-dot, .bd-legend-diamond, .bd-legend-hollow {
        width: 11px;
        height: 11px;
        flex: none;
    }

    .bd-legend-dot {
        border-radius: 50%;
        background: var(--mix-primary);
