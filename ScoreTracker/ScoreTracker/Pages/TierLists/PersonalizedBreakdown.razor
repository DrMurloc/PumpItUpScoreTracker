@using ScoreTracker.Domain.Services.Contracts
@page "/TierLists/{ChartTypeRoute}/{LevelRoute:int}/Breakdown"
@rendermode RenderModes.Interactive
@using System.Globalization
@using MediatR
@using ScoreTracker.Catalog.Contracts
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.ChartIntelligence.Contracts
@using ScoreTracker.ChartIntelligence.Contracts.Queries
@using ScoreTracker.Domain.Models
@using ScoreTracker.Domain.Records
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.PlayerProgress.Contracts.Queries
@using ScoreTracker.ScoreLedger.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Contracts
@using ScoreTracker.Web.Services.Theming
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType

<PageTitle>@L["Personalized Breakdown"]</PageTitle>
<HeadContent>
    <meta name="description" content="How your personalized PIU tier list is computed for this folder."/>
</HeadContent>

@if (!CurrentUser.IsLoggedIn)
{
    <div class="tier-list-cta">
        <MudText Typo="Typo.h6">@L["Import your scores to light this folder up"]</MudText>
        <div class="tier-list-cta-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/Login">@L["Login"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/UploadPhoenixScores">@L["Import Scores"]</MudButton>
        </div>
    </div>
}
else
{
    <div class="bd-page">
        @* Header: where you are (folder + lens) and the way back. The folder picker and
           lens select stay live so folder-hopping doesn't bounce through the tier list. *@
        <div class="bd-toolbar">
            <MudLink Href="@TierListUrl" Typo="Typo.caption">← @L["Back to Tier List"]</MudLink>
            <div class="bd-toolbar-row">
                <MudText Typo="Typo.h4" Class="bd-title">@L["Personalized Breakdown"]</MudText>
                <FolderPicker Type="_chartType" Level="_level" Disabled="_isLoading" FolderChanged="ChangeFolder"></FolderPicker>
                <MudSelect T="string" Class="bd-lens-select" Label="@L["Ranked by"]" Disabled="_isLoading" Value="_lens" ValueChanged="ChangeLens">
                    <MudSelectItem T="string" Value="@("Score")">@L["Score Difficulty"]</MudSelectItem>
                </MudSelect>
            </div>
        </div>

        @* Always the card here: this page only exists for a signed-in player on a personalizing
           lens, so its wait is the slow one every time. *@
        @if (_isLoading)
        {
            <PatienceCard Explanation="@L["Compiling your personalized breakdown."]"></PatienceCard>
        }
        else if (_breakdown == null)
        {
            <div class="tier-list-cta">
                <MudText>@L["No charts match your filters"]</MudText>
            </div>
        }
        else if (_lens != "Score")
        {
            @* Pass is on hold (owner, 2026-08-11). Its personal half — the skill estimate and
               the similar-players read — is being reworked, and everything this page says about
               Pass explains the version that is going away. Better to say nothing than to
               explain a blend nobody is keeping. *@
            <div class="tier-list-cta">
                <MudText Typo="Typo.h6">@L["A breakdown for Pass Difficulty is coming."]</MudText>
                <MudText Typo="Typo.caption">@L["The way Pass personalizes is being reworked, so this page waits for it rather than explaining the version being replaced."]</MudText>
                <div class="tier-list-cta-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ChangeLens("Score"))">@L["See the Score breakdown"]</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@TierListUrl">@L["Back to Tier List"]</MudButton>
                </div>
            </div>
        }
        else
        {
            @* The verdict: what personalization actually did to this folder, in numbers
               that always print (rule 8). *@
            <div class="bd-verdict">
                <span>@L["Your personalized list moves {0} of {1} charts away from the community's.", MovedCount, _breakdown.Charts.Count]</span>
                <span class="bd-verdict-detail">
                    <span class="bd-harder-text">@L["{0} harder for you", _harderMovers.Count]</span>
                    <span class="bd-dot">·</span>
                    <span class="bd-easier-text">@L["{0} easier for you", _easierMovers.Count]</span>
                    <span class="bd-dot">·</span>
                    <span>@L["{0} match the community tier", UnchangedCount]</span>
                    @if (_noDataCharts.Any())
                    {
                        <span class="bd-dot">·</span>
                        <span>@L["{0} not enough data", _noDataCharts.Count]</span>
                    }
                </span>
                <MudText Typo="Typo.caption" Class="bd-caption">@L["Recalculated every few hours"]</MudText>
            </div>

            @* The recipe, as figures. It used to be sixty words describing a cohort the page had
               no way to count; now it can count it, and a reader can weigh "148 players" in a way
               they cannot weigh "everyone within half a level of you". *@
            <section class="bd-block">
                <div class="bd-head">
                    <MudText Typo="Typo.h5">@L["What your list is built from"]</MudText>
                    @* The one surviving explanation, and it waits to be asked: it answers "why
                       isn't the community list mixed in", which is a question a reader either
                       has or does not. Leading with it made the page argue with itself. *@
                    <MudTooltip ShowOnClick="true" ShowOnFocus="true" Placement="Placement.Bottom">
                        <ChildContent>
                            <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Class="bd-qmark"></MudIcon>
                        </ChildContent>
                        <TooltipContent>
                            <div class="bd-qbody">@L["Nothing else votes. The community score lists are built from the same scores this reads, so blending them in would count the same evidence twice."]</div>
                        </TooltipContent>
                    </MudTooltip>
                </div>
                @if (_breakdown.ProjectedChartCount >= 3)
                {
                    <div class="bd-stats">
                        @if (_breakdown.Peers is { Kind: PeerGroupKind.PumbilityPeers } pumbilityPeers)
                        {
                            @* Phoenix 2 reads PUMBILITY peers (docs/design/personalized-breakdown.md):
                               the group and the window on the pool of the type (D53) replace the
                               competitive figures, and nothing is discounted, so the stale-weight
                               figure has nothing to say. A pool total prints whole off the PUMBILITY
                               pages (docs/UX-GUIDELINES.md, the precision rule). *@
                            <div class="bd-stat bd-stat-accent">
                                <span class="bd-stat-v">@pumbilityPeers.Size.ToString("N0")</span>
                                <span class="bd-stat-l">@L["PUMBILITY peers"]</span>
                                <span class="bd-stat-s">@L["pools within {0} below and {1} above yours, each a full pool of the type", pumbilityPeers.Below.ToString("N0"), pumbilityPeers.Above.ToString("N0")]</span>
                            </div>
                            <div class="bd-stat">
                                <span class="bd-stat-v">@PoolWindow(pumbilityPeers)</span>
                                <span class="bd-stat-l">@L["Pool window"]</span>
                                <span class="bd-stat-s">
                                    @(_chartType == ChartType.Single
                                        ? L["your singles pool is {0}", pumbilityPeers.Center.ToString("N0")]
                                        : L["your doubles pool is {0}", pumbilityPeers.Center.ToString("N0")])
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="bd-stat bd-stat-accent">
                                <span class="bd-stat-v">@_breakdown.PeerCount.ToString("N0")</span>
                                <span class="bd-stat-l">@L["Players"]</span>
                                <span class="bd-stat-s">@L["who played these charts"]</span>
                            </div>
                            <div class="bd-stat">
                                <span class="bd-stat-v">@BandLow–@BandHigh</span>
                                <span class="bd-stat-l">@L["Level band"]</span>
                                <span class="bd-stat-s">@L["you sit at {0}", _breakdown.CompetitiveLevel.ToString("N1")]</span>
                            </div>
                        }
                        <div class="bd-stat">
                            <span class="bd-stat-v">@_breakdown.ProjectedChartCount / @_breakdown.FolderChartCount</span>
                            <span class="bd-stat-l">@L["Charts covered"]</span>
                            <span class="bd-stat-s">@L["{0} have no peer score", _breakdown.FolderChartCount - _breakdown.ProjectedChartCount]</span>
                        </div>
                        @if (_breakdown.Peers is not { Kind: PeerGroupKind.PumbilityPeers })
                        {
                            <div class="bd-stat">
                                <span class="bd-stat-v">▾ @((1 - _breakdown.MeanFreshness).ToString("P0"))</span>
                                <span class="bd-stat-l">@L["Stale weight"]</span>
                                <span class="bd-stat-s">@L["discount for peers who outgrew the score"]</span>
                            </div>
                        }
                    </div>
                }
                else if (_breakdown.Peers is { Kind: PeerGroupKind.PumbilityPeers, IsLit: false } dark)
                {
                    @* Phoenix 2, and the viewer's own pool of the type is short (D28): the silence is
                       theirs, not the peers', and the page says how far they are — the same figure
                       the PUMBILITY page's chip prints — rather than blaming a group that was never
                       asked. *@
                    <div class="bd-quiet">
                        <span>
                            @(_chartType == ChartType.Single
                                ? L["Singles: {0}/{1} charts", dark.PoolCount, dark.PoolSize]
                                : L["Doubles: {0}/{1} charts", dark.PoolCount, dark.PoolSize])
                            · @(_chartType == ChartType.Single
                                ? L["Peer projections show once your singles pool has {0} charts.", dark.PoolSize]
                                : L["Peer projections show once your doubles pool has {0} charts.", dark.PoolSize])
                        </span>
                    </div>
                }
                else
                {
                    <div class="bd-quiet">
                        <span>@L["Silent — players at your level have only scored {0} of these charts. Your list currently matches the community's.", _breakdown.ProjectedChartCount]</span>
                    </div>
                }
            </section>

            @* The spread the tiers were cut from — the section carrying this page's whole
               reason for existing. With the blend gone it is not one input among several, it
               IS the list. *@
            @if (_spreadRows.Count > 0)
            {
                <section class="bd-block">
                    @* No caption: the bands are drawn over the dots, so the picture states what a
                       sentence underneath would only restate. *@
                    <div class="bd-head">
                        <MudText Typo="Typo.h5">@L["What players at your level score here"]</MudText>
                        @* Reading down the projections answers "what is hard here"; reading down
                           your own answers "where am I weakest". Both are the point of the
                           picture, and neither is a filter, so it is a sort rather than a view. *@
                        <MudMenu Dense="true" Size="Size.Small" Icon="@Icons.Material.Filled.SwapVert"
                                 title="@L["Sort by"]" AriaLabel="@L["Sort by"]">
                            <MudMenuItem OnClick="@(() => SetSpreadSort("Projected"))"
                                         Icon="@(_spreadSort == "Projected" ? Icons.Material.Filled.Check : null)">
                                @L["Projected"]
                            </MudMenuItem>
                            <MudMenuItem OnClick="@(() => SetSpreadSort("Mine"))"
                                         Icon="@(_spreadSort == "Mine" ? Icons.Material.Filled.Check : null)">
                                @L["My Scores"]
                            </MudMenuItem>
                        </MudMenu>
                    </div>
                    <ProjectionSpread Rows="_spreadRows" Mix="_currentMix" ChartSelected="OpenChart"
                                      RailBy="@(_spreadSort == "Mine" ? ProjectionSpread.SpreadRail.Mine : ProjectionSpread.SpreadRail.Projected)"></ProjectionSpread>
                    <div class="bd-spread-legend">
                        <span><span class="bd-legend-dot"></span> @L["Projected Score"]</span>
                        <span><span class="bd-legend-diamond"></span> @L["You"]</span>
                        <span><span class="bd-legend-hollow"></span> @L["Not played"]</span>
                        <span><span class="bd-legend-caret"></span> @L["off the scale"]</span>
                        <span>@L["hover or tap a marker"]</span>
                    </div>
                </section>
            }

            @* Charts that moved — the reason this page exists. Simple rows (jacket,
               movement in ramp-colored words, top contribution chips); tapping a row
               expands the full source strip (owner: simple view, tap for more data). *@
            <section class="bd-block">
                @* No caption: two group headings that say "Harder for you" and "Easier for you",
                   each with its count, already say what a sentence would. *@
                <MudText Typo="Typo.h5">@L["Charts that moved"]</MudText>
                @if (!_harderMovers.Any() && !_easierMovers.Any())
                {
                    <div class="bd-quiet">@L["Your list currently matches the community's on every rated chart."]</div>
                }
                @foreach (var group in MoverGroups)
                {
                    if (!group.Movers.Any())
                    {
                        continue;
                    }
                    var shown = _showAllGroups.Contains(group.Key)
                        ? group.Movers
                        : group.Movers.Take(InitialMoversShown).ToArray();
                    <div class="bd-mover-group">
                        <div class="bd-group-head">
                            <MudText Typo="Typo.subtitle1">@group.Title</MudText>
                            <span class="bd-count @group.CssClass">@group.Movers.Count</span>
                        </div>
                        @foreach (var mover in shown)
                        {
                            if (!_charts.TryGetValue(mover.ChartId, out var chart))
                            {
                                continue;
                            }
                            var expanded = _expandedCharts.Contains(mover.ChartId);
                            <div class="bd-mover" role="button" tabindex="0" @onclick="() => ToggleExpanded(mover.ChartId)">
                                <span class="bd-jacket" style="background-image:url('@chart.Song.ImagePath')"
                                      @onclick:stopPropagation="true" @onclick="() => OpenChart(chart)"></span>
                                <span class="bd-mover-song">
                                    <span class="bd-mover-name" @onclick:stopPropagation="true"
                                          @onclick="() => OpenChart(chart)">@chart.Song.Name</span>
                                    @* Two labelled figures where a sentence used to be, and the
                                       grades make the gap legible without reading either number. *@
                                    <span class="bd-pair">
                                        @if (mover.ProjectedScore != null)
                                        {
                                            <span class="bd-f">
                                                <span class="bd-k">@L["peers:"]</span>
                                                <b>@(((int)mover.ProjectedScore.Value).ToString("N0"))</b>
                                                <LetterGradeIcon Grade="@GradeOf((int)mover.ProjectedScore.Value)" Height="15"></LetterGradeIcon>
                                            </span>
                                        }
                                        @if (MyScoreOn(mover.ChartId) is { } mine)
                                        {
                                            <span class="bd-f">
                                                <span class="bd-k">@L["you:"]</span>
                                                <b>@mine.ToString("N0")</b>
                                                <LetterGradeIcon Grade="@GradeOf(mine)" Height="15"></LetterGradeIcon>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="bd-f bd-k">@L["Not played"]</span>
                                        }
                                    </span>
                                </span>
                                <span class="bd-move">
                                    <span style="color:@ThemeScales.DifficultyColor(mover.CommunityCategory)">@L[TierNameFor(mover.CommunityCategory)]</span>
                                    <span class="bd-move-arrow">→</span>
                                    <span style="color:@ThemeScales.DifficultyColor(mover.PersonalizedCategory)">@L[TierNameFor(mover.PersonalizedCategory)]</span>
                                </span>
                                @if (expanded)
                                {
                                    @* Sources with no vote don't render at all (a dangling "—"
                                       read as a stray dash — owner field-test), and the final
                                       flows inline instead of floating right. *@
                                    <div class="bd-source-strip">
                                        @SourceSegment(L["Community"], _breakdown.CommunityWeight, mover.CommunityCategory)
                                        @SourceSegment(L["Players at your level"], _breakdown.ProjectionWeight, mover.ProjectionCategory)
                                        <span class="bd-src-final">= <span style="color:@ThemeScales.DifficultyColor(mover.PersonalizedCategory)">@L[TierNameFor(mover.PersonalizedCategory)]</span></span>
                                    </div>
                                }
                            </div>
                        }
                        @if (group.Movers.Count > InitialMoversShown)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       OnClick="() => ToggleShowAll(group.Key)">
                                @(_showAllGroups.Contains(group.Key) ? L["Show fewer"] : L["Show all {0} charts", group.Movers.Count])
                            </MudButton>
                        }
                    </div>
                }
                <div class="bd-quiet">
                    <span>@L["{0} charts match the community tier", UnchangedCount]</span>
                    @if (_noDataCharts.Any())
                    {
                        <span class="bd-dot">·</span>
                        <span>@L["{0} have no projection — nobody near your level has scored them:", _noDataCharts.Count]</span>
                        <span class="bd-nodata-names">@string.Join(" · ", NoDataChartNames.Take(_showNoData ? _noDataCharts.Count : 3))</span>
                        @if (_noDataCharts.Count > 3)
                        {
                            <MudLink Typo="Typo.caption" OnClick="() => _showNoData = !_showNoData">@(_showNoData ? L["Show fewer"] : L["+{0} more", _noDataCharts.Count - 3])</MudLink>
                        }
                    }
                </div>
            </section>

            <section class="bd-block">
                <div class="bd-head">
                    <MudText Typo="Typo.h5">@L["You against your level"]</MudText>
                    @* A chip rather than a sentence: what mattered about "shown for comparison
                       only" was the fact, and the fact fits in three words. *@
                    <span class="bd-chip-note">@L["not an input"]</span>
                </div>
                @if (_gaps.Count > 0)
                {
                    @* The balance, drawn. Three sentences used to assert that nobody clears their
                       whole folder; the split says it, and says it about this player. *@
                    <div class="bd-balance">
                        <span class="bd-balance-n bd-easier-text">@AheadCount</span>
                        <span>@L["above"]</span>
                        <span class="bd-balance-bar">
                            <span style="width:@Css(AheadCount * 100.0 / _gaps.Count)%;background:var(--diff-veryeasy)"></span>
                            <span style="width:@Css((_gaps.Count - AheadCount) * 100.0 / _gaps.Count)%;background:var(--diff-veryhard)"></span>
                        </span>
                        <span class="bd-balance-n bd-harder-text">@(_gaps.Count - AheadCount)</span>
                        <span>@L["below"]</span>
                    </div>
                    <MudText Typo="Typo.body2" Class="bd-shifting-bar">@L["Nobody is above the line on every chart — if you were, your level would climb and the line with it."]</MudText>
                    <div class="bd-gaps">
                        <div class="bd-gap-row bd-gap-head">
                            <span>@L["Chart"]</span>
                            <span>@L["Behind / ahead"]</span>
                            <span class="bd-gap-num">@L["Gap"]</span>
                        </div>
                        @foreach (var gap in _gaps)
                        {
                            var behind = gap.Delta < 0;
                            var ramp = behind ? TierListCategory.VeryHard : TierListCategory.VeryEasy;
                            <div class="bd-gap-row">
                                @NameCell(gap.Chart)
                                <span class="bd-gap-bar">
                                    <span class="bd-gap-fill" style="@(behind ? "right:50%;" : "left:50%;")width:@Css(Math.Abs(gap.Delta) * 48.0 / WidestGap)%;background:@ThemeScales.DifficultyColor(ramp)"></span>
                                </span>
                                <span class="bd-gap-num" style="color:@ThemeScales.DifficultyColor(ramp)">
                                    @(gap.Delta > 0 ? "+" : "−")@Math.Abs(gap.Delta).ToString("N0")
                                    <span class="bd-gap-grades">
                                        <LetterGradeIcon Grade="@GradeOf(gap.Mine)" Height="14"></LetterGradeIcon>
                                        <span>/</span>
                                        <LetterGradeIcon Grade="@GradeOf(gap.Projected)" Height="14"></LetterGradeIcon>
                                    </span>
                                </span>
                            </div>
                        }
                    </div>
                }
                @if (_notPlayed.Count > 0)
                {
                    @* The projection does not need the player to have played a chart — it is
                       drawn from the peers who have — so these have a number and no comparison. *@
                    <div class="bd-gaps">
                        <div class="bd-gap-row bd-gap-head">
                            <span>@L["Not played yet"]</span>
                            <span></span>
                            <span class="bd-gap-num">@L["Projected Scores"]</span>
                        </div>
                        @foreach (var row in _notPlayed)
                        {
                            <div class="bd-gap-row">
                                @NameCell(row.Chart)
                                <span></span>
                                <span class="bd-gap-num bd-gap-projected">
                                    @row.Projected.ToString("N0")
                                    <span class="bd-gap-grades">
                                        <LetterGradeIcon Grade="@GradeOf(row.Projected)" Height="14"></LetterGradeIcon>
                                    </span>
                                </span>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
    @* Every song name and jacket on the page raises this one dialog — the shared chart details,
       same as the tier list and Charts. The page owns it; the spread and the lists just ask. *@
    <ChartDetailsDialog @bind-Visible="_detailsOpen" Chart="_detailsChart" Mix="_currentMix"></ChartDetailsDialog>
}
<style>
    .bd-page {
        max-width: 1240px;
        margin: 0 auto;
        padding-bottom: 24px;
    }

    .bd-toolbar {
        margin-top: 12px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .bd-toolbar-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .bd-title {
        margin-right: 4px;
    }

    .bd-lens-select {
        max-width: 190px;
    }

    .bd-caption {
        color: var(--mud-palette-text-secondary);
        display: block;
    }

    .bd-verdict {
        margin: 16px 0 4px;
        padding: 12px 16px;
        border-left: 3px solid var(--mud-palette-primary);
        background: var(--mud-palette-surface);
        border-radius: 0 8px 8px 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .bd-verdict-detail {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        font-size: .85rem;
        color: var(--mud-palette-text-secondary);
    }

    .bd-harder-text {
        color: var(--diff-veryhard);
    }

    .bd-easier-text {
        color: var(--diff-veryeasy);
    }

    .bd-dot {
        opacity: .6;
    }

    .bd-block {
        margin-top: 28px;
    }

    .bd-weightbar {
        display: flex;
        height: 8px;
        border-radius: 4px;
        overflow: hidden;
        max-width: 520px;
        margin: 10px 0 14px;
    }

    .bd-weightbar span {
        display: block;
    }

    .bd-w-community {
        background: var(--mud-palette-text-secondary);
    }

    .bd-w-skill {
        background: var(--mud-palette-primary);
    }

    .bd-w-similar {
        background: var(--mix-secondary);
    }

    .bd-w-projection {
        background: var(--mix-accent);
    }

    span.bd-weight {
        font-size: .68rem;
        letter-spacing: .1em;
        border-radius: 4px;
        padding: 1px 6px;
        font-weight: 700;
        background: transparent;
    }

    .bd-weight.bd-w-community {
        background: color-mix(in srgb, var(--mud-palette-text-secondary) 25%, transparent);
        color: var(--mud-palette-text-primary);
    }

    .bd-weight.bd-w-skill {
        background: color-mix(in srgb, var(--mud-palette-primary) 25%, transparent);
        color: var(--mud-palette-primary);
    }

    .bd-weight.bd-w-similar {
        background: color-mix(in srgb, var(--mix-secondary) 25%, transparent);
        color: var(--mix-secondary);
    }

    .bd-recipe-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 12px;
    }

    .bd-card {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 10px;
        padding: 14px 16px;
    }

    .bd-card-head {
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: space-between;
    }

    .bd-status {
        margin-top: 8px;
        display: flex;
        gap: 6px;
        align-items: baseline;
        font-size: .82rem;
    }

    .bd-status-ok {
        color: var(--mud-palette-success);
    }

    .bd-status-off {
        color: var(--mud-palette-warning);
    }

    .bd-status.bd-age-note {
        color: var(--mud-palette-text-secondary);
        margin-top: 4px;
