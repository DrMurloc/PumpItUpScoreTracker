@using ScoreTracker.Web.Components
@page "/Pumbility/Breakdown"
@page "/Pumbility/Pool"
@rendermode RenderModes.Interactive
@namespace ScoreTracker.Web.Pages.Progress

@* What the number is worth and what it is made of (docs/design/pumbility-overhaul.md D45): the
   title rails, where your PUMBILITY comes from, and the pool curve. The fifty themselves moved
   to the Play list as its Your top 50 lens (D44); the curve stays, because it draws the bar, not
   the list. The old route still resolves — a second @page, not a redirect, because nothing about
   the page is canonical to a crawler: it is signed-in only. *@

<PumbilitySectionFrame Active="breakdown">
    <Body Context="ctx">
        @if (ctx.Page.Rails is { Count: > 0 })
        {
            <section class="pmb-block">
                <div class="pmb-block-head">
                    <h2 class="pmb-block-title">@L["Your PUMBILITY titles"]</h2>
                </div>
                <p class="pmb-block-lede">
                    @L["Each rung asks a flat value of every one of your fifty charts. Switch pools above to see the other ladders."]
                </p>
                <PumbilityTitleRails Rails="ctx.Page.Rails"></PumbilityTitleRails>
            </section>
        }

        <section class="pmb-block">
            <PumbilityBreakdown Breakdown="ctx.Page.Breakdown" PoolCount="ctx.Page.Pool.Count"></PumbilityBreakdown>
        </section>

        <section class="pmb-block">
            <PoolCurve Page="ctx.Page" Charts="ctx.Charts"></PoolCurve>
        </section>
    </Body>
</PumbilitySectionFrame>
