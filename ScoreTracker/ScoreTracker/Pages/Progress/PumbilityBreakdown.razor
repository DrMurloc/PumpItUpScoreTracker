@using MediatR
@using ScoreTracker.Application.Commands
@using ScoreTracker.Application.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Components
@page "/Pumbility/Breakdown"
@page "/Pumbility/Pool"
@rendermode RenderModes.Interactive
@namespace ScoreTracker.Web.Pages.Progress
@inject IMediator Mediator
@inject ISnackbar Snackbar

@* What the number is worth, what it is made of, and what it is: the title rails, where your
   PUMBILITY comes from, and your top 50 with the pool curve at its head
   (docs/design/pumbility-overhaul.md D45, D57, D58). The fifty came back here in round nine —
   this page holds what you hold, Play holds what is projected — so nothing on them is a peers'
   number; the one comparison against your peers, by type and by level, sits inside the
   breakdown band. The old route still resolves — a second @page, not a redirect, because nothing
   about the page is canonical to a crawler: it is signed-in only. *@

<PumbilitySectionFrame Active="breakdown">
    <Body Context="ctx">
        @if (ctx.Page.Rails is { Count: > 0 })
        {
            <section class="pmb-block">
                <div class="pmb-block-head">
                    <h2 class="pmb-block-title">@L["Your PUMBILITY titles"]</h2>
                </div>
                <p class="pmb-block-lede">
                    @L["Each rung asks a flat value of every one of your fifty charts. Switch pools above to see the other ladders."]
                </p>
                <PumbilityTitleRails Rails="ctx.Page.Rails"></PumbilityTitleRails>
            </section>
        }

        <section class="pmb-block">
            <PumbilityBreakdown Breakdown="ctx.Page.Breakdown" PoolCount="ctx.Page.Pool.Count"
                                Page="ctx.Page" Charts="ctx.Charts"></PumbilityBreakdown>
        </section>

        <PumbilityPoolSection Page="ctx.Page" Charts="ctx.Charts"
                              ToDos="_todos" OnToDo="ToggleToDo" OnOpen="ShowChartDetails" OnPlay="PlayChart"
                              OnOpenBoard="@(r => OpenBoard(r, ctx.Charts))"></PumbilityPoolSection>

        @* AutoPlay is bound rather than fixed: the card's play button and its jacket open the
           same dialog, and only one of them asked for the video. The board opens on the World,
           these being your own charts — unless a popover line asked for its own source's board,
           which is the one thing on these rows that names a peer group (D63). *@
        <ChartDetailsDialog @bind-Visible="_detailsOpen" Chart="_detailsChart" Mix="ctx.Mix"
                            AutoPlay="_detailsAutoPlay"
                            BoardScope="@(_detailsBoardScope ?? ChartLeaderboardScopes.LeaderboardScope.World)"
                            BoardCommunity="_detailsBoardCommunity" InitialTab="_detailsTab"
                            IsToDo="_detailsChart != null && _todos.Contains(_detailsChart.Id)"
                            OnToDo="ToggleToDo"></ChartDetailsDialog>
    </Body>
</PumbilitySectionFrame>

@code {
    private Chart? _detailsChart;
    private bool _detailsOpen;
    private bool _detailsAutoPlay;

    private readonly ISet<Guid> _todos = new HashSet<Guid>();

    protected override async Task OnInitializedAsync()
    {
        foreach (var saved in (await Mediator.Send(new GetSavedChartsQuery()))
                 .Where(c => c.ListType == ChartListType.ToDo))
            _todos.Add(saved.ChartId);
    }

    private void ShowChartDetails(Chart chart)
    {
        _detailsChart = chart;
        _detailsAutoPlay = false;
        Plain();
        _detailsOpen = true;
    }

    private void PlayChart(Chart chart)
    {
        _detailsChart = chart;
        _detailsAutoPlay = true;
        Plain();
        _detailsOpen = true;
    }

    /// <summary>Forgets the last board request, so opening a card plainly is a plain open.</summary>
    private void Plain()
    {
        _detailsBoardScope = null;
        _detailsBoardCommunity = null;
        _detailsTab = null;
    }

    /// <summary>The board the dialog opens on: a popover line’s, until the next plain open.</summary>
    private ChartLeaderboardScopes.LeaderboardScope? _detailsBoardScope;

    private Name? _detailsBoardCommunity;

    /// <summary>Null lets the dialog open on the tab the player remembers; a board request forces Leaderboard.</summary>
    private ChartDetailsDialog.DetailsTab? _detailsTab;

    /// <summary>
    ///     A card’s popover asked for one source’s board (peers-abstraction.md D12): details, on
    ///     that scope, on the Leaderboard tab whatever tab the player last left it on.
    /// </summary>
    private void OpenBoard(PeerBoardRequest request, IReadOnlyDictionary<Guid, Chart> charts)
    {
        if (!charts.TryGetValue(request.ChartId, out var chart)) return;
        _detailsChart = chart;
        _detailsAutoPlay = false;
        _detailsBoardScope = request.Scope;
        _detailsBoardCommunity = request.Community;
        _detailsTab = ChartDetailsDialog.DetailsTab.Leaderboard;
        _detailsOpen = true;
    }

    private async Task ToggleToDo(Guid chartId)
    {
        if (_todos.Contains(chartId))
        {
            await Mediator.Send(new RemoveChartFromListCommand(ChartListType.ToDo, chartId));
            Snackbar.Add(L["Removed from ToDo List!"], Severity.Success);
            _todos.Remove(chartId);
        }
        else
        {
            await Mediator.Send(new SaveChartToListCommand(ChartListType.ToDo, chartId));
            Snackbar.Add(L["Added to ToDo List!"], Severity.Success);
            _todos.Add(chartId);
        }

        StateHasChanged();
    }
}
