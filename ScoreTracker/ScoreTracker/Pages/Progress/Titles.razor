@page "/Titles"
@rendermode RenderModes.Interactive
@using System.Globalization
@using MediatR
@using ScoreTracker.Domain.Models.Titles
@using ScoreTracker.Domain.Models.Titles.Phoenix
@using ScoreTracker.Domain.SecondaryPorts
@using Title = ScoreTracker.Domain.Models.Titles.Title
@using ScoreTracker.PlayerProgress.Contracts
@using ScoreTracker.PlayerProgress.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Contracts
@using ScoreTracker.Web.Services.Theming
<PageTitle>@L["Titles"]</PageTitle>

@* Titles are ladders — a folder tier, a skill track, a plate family, a mix's boss pair — so
   the page draws one rail per ladder rather than one row per title. See
   docs/design/titles-overhaul.md. *@

@if (_loading)
{
    <div class="title-skeleton">
        @for (var i = 0; i < 8; i++)
        {
            <div class="title-skeleton-rail"></div>
        }
    </div>
}
else
{
    @if (CurrentUser.IsLoggedIn)
    {
        <section class="title-standing">
            <div class="title-standing-id">
                <p class="title-eyebrow">@L["Your title"]</p>
                <h1 class="title-worn">@(_worn?.Name.ToString() ?? L["No title yet"])</h1>
            </div>
            <div class="title-standing-tally">
                <div class="title-tally">
                    <span class="title-tally-num">@_earned / @_total</span>
                    <span class="title-tally-of">@L["titles earned"]</span>
                </div>
                <div class="title-meter">
                    <i style="width:@(_total == 0 ? "0" : (100.0 * _earned / _total).ToString("N1", CultureInfo.InvariantCulture) + "%")"></i>
                </div>
                <div class="title-meter-legend">
                    <span>@L["{0} tracked here, {1} from the official import", _total - _official, _official]</span>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="title-anon">
            <p>@L["{0} titles, and the game shows you none of your progress.", _total]</p>
            <MudButton Href="/Login" Variant="Variant.Filled" Color="Color.Primary">@L["Log In"]</MudButton>
        </section>
    }

    <div class="title-controls">
        <MudTextField T="string" Value="_search" ValueChanged="OnSearch" DebounceInterval="200"
                      Placeholder="@L["Search a title, chart, or step artist"]"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="title-search"></MudTextField>
        <div class="title-chips">
            @foreach (var filter in Filters)
            {
                <button type="button" class="title-chip @(_filter == filter.State ? "on" : "")"
                        @onclick="() => SetFilter(filter.State)">
                    @filter.Label<span class="n">@CountFor(filter.State)</span>
                </button>
            }
        </div>
    </div>

    @foreach (var section in _sections)
    {
        var rails = VisibleRails(section);
        var oneOffs = VisibleOneOffs(section);
        if (rails.Count == 0 && oneOffs.Count == 0)
        {
            continue;
        }

        <section class="title-section">
            <div class="title-section-head">
                <h2>@SectionName(section.Section)</h2>
                <span class="title-section-count">
                    @(CurrentUser.IsLoggedIn
                        ? L["{0} of {1} earned", section.Earned, section.Total]
                        : L["{0} titles", section.Total])
                </span>
            </div>

            @if (rails.Count > 0)
            {
                <div class="@(section.Section == TitleSection.BossBreakers ? "title-rails grid" : "title-rails")">
                    @foreach (var rail in rails)
                    {
                        <div class="title-rail">
                            <div class="title-rail-name"><span>@rail.Name</span></div>
                            <div class="title-rail-track">
                                @foreach (var rung in rail.Rungs)
                                {
                                    <TitleRungPip Rung="rung" WideLabel="@WideLabelFor(rail, rung)"
                                                  Dimmed="@(!Matches(rung))" OnSelected="Select"></TitleRungPip>
                                }
                            </div>
                            <div class="title-rail-tail"><b>@rail.Earned</b> / @rail.Total</div>
                        </div>
                    }
                </div>
            }

            @if (oneOffs.Count > 0)
            {
                <div class="title-badges">
                    @foreach (var rung in oneOffs)
                    {
                        <button type="button"
                                class="title-badge @(rung.State == RungState.Earned ? "owned" : "unowned") @(rung.Official ? "official" : "") @ThemeScales.RarityClass(rung.Band)"
                                style="--band:@ThemeScales.CssVar(rung.Band)"
                                @onclick="() => Select(rung)">
                            <span class="title-badge-dot"></span>
                            <span class="title-badge-name">@rung.Title.Name</span>
                        </button>
                    }
                </div>
            }
        </section>
    }

    @if (_sections.Count > 0 && !_sections.Any(s => VisibleRails(s).Count > 0 || VisibleOneOffs(s).Count > 0))
    {
        <MudText Class="title-empty">@L["No titles match what you're looking for."]</MudText>
    }

    <TitleDetailDrawer Rung="_selected" Ladder="_selectedLadder" Mix="_currentMix"
                       IsLoggedIn="CurrentUser.IsLoggedIn" CurrentUserId="_currentUserId"
                       TrackedPlayers="_trackedPlayers" OnClosed="Deselect"></TitleDetailDrawer>
}

@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@inject IUiSettingsAccessor UiSettings
@code {
    private sealed record FilterChip(RungState? State, string Label);

    private IReadOnlyList<FilterChip> Filters => new[]
    {
        new FilterChip(null, L["All"]),
        new FilterChip(RungState.Active, L["In progress"]),
        new FilterChip(RungState.Earned, L["Earned"]),
        new FilterChip(RungState.Locked, L["Not yet"])
    };

    private MixEnum _currentMix;
    private bool _loading = true;
    private IReadOnlyList<TitleSectionRows> _sections = Array.Empty<TitleSectionRows>();
    private TitleRung? _selected;
    private IReadOnlyList<Name> _selectedLadder = Array.Empty<Name>();
    private RungState? _filter;
    private string _search = string.Empty;

    private int _total;
    private int _earned;
    private int _official;
    private int _trackedPlayers;
    private Guid? _currentUserId;
    private Title? _worn;

    protected override async Task OnInitializedAsync()
    {
        _currentMix = await UiSettings.GetSelectedMix();
        _currentUserId = CurrentUser.IsLoggedIn ? CurrentUser.User.Id : null;

        var progress = (await Mediator.Send(new GetTitleProgressQuery(_currentMix))).ToArray();
        var rarity = await Mediator.Send(new GetTitleRarityQuery(_currentMix));
        _trackedPlayers = rarity.TrackedPlayers;
        _sections = TitleRails.Build(progress, rarity);

        var rungs = _sections.SelectMany(s => s.Rails.SelectMany(r => r.Rungs).Concat(s.OneOffs)).ToArray();
        _total = rungs.Length;
        _earned = rungs.Count(r => r.State == RungState.Earned);
        _official = rungs.Count(r => r.Official);
        _worn = TitleRails.WornTitle(_sections)?.Title;

        _loading = false;
    }

    private void SetFilter(RungState? state)
    {
        _filter = state;
    }

    private void OnSearch(string value)
    {
        _search = value ?? string.Empty;
    }

    private int CountFor(RungState? state)
    {
        var all = _sections.SelectMany(s => s.Rails.SelectMany(r => r.Rungs).Concat(s.OneOffs));
        return state == null ? _total : all.Count(r => r.State == state);
    }

    private bool Matches(TitleRung rung)
    {
        if (_filter != null && rung.State != _filter) return false;
        if (string.IsNullOrWhiteSpace(_search)) return true;

        var needle = _search.Trim();
        return rung.Title.Name.ToString().Contains(needle, StringComparison.OrdinalIgnoreCase)
               || rung.Title.Description.Contains(needle, StringComparison.OrdinalIgnoreCase)
               || (rung.Title.Ladder?.ToString().Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    /// <summary>A rail survives filtering when any of its rungs does; it never renders half-empty.</summary>
    private IReadOnlyList<TitleRailRow> VisibleRails(TitleSectionRows section)
    {
        if (_filter == null && string.IsNullOrWhiteSpace(_search)) return section.Rails;
        return section.Rails.Where(r => r.Rungs.Any(Matches)).ToArray();
    }

    private IReadOnlyList<TitleRung> VisibleOneOffs(TitleSectionRows section)
    {
        if (_filter == null && string.IsNullOrWhiteSpace(_search)) return section.OneOffs;
        return section.OneOffs.Where(Matches).ToArray();
    }

    /// <summary>
    ///     A rung shows its number unless the rail is short enough that a name fits, or the
    ///     rung's own name is the point — a capstone, a plate tier, a PUMBILITY gem.
    /// </summary>
    private string? WideLabelFor(TitleRailRow rail, TitleRung rung)
    {
        if (rail.Rungs.Count > 8 && rung.Rung <= 10) return null;

        var name = rung.Title.Name.ToString();
        // "[BRACKET] EXPERT" reads as EXPERT once the rail already says BRACKET.
        var trimmed = name.Replace($"[{rail.Name}]", string.Empty).Replace(rail.Name.ToString(), string.Empty).Trim();
        if (trimmed.StartsWith('(') && trimmed.EndsWith(')')) trimmed = trimmed[1..^1];
        return string.IsNullOrWhiteSpace(trimmed) ? name : trimmed;
    }

    private string SectionName(TitleSection section) => section switch
    {
        TitleSection.Progression => _currentMix == MixEnum.Phoenix2 ? L["PUMBILITY"] : L["Progression"],
        TitleSection.Skill => L["Skill"],
        TitleSection.CoOp => L["Co-Op"],
        TitleSection.Plates => L["Plates"],
        TitleSection.BossBreakers => L["Boss breakers"],
        TitleSection.StepArtists => L["Step artists"],
        TitleSection.PlayCount => L["Play count"],
        _ => L["One-offs"]
    };

    /// <summary>
    ///     The rung opens the drawer, and its rail travels with it: the drawer needs the whole
    ///     ladder to tell who is standing on this rung from who has climbed past it.
    /// </summary>
    private void Select(TitleRung rung)
    {
        _selected = rung;
        _selectedLadder = rung.Title.Ladder == null
            ? Array.Empty<Name>()
            : _sections.SelectMany(s => s.Rails).FirstOrDefault(r => r.Name == rung.Title.Ladder.Value)
                ?.Rungs.Select(r => r.Title.Name).ToArray() ?? Array.Empty<Name>();
    }

    private void Deselect()
    {
        _selected = null;
        _selectedLadder = Array.Empty<Name>();
    }

}
