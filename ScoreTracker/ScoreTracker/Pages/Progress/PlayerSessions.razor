@using MediatR
@using ScoreTracker.Domain.Models
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.Identity.Contracts.Queries
@using ScoreTracker.Domain.Events
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.UiNotifications
@page "/Player/{UserIdParam:guid}/Sessions"
@rendermode RenderModes.Interactive
@implements IDisposable

@if (_user != null)
{
    <div class="d-flex align-center gap-3 mb-3">
        <MudAvatar>
            <MudImage Src="@_user.ProfileImage.ToString()" Alt="@_user.Name.ToString()"></MudImage>
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h5">@_user.Name — @L["Sessions"]</MudText>
            <MudText Typo="Typo.caption">@L["Your most recent session, in full"]</MudText>
        </div>
    </div>

    @if (_firstLoad)
    {
        @* Skeletons match the shape they become — never a lone spinner on a data page. *@
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" Class="mb-3"></MudSkeleton>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px"></MudSkeleton>
    }
    else if (_model.Hero == null)
    {
        <MudAlert Severity="Severity.Normal" data-testid="sessions-empty">
            @L["No sessions recorded yet."]
        </MudAlert>
    }
    else
    {
        @if (_model.SelectedSessionWasUndone)
        {
            @* A Discord card outlives the session it links to: undo deletes the journal rows.
               Saying so beats rendering the newest session as if it were the linked one. *@
            <MudAlert Severity="Severity.Info" Class="mb-3" data-testid="session-undone">
                @L["That session was undone, so it no longer exists. Showing your most recent one instead."]
            </MudAlert>
        }

        <div class="@(_busy ? "sbd-busy" : null)">
            <SessionHero Breakdown="_model.Hero" OnOpenChart="OpenChart"></SessionHero>
        </div>

        <div class="mt-4 @(_busy ? "sbd-busy" : null)">
            <SessionHistoryCards Rows="_model.History" SelectedSessionId="_model.Hero.Group.SessionId"
                                 Page="_page" PageCount="PageCount" Before="_before"
                                 OnView="ViewSession" OnPage="ChangePage" OnBefore="ChangeBefore">
            </SessionHistoryCards>
        </div>

        <MudText Typo="Typo.caption" Class="mt-2 d-block">
            @L["Score history begins with journaling (June 2026) — older plays aren't shown."]
        </MudText>

        @* The details dialogue carries the board now, so there is no dedicated leaderboard
           dialog to open. It opens on Competitive Peers because that is the cohort the row's
           score colour came from — opening there makes the colour auditable rather than
           asserted (rivals.md, session-breakdown.md). *@
        <ChartDetailsDialog @bind-Visible="_detailsOpen" Chart="_detailsChart"
                            Mix="_model.Hero.Group.Mix"
                            BoardScope="ChartLeaderboardScopes.LeaderboardScope.CompetitivePeers">
        </ChartDetailsDialog>
    }
}

@inject IMediator Mediator
@inject NavigationManager NavManager
@inject ICurrentUserAccessor CurrentUser
@inject SessionBreakdownBuilder Breakdowns
@inject IUiNotificationHub UiHub
@inject IJSRuntime JS
@code {
    // Two full rows of the desktop grid. The cards are 268px minimum inside a 1132px content
    // column, so four fit a row — a page that ends mid-row reads as a rendering fault rather
    // than the end of a page.
    private const int HistoryPageSize = 8;

    [Parameter] public Guid UserIdParam { get; set; }

    private User? _user;
    private bool _firstLoad = true;
    private bool _busy;
    private Guid? _selectedSessionId;
    private bool _detailsOpen;
    private int _page = 1;
    private DateTime? _before;
    private Chart? _detailsChart;
    private SessionsPageModel _model = new(null, Array.Empty<SessionHistoryRow>(), 0, false);

    protected override async Task OnInitializedAsync()
    {
        // Public players only: anyone else's private page redirects home; your own never does.
        // The builder's queries independently return nothing to non-owners, so this is
        // presentation rather than the guard.
        _user = await Mediator.Send(new GetUserByIdQuery(UserIdParam));
        var isOwner = CurrentUser.IsLoggedIn && CurrentUser.User.Id == UserIdParam;
        if (_user == null || (!_user.IsPublic && !isOwner))
        {
            NavManager.NavigateTo("/");
            return;
        }

        var query = System.Web.HttpUtility.ParseQueryString(NavManager.ToAbsoluteUri(NavManager.Uri).Query);
        if (Guid.TryParse(query.Get("session"), out var session)) _selectedSessionId = session;

        WatchTheImport();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _model = await Breakdowns.Build(UserIdParam, _selectedSessionId, _page, HistoryPageSize,
            Before, CancellationToken.None);
        _firstLoad = false;
        StartWatchingForCapture();
    }

    /// <summary>
    ///     How often the page asks whether capture has landed. Short enough that the card gives
    ///     way promptly, long enough that a two-minute wait is a few dozen reads rather than
    ///     hundreds — and it only ever runs for the one person watching their own fresh import.
    /// </summary>
    private static readonly TimeSpan CapturePoll = TimeSpan.FromSeconds(3);

    private CancellationTokenSource? _watch;
    private IDisposable? _importStatus;
    private bool _importRunning;

    /// <summary>
    ///     The status the import sends when it has finished writing scores. Capture runs on the
    ///     bus AFTER that, so this is where the watch's tail begins rather than where it ends.
    /// </summary>
    private const string ImportFinished = "Charts finished saving";

    /// <summary>
    ///     An import is the reason this page has anything to wait for, so it is what the watch
    ///     should follow — not a fixed window guessed from when scores last landed. A long import
    ///     writes in phases minutes apart, and every phase pushes a status the shell's pulse dot
    ///     already listens to; a window anchored on the last write closed between two of them and
    ///     left the page stranded on a half-captured session.
    ///     <para>
    ///         Only the owner's own page subscribes: the topic is per-user, and nobody else's
    ///         import has anything to say about this one.
    ///     </para>
    /// </summary>
    private void WatchTheImport()
    {
        if (!CurrentUser.IsLoggedIn || CurrentUser.User.Id != UserIdParam) return;

        _importStatus = UiHub.Subscribe<ImportStatusUpdatedEvent>(UiTopics.User(UserIdParam), status =>
        {
            _importRunning = status.Status != ImportFinished;
            // A status arriving after the watch gave up restarts it — which is the case the
            // three-refresh dance was really reporting.
            return InvokeAsync(StartWatchingForCapture);
        });
    }

    /// <summary>
    ///     Capture lands on the bus behind the import, so a page opened right after one is
    ///     watching a session that is still being written.
    ///     <para>
    ///         Gated on the WINDOW, not on the card. Capture writes in several passes, so a page
    ///         that opens between two of them already has rows — no card — and would otherwise
    ///         sit on half a session until someone reloaded by hand. That was the bug: the
    ///         watcher only started when there was nothing at all, which is the one case where a
    ///         reload was obviously needed and the least likely one to be hit.
    ///     </para>
    /// </summary>
    private void StartWatchingForCapture()
    {
        if ((_model.Hero?.CaptureWindowOpen != true && !_importRunning) || _watch != null) return;

        var cts = new CancellationTokenSource();
        _watch = cts;
        _ = WatchForCapture(cts);
    }

    private async Task WatchForCapture(CancellationTokenSource cts)
    {
        // Refresh until the window closes, and NOT a moment sooner on a guess about being
        // finished. An import is many batches over minutes, each running capture separately, so
        // the row count sitting still for a few seconds means "between batches" just as readily
        // as "done" — reading it as done is what cleared the page while more was still coming.
        //
        // The window needs no such guess because it hangs off LastActivityAt, which advances
        // every time a batch lands: a live import keeps extending its own deadline, and the
        // watch outlives the last batch by the window and then stops.
        try
        {
            using var timer = new PeriodicTimer(CapturePoll);
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                // Build, not Reselect, when the reader has not chosen a session. Reselect is
                // PINNED to the id it is given, so an import that opens a newer session left the
                // watch re-reading the old one forever while a manual reload moved on — which is
                // exactly why refreshing by hand showed something the auto-refresh never did.
                var refreshed = await Breakdowns.Build(UserIdParam, _selectedSessionId, _page,
                    HistoryPageSize, Before, cts.Token);
                await InvokeAsync(() =>
                {
                    _model = refreshed;
                    StateHasChanged();
                });
                if (refreshed.Hero?.CaptureWindowOpen != true && !_importRunning) break;
            }
        }
        catch (Exception) when (cts.IsCancellationRequested)
        {
            // Navigated away mid-read. A cancelled SqlCommand does not always surface as an
            // OperationCanceledException, so the token is what decides this is expected —
            // filtering on the exception type would let a real failure through as a silent stop.
        }
        finally
        {
            if (ReferenceEquals(_watch, cts)) _watch = null;
            cts.Dispose();
        }
    }

    public void Dispose()
    {
        _importStatus?.Dispose();
        _watch?.Cancel();
    }

    /// <summary>
    ///     The picker is a date; the filter is an instant. Take the START of the chosen day so
    ///     "before the 5th" excludes the 5th rather than half of it.
    /// </summary>
    private DateTimeOffset? Before => _before?.ToUniversalTime();

    /// <summary>
    ///     Runs a targeted rebuild without tearing the page down. Skeletons belong to the first
    ///     load only — swapping the whole page for them on a filter change is what made these
    ///     interactions feel like navigation on a page that never navigates.
    /// </summary>
    private async Task Refresh(Func<Task<SessionsPageModel>> rebuild)
    {
        _busy = true;
        try
        {
            _model = await rebuild();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    ///     Promotes a session into the hero and rewrites the URL in place. Deliberately not a
    ///     NavigateTo: programmatic navigation on the static router triggers an enhanced reload,
    ///     which is a flake this codebase has been bitten by. The link still has to work as a
    ///     real deep link, which is why the query parameter is what changes.
    /// </summary>
    private async Task ViewSession(Guid sessionId)
    {
        _selectedSessionId = sessionId;
        // Only the hero changes — the cards are the same cards, one of them now highlighted.
        await Refresh(() => Breakdowns.Reselect(_model, UserIdParam, sessionId, _page, HistoryPageSize,
            Before, CancellationToken.None));
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri).GetLeftPart(UriPartial.Path);
        await JS.InvokeVoidAsync("history.replaceState", null, string.Empty, $"{uri}?session={sessionId}");
    }

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_model.TotalGroups / (double)HistoryPageSize));

    private async Task ChangePage(int page)
    {
        _page = page;
        // Only the grid changes; the hero is not what you paged.
        await Refresh(() => Breakdowns.Refilter(_model, UserIdParam, _page, HistoryPageSize, Before,
            CancellationToken.None));
    }

    private async Task ChangeBefore(DateTime? before)
    {
        _before = before;
        // A filter change invalidates the page number — page 3 of the old list is not page 3
        // of the new one.
        _page = 1;
        await Refresh(() => Breakdowns.Refilter(_model, UserIdParam, _page, HistoryPageSize, Before,
            CancellationToken.None));
    }

    private void OpenChart(Chart chart)
    {
        _detailsChart = chart;
        _detailsOpen = true;
    }
}
