@using MediatR
@using ScoreTracker.Domain.Models
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Identity.Contracts.Queries
@using ScoreTracker.PlayerProgress.Contracts.Events
@using ScoreTracker.ScoreLedger.Contracts
@using ScoreTracker.EventCompetition.Contracts
@using ScoreTracker.EventCompetition.Contracts.Queries
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.UiNotifications
@page "/Player/{UserIdParam:guid}/Sessions"
@rendermode RenderModes.Interactive
@implements IDisposable

@if (_user != null)
{
    <div class="d-flex align-center gap-3 mb-3">
        <MudAvatar>
            <MudImage Src="@_user.ProfileImage.ToString()" Alt="@_user.Name.ToString()"></MudImage>
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h5">@_user.Name — @L["Sessions"]</MudText>
            <MudText Typo="Typo.caption">@L["Your most recent session, in full"]</MudText>
        </div>
    </div>

    @if (_firstLoad)
    {
        @* Skeletons match the shape they become — never a lone spinner on a data page. *@
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" Class="mb-3"></MudSkeleton>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px"></MudSkeleton>
    }
    else if (_model.Hero == null)
    {
        <MudAlert Severity="Severity.Normal" data-testid="sessions-empty">
            @L["No sessions recorded yet."]
        </MudAlert>
    }
    else
    {
        @if (_model.SelectedSessionWasUndone)
        {
            @* A Discord card outlives the session it links to: undo deletes the journal rows.
               Saying so beats rendering the newest session as if it were the linked one. *@
            <MudAlert Severity="Severity.Info" Class="mb-3" data-testid="session-undone">
                @L["That session was undone, so it no longer exists. Showing your most recent one instead."]
            </MudAlert>
        }

        <div class="@(_busy ? "sbd-busy" : null)">
            <SessionHero Breakdown="_model.Hero" OnOpenChart="OpenChart" MoM="_momOnRamp"
                         OnOpenBreakdown="OpenBreakdown" OnOpenBoard="OpenBoard"></SessionHero>
        </div>

        <div class="mt-4 @(_busy ? "sbd-busy" : null)">
            <SessionHistoryCards Rows="_model.History" SelectedSessionId="_model.Hero.Group.SessionId"
                                 Page="_page" PageCount="PageCount" Before="_before"
                                 OnView="ViewSession" OnPage="ChangePage" OnBefore="ChangeBefore">
            </SessionHistoryCards>
        </div>

        <MudText Typo="Typo.caption" Class="mt-2 d-block">
            @L["Score history begins with journaling (June 2026) — older plays aren't shown."]
        </MudText>

        @* The details dialogue carries the board now, so there is no dedicated leaderboard
           dialog to open. A row's name opens it on Competitive Peers, the default cohort; a
           popover source line opens it on that source's own board, which is what makes a score's
           color auditable rather than asserted (peers-abstraction.md D12). *@
        <ChartDetailsDialog @bind-Visible="_detailsOpen" Chart="_detailsChart"
                            Mix="_model.Hero.Group.Mix"
                            BoardScope="_boardScope" BoardCommunity="_boardCommunity" BoardSubject="UserIdParam"
                            InitialTab="_boardTab">
        </ChartDetailsDialog>

        @* The play's own story — tapped in from a judgement strip. The identity comes off the
           journal row (the site's play date, the row's own source), never off the session. *@
        <ScoreBreakdownDialog @bind-Visible="_breakdownOpen" Chart="_breakdownScore?.Chart"
                              Mix="_model.Hero.Group.Mix"
                              Score="_breakdownScore?.Row.Score"
                              Plate="PhoenixPlateHelperMethods.TryParse(_breakdownScore?.Row.Plate)"
                              IsBroken="_breakdownScore?.Row.IsBroken ?? false"
                              Judgements="_breakdownScore?.Row.Judgements"
                              PlayedAt="_breakdownScore?.Row.OccurredAt"
                              SourceLabel="@(_breakdownScore == null ? null : SourceLabel(_breakdownScore.Row.Source))">
        </ScoreBreakdownDialog>
    }
}

@inject IMediator Mediator
@inject NavigationManager NavManager
@inject ICurrentUserAccessor CurrentUser
@inject SessionBreakdownBuilder Breakdowns
@inject IUiNotificationHub UiHub
@inject IJSRuntime JS
@code {
    // Two full rows of the desktop grid. The cards are 268px minimum inside a 1132px content
    // column, so four fit a row — a page that ends mid-row reads as a rendering fault rather
    // than the end of a page.
    private const int HistoryPageSize = 8;

    [Parameter] public Guid UserIdParam { get; set; }

    private User? _user;
    private bool _firstLoad = true;
    private bool _busy;
    private Guid? _selectedSessionId;
    private bool _detailsOpen;
    private int _page = 1;
    private DateTime? _before;
    private Chart? _detailsChart;
    private SessionsPageModel _model = new(null, Array.Empty<SessionHistoryRow>(), 0, false);
    private MoMOnRamp? _momOnRamp;

    protected override async Task OnInitializedAsync()
    {
        // Public players only: anyone else's private page redirects home; your own never does.
        // The builder's queries independently return nothing to non-owners, so this is
        // presentation rather than the guard.
        _user = await Mediator.Send(new GetUserByIdQuery(UserIdParam));
        var isOwner = CurrentUser.IsLoggedIn && CurrentUser.User.Id == UserIdParam;
        if (_user == null || (!_user.IsPublic && !isOwner))
        {
            NavManager.NavigateTo("/");
            return;
        }

        var query = System.Web.HttpUtility.ParseQueryString(NavManager.ToAbsoluteUri(NavManager.Uri).Query);
        if (Guid.TryParse(query.Get("session"), out var session)) _selectedSessionId = session;

        ListenForCapture();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _model = await Breakdowns.Build(UserIdParam, _selectedSessionId, _page, HistoryPageSize,
            Before, CancellationToken.None);
        _firstLoad = false;
        await LoadMoMAsync();
    }

    /// <summary>
    ///     What March of Murlocs makes of the session on show (D32). Your own page only: the
    ///     on-ramp is an offer to record your own play, and a visitor has nothing to do with it.
    /// </summary>
    private async Task LoadMoMAsync()
    {
        _momOnRamp = null;
        if (_model.Hero is not { } hero) return;
        if (!CurrentUser.IsLoggedIn || CurrentUser.User.Id != UserIdParam) return;

        _momOnRamp = await Mediator.Send(new DetectMoMSessionQuery(UserIdParam, hero.Group.Mix,
            hero.Group.Start, hero.Group.End));
    }

    private IDisposable? _captured;

    /// <summary>
    ///     Capture announces itself when it finishes, so the page listens instead of asking.
    ///     <para>
    ///         Polling could never work here, and the reason is worth keeping: scores are held as
    ///         a batch for two minutes past the LAST of them before capture even begins
    ///         (<see cref="ScoreBatchPolicy" />), an import writes in phases minutes apart, and
    ///         each phase is a separate batch and a separate capture. Every timer aimed at that
    ///         was guessing at another component's schedule, and each guess failed differently —
    ///         clearing the card mid-pipeline, between batches, or never watching at all.
    ///     </para>
    ///     <para>
    ///         Same shape as the randomizer's draw view: a bus consumer bridges the event onto
    ///         the user's UI topic and whichever circuit cares picks it up. Delivery is
    ///         best-effort by design — a player who was not on the page simply never receives it
    ///         and reads the finished article when they arrive.
    ///     </para>
    /// </summary>
    private void ListenForCapture()
    {
        if (!CurrentUser.IsLoggedIn || CurrentUser.User.Id != UserIdParam) return;

        _captured = UiHub.Subscribe<ScoreHighlightsCapturedEvent>(UiTopics.User(UserIdParam), async _ =>
        {
            // Build, not Reselect: Reselect is PINNED to the id it is handed, so a capture for a
            // newer session would refresh the older one forever. Build takes the newest, which
            // is what the hero means when the reader has not chosen one.
            var refreshed = await Breakdowns.Build(UserIdParam, _selectedSessionId, _page,
                HistoryPageSize, Before, CancellationToken.None);
            await InvokeAsync(() =>
            {
                _model = refreshed;
                StateHasChanged();
            });
        });
    }

    public void Dispose()
    {
        _captured?.Dispose();
    }

    /// <summary>
    ///     The picker is a date; the filter is an instant. Take the START of the chosen day so
    ///     "before the 5th" excludes the 5th rather than half of it.
    /// </summary>
    private DateTimeOffset? Before => _before?.ToUniversalTime();

    /// <summary>
    ///     Runs a targeted rebuild without tearing the page down. Skeletons belong to the first
    ///     load only — swapping the whole page for them on a filter change is what made these
    ///     interactions feel like navigation on a page that never navigates.
    /// </summary>
    private async Task Refresh(Func<Task<SessionsPageModel>> rebuild)
    {
        _busy = true;
        try
        {
            _model = await rebuild();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    ///     Promotes a session into the hero and rewrites the URL in place. Deliberately not a
    ///     NavigateTo: programmatic navigation on the static router triggers an enhanced reload,
    ///     which is a flake this codebase has been bitten by. The link still has to work as a
    ///     real deep link, which is why the query parameter is what changes.
    /// </summary>
    private async Task ViewSession(Guid sessionId)
    {
        _selectedSessionId = sessionId;
        // Only the hero changes — the cards are the same cards, one of them now highlighted.
        await Refresh(() => Breakdowns.Reselect(_model, UserIdParam, sessionId, _page, HistoryPageSize,
            Before, CancellationToken.None));
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri).GetLeftPart(UriPartial.Path);
        await JS.InvokeVoidAsync("history.replaceState", null, string.Empty, $"{uri}?session={sessionId}");
    }

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_model.TotalGroups / (double)HistoryPageSize));

    private async Task ChangePage(int page)
    {
        _page = page;
        // Only the grid changes; the hero is not what you paged.
        await Refresh(() => Breakdowns.Refilter(_model, UserIdParam, _page, HistoryPageSize, Before,
            CancellationToken.None));
    }

    private async Task ChangeBefore(DateTime? before)
    {
        _before = before;
        // A filter change invalidates the page number — page 3 of the old list is not page 3
        // of the new one.
        _page = 1;
        await Refresh(() => Breakdowns.Refilter(_model, UserIdParam, _page, HistoryPageSize, Before,
            CancellationToken.None));
    }

    private ChartLeaderboardScopes.LeaderboardScope _boardScope = ChartLeaderboardScopes.LeaderboardScope.CompetitivePeers;
    private Name? _boardCommunity;
    /// <summary>Null lets the dialog open on the tab the player remembers; a board request forces Leaderboard.</summary>
    private ChartDetailsDialog.DetailsTab? _boardTab;

    private void OpenChart(Chart chart)
    {
        _boardScope = ChartLeaderboardScopes.LeaderboardScope.CompetitivePeers;
        _boardCommunity = null;
        _boardTab = null;
        _detailsChart = chart;
        _detailsOpen = true;
    }

    private void OpenBoard(PeerBoardRequest request)
    {
        if (_model.Hero == null || !_model.Hero.Charts.TryGetValue(request.ChartId, out var chart)) return;
        _boardScope = request.Scope;
        _boardCommunity = request.Community;
        _boardTab = ChartDetailsDialog.DetailsTab.Leaderboard;
        _detailsChart = chart;
        _detailsOpen = true;
    }

    private bool _breakdownOpen;
    private SessionScore? _breakdownScore;

    private void OpenBreakdown(SessionScore score)
    {
        _breakdownScore = score;
        _breakdownOpen = true;
    }

    /// <summary>
    ///     The row's own acquisition channel, in the hero header's words — a play's dialog can
    ///     say "CSV Upload" inside a session the header calls an Official Import.
    /// </summary>
    private string SourceLabel(string source)
    {
        return source switch
        {
            "officialImport" => L["Official Import"],
            "csv" => L["CSV Upload"],
            "backfill" => L["Backfill"],
            _ => L["Play Session"]
        };
    }
}
