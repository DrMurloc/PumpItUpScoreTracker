@using MediatR
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.Domain.Services
@using ScoreTracker.PlayerProgress.Contracts
@using ScoreTracker.PlayerProgress.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Enums
@using ScoreTracker.Web.Services.Contracts
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@page "/Pumbility"
@rendermode RenderModes.Interactive

@* The page answers "what should I grind" and has to define the question before it answers
   it: the number, then the bar it has to beat, then what to play. The eight rating bands
   this replaced ranked your pool against itself and never said what for
   (docs/design/pumbility-overhaul.md §3). *@

<PageTitle>@L["PUMBILITY"]</PageTitle>

<p class="pmb-eyebrow">@MixName · @L["PUMBILITY"]</p>

@if (_page == null)
{
    @* Rule 9: a skeleton shaped like what it becomes, never a lone spinner. *@
    <div class="pmb-hero">
        <div class="pmb-skeleton pmb-skeleton-figure"></div>
        <div class="pmb-skeleton pmb-skeleton-curve"></div>
    </div>
}
else
{
    <div class="pmb-hero">
        <PumbilityHero Page="_page" Charts="_charts" Pools="_pools" Selected="_pool"
                       Subtitle="@HeroSubtitle" OnPoolChanged="ChangePool"></PumbilityHero>
        <PoolCurve Page="_page" Charts="_charts"></PoolCurve>
    </div>

    @if (_carryover != null)
    {
        <section class="pmb-block">
            <div class="pmb-block-head">
                <h2 class="pmb-block-title">@L["What Phoenix 1 is worth here"]</h2>
            </div>
            <p class="pmb-block-lede">
                @string.Format(L["You have {0} scores in Phoenix 2. This is your Phoenix 1 record priced under Phoenix 2's rules — what your pool becomes if you re-clear everything to the same standard."], _carryover.ScoredHere)
            </p>
            <CarryoverPanel Carryover="_carryover" Charts="_charts"></CarryoverPanel>
        </section>
    }

    <section class="pmb-block">
        <div class="pmb-block-head">
            <h2 class="pmb-block-title">@L["What to play next"]</h2>
            <div class="pmb-densitybar" role="group" aria-label="@L["Density"]">
                <button type="button" aria-pressed="@Pressed(UiDensity.Comfortable)"
                        @onclick="() => SetDensity(UiDensity.Comfortable)">@L["Comfortable"]</button>
                <button type="button" aria-pressed="@Pressed(UiDensity.Compact)"
                        @onclick="() => SetDensity(UiDensity.Compact)">@L["Compact"]</button>
                <button type="button" aria-pressed="@Pressed(UiDensity.Table)"
                        @onclick="() => SetDensity(UiDensity.Table)">@L["Table"]</button>
            </div>
        </div>
        <p class="pmb-block-lede">
            @L["Ranked by what each would add if you played it to the standard players at your level reach. Everything here clears your bar."]
        </p>

        @if (_projecting)
        {
            <div class="pmb-skeleton pmb-skeleton-targets"></div>
        }
        else
        {
            <TargetList Targets="_page.Targets" Charts="_charts" Density="_density" Mix="_currentMix"
                        OnOpen="ShowChartDetails"></TargetList>
        }
    </section>

    <details class="pmb-fold">
        <summary>
            <h3>@L["Your top 50"]</h3>
            <span class="pmb-sum-note">@L["The charts your PUMBILITY is made of"]</span>
        </summary>
        <div class="pmb-fold-body">
            <PoolBoard Page="_page" Charts="_charts" OnOpen="ShowChartDetails"></PoolBoard>
        </div>
    </details>

    <details class="pmb-fold">
        <summary>
            <h3>@L["What would a clear be worth?"]</h3>
            <span class="pmb-sum-note">@L["Try a level and a grade"]</span>
        </summary>
        <div class="pmb-fold-body">
            <div class="pmb-whatif">
                <div class="pmb-field">
                    <label for="wi-level">@L["Difficulty Level"]</label>
                    <MudNumericField id="wi-level" T="int" Min="1" Max="DifficultyLevel.Max" Value="_whatIfLevel"
                                     ValueChanged="l => Recalculate(l, _whatIfType, _whatIfNew, _whatIfOld)"></MudNumericField>
                </div>
                <div class="pmb-field">
                    <label for="wi-type">@L["Type"]</label>
                    <MudSelect id="wi-type" T="ChartType" Value="_whatIfType"
                               ValueChanged="t => Recalculate(_whatIfLevel, t, _whatIfNew, _whatIfOld)">
                        <MudSelectItem T="ChartType" Value="ChartType.Single">@L["Singles"]</MudSelectItem>
                        <MudSelectItem T="ChartType" Value="ChartType.Double">@L["Doubles"]</MudSelectItem>
                    </MudSelect>
                </div>
                <div class="pmb-field">
                    <label>@L["Old Letter Grade"]</label>
                    <MudSelect T="PhoenixLetterGrade?" Clearable="true" Value="_whatIfOld"
                               ValueChanged="g => Recalculate(_whatIfLevel, _whatIfType, _whatIfNew, g)">
                        @foreach (var grade in Enum.GetValues<PhoenixLetterGrade>())
                        {
                            <MudSelectItem T="PhoenixLetterGrade?" Value="grade">
                                <LetterGradeIcon Grade="grade"></LetterGradeIcon>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="pmb-field">
                    <label>@L["New Letter Grade"]</label>
                    <MudSelect T="PhoenixLetterGrade" Value="_whatIfNew"
                               ValueChanged="g => Recalculate(_whatIfLevel, _whatIfType, g, _whatIfOld)">
                        @foreach (var grade in Enum.GetValues<PhoenixLetterGrade>())
                        {
                            <MudSelectItem T="PhoenixLetterGrade" Value="grade">
                                <LetterGradeIcon Grade="grade"></LetterGradeIcon>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="pmb-whatif-out">
                    +@_whatIfGain.ToString("N0")
                    <small>@(_whatIfGain <= 0 ? L["this would not clear your bar"] : L["added to your PUMBILITY"])</small>
                </div>
            </div>
        </div>
    </details>
}

<ChartDetailsDialog @bind-Visible="_detailsOpen" Chart="_detailsChart" Mix="_currentMix"></ChartDetailsDialog>

@inject IMediator Mediator
@inject NavigationManager NavManager
@inject ICurrentUserAccessor CurrentUser
@inject IUiSettingsAccessor UiSettings

@code {
    private const string DensitySettingKey = "Density__Pumbility";

    // PUMBILITY is a Phoenix-lineage stat — XX viewers keep seeing Phoenix, as before.
    private MixEnum _currentMix = MixEnum.Phoenix;

    private PumbilityPageRecord? _page;
    private Phoenix2CarryoverRecord? _carryover;
    private IReadOnlyDictionary<Guid, Chart> _charts = new Dictionary<Guid, Chart>();
    private IReadOnlyList<PumbilityHero.PoolOption> _pools = Array.Empty<PumbilityHero.PoolOption>();
    private ChartType? _pool;
    private UiDensity _density = UiDensity.Comfortable;
    private bool _projecting;

    private Chart? _detailsChart;
    private bool _detailsOpen;

    private DifficultyLevel _whatIfLevel = 18;
    private ChartType _whatIfType = ChartType.Single;
    private PhoenixLetterGrade _whatIfNew = PhoenixLetterGrade.AA;
    private PhoenixLetterGrade? _whatIfOld;
    private int _whatIfGain;

    private string MixName => _currentMix == MixEnum.Phoenix2 ? "Phoenix 2" : "Phoenix";

    private string? HeroSubtitle => _currentMix == MixEnum.Phoenix2 && _carryover != null
        ? string.Format(L["Projected from Phoenix 1 — you have {0} Phoenix 2 scores of your own."],
            _carryover.ScoredHere)
        : L["The sum of your 50 best-rated charts."];

    private string Pressed(UiDensity density) => _density == density ? "true" : "false";

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsLoggedIn)
        {
            NavManager.NavigateTo("/");
            return;
        }

        var selected = await UiSettings.GetSelectedMix();
        _currentMix = selected == MixEnum.XX ? MixEnum.Phoenix : selected;
        if (Enum.TryParse<UiDensity>(await UiSettings.GetSetting(DensitySettingKey), out var density))
            _density = density;

        _charts = (await Mediator.Send(new GetChartsQuery(_currentMix))).ToDictionary(c => c.Id);
        await Load();
    }

    private async Task Load()
    {
        _projecting = true;
        _page = await Mediator.Send(new GetPumbilityPageQuery(CurrentUser.User.Id, _currentMix, _pool));
        _projecting = false;

        // Phoenix 2 keeps Singles and Doubles as independent pools alongside the merged one,
        // so the selector is real there and would invent a stat on Phoenix 1.
        if (_currentMix == MixEnum.Phoenix2)
        {
            _pools = new[]
            {
                new PumbilityHero.PoolOption(null, L["All"], await TotalFor(null)),
                new PumbilityHero.PoolOption(ChartType.Single, L["Singles"], await TotalFor(ChartType.Single)),
                new PumbilityHero.PoolOption(ChartType.Double, L["Doubles"], await TotalFor(ChartType.Double))
            };
            _carryover = await Mediator.Send(new ProjectPhoenix2CarryoverQuery(CurrentUser.User.Id, _pool));
        }

        Recalculate(_whatIfLevel, _whatIfType, _whatIfNew, _whatIfOld);
    }

    private async Task<int> TotalFor(ChartType? pool)
    {
        if (pool == _pool && _page != null) return _page.Total;
        var record = await Mediator.Send(new GetPumbilityPageQuery(CurrentUser.User.Id, _currentMix, pool));
        return record.Total;
    }

    private async Task ChangePool(ChartType? pool)
    {
        if (_pool == pool) return;
        _pool = pool;
        await Load();
    }

    private async Task SetDensity(UiDensity density)
    {
        _density = density;
        await UiSettings.SetSetting(DensitySettingKey, density.ToString());
    }

    private void ShowChartDetails(Chart chart)
    {
        _detailsChart = chart;
        _detailsOpen = true;
    }

    // The what-if is a tool, not an answer, which is why it sits at the bottom. It prices
    // against the same bar everything else on the page measures from.
    private void Recalculate(DifficultyLevel level, ChartType type, PhoenixLetterGrade newGrade,
        PhoenixLetterGrade? oldGrade)
    {
        _whatIfLevel = level;
        _whatIfType = type;
        _whatIfNew = newGrade;
        _whatIfOld = oldGrade;

        var scoring = ScoringConfiguration.PumbilityScoring(_currentMix, false);
        var bar = _page?.Bar ?? 0;
        var floor = (double)bar;
        if (oldGrade != null)
            floor = Math.Max(
                scoring.GetScore(type, level, oldGrade.Value.GetMinimumScoreFor(_currentMix)), bar);

        var after = scoring.GetScore(type, level, newGrade.GetMinimumScoreFor(_currentMix));
        _whatIfGain = (int)Math.Max(0, after - floor);
    }
}
