@page "/PhoenixCalculator"
@page "/PhoenixCalculator/{MixSlug}"
@using MediatR
@using ScoreTracker.Catalog.Contracts
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.ScoreLedger.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services.Contracts
@using ScoreTracker.Web.Services.ScoreCalculator
@inject IMediator Mediator
@inject IUiSettingsAccessor UiSettings
@inject NavigationManager Nav
@inject ICurrentUserAccessor CurrentUser

@* The Phoenix score page (docs/design/phoenix-score-calculator.md). Static SSR — no
   @rendermode — so the formula, the costs, both mixes' letter cutoffs and the measured
   sections are real HTML a crawler reads; the head is StaticHeadResolver's, keyed off the
   route. What moves (the live calculator, its bars and next-letter walk, the plays dialog,
   the toggles and chart tooltips) is phoenix-calculator.js working on this markup and on
   the constants block the model emits from the engine. One URL per mix; the bare route —
   the pre-rebuild URL — serves the viewer's mix. *@

@if (_model != null)
{
    <div class="sc-page" data-sc-page data-sc-mix="@_model.Mix">
        <header class="sc-hero">
            <div>
                <div class="sc-eyebrow">
                    <span>@L["Scoring"]</span><span class="sc-sep">/</span><span class="sc-mix">@_model.Mix.GetName()</span>
                    <span class="sc-sep">·</span><a href="@ScoreCalculatorMixes.PathFor(_model.OtherMix)">@_model.OtherMix.GetName() →</a>
                    <span class="sc-sep">·</span><a href="@Services.PumbilityCalculator.PumbilityCalculatorMixes.PathFor(_model.Mix)">@L["PUMBILITY Calculator"] →</a>
                </div>
                <h1 class="sc-h1"><span>Phoenix</span> @L["Score Calculator"]</h1>
                <p class="sc-lede">
                    @L["Every Pump It Up Phoenix score is judgement-weighted accuracy out of 1,000,000 — half a percent of it is combo."]
                    @if (_model.Mix == MixEnum.Phoenix2)
                    {
                        @L["Phoenix and Phoenix 2 score a play identically; Phoenix 2 changed what the letters below AAA demand."]
                    }
                    else
                    {
                        @L["Phoenix and Phoenix 2 score a play identically; this page reads the original letter table."]
                    }
                    <span class="sc-muted">@L["This page is the formula, what each judgement costs, the letter cutoffs, and what real scores look like at every level."]</span>
                </p>
            </div>
        </header>

        <ScoreCalculatorCard Model="_model" IsLoggedIn="CurrentUser.IsLoggedIn" />
        <ScoreFormulaCard Model="_model" />
        <ScoreJudgementCosts Model="_model" />
        <ScoreGradeLadder Model="_model" />
        <ScoreGradeSpreads Model="_model" />
        <ScorePopulationChart Model="_model" />
        <ScoreNoteCountChart Model="_model" />
        <ScoreHoldTicksCard Model="_model" />
    </div>
}

@code {
    [Parameter] public string? MixSlug { get; set; }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private ScoreCalculatorModel? _model;

    protected override async Task OnParametersSetAsync()
    {
        MixEnum mix;
        if (MixSlug != null)
        {
            // Only mixes scored by the Phoenix formula have a page; anything else is a real 404.
            if (!ChartSlugs.TryParseMixSlug(MixSlug, out mix) || !ScoreCalculatorMixes.All.Contains(mix))
            {
                _model = null;
                Nav.NotFound();
                return;
            }
        }
        else
        {
            // The bare route serves the viewer's mix; a mix without Phoenix scoring falls back
            // to the newest one that has it.
            var selected = await UiSettings.GetSelectedMix();
            mix = ScoreCalculatorMixes.All.Contains(selected) ? selected : ScoreCalculatorMixes.All[0];
        }

        var cancellation = HttpContext?.RequestAborted ?? default;
        var charts = await Mediator.Send(new GetChartsQuery(mix), cancellation);
        // Phoenix 2's note counts refill from play; unobserved charts read their Phoenix count
        // (owner ruling, no disclaimer — see the design doc's D10).
        var fallback = mix == MixEnum.Phoenix
            ? Array.Empty<Chart>().AsEnumerable()
            : await Mediator.Send(new GetChartsQuery(MixEnum.Phoenix), cancellation);
        var population = await Mediator.Send(new GetScorePopulationQuery(mix), cancellation);
        var spreads = await Mediator.Send(new GetJudgementSpreadsQuery(mix), cancellation);
        var holds = await Mediator.Send(new GetHoldTickProfileQuery(mix), cancellation);
        _model = ScoreCalculatorModel.For(mix, charts, fallback, population, spreads, holds);
    }
}
