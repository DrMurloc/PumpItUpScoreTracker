@page "/MixChanges"
@page "/MixChanges/{FromSlug}/{ToSlug}"
@rendermode RenderModes.Interactive
@using MediatR
@using ScoreTracker.Catalog.Contracts
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Contracts
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType

<PageTitle>@L["Mix Changes"]</PageTitle>

@* The mix diff. Any two mixes, not just XX to Phoenix: a chart keeps its identity across
   mixes, so the same three questions — what arrived, what left, what changed level — answer
   for every pair the catalog knows. The pair is URL state so an answer is linkable; the
   folder and the filters below are presentation and stay in the circuit. *@

<div class="mc">
    <div class="mc-head">
        <div>
            <MudText Typo="Typo.h4" Class="mc-title">@L["Mix Changes"]</MudText>
            <MudText Typo="Typo.body2" Class="mc-sub">
                @L["Every chart that moved, arrived, or left between {0} and {1}.", _from.GetName(), _to.GetName()]
            </MudText>
        </div>
        <div class="mc-mixpair">
            <MudSelect T="MixEnum" Value="_from" ValueChanged="SetFrom" Label="@L["From"]" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mc-mixsel">
                @foreach (var mix in Mixes)
                {
                    <MudSelectItem T="MixEnum" Value="@mix">@mix.GetName()</MudSelectItem>
                }
            </MudSelect>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="mc-tween"></MudIcon>
            <MudSelect T="MixEnum" Value="_to" ValueChanged="SetTo" Label="@L["To"]" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mc-mixsel mc-mixsel-to">
                @foreach (var mix in Mixes)
                {
                    <MudSelectItem T="MixEnum" Value="@mix">@mix.GetName()</MudSelectItem>
                }
            </MudSelect>
            <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" OnClick="Swap" Size="Size.Small"
                           Title="@L["Swap direction"]" aria-label="@L["Swap direction"]"></MudIconButton>
        </div>
    </div>

    @* The page's job: one field, above the fold, answering in a sentence. The shell's own
       chart search, fed both catalogs — a song that left is not in the later mix's list, and
       a rerated chart is findable under either its old or its new difficulty. *@
    <div class="mc-lookup">
        <SongSelector Songs="_lookupSongs" Label=""
                      Placeholder="@L["Find a song — e.g. Iolite Sky"].Value"
                      SongSelected="AnswerForSong"></SongSelector>
        @if (_answer != null)
        {
            <MixChangesAnswer Answer="_answer" From="_from" To="_to"></MixChangesAnswer>
        }
        else
        {
            @* Says what the field covers, so a song that returns nothing reads as an answer
               rather than a dead end. *@
            <div class="mc-hint">@L["Only songs with a changed chart are listed."]</div>
        }
    </div>

    @if (_loading)
    {
        <MudSkeleton Height="52px" SkeletonType="SkeletonType.Rectangle"></MudSkeleton>
        <MudSkeleton Height="320px" SkeletonType="SkeletonType.Rectangle"></MudSkeleton>
    }
    else if (_from == _to)
    {
        <div class="mc-empty">@L["Pick two different mixes."]</div>
    }
    else if (_diff.IsEmpty)
    {
        <div class="mc-empty">@L["Nothing changed between these two mixes."]</div>
    }
    else
    {
        @* aria-* values are written as strings, not bools: Blazor renders a bool-valued
           attribute as a boolean attribute (present-and-empty, or absent), which the
           [aria-pressed="true"] selectors these controls are styled by cannot match. *@
        <div class="mc-tabs" role="tablist">
            <button type="button" role="tab" class="mc-tab" aria-selected="@Aria(_tab == Tab.Rerated)"
                    @onclick="() => SetTab(Tab.Rerated)">
                <span>@L["Re-rated"]</span><span class="mc-tab-n">@_diff.Rerated.Count</span>
            </button>
            <button type="button" role="tab" class="mc-tab" aria-selected="@Aria(_tab == Tab.Arrived)"
                    @onclick="() => SetTab(Tab.Arrived)">
                <span>@L["Arrived"]</span><span class="mc-tab-n">@(_diff.ArrivedSongs.Count + _diff.AddedCharts.Count)</span>
            </button>
            <button type="button" role="tab" class="mc-tab" aria-selected="@Aria(_tab == Tab.Left)"
                    @onclick="() => SetTab(Tab.Left)">
                <span>@L["Left"]</span><span class="mc-tab-n">@(_diff.DepartedSongs.Count + _diff.RemovedCharts.Count)</span>
            </button>
            @* Absent, not zero, when the pair records no note counts: a 0 would claim we
               looked. Present-and-zero when we did look and nothing moved. *@
            @if (_diff.NoteCountsTracked)
            {
                <button type="button" role="tab" class="mc-tab" aria-selected="@Aria(_tab == Tab.Restepped)"
                        @onclick="() => SetTab(Tab.Restepped)">
                    <span>@L["Note Counts"]</span><span class="mc-tab-n">@_diff.Restepped.Count</span>
                </button>
            }
        </div>

        <div role="tabpanel">
            @if (_tab == Tab.Rerated)
            {
                @* One folder at a time. 338 rerates across 41 folders is a scroll, not an
                   answer — and the folder is the unit players think in. Folders nothing
                   moved in or out of are disabled, so the picker doubles as a map of where
                   the mix actually churned. *@
                <div class="mc-filters">
                    <FolderPicker Type="_folder.Type" Level="_folder.Level" ShowCoOp="false"
                                  IsEnabled="HasChanges" FolderChanged="SetFolder"></FolderPicker>
                    <span class="mc-filter-sep"></span>
                    @foreach (var (dir, text) in DirectionFilters)
                    {
                        <button type="button" class="mc-chip" aria-pressed="@Aria(_direction == dir)"
                                @onclick="() => SetDirection(dir)">@L[text]</button>
                    }
                    <div class="mc-groupby">
                        <span>@L["Group by"]</span>
                        <div class="mc-seg">
                            <button type="button" aria-pressed="@Aria(!_groupByDestination)"
                                    @onclick="() => SetGrouping(false)">@L["Old folder"]</button>
                            <button type="button" aria-pressed="@Aria(_groupByDestination)"
                                    @onclick="() => SetGrouping(true)">@L["New folder"]</button>
                        </div>
                    </div>
                </div>

                <section class="mc-fgroup">
                    <div class="mc-fhead">
                        <DifficultyBubble Type="_folder.Type" Level="DifficultyLevel.From(_folder.Level)"
                                          Mix="_groupByDestination ? _to : _from" Small="true"></DifficultyBubble>
                        <span class="mc-ftitle">@L["{0} folder", _folder.Label]</span>
                        <span class="mc-fcount">
                            @(_groupByDestination
                                ? L["{0} arrived", FolderMoves.Count()]
                                : L["{0} left", FolderMoves.Count()])
                        </span>
                    </div>
                    @if (!FolderMoves.Any())
                    {
                        <div class="mc-empty">@L["Nothing matches these filters. Clear one to see the rest."]</div>
                    }
                    else
                    {
                        @foreach (var move in FolderMoves)
                        {
                            <button type="button" class="mc-row" @onclick="() => Answer(move.After)">
                                <SongImage Song="move.After.Song" Small="true"></SongImage>
                                <span class="mc-name">@move.After.Song.Name</span>
                                <span class="mc-tail">
                                    <span class="mc-was">
                                        <DifficultyBubble Chart="move.Before" Small="true"></DifficultyBubble>
                                    </span>
                                    <span class="mc-arrow">→</span>
                                    <DifficultyBubble Chart="move.After" Small="true"></DifficultyBubble>
                                    <span class="mc-delta @(move.Delta > 0 ? "mc-up" : "mc-down")">
                                        @(move.Delta > 0 ? "▲" : "▼")@Math.Abs(move.Delta)
                                    </span>
                                </span>
                            </button>
                        }
                    }
                </section>
            }
            else if (_tab == Tab.Arrived)
            {
                <MixChangesSongSheet Songs="_diff.ArrivedSongs" LooseCharts="_diff.AddedCharts"
                                     Departed="false" Mix="_to"></MixChangesSongSheet>
            }
            else if (_tab == Tab.Left)
            {
                <MixChangesSongSheet Songs="_diff.DepartedSongs" LooseCharts="_diff.RemovedCharts"
                                     Departed="true" Mix="_from"></MixChangesSongSheet>
            }
            else
            {
                @* A changed note count means the steps changed, not the rating — the chart you
                   memorised is a different chart now. Not folder-scoped: this is a short list
                   by nature, and it is the one section you want whole. *@
                <div class="mc-sheet">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mc-notice">
                        @if (_diff.Restepped.Any())
                        {
                            @L["{0} charts have a different note count in {1} — the steps changed, not just the rating.",
                                _diff.Restepped.Count, _to.GetName()]
                        }
                        else
                        {
                            @L["No chart's note count changed between {0} and {1}.", _from.GetName(), _to.GetName()]
                        }
                        @if (_diff.NoteCountsUnknown > 0)
                        {
                            <span> </span>
                            @L["{0} charts have no note count recorded, so they aren't compared.", _diff.NoteCountsUnknown]
                        }
                    </MudAlert>

                    @foreach (var move in _diff.Restepped)
                    {
                        <button type="button" class="mc-row" @onclick="() => Answer(move.After)">
                            <SongImage Song="move.After.Song" Small="true"></SongImage>
                            <span class="mc-name">@move.After.Song.Name</span>
                            <span class="mc-tail">
                                <DifficultyBubble Chart="move.After" Small="true"></DifficultyBubble>
                                <span class="mc-notes">
                                    @move.Before.NoteCount?.ToString("N0") <span class="mc-arrow">→</span>
                                    @move.After.NoteCount?.ToString("N0")
                                </span>
                                <span class="mc-delta @(move.NoteDelta > 0 ? "mc-up" : "mc-down")">
                                    @(move.NoteDelta > 0 ? "▲" : "▼")@Math.Abs(move.NoteDelta ?? 0).ToString("N0")
                                </span>
                            </span>
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@inject IMediator Mediator
@inject IUiSettingsAccessor UiSettings
@inject NavigationManager Nav

@code
{
    private enum Tab
    {
        Rerated,
        Arrived,
        Left,
        Restepped
    }

    /// <summary>Newest first — the pair a player wants is usually the one they are living through.</summary>
    private static readonly MixEnum[] Mixes =
        Enum.GetValues<MixEnum>().OrderByDescending(m => m.DisplayOrder()).ToArray();

    [Parameter] public string? FromSlug { get; set; }
    [Parameter] public string? ToSlug { get; set; }

    private MixEnum _from = MixEnum.Phoenix;
    private MixEnum _to = MixEnum.Phoenix2;
    private bool _loading = true;
    private Tab _tab = Tab.Rerated;

    private MixDiffRecord _diff = MixDiffRecord.Empty(MixEnum.Phoenix, MixEnum.Phoenix2);
    private Song[] _lookupSongs = Array.Empty<Song>();
    private IReadOnlyDictionary<Name, Chart[]> _beforeBySong = new Dictionary<Name, Chart[]>();
    private IReadOnlyDictionary<Name, Chart[]> _afterBySong = new Dictionary<Name, Chart[]>();
    private MixChangesAnswerModel? _answer;

    private int _direction;
    private bool _groupByDestination;
    private FolderKey _folder = new(ChartType.Double, 20);

    private static readonly (int Direction, string Text)[] DirectionFilters =
    {
        (0, "All"), (1, "▲ Harder"), (-1, "▼ Easier")
    };

    /// <summary>
    ///     Blazor renders a bool-valued attribute as a boolean attribute — present with an
    ///     empty value, or absent entirely — so an aria state written as a bool never
    ///     matches the [aria-pressed="true"] selectors these controls are styled by.
    /// </summary>
    private static string Aria(bool on)
    {
        return on ? "true" : "false";
    }

    protected override async Task OnParametersSetAsync()
    {
        var (from, to) = await ResolvePair();
        if (from == _from && to == _to && !_loading) return;
        _from = from;
        _to = to;
        await Load();
    }

    /// <summary>
    ///     The URL wins when it names a pair. Otherwise the comparison a player wants by
    ///     default is the one they are living through: their mix, against the mix it
    ///     succeeded. Mixes is newest-first, so that is the next entry.
    /// </summary>
    private async Task<(MixEnum From, MixEnum To)> ResolvePair()
    {
        if (ChartSlugs.TryParseMixSlug(FromSlug, out var urlFrom) &&
            ChartSlugs.TryParseMixSlug(ToSlug, out var urlTo))
            return (urlFrom, urlTo);

        var selected = await UiSettings.GetSelectedMix();
        var index = Math.Max(0, Array.IndexOf(Mixes, selected));
        if (index + 1 < Mixes.Length) return (Mixes[index + 1], selected);

        // Nothing precedes the oldest mix — compare it forward instead of against itself.
        return (selected, Mixes[Math.Max(0, index - 1)]);
    }

    private async Task Load()
    {
        _loading = true;
        _answer = null;

        if (_from == _to)
        {
            _diff = MixDiffRecord.Empty(_from, _to);
            _lookupSongs = Array.Empty<Song>();
            _loading = false;
            return;
        }

        var before = (await Mediator.Send(new GetChartsQuery(_from))).ToArray();
        var after = (await Mediator.Send(new GetChartsQuery(_to))).ToArray();
        _diff = await Mediator.Send(new GetMixDiffQuery(_from, _to));

        // Only the songs the diff touched. The answer is about a whole song, so the search
        // is too — and offering the full catalog meant thousands of suggestions that resolve
        // to "nothing changed". Arrivals and departures are in scope: a song that left is a
        // thing that happened to it, and leaving it out would answer "no such song" for a
        // song the earlier mix plainly has.
        var touched = _diff.Rerated.Select(m => m.After)
            .Concat(_diff.Restepped.Select(m => m.After))
            .Concat(_diff.ArrivedSongs.SelectMany(s => s.Charts))
            .Concat(_diff.AddedCharts)
            .Concat(_diff.DepartedSongs.SelectMany(s => s.Charts))
            .Concat(_diff.RemovedCharts)
            .ToArray();
        _lookupSongs = touched
            .GroupBy(c => c.Song.Name)
            .Select(g => g.First().Song)
            .OrderBy(s => s.Name.ToString(), StringComparer.OrdinalIgnoreCase)
            .ToArray();

        // Answering needs a song's whole line-up, unchanged charts included — but only for
        // songs something can be asked about, which is exactly the songs above.
        var asked = touched.Select(c => c.Song.Name).ToHashSet();
        _beforeBySong = before.Where(c => asked.Contains(c.Song.Name))
            .GroupBy(c => c.Song.Name).ToDictionary(g => g.Key, g => g.ToArray());
        _afterBySong = after.Where(c => asked.Contains(c.Song.Name))
            .GroupBy(c => c.Song.Name).ToDictionary(g => g.Key, g => g.ToArray());

        _folder = DefaultFolder();
        _loading = false;
    }

    // A pair change is a different dataset, so it travels through the URL — which also makes
    // an answer linkable. The router is static, so this is a document load and Load() reruns.
    private void SetFrom(MixEnum mix)
    {
        Go(mix, _to);
    }

    private void SetTo(MixEnum mix)
    {
        Go(_from, mix);
    }

    private void Swap()
    {
        Go(_to, _from);
    }

    private void Go(MixEnum from, MixEnum to)
    {
        Nav.NavigateTo($"/MixChanges/{ChartSlugs.MixSlug(from)}/{ChartSlugs.MixSlug(to)}");
    }

    private void SetTab(Tab tab)
    {
        _tab = tab;
    }

    private void SetDirection(int direction)
    {
        _direction = direction;
        if (!HasChanges(_folder.Type, _folder.Level)) _folder = DefaultFolder();
    }

    private void SetGrouping(bool byDestination)
    {
        _groupByDestination = byDestination;
        // Grouping by destination is a different set of folders; the one in view may not be
        // one of them any more.
        if (!HasChanges(_folder.Type, _folder.Level)) _folder = DefaultFolder();
    }

    private void SetFolder((ChartType Type, int Level) folder)
    {
        _folder = new FolderKey(folder.Type, folder.Level);
    }

    /// <summary>
    ///     Opening on the busiest folder: it is the mix's headline, and it guarantees the
    ///     first thing a visitor sees is populated rather than the lowest folder that
    ///     happens to have one chart in it.
    /// </summary>
    private FolderKey DefaultFolder()
    {
        var best = Moves
            .GroupBy(KeyFor)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key.Type)
            .ThenBy(g => g.Key.Level)
            .FirstOrDefault();
        return best?.Key ?? new FolderKey(ChartType.Double, 20);
    }

    private bool HasChanges(ChartType type, int level)
    {
        return Moves.Any(m => KeyFor(m) == new FolderKey(type, level));
    }

    /// <summary>Every rerate the direction filter allows, before the folder narrows it.</summary>
    private IEnumerable<MixDiffMoveRecord> Moves => _diff.Rerated
        .Where(m => _direction == 0 || (_direction > 0 ? m.Delta > 0 : m.Delta < 0));

    private IEnumerable<MixDiffMoveRecord> FolderMoves => Moves
        .Where(m => KeyFor(m) == _folder)
        .OrderBy(m => m.After.Song.Name.ToString(), StringComparer.OrdinalIgnoreCase);

    private FolderKey KeyFor(MixDiffMoveRecord move)
    {
        return new FolderKey(move.After.Type, _groupByDestination ? move.After.Level : move.Before.Level);
    }

    /// <summary>A row knows which chart you meant, so the answer names that chart.</summary>
    private void Answer(Chart chart)
    {
        _answer = MixChangesAnswerModel.For(chart.Song.Name, chart, _beforeBySong, _afterBySong);
    }

    /// <summary>The search only knows the song, so the answer summarises it.</summary>
    private void AnswerForSong(Name song)
    {
        _answer = MixChangesAnswerModel.For(song, null, _beforeBySong, _afterBySong);
    }

    private sealed record FolderKey(ChartType Type, int Level)
    {
        public string Label => $"{Type.GetShortHand()}{Level}";
    }
}
