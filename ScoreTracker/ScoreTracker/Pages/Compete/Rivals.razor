@page "/Rivals"
@rendermode RenderModes.Interactive
@using MediatR
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.Domain.Exceptions
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.PlayerProgress.Contracts
@using ScoreTracker.Rivals.Contracts
@using ScoreTracker.Rivals.Contracts.Commands
@using ScoreTracker.Rivals.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.PlayerProgress.Contracts.Queries
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Components.Rivals

<PageTitle>@L["Rivals"]</PageTitle>

@* Players you picked out to measure yourself against. Unlike a community — a room you join — a
   rivalry is a one-way arrow you draw, and the person on the other end can see it and cut it,
   which is what the second tab is for (docs/design/rivals.md). *@
@if (!CurrentUser.IsLoggedIn)
{
    <MudText Typo="Typo.body1">@L["Sign in to track rivals."]</MudText>
}
else if (CurrentMix.UsesLegacyScoring())
{
    @* Every comparison here is built on normalized scoring — the head-to-head, the feed's
       "beat your score by", the competitive-level match that decides who is worth rivalling.
       A legacy mix records a letter grade, and two letter grades on different charts do not
       compare, so the page would answer every question with nothing. Said plainly rather
       than rendered as an empty roster that looks like you simply have no rivals. *@
    <MixUnavailableNotice Mix="CurrentMix" Subject="@L["Rivals"]">
        @L["Rivalries compare scores, and scores before Phoenix aren't comparable between charts."]
    </MixUnavailableNotice>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-1">@L["Rivals"]</MudText>
    <MudText Typo="Typo.caption" Class="dash-muted">@L["{0} rivals", _rivals.Count]</MudText>

    @* What your rivals have been doing is the reason to open this page, so it leads rather than
       hiding behind a tab nobody clicked. A strip, not a column: the roster underneath still has
       to be visible without scrolling. Only shown once you HAVE rivals — an empty rail above an
       empty roster is two ways of saying the same nothing. *@
    @if (_rivals.Count > 0)
    {
        <div class="rvl-feed-lead">
            <div class="sbd-section-head">
                <span class="sbd-eyebrow">@L["What your rivals are up to"]</span>
            </div>
            <RivalHighlightsFeed Records="_feed" Charts="_charts" Clubmates="_clubmateIds"
                                 Rail="true"></RivalHighlightsFeed>
        </div>
    }

    <MudTabs Elevation="0" Class="mt-3" ApplyEffectsToContainer="true">
        <MudTabPanel Text="@L["Your rivals"]">
            @if (_selected != null)
            {
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                           OnClick="() => _selected = null" Class="mb-2">@L["Back to rivals"]</MudButton>
                <RivalComparison Record="_headToHead" Charts="_charts" YourAvatar="@MyAvatar"
                                 Mix="CurrentMix" FolderType="_compareType" FolderLevel="_compareLevel"
                                 FolderChanged="OnFolderChanged" OnOpenChart="OpenChart"></RivalComparison>
            }
            else
            {
                <RivalRoster Rivals="_rivals" OnCompare="Compare" OnRemove="RemoveRival"></RivalRoster>
                <AddRivalPanel OnAdded="Reload"></AddRivalPanel>
                <RivalInviteCard Code="@_inviteCode" OnRecycle="RecycleCode"></RivalInviteCard>
            }
        </MudTabPanel>

        <MudTabPanel Text="@L["Rivals of you"]">
            <RivalsOfMeList Rivals="_rivalsOfMe" Blocked="_blocked" OnRemove="RemoveRival"
                            OnBlock="Block" OnUnblock="Unblock" OnAdd="AddBack"></RivalsOfMeList>
        </MudTabPanel>

    </MudTabs>

    @* Same shared surface every other chart affordance on the site opens. *@
    <ChartDetailsDialog @bind-Visible="_detailsOpen" Chart="_detailsChart"
                        Mix="CurrentMix"></ChartDetailsDialog>
}

@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@inject ISnackbar Snackbar
@inject ScoreTracker.Web.Services.HomeDashboard.ChartCatalogCache ChartCatalog
@code {
    private const int FeedTake = 30;

    [CascadingParameter(Name = "Mix")] public MixEnum CurrentMix { get; set; } = MixEnum.Phoenix;

    private ChartType _compareType = ChartType.Double;
    private int? _compareLevel;
    private bool _detailsOpen;
    private Chart? _detailsChart;

    private void OpenChart(Chart chart)
    {
        _detailsChart = chart;
        _detailsOpen = true;
    }

    private IReadOnlyList<RivalSubject> _rivals = Array.Empty<RivalSubject>();
    private IReadOnlyList<RivalOfMeRecord> _rivalsOfMe = Array.Empty<RivalOfMeRecord>();
    private IReadOnlyList<BlockedPlayerRecord> _blocked = Array.Empty<BlockedPlayerRecord>();
    private IReadOnlyList<PlayerHighlightRecord> _feed = Array.Empty<PlayerHighlightRecord>();
    private IReadOnlyDictionary<Guid, Chart> _charts = new Dictionary<Guid, Chart>();
    private IReadOnlySet<Guid> _clubmateIds = new HashSet<Guid>();
    private string? _inviteCode;
    private RivalSubject? _selected;
    private RivalHeadToHeadRecord? _headToHead;

    private string MyAvatar => CurrentUser.IsLoggedIn
        ? CurrentUser.User.ProfileImage.ToString()
        : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Nothing below has an answer on a legacy mix, so none of it is asked for.
        if (CurrentUser.IsLoggedIn && !CurrentMix.UsesLegacyScoring()) await Reload();
    }

    private async Task Reload()
    {
        _rivals = await Mediator.Send(new GetMyRivalsQuery(CurrentMix));
        _rivalsOfMe = await Mediator.Send(new GetRivalsOfMeQuery());
        _blocked = await Mediator.Send(new GetMyBlockedPlayersQuery());
        _feed = (await Mediator.Send(new GetMyRivalHighlightsQuery(CurrentMix, FeedTake))).ToArray();
        _charts = await ChartCatalog.GetCharts(CurrentMix);
        // The feed marks a rival who is ALSO a clubmate in green. Red would mark every row here
        // and therefore nothing — every row is a rival by construction.
        _clubmateIds = _rivalsOfMe.Where(r => r.SharesCommunity).Select(r => r.UserId).ToHashSet();
        _inviteCode = await Mediator.Send(new GetMyRivalInviteCodeQuery());
    }

    private async Task Compare(RivalSubject subject)
    {
        _selected = subject;
        _headToHead = null;

        // Open on the folder where the two of you are closest, the way the community compare
        // does. Without one the table is every chart you have ever scored — thousands of rows
        // answering a question nobody asked. A ghost has no competitive level and its unit is
        // "boards we're both on" rather than a folder, so it stays unfiltered.
        _compareLevel = null;
        if (subject.Can(RivalCapabilities.FolderCompare) && subject.UserId is { } rivalId)
        {
            var mine = await Mediator.Send(new GetPlayerStatsQuery(CurrentUser.User.Id, CurrentMix));
            var theirs = await Mediator.Send(new GetPlayerStatsQuery(rivalId, CurrentMix));
            var singlesGap = Math.Abs(mine.SinglesCompetitiveLevel - theirs.SinglesCompetitiveLevel);
            var doublesGap = Math.Abs(mine.DoublesCompetitiveLevel - theirs.DoublesCompetitiveLevel);
            var (type, myLevel, theirLevel) = singlesGap <= doublesGap
                ? (ChartType.Single, mine.SinglesCompetitiveLevel, theirs.SinglesCompetitiveLevel)
                : (ChartType.Double, mine.DoublesCompetitiveLevel, theirs.DoublesCompetitiveLevel);
            _compareType = type;
            _compareLevel = Math.Clamp((int)Math.Round((myLevel + theirLevel) / 2), 1,
                (int)DifficultyLevel.Max);
        }

        await LoadHeadToHead();
    }

    /// <summary>Null level is "All folders" — the query treats a missing folder as unfiltered.</summary>
    private async Task OnFolderChanged((ChartType Type, int? Level) folder)
    {
        _compareType = folder.Type;
        _compareLevel = folder.Level;
        await LoadHeadToHead();
    }

    private async Task LoadHeadToHead()
    {
        if (_selected == null) return;
        _headToHead = await Mediator.Send(new GetRivalHeadToHeadQuery(CurrentMix, _selected.EdgeId,
            _compareLevel == null ? null : _compareType,
            _compareLevel == null ? null : DifficultyLevel.From(_compareLevel.Value)));
    }

    private async Task RemoveRival(Guid edgeId)
    {
        await Mediator.Send(new RemoveRivalCommand(edgeId));
        Snackbar.Add(L["Rival removed."].Value, Severity.Success);
        await Reload();
    }

    /// <summary>
    ///     The same add the picker makes, from the row that told you about them. The refusal is
    ///     still possible — a block can land between the render and the click — and is reported the
    ///     same deliberately generic way it is on the picker.
    /// </summary>
    private async Task AddBack(RivalOfMeRecord rival)
    {
        try
        {
            await Mediator.Send(new AddRivalCommand(rival.UserId, null));
            Snackbar.Add(L["{0} added as a rival.", rival.PlayerName].Value, Severity.Success);
            await Reload();
        }
        catch (RivalNotAvailableException e)
        {
            Snackbar.Add(e.Message, Severity.Warning);
        }
    }

    private async Task Block(Guid userId)
    {
        await Mediator.Send(new BlockRivalCommand(userId));
        Snackbar.Add(L["Blocked. Neither of you can rival the other."].Value, Severity.Success);
        await Reload();
    }

    private async Task Unblock(Guid userId)
    {
        await Mediator.Send(new UnblockRivalCommand(userId));
        await Reload();
    }

    private async Task RecycleCode()
    {
        _inviteCode = await Mediator.Send(new RecycleRivalInviteCodeCommand());
        Snackbar.Add(L["New code. The old link no longer works."].Value, Severity.Success);
    }
}
