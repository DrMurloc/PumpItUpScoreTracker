    }

    private async Task DeleteSession()
    {
        if (_view == null) return;
        await Mediator.Send(new DeleteMoMSessionCommand(_view.Id));
        Snackbar.Add(L["Session deleted."], Severity.Success);
        Nav.NavigateTo(MoMRoutes.SeasonPath(_view.Season));
    }

    /// <summary>
    ///     The pace chart: one bar per chart at its points-per-second, gaps between them the
    ///     rest. When every play carries a real timestamp the bars sit at their real wall-clock
    ///     positions; otherwise rest spreads evenly, and the note under the chart says derived.
    /// </summary>
    private string TimelineSvg()
    {
        if (_view == null || _rows.Count == 0) return string.Empty;
        const int width = 1000, height = 220, padLeft = 42, padRight = 12, padTop = 12, padBottom = 26;
        var ordered = _rows.OrderBy(r => r.Ordinal).ToArray();

        var segments = new List<(double Start, double End, double Pps, SessionRow Row)>();
        if (ordered.All(r => r.PlayedAt != null) && ordered.Length > 1)
        {
            var first = ordered.Min(r => r.PlayedAt!.Value);
            foreach (var row in ordered)
            {
                var start = (row.PlayedAt!.Value - first).TotalSeconds;
                segments.Add((start, start + row.Seconds, row.Pps, row));
            }
        }
        else
        {
            var restEach = ordered.Length <= 1
                ? 0
                : _view.RestTime.TotalSeconds / (ordered.Length - 1);
            double t = 0;
            foreach (var row in ordered)
            {
                segments.Add((t, t + row.Seconds, row.Pps, row));
                t += row.Seconds + restEach;
            }
        }

        var total = Math.Max(1, segments.Max(s => s.End));
        var maxY = Math.Max(5, Math.Ceiling(ordered.Max(r => r.Pps) / 5) * 5);
        var average = ordered.Sum(r => (double)r.Points) / total;
        double X(double v) => padLeft + v / total * (width - padLeft - padRight);
        double Y(double v) => height - padBottom - v / maxY * (height - padTop - padBottom);
        string F(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

        var svg = new System.Text.StringBuilder();
        for (var grid = 0d; grid <= maxY; grid += 5)
        {
            svg.Append($"<line x1='{padLeft}' y1='{F(Y(grid))}' x2='{width - padRight}' y2='{F(Y(grid))}' class='tl-grid'/>");
            svg.Append($"<text x='{padLeft - 7}' y='{F(Y(grid) + 4)}' class='tl-axis' text-anchor='end'>{grid:0}</text>");
        }

        for (var minute = 0; minute * 60 <= total; minute += 15)
            svg.Append($"<text x='{F(X(minute * 60))}' y='{height - 7}' class='tl-axis' text-anchor='middle'>{minute}m</text>");

        svg.Append($"<line x1='{padLeft}' y1='{F(Y(average))}' x2='{width - padRight}' y2='{F(Y(average))}' class='tl-avg'/>");
        foreach (var segment in segments)
        {
            var barWidth = Math.Max(X(segment.End) - X(segment.Start), 1.5);
            var title = $"{segment.Row.Chart.Song.Name} · {segment.Row.Chart.DifficultyString} · {segment.Row.Pps:F1} pps";
            svg.Append($"<rect x='{F(X(segment.Start))}' y='{F(Y(segment.Pps))}' width='{F(barWidth)}' height='{F(Y(0) - Y(segment.Pps))}' class='tl-bar'/>");
            svg.Append($"<line x1='{F(X(segment.Start))}' y1='{F(Y(segment.Pps))}' x2='{F(X(segment.End))}' y2='{F(Y(segment.Pps))}' class='tl-top'><title>{System.Net.WebUtility.HtmlEncode(title)}</title></line>");
        }

        svg.Append($"<text x='{width - padRight}' y='{F(Y(average) - 6)}' class='tl-avg-label' text-anchor='end'>avg {average:F2} pps</text>");
        return svg.ToString();
    }
