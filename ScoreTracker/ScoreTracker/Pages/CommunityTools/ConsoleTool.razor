@page "/Developers/{ToolId:guid}"
@rendermode RenderModes.Interactive
@using MediatR
@using ScoreTracker.CommunityTools.Contracts
@using ScoreTracker.CommunityTools.Contracts.Commands
@using ScoreTracker.CommunityTools.Contracts.Queries
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.Web.Components.CommunityTools
@using ScoreTracker.Web.Services
<PageTitle>@L["Developers"]</PageTitle>

@* Identity, contact, reach, and the one destructive control on the whole console. *@

<ToolConsoleFrame Section="tool" ToolId="ToolId" Context="tool">
    <div class="ct-cards">
        <ConsoleCard Title=@L["Identity"].Value Class="ct-card-wide"
                     Hint='@L["What a player reads in the directory before deciding whether to connect."].Value'>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_name" Label=@L["Name"] MaxLength="64"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_url" Label=@L["Tool's URL"] MaxLength="500"
                                  Placeholder="https://example.piutool.com"></MudTextField>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_description" Label=@L["Description"]
                                  MaxLength="500" Lines="2"></MudTextField>
                </MudItem>
            </MudGrid>
        </ConsoleCard>

        @* Discord leads because it is the requirement: a linked account is what lets anyone but the
           maker connect, and how DrMurloc reaches them. The source link is optional until listing. *@
        <ConsoleCard Title=@L["Contact & source"].Value>
            <div class="d-flex flex-column gap-2">
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.overline">@L["Discord"]</MudText>
                    @if (tool.MakerDiscordId is null)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                            @L["Not linked"]
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                            @L["Linked"]
                        </MudChip>
                    }
                </div>

                @if (tool.MakerDiscordId is null)
                {
                    <MudText Typo="Typo.body2">
                        @L["Link your Discord to let other players share their scores with this tool. It guarantees DrMurloc can contact you if anything goes wrong, for your players or for you."]
                    </MudText>
                    @* Linking attaches the account to whoever is signed in, so an admin looking at
                       someone else's tool is not offered it. *@
                    @if (IsMaker(tool))
                    {
                        <div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       Href="@LinkDiscordUrl(tool)">@L["Link Discord"]</MudButton>
                        </div>
                        <MudText Typo="Typo.caption" Style="opacity:.7;">
                            @L["Discord asks you to confirm, then brings you back here."]
                        </MudText>
                    }
                    @if (!tool.CanTakePlayers)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning">@L["Only you can use this tool right now."]</MudText>
                    }
                }
                else
                {
                    <LinkedDiscordAccount DiscordId="@tool.MakerDiscordId" Handle="@tool.MakerDiscordHandle"
                                          ShowAvatar="true"></LinkedDiscordAccount>
                    <MudText Typo="Typo.body2">
                        @L["DrMurloc can reach you here if anything goes wrong, for your players or for you."]
                        @DifferentAccountSentence
                    </MudText>
                }
            </div>

            <MudDivider Class="my-3"></MudDivider>

            <MudTextField T="string" @bind-Value="_repository" MaxLength="500"
                          Label=@L["Public source repository"]
                          Placeholder="https://github.com/you/your-tool"
                          HelperText='@L["Optional. Players see a link to it next to your tool. If you ask to be listed, DrMurloc reads it before approving."].Value'></MudTextField>
        </ConsoleCard>

        <ConsoleCard Title=@L["Who can find it"].Value>
            @if (tool.Visibility == ToolVisibility.Public)
            {
                <MudText Typo="Typo.body2" Style="opacity:.75;">@L["Listed in the directory."]</MudText>
            }
            else if (tool.Visibility == ToolVisibility.PendingApproval)
            {
                <MudText Typo="Typo.body2"><b>@L["Waiting on a human — give them a nudge"]</b></MudText>
                <MudText Typo="Typo.body2" Style="opacity:.75;">
                    @L["Nothing gets sent when you ask, so post in the PIU Scores Discord and someone will look. Your tool keeps working in the meantime."]
                </MudText>
            }
            else
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_busy"
                           OnClick="() => RequestListing(tool)">@L["Ask to be listed"]</MudButton>
                @if (tool.Visibility == ToolVisibility.Rejected
                     && !string.IsNullOrWhiteSpace(tool.RejectionReason))
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-2">
                        @L["Listing was turned down"]: @tool.RejectionReason
                    </MudText>
                }
            }

            @if (tool.Kind == ToolKind.Integrated)
            {
                <MudSwitch T="bool" @bind-Value="_acceptsAllTools" Color="Color.Success" Class="mt-3"
                           Label=@L["Accept players who share with all tools"]></MudSwitch>
                <MudText Typo="Typo.body2" Style="opacity:.7;" Class="ml-11">
                    @L["Off means only people who connect to you directly."]
                </MudText>
            }
        </ConsoleCard>
    </div>

    <div class="d-flex gap-2 mt-4 flex-wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                   OnClick="() => Save(tool)">@L["Save"]</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                   OnClick="() => _showDelete = true">@L["Delete tool"]</MudButton>
    </div>

    <MudDialog @bind-Visible="_showDelete">
        <TitleContent><MudText Typo="Typo.h6">@L["Delete {0}", tool.Name]</MudText></TitleContent>
        <DialogContent>
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                <MudText Typo="Typo.body2">
                    @L["Its keys stop working, its webhooks stop firing, and the {0} players connected to it lose access.", tool.ConnectedPlayers]
                </MudText>
            </MudAlert>
        </DialogContent>
        <DialogActions>
            <MudSpacer></MudSpacer>
            <MudButton Variant="Variant.Text" OnClick="() => _showDelete = false">@L["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error"
                       OnClick="() => Delete(tool)">@L["Delete tool"]</MudButton>
        </DialogActions>
    </MudDialog>
</ToolConsoleFrame>

@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject NavigationManager NavManager
@inject ICurrentUserAccessor CurrentUser
@code {
    [Parameter] public Guid ToolId { get; set; }

    private bool _busy;
    private bool _showDelete;
    private bool _loaded;

    private string _name = string.Empty;
    private string _description = string.Empty;
    private string _url = string.Empty;
    private string _repository = string.Empty;
    private bool _acceptsAllTools = true;

    private bool IsMaker(ToolRecord tool) => CurrentUser.IsLoggedIn && CurrentUser.User.Id == tool.OwnerUserId;

    /// <summary>Linking goes out to Discord and back, and lands the maker on this page again.</summary>
    private static string LinkDiscordUrl(ToolRecord tool) =>
        SignInReturnUrl.Append("/Login/Discord/Link", $"/Developers/{tool.Id}");

    private MarkupString DifferentAccountSentence => (MarkupString)L[
        "To use a different account, change it on your {0}.",
        CommunityToolLinks.InternalAnchor("/Account?tab=signin", L["Account page"].Value)].Value;

    /// <summary>
    ///     The page seeds its own fields rather than reading them off the frame. One extra read, and
    ///     it keeps the frame a layout component instead of something pages reach into — and seeding
    ///     once rather than per render is what stops a save overwriting what is half typed.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // A visitor who is not signed in is sent to sign in by the frame; this read would refuse them
        // before the frame got the chance.
        if (_loaded || !CurrentUser.IsLoggedIn) return;

        var tool = await Mediator.Send(new GetToolQuery(ToolId));
        if (tool is null) return;

        _name = tool.Name;
        _description = tool.Description ?? string.Empty;
        _url = tool.Url ?? string.Empty;
        _repository = tool.RepositoryUrl ?? string.Empty;
        _acceptsAllTools = tool.AcceptsAllToolsShare;
        _loaded = true;
    }

    /// <summary>
    ///     Validates everything before sending anything: these are two commands, and a throw partway
    ///     leaves the first committed — which is the one that returns a listed tool to review.
    /// </summary>
    private async Task Save(ToolRecord tool)
    {
        foreach (var link in new[] { _url, _repository })
            if (!string.IsNullOrWhiteSpace(link) && !IsBrowsableUrl(link))
            {
                Snackbar.Add(L["\"{0}\" isn't a valid link. Include https://", link].Value, Severity.Error);
                return;
            }

        _busy = true;
        try
        {
            await Mediator.Send(new UpdateToolCommand(tool.Id, _name, Blank(_description), Blank(_url),
                Blank(_repository)));
            await Mediator.Send(new SetToolAllToolsShareCommand(tool.Id, _acceptsAllTools));
            Snackbar.Add(L["Saved"].Value, Severity.Success);
            NavManager.Refresh();
        }
        catch (Exception e)
        {
            // A domain exception's message is written for the person who tripped it.
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RequestListing(ToolRecord tool)
    {
        _busy = true;
        try
        {
            await Mediator.Send(new RequestToolListingCommand(tool.Id));
            Snackbar.Add(L["Marked for review — now go ask on Discord"].Value, Severity.Success);
            NavManager.Refresh();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Delete(ToolRecord tool)
    {
        await Mediator.Send(new DeleteToolCommand(tool.Id));
        _showDelete = false;
        NavManager.NavigateTo("/Developers", true);
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    /// <summary>A bare host like "planner.example" is the one people type, and it parses as nothing.</summary>
    private static bool IsBrowsableUrl(string value)
    {
        return Uri.TryCreate(value, UriKind.Absolute, out var uri)
               && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp);
    }
}
