@page "/CommunityTools"
@rendermode RenderModes.Interactive
@using MediatR
@using ScoreTracker.CommunityTools.Contracts
@using ScoreTracker.CommunityTools.Contracts.Commands
@using ScoreTracker.CommunityTools.Contracts.Queries
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.Web.Components.CommunityTools
@using ScoreTracker.Web.Services
<PageTitle>@L["Community Tools"]</PageTitle>

@* Browsing is the job. Most people arrive wondering what exists, so the catalogue leads and the
   privacy answer is a permanent strip above it carrying whichever state is true — it is still
   answered above the fold without owning the page.

   Makers are the secondary audience and get one button, which is the only place the wizard is
   launched from. A player who has never built anything never sees the word "console".

   Two row shapes, and the difference matters to a player: a tool that reads scores offers Connect,
   a listing-only tool offers Visit and has no player count — printing "0 players" beside it would
   read as unpopular rather than not-applicable. *@

<div class="d-flex align-start gap-3 flex-wrap mt-2 mb-3">
    <div class="flex-grow-1" style="min-width:200px;">
        <MudText Typo="Typo.h4">@L["Community Tools"]</MudText>
        <MudText Typo="Typo.body2" Style="opacity:.75;">
            @L["Built by players, on your scores. You choose who gets access."]
        </MudText>
    </div>
    @if (_myTools.Any())
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/Developers"
                   EndIcon="@Icons.Material.Filled.ChevronRight">@L["Dev Console"]</MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/Developers"
                   StartIcon="@Icons.Material.Filled.Code">@L["Create a tool"]</MudButton>
    }
</div>

<div class="ct-dir-strip @(Connected.Any() ? string.Empty : "ct-dir-strip-empty")">
    @if (Connected.Any())
    {
        <MudText Typo="Typo.body2">
            <b>@L["{0} tools can read your scores.", Connected.Count]</b>
            @L["You can take that back at any time."]
        </MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _showAccess = true">
            @L["Review access"]
        </MudButton>
    }
    else
    {
        <MudText Typo="Typo.body2">
            <b>@L["No tools can read your scores."]</b>
            @L["Connect one below, or turn on sharing with all tools on your Account page."]
        </MudText>
    }
</div>

@if (!_publicTools.Any())
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true">
        <MudText Typo="Typo.body2"><b>@L["No tools are listed yet"]</b></MudText>
        <MudText Typo="Typo.body2">@L["Build the first one, or connect to a private tool with an invite link."]</MudText>
    </MudAlert>
}
else
{
    @foreach (var tool in _publicTools)
    {
        var connection = Connected.FirstOrDefault(c => c.ToolId == tool.Id);
        <div class="ct-dir-row">
            @* Derived from the name. Tools have no icon, and a letter is enough to make a list of
               rows scannable without inventing an image field for them. *@
            <div class="ct-dir-mark" style="@MarkStyle(tool.Name)">@Monogram(tool.Name)</div>

            <div class="ct-dir-who">
                <MudText Typo="Typo.body1">
                    <b>@tool.Name</b>
                    @if (connection is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                            @L["Connected"]
                        </MudChip>
                    }
                    @if (tool.Kind == ToolKind.ListingOnly)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Site only"]</MudChip>
                    }
                    @if (tool.RequiresPiuGameSession)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                            @L["PIUGame session"]
                        </MudChip>
                    }
                </MudText>
                @if (!string.IsNullOrWhiteSpace(tool.Description))
                {
                    <MudText Typo="Typo.body2">@tool.Description</MudText>
                }
                <MudText Typo="Typo.caption" Style="opacity:.7;">
                    @L["by {0}", tool.OwnerName]
                    @if (tool.Kind == ToolKind.Integrated)
                    {
                        @($" · {L["{0} Players", tool.ConnectedPlayers]}")
                    }
                    @if (!string.IsNullOrWhiteSpace(tool.RepositoryUrl))
                    {
                        <span> · </span>
                        <MudLink Href="@tool.RepositoryUrl" Target="_blank" rel="nofollow noopener"
                                 Typo="Typo.caption" OnClick="() => RecordClick(tool)">
                            @L["Read the source"]
                        </MudLink>
                    }
                </MudText>
            </div>

            <div class="ct-dir-tail">
                @if (tool.Kind == ToolKind.ListingOnly)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               Href="@tool.Url" Target="_blank" rel="noopener"
                               OnClick="() => RecordClick(tool)"
                               EndIcon="@Icons.Material.Filled.OpenInNew">@L["Visit"]</MudButton>
                }
                else if (connection is not null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               OnClick="() => Disconnect(connection)">
                        @(connection.Source == ShareSource.Direct ? L["Disconnect"] : L["Block this tool"])
                    </MudButton>
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="() => OpenConnect(tool)">@L["Connect"]</MudButton>
                }
            </div>
        </div>
    }
}

<div class="d-flex gap-2 mt-4 flex-wrap">
    <MudButton Variant="Variant.Text" OnClick="() => _showInviteEntry = true"
               StartIcon="@Icons.Material.Filled.Link">@L["Have an invite link?"]</MudButton>
    @if (CurrentUser.IsLoggedIn && CurrentUser.User.IsAdmin)
    {
        <MudButton Variant="Variant.Text" Color="Color.Warning" Href="/Admin/CommunityTools"
                   StartIcon="@Icons.Material.Filled.FactCheck">@L["Review queue"]</MudButton>
    }
</div>

<ToolConnectDialog @bind-Visible="_showConnectDialog" Tool="_connecting" OnConnected="Reload"></ToolConnectDialog>

@* The privacy answer in full, opened from the strip. Kept off the page itself because it is the
   thing you check occasionally, not the thing you came for. *@
<MudDialog @bind-Visible="_showAccess" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@L["Who can read your scores"]</MudText></TitleContent>
    <DialogContent>
        @foreach (var connection in Connected)
        {
            <div class="olb-rank-card">
                <div class="flex-grow-1" style="min-width:0;">
                    <MudText Typo="Typo.body1"><b>@connection.Name</b></MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.7;">
                        @(connection.Source == ShareSource.Direct
                            ? L["You connected directly"]
                            : L["Through \"share with all tools\""])
                        · @L["by {0}", connection.OwnerName]
                    </MudText>
                </div>
                <div class="olb-rank-tail">
                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               OnClick="() => Disconnect(connection)">
                        @(connection.Source == ShareSource.Direct ? L["Disconnect"] : L["Block this tool"])
                    </MudButton>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudSpacer></MudSpacer>
        <MudButton Variant="Variant.Text" OnClick="() => _showAccess = false">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showInviteEntry">
    <TitleContent><MudText Typo="Typo.h6">@L["Have an invite link?"]</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            @L["Paste the whole link, or just the code at the end of it."]
        </MudText>
        <MudTextField T="string" @bind-Value="_inviteEntry" Label=@L["Invite link"] Immediate="true"></MudTextField>
    </DialogContent>
    <DialogActions>
        <MudSpacer></MudSpacer>
        <MudButton Variant="Variant.Text" OnClick="() => _showInviteEntry = false">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!HasInviteCode)"
                   OnClick="FollowInvite">@L["Continue"]</MudButton>
    </DialogActions>
</MudDialog>

@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject NavigationManager NavManager
@inject ICurrentUserAccessor CurrentUser
@code {
    // MaxWidth.Small is defeated site-wide by charts.scss, so the cap has to be ours.
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.False, FullWidth = true };

    private IReadOnlyList<PlayerToolConnectionRecord> _connections = Array.Empty<PlayerToolConnectionRecord>();
    private IReadOnlyList<PublicToolRecord> _publicTools = Array.Empty<PublicToolRecord>();
    private IReadOnlyList<ToolRecord> _myTools = Array.Empty<ToolRecord>();
    private PublicToolRecord? _connecting;
    private bool _showConnectDialog;
    private bool _showInviteEntry;
    private bool _showAccess;
    private string _inviteEntry = string.Empty;

    private bool HasInviteCode => TryReadInviteCode(_inviteEntry, out _);

    /// <summary>Connections to tools somebody else made. Your own are reached from the console.</summary>
    private IReadOnlyList<PlayerToolConnectionRecord> Connected =>
        _connections.Where(c => _myTools.All(m => m.Id != c.ToolId)).ToArray();

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _connections = await Mediator.Send(new GetMyToolConnectionsQuery());
        _publicTools = await Mediator.Send(new GetPublicToolsQuery());
        _myTools = await Mediator.Send(new GetMyToolsQuery());
    }

    /// <summary>
    ///     Counted in the row's own handler rather than behind a redirect. A redirect would catch a
    ///     middle-click too, and would make the link opaque on hover — a worse trade on a row whose
    ///     whole point is "go and read this person's source".
    /// </summary>
    private async Task RecordClick(PublicToolRecord tool)
    {
        await Mediator.Send(new RecordToolClickCommand(tool.Id));
    }

    private void OpenConnect(PublicToolRecord tool)
    {
        _connecting = tool;
        _showConnectDialog = true;
    }

    // A direct grant is revoked; an all-tools one is blocked, because revoking a grant the player
    // never made individually would be undone by the next sweep of the pool.
    private async Task Disconnect(PlayerToolConnectionRecord connection)
    {
        if (connection.Source == ShareSource.Direct)
            await Mediator.Send(new DisconnectToolCommand(connection.ToolId));
        else
            await Mediator.Send(new BlockToolCommand(connection.ToolId));

        Snackbar.Add(L["{0} can no longer read your scores", connection.Name].Value, Severity.Success);
        await Reload();
    }

    /// <summary>Accepts a bare code or a whole invite URL — a player will paste whichever they were sent.</summary>
    private static bool TryReadInviteCode(string entry, out Guid code)
    {
        code = Guid.Empty;
        if (string.IsNullOrWhiteSpace(entry)) return false;

        var tail = entry.Trim().TrimEnd('/');
        var slash = tail.LastIndexOf('/');
        if (slash >= 0) tail = tail[(slash + 1)..];
        return Guid.TryParse(tail, out code);
    }

    private void FollowInvite()
    {
        if (!TryReadInviteCode(_inviteEntry, out var code)) return;

        _showInviteEntry = false;
        NavManager.NavigateTo($"/CommunityTools/Invite/{code}");
    }

    private static string Monogram(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length switch
        {
            0 => "?",
            1 => words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant(),
            _ => $"{words[0][0]}{words[1][0]}".ToUpperInvariant()
        };
    }

    /// <summary>
    ///     A stable hue per name, off the mix's own ramp rather than a colour literal — the arch
    ///     test would refuse a hex here, and rightly: this is decoration, not data meaning.
    /// </summary>
    private static string MarkStyle(string name)
    {
        var ramp = new[]
        {
            "var(--mix-primary)", "var(--mix-secondary)", "var(--mix-accent)",
            "var(--rarity-emerald)", "var(--rarity-sapphire)", "var(--rarity-silver)"
        };
        var index = Math.Abs(StringComparer.Ordinal.GetHashCode(name)) % ramp.Length;
        return $"background:{ramp[index]};";
    }
}
