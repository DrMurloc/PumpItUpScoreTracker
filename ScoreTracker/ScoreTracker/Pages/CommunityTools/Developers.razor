@page "/Developers"
@rendermode RenderModes.Interactive
@using MediatR
@using ScoreTracker.CommunityTools.Contracts
@using ScoreTracker.CommunityTools.Contracts.Commands
@using ScoreTracker.CommunityTools.Contracts.Queries
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Web.Components.CommunityTools
@using ScoreTracker.Web.Services
<PageTitle>@L["Developers"]</PageTitle>

@* Maker-facing, so the jargon is allowed here — webhook, API key, rate limit. Player-facing
   screens never use those words.

   Section order is the order a maker needs them: identity, then the credential their code uses,
   then how they recruit players, then delivery. Help sits at the bottom because it is a place you
   go looking, not a thing you trip over — and Delete sits below Help so nothing above it is a
   destructive control. *@

<div class="d-flex align-end gap-3 flex-wrap mt-2 mb-4">
    <div class="flex-grow-1">
        <MudText Typo="Typo.h4">@L["Developers"]</MudText>
        <MudText Typo="Typo.body2" Style="opacity:.75;">
            @L["Your tools, their keys, and how they hear about new scores."]
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => _showCreate = true">@L["New tool"]</MudButton>
</div>

@if (_expiringSoon.Any())
{
    @* There are no expiry emails, so this banner is the whole warning. It has to be loud rather
       than precise — a key that dies unannounced breaks a tool at 2am. *@
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
        <MudText Typo="Typo.body2">
            <b>@L["{0} expires in {1} days", _expiringSoon[0].Name, _expiringSoon[0].DaysLeft]</b>
        </MudText>
        <MudText Typo="Typo.body2">
            @L["We don't email reminders, so this banner is the reminder. Create a replacement now and run both until you've swapped it over."]
        </MudText>
    </MudAlert>
}

@if (_loading)
{
    <MudSkeleton Height="180px"></MudSkeleton>
}
else if (!_tools.Any())
{
    <ToolIntegrationChecklist Tool="null"></ToolIntegrationChecklist>
}
else
{
    <MudPaper Outlined="true" Class="pa-3 mb-4">
        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Your tools"]</MudText>
        @foreach (var tool in _tools)
        {
            <div class="olb-rank-card" style="cursor:pointer;" @onclick="() => Select(tool)">
                <div class="flex-grow-1" style="min-width:0;">
                    <MudText Typo="Typo.body1">
                        <b>@tool.Name</b>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@VisibilityColor(tool.Visibility)">@VisibilityLabel(tool.Visibility)</MudChip>
                    </MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.7;">
                        @WebhookLabel(tool.WebhookMode)
                        · @L["{0} Players", tool.ConnectedPlayers]
                    </MudText>
                </div>
            </div>
        }
    </MudPaper>

    @if (_selected is not null)
    {
        <ToolIntegrationChecklist Tool="_selected"></ToolIntegrationChecklist>

        @* 1. Who this tool is. *@
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-3">@L["{0} — settings", _selected.Name]</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_editName" Label=@L["Name"] MaxLength="64"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_editUrl" Label=@L["Link"] MaxLength="500"
                                  HelperText='@L["Leave blank if no hosted URL."].Value'></MudTextField>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_editDescription" Label=@L["Description"] MaxLength="500"
                                  Lines="2"
                                  HelperText='@L["Shown in the tool directory. Players read this before they connect."].Value'></MudTextField>
                </MudItem>
            </MudGrid>

            <MudSwitch T="bool" @bind-Value="_editAcceptsAllTools" Color="Color.Success" Class="mt-3"
                       Label=@L["Accept players who share with all tools"]></MudSwitch>
            <MudText Typo="Typo.body2" Style="opacity:.7;" Class="ml-11">
                @L["Off means only players who connect to you directly, by invite. Turn it off if your tool is for one crew and a thousand strangers would be noise."]
            </MudText>

            <div class="d-flex gap-2 mt-4 flex-wrap align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@L["Save"]</MudButton>
                @if (_selected.Visibility != ToolVisibility.Public
                     && _selected.Visibility != ToolVisibility.PendingApproval)
                {
                    @* Disabled rather than throwing on click: a listing needs a description, and the
                       rule is worth stating where it is broken instead of after the attempt. *@
                    <MudButton Variant="Variant.Outlined" Disabled="@(!CanRequestListing)"
                               OnClick="RequestListing">@L["Ask to be listed"]</MudButton>
                    @if (!CanRequestListing)
                    {
                        <MudText Typo="Typo.caption" Style="opacity:.7;">
                            @L["Add a description first — it is what a player reads before deciding whether to connect."]
                        </MudText>
                    }
                }
            </div>

            @* Nothing is notified when this is pressed — no email, no bot, no queue anybody
               watches. Saying so, and naming the step that actually moves it, is the difference
               between a maker waiting a week and a maker getting listed. *@
            @if (_selected.Visibility == ToolVisibility.PendingApproval)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    <MudText Typo="Typo.body2"><b>@L["Waiting on a human — give them a nudge"]</b></MudText>
                    <MudText Typo="Typo.body2">
                        @L["Nothing gets sent when you ask, so post in the PIU Scores Discord and someone will look. Your tool keeps working in the meantime."]
                    </MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="mt-1"
                               Target="_blank" Href="https://discord.gg/AvS5PxnvSN"
                               EndIcon="@Icons.Material.Filled.OpenInNew">@L["Ask on Discord"]</MudButton>
                </MudAlert>
            }

            @if (_selected.Visibility == ToolVisibility.Rejected
                 && !string.IsNullOrWhiteSpace(_selected.RejectionReason))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    <MudText Typo="Typo.body2"><b>@L["Listing was turned down"]</b></MudText>
                    <MudText Typo="Typo.body2">@_selected.RejectionReason</MudText>
                </MudAlert>
            }
        </MudPaper>

        @* 2, 3, 4. *@
        <ToolKeyPanel ToolId="_selected.Id" OnChanged="Reload"></ToolKeyPanel>
        <ToolInvitePanel ToolId="_selected.Id"></ToolInvitePanel>
        <ToolWebhookPanel Tool="_selected" OnChanged="Reload"></ToolWebhookPanel>

        @* 5. Reference material, gathered here rather than scattered up the page. *@
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Help"]</MudText>
            <div class="d-flex gap-2 flex-wrap">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Href="/swagger" Target="_blank"
                           EndIcon="@Icons.Material.Filled.OpenInNew">@L["Swagger"]</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Target="_blank"
                           Href="https://github.com/DrMurloc/PumpItUpScoreTracker/blob/main/docs/INTEGRATING.md"
                           EndIcon="@Icons.Material.Filled.OpenInNew">@L["Full reference"]</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Target="_blank"
                           Href="https://github.com/DrMurloc/PumpItUpScoreTracker/blob/main/docs/HOW-TO-RUN.md"
                           EndIcon="@Icons.Material.Filled.OpenInNew">@L["Run PIU Scores locally"]</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Target="_blank"
                           Href="https://discord.gg/AvS5PxnvSN"
                           EndIcon="@Icons.Material.Filled.OpenInNew">@L["Ask on Discord"]</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text"
                           Href="@($"/Developers/{_selected.Id}/Console")">@L["Activity log"]</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text"
                           Href="@($"/Developers/{_selected.Id}/Debug")">@L["Test delivery"]</MudButton>
            </div>
        </MudPaper>

        @* 6. Last, and the only destructive control on the page. *@
        <MudPaper Outlined="true" Class="pa-4 mb-4"
                  Style="border-color:color-mix(in srgb, var(--mud-palette-error) 45%, transparent);">
            @* "Danger Zone" — the existing casing. A second key differing only by case is dropped
               from every compiled satellite, so both spellings would render English. *@
            <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mb-1">@L["Danger Zone"]</MudText>
            <div class="d-flex gap-3 flex-wrap align-center">
                <div class="flex-grow-1" style="min-width:240px;">
                    <MudText Typo="Typo.body2"><b>@L["Delete {0}", _selected.Name]</b></MudText>
                    <MudText Typo="Typo.body2" Style="opacity:.7;">
                        @L["Its keys stop working, its webhooks stop firing, and the {0} players connected to it lose access.", _selected.ConnectedPlayers]
                    </MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           OnClick="() => _showDelete = true">@L["Delete tool"]</MudButton>
            </div>
        </MudPaper>
    }
}

<MudDialog @bind-Visible="_showCreate">
    <TitleContent><MudText Typo="Typo.h6">@L["New tool"]</MudText></TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_newName" Label=@L["Name"] MaxLength="64" Immediate="true"></MudTextField>
        <MudText Typo="Typo.body2" Style="opacity:.7;" Class="mt-2">
            @L["It starts private and fully working — invite links, keys and webhooks all function. Listing only puts you in the directory."]
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudSpacer></MudSpacer>
        <MudButton Variant="Variant.Text" OnClick="() => _showCreate = false">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(string.IsNullOrWhiteSpace(_newName))" OnClick="Create">@L["Create"]</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showDelete">
    <TitleContent><MudText Typo="Typo.h6">@L["Delete {0}", _selected?.Name ?? string.Empty]</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
            <MudText Typo="Typo.body2">
                @L["Its keys stop working, its webhooks stop firing, and the {0} players connected to it lose access.", _selected?.ConnectedPlayers ?? 0]
            </MudText>
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudSpacer></MudSpacer>
        <MudButton Variant="Variant.Text" OnClick="() => _showDelete = false">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Delete">@L["Delete tool"]</MudButton>
    </DialogActions>
</MudDialog>

@inject IMediator Mediator
@inject ISnackbar Snackbar
@code {
    private IReadOnlyList<ToolRecord> _tools = Array.Empty<ToolRecord>();
    private ToolRecord? _selected;
    private bool _loading = true;
    private bool _showCreate;
    private bool _showDelete;
    private string _newName = string.Empty;

    private string _editName = string.Empty;
    private string _editDescription = string.Empty;
    private string _editUrl = string.Empty;
    private bool _editAcceptsAllTools = true;

    private IReadOnlyList<(string Name, int DaysLeft)> _expiringSoon = Array.Empty<(string, int)>();

    /// <summary>
    ///     Mirrors the domain rule on <c>Tool.RequestListing</c>. Reads the box rather than the
    ///     saved record, so writing a description enables the button without a round trip — and the
    ///     Save above it is what commits either way.
    /// </summary>
    private bool CanRequestListing => !string.IsNullOrWhiteSpace(_editDescription);

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _tools = await Mediator.Send(new GetMyToolsQuery());
        if (_selected is not null) _selected = _tools.FirstOrDefault(t => t.Id == _selected.Id);
        if (_selected is null && _tools.Any()) Select(_tools[0]);

        var expiring = new List<(string, int)>();
        foreach (var tool in _tools)
        foreach (var key in await Mediator.Send(new GetToolApiKeysQuery(tool.Id)))
            if (key.IsExpiringSoon(DateTimeOffset.Now))
                expiring.Add(($"{tool.Name} · {key.Name}", (int)(key.ExpiresAt!.Value - DateTimeOffset.Now).TotalDays));

        _expiringSoon = expiring;
        _loading = false;
    }

    private void Select(ToolRecord tool)
    {
        _selected = tool;
        _editName = tool.Name;
        _editDescription = tool.Description ?? string.Empty;
        _editUrl = tool.Url ?? string.Empty;
        _editAcceptsAllTools = tool.AcceptsAllToolsShare;
    }

    private async Task Create()
    {
        var id = await Mediator.Send(new CreateToolCommand(_newName));
        _newName = string.Empty;
        _showCreate = false;
        await Reload();
        var created = _tools.FirstOrDefault(t => t.Id == id);
        if (created is not null) Select(created);
    }

    /// <summary>
    ///     Validates everything before sending anything.
    ///     <para>
    ///         These are two commands, so a throw partway through leaves the first committed — and
    ///         the first is <c>UpdateToolCommand</c>, which returns an approved tool to
    ///         PendingApproval when its identity changes. A failed save used to de-list a listed tool
    ///         and show the maker nothing but a dead circuit.
    ///     </para>
    /// </summary>
    private async Task Save()
    {
        if (_selected is null) return;

        if (!string.IsNullOrWhiteSpace(_editUrl) && !IsBrowsableUrl(_editUrl))
        {
            Snackbar.Add(L["\"{0}\" isn't a valid link. Include https://", _editUrl].Value, Severity.Error);
            return;
        }

        try
        {
            await Mediator.Send(new UpdateToolCommand(_selected.Id, _editName,
                string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription,
                string.IsNullOrWhiteSpace(_editUrl) ? null : _editUrl));
            await Mediator.Send(new SetToolAllToolsShareCommand(_selected.Id, _editAcceptsAllTools));
        }
        catch (Exception e)
        {
            // A domain exception's message is written for the person who tripped it.
            Snackbar.Add(e.Message, Severity.Error);
            await Reload();
            return;
        }

        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }

    /// <summary>
    ///     What we can catch before touching the database. A bare host like "planner.example" is the
    ///     one people actually type, and it parses as nothing useful.
    /// </summary>
    private static bool IsBrowsableUrl(string value)
    {
        return Uri.TryCreate(value, UriKind.Absolute, out var uri)
               && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp);
    }

    private async Task RequestListing()
    {
        if (_selected is null) return;

        try
        {
            await Mediator.Send(new RequestToolListingCommand(_selected.Id));
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
            await Reload();
            return;
        }

        Snackbar.Add(L["Marked for review — now go ask on Discord"].Value, Severity.Success);
        await Reload();
    }

    private async Task Delete()
    {
        if (_selected is null) return;

        await Mediator.Send(new DeleteToolCommand(_selected.Id));
        _showDelete = false;
        _selected = null;
        await Reload();
    }

    private string VisibilityLabel(ToolVisibility visibility) => visibility switch
    {
        ToolVisibility.Public => L["Public"].Value,
        ToolVisibility.PendingApproval => L["Awaiting review"].Value,
        ToolVisibility.Rejected => L["Listing was turned down"].Value,
        _ => L["Private"].Value
    };

    private static Color VisibilityColor(ToolVisibility visibility) => visibility switch
    {
        ToolVisibility.Public => Color.Success,
        ToolVisibility.PendingApproval => Color.Warning,
        ToolVisibility.Rejected => Color.Error,
        _ => Color.Default
    };

    private string WebhookLabel(WebhookMode mode) => mode switch
    {
        WebhookMode.ScorePush => L["Score Push"].Value,
        WebhookMode.PlayerPing => L["Player ping"].Value,
        WebhookMode.PiuGameSession => L["PIUGame session"].Value,
        _ => L["No webhook"].Value
    };
}
