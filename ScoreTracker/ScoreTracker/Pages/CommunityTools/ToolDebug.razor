@page "/Developers/{ToolId:guid}/Debug"
@rendermode RenderModes.Interactive
@using MediatR
@using ScoreTracker.CommunityTools.Contracts
@using ScoreTracker.CommunityTools.Contracts.Commands
@using ScoreTracker.CommunityTools.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Web.Services
<PageTitle>@L["Debug"]</PageTitle>

@* Three tools, in order of how much time they save: is anything firing, why doesn't my signature
   match, and fix-then-verify. Session mode gets none of them and the page says why rather than
   looking broken. *@

<div class="d-flex align-end gap-3 flex-wrap mt-2 mb-4">
    <div class="flex-grow-1">
        <MudText Typo="Typo.h5">@L["{0} — debug", _tool?.Name ?? string.Empty]</MudText>
        <MudText Typo="Typo.body2" Style="opacity:.75;">
            @L["Fire a delivery at your own endpoint, check your signature, replay what failed."]
        </MudText>
    </div>
    <MudButton Variant="Variant.Text" Href="@($"/Developers/{ToolId}/Console")">@L["Activity"]</MudButton>
</div>

@if (_tool?.WebhookMode == WebhookMode.PiuGameSession)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        <MudText Typo="Typo.body2"><b>@L["None of this works in PIUGame session mode"]</b></MudText>
        <MudText Typo="Typo.body2">
            @L["A session delivery carries a live piugame.com key, so we never write it down — there's nothing to replay, no body to show you, and no retry if your server is down when it fires. Test against your own account by importing."]
        </MudText>
    </MudAlert>
}
else
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Send a test delivery"]</MudText>
        <MudText Typo="Typo.body2" Style="opacity:.7;" Class="mb-3">
            @L["Goes to your configured URL, signed exactly like a real one."]
        </MudText>

        <MudSelect T="MixEnum" @bind-Value="_mix" Label=@L["Mix"] Dense="true" Class="mb-3">
            @foreach (var mix in Mixes)
            {
                <MudSelectItem T="MixEnum" Value="@mix">@mix.GetName()</MudSelectItem>
            }
        </MudSelect>

        <MudRadioGroup T="bool" @bind-Value="_useMyLastImport">
            <MudRadio T="bool" Value="true" Color="Color.Primary">
                <b>@L["My last import"]</b> — @L["Real scores from your own account. What a live delivery actually looks like."]
            </MudRadio>
            <MudRadio T="bool" Value="false" Color="Color.Primary">
                <b>@L["Made-up scores"]</b> — @L["Synthetic charts and scores, if you'd rather not use your own or want a specific size."]
            </MudRadio>
        </MudRadioGroup>

        @if (!_useMyLastImport)
        {
            <MudNumericField T="int" @bind-Value="_syntheticCount" Label=@L["How many"] Min="1" Max="100"
                             Class="mt-2" Style="max-width:160px;"></MudNumericField>
        }

        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
            <MudText Typo="Typo.body2"><b>@L["Always a test, always you"]</b></MudText>
            <MudText Typo="Typo.body2">
                @L["The body carries \"test\": true and the delivery id starts with test-. The player is always your own account — a test can never send you another player's scores."]
            </MudText>
        </MudAlert>

        <div class="d-flex align-center gap-3 mt-3 flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendTest">@L["Send it"]</MudButton>
            @if (_sendResult is not null)
            {
                <MudText Typo="Typo.body2">@_sendResult</MudText>
            }
        </div>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle2" Class="mb-1">@L["Signature check — your last delivery"]</MudText>
        <MudText Typo="Typo.body2" Style="opacity:.7;" Class="mb-2">
            @L["Compute HMAC-SHA256 over exactly these bytes with your signing secret. If yours differs, you're almost certainly re-serializing the JSON before hashing — hash the raw body you received, not a parsed-then-restringified copy."]
        </MudText>
        @if (_echo is null)
        {
            <MudText Typo="Typo.body2" Style="opacity:.6;">
                @L["Nothing to show yet — send a test delivery and it appears here."]
            </MudText>
        }
        else
        {
            <MudPaper Outlined="true" Class="pa-2 mb-2" Style="overflow-x:auto;">
                <pre style="margin:0; font-size:12px; white-space:pre-wrap; word-break:break-all;">@_echo.SignedPayload</pre>
            </MudPaper>
            <MudPaper Outlined="true" Class="pa-2" Style="overflow-x:auto;">
                <pre style="margin:0; font-size:12px; word-break:break-all;">@_echo.Signature</pre>
            </MudPaper>
        }
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4">
        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Replay a delivery"]</MudText>
        @foreach (var row in _activity.Where(r => r.DeliveryId is not null))
        {
            <div class="olb-rank-card">
                <MudText Typo="Typo.caption" Style="opacity:.6; min-width:120px;">
                    @row.OccurredAt.LocalDateTime.ToString("dd MMM HH:mm")
                </MudText>
                <div class="flex-grow-1" style="min-width:0;">
                    <MudText Typo="Typo.body2">@row.DeliveryId</MudText>
                </div>
                <div class="olb-rank-tail">
                    @if (row.CanReplay)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="() => Replay(row.DeliveryRowId!.Value)">@L["Replay"]</MudButton>
                    }
                    else
                    {
                        @* Said out loud, because a maker who hits the 7-day window in month two
                           would otherwise file it as a bug. *@
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Body expired"]</MudChip>
                    }
                </div>
            </div>
        }
        <MudText Typo="Typo.caption" Class="mt-2 d-block" Style="opacity:.7;">
            @L["We keep the body of a failed delivery for 7 days so you can replay it. After that the activity log still shows what happened, but the payload is gone."]
        </MudText>
    </MudPaper>
}

@inject IMediator Mediator
@inject ISnackbar Snackbar
@code {
    private static readonly MixEnum[] Mixes =
        Enum.GetValues<MixEnum>().OrderByDescending(m => m.DisplayOrder()).ToArray();

    [Parameter] public Guid ToolId { get; set; }

    private ToolRecord? _tool;
    private SignatureEcho? _echo;
    private IReadOnlyList<ToolActivityRecord> _activity = Array.Empty<ToolActivityRecord>();
    private MixEnum _mix = MixEnum.Phoenix;
    private bool _useMyLastImport = true;
    private int _syntheticCount = 10;
    private string? _sendResult;

    protected override async Task OnParametersSetAsync() => await Reload();

    private async Task Reload()
    {
        _tool = await Mediator.Send(new GetToolQuery(ToolId));
        _echo = await Mediator.Send(new GetToolSignatureEchoQuery(ToolId));
        _activity = await Mediator.Send(new GetToolActivityQuery(ToolId, 25));
    }

    private async Task SendTest()
    {
        try
        {
            await Mediator.Send(new SendTestDeliveryCommand(ToolId, _mix, _useMyLastImport,
                _syntheticCount));
            _sendResult = L["Sent — check the activity log for the result."].Value;
            await Reload();
        }
        catch (Exception e)
        {
            // A domain exception's message is written for the person who tripped it.
            Snackbar.Add(e.Message, Severity.Error);
        }
    }

    private async Task Replay(Guid deliveryRowId)
    {
        var delivered = await Mediator.Send(new ReplayDeliveryCommand(ToolId, deliveryRowId));
        Snackbar.Add(delivered ? L["Delivered"].Value : L["Still failing — check the activity log."].Value,
            delivered ? Severity.Success : Severity.Warning);
        await Reload();
    }
}
