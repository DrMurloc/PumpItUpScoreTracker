@page "/Developers/{ToolId:guid}/code"
@rendermode RenderModes.Interactive
@using MediatR
@using ScoreTracker.CommunityTools.Contracts
@using ScoreTracker.CommunityTools.Contracts.Queries
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Web.Components.CommunityTools
@using ScoreTracker.Web.Services
<PageTitle>@L["Developers"]</PageTitle>

@* What replaced the integration guide.

   On-site rather than in a repository because the snippets carry this tool's own values — the key
   tail it actually holds, the URL it actually delivers to, the header it actually sends. A markdown
   file can only ever show placeholders and hope the reader substitutes correctly.

   Four languages, two groups. A maker arrives here either to call the API or to answer a delivery,
   and those are different code. *@

<ToolConsoleFrame Section="code" ToolId="ToolId" Context="tool">
    <MudText Typo="Typo.body2" Style="opacity:.75;" Class="mb-3">
        @L["Your key tail, your URL and your mixes are already filled in. Copy and run."]
    </MudText>

    <div class="d-flex gap-2 mb-3 flex-wrap">
        @foreach (var group in new[] { (Key: "api", Label: L["API"].Value), (Key: "webhook", Label: L["Webhook"].Value) })
        {
            <MudButton Size="Size.Small" Color="Color.Primary"
                       Variant="@(_group == group.Key ? Variant.Filled : Variant.Outlined)"
                       OnClick="() => _group = group.Key">@group.Label</MudButton>
        }
    </div>

    <div class="d-flex gap-1 mb-2 flex-wrap">
        @foreach (var language in Languages)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Color="@(_language == language.Key ? Color.Info : Color.Default)"
                     OnClick="() => _language = language.Key">@language.Label</MudChip>
        }
    </div>

    <div class="ct-secret ct-secret-wrap">
        <pre>@Snippet()</pre>
        <MudIconButton Class="ct-secret-copy" Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                       Color="Color.Default" aria-label=@L["Copy"] OnClick="Copy"></MudIconButton>
    </div>

    @if (_group == "webhook" && string.IsNullOrWhiteSpace(_context.WebhookUrl))
    {
        <MudText Typo="Typo.body2" Style="opacity:.7;" Class="mt-2">
            @L["Set a delivery URL on the Webhooks section and this fills in with yours."]
        </MudText>
    }

    <div class="d-flex gap-2 mt-3 flex-wrap">
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Href="/swagger" Target="_blank"
                   EndIcon="@Icons.Material.Filled.OpenInNew">@L["Swagger"]</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Target="_blank"
                   Href="https://discord.gg/AvS5PxnvSN"
                   EndIcon="@Icons.Material.Filled.OpenInNew">@L["Ask on Discord"]</MudButton>
    </div>
</ToolConsoleFrame>

@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@inject ICurrentUserAccessor CurrentUser
@code {
    [Parameter] public Guid ToolId { get; set; }

    private static readonly (string Key, string Label)[] Languages =
    {
        ("cs", "C#"), ("java", "Java"), ("py", "Python"), ("ts", "TypeScript")
    };

    private string _group = "api";
    private string _language = "cs";
    private ToolCodeContext _context = new(string.Empty, null, null, Array.Empty<MixEnum>());

    protected override async Task OnParametersSetAsync()
    {
        // A visitor who is not signed in is sent to sign in by the frame; this read would refuse them
        // before the frame got the chance.
        if (!CurrentUser.IsLoggedIn) return;

        _context = await Mediator.Send(new GetToolCodeSamplesQuery(ToolId));
    }

    private string Base => NavManager.BaseUri.TrimEnd('/') + "/";

    /// <summary>The tail, never a key — a snippet on screen is a snippet in a screenshot.</summary>
    private string KeyText => string.IsNullOrWhiteSpace(_context.KeyTail)
        ? "piu_scores_live_…"
        : $"piu_scores_live_…{_context.KeyTail}";

    private string Mix => _context.Mixes.Any() ? _context.Mixes[0].ToString() : "Phoenix2";

    private static string Header => WebhookContract.OutboundHeader;

    private string Route
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_context.WebhookUrl)) return "/hooks/piu";
            return Uri.TryCreate(_context.WebhookUrl, UriKind.Absolute, out var uri)
                ? uri.AbsolutePath
                : "/hooks/piu";
        }
    }

    private async Task Copy()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Snippet());
        Snackbar.Add(L["Copied"].Value, Severity.Success);
    }

    private string Snippet() => (_group, _language) switch
    {
        ("api", "cs") => $$"""
            using System.Net;
            using System.Net.Http.Json;

            var http = new HttpClient { BaseAddress = new("{{Base}}") };
            http.DefaultRequestHeaders.Authorization = new("Bearer", "{{KeyText}}");

            // The players who shared with this tool, then each one's best scores by id.
            // A tool key has no "me" — that is a personal token's own scores.
            await foreach (var player in Rows<Player>("api/v2/players?limit=500"))
                await foreach (var score in Rows<BestScore>(
                    $"api/v2/players/{player.UserId}/scores?mix={{Mix}}&limit=500"))
                    Console.WriteLine($"{player.Username}: {score.ChartId} {score.Score} {score.LetterGrade}");

            // Up to 500 rows a page. `next` is the full URL of the next page: follow it as it is
            // until it is null. 600 requests a minute per key: a 429 is waited out for its
            // Retry-After and asked again, and any other failure throws, so a sweep is never cut
            // short in silence.
            async IAsyncEnumerable<T> Rows<T>(string? url)
            {
                while (url is not null)
                {
                    using var response = await http.GetAsync(url);
                    if (response.StatusCode == HttpStatusCode.TooManyRequests)
                    {
                        await Task.Delay(response.Headers.RetryAfter?.Delta ?? TimeSpan.FromMinutes(1));
                        continue;
                    }
                    response.EnsureSuccessStatusCode();

                    var page = await response.Content.ReadFromJsonAsync<Page<T>>();
                    foreach (var row in page!.Data) yield return row;
                    url = page.Next;
                }
            }

            record Page<T>(T[] Data, string? Next);
            record Player(Guid UserId, string Username);
            record BestScore(Guid ChartId, int? Score, string? LetterGrade, string? Plate, double? Pumbility);
            """,

        ("api", "java") => $$"""
            static final HttpClient HTTP = HttpClient.newHttpClient();
            static final ObjectMapper MAPPER = new ObjectMapper();
            static final String AUTH = "Bearer {{KeyText}}";

            public static void main(String[] args) throws Exception {
                // The players who shared with this tool, then each one's best scores by id.
                // A tool key has no "me" — that is a personal token's own scores.
                for (JsonNode player : rows("{{Base}}api/v2/players?limit=500")) {
                    String id = player.path("userId").asText();
                    for (JsonNode score : rows("{{Base}}api/v2/players/" + id + "/scores?mix={{Mix}}&limit=500"))
                        System.out.println(player.path("username").asText() + ": " + score);
                }
            }

            // Up to 500 rows a page. `next` is the full URL of the next page: follow it as it is
            // until it is null. 600 requests a minute per key: a 429 is waited out for its
            // Retry-After and asked again, and any other failure throws, so a sweep is never cut
            // short in silence.
            static List<JsonNode> rows(String url) throws Exception {
                List<JsonNode> found = new ArrayList<>();
                while (url != null) {
                    HttpRequest request = HttpRequest.newBuilder(URI.create(url))
                            .header("Authorization", AUTH)
                            .build();
                    HttpResponse<String> response = HTTP.send(request, BodyHandlers.ofString());
                    if (response.statusCode() == 429) {
                        String wait = response.headers().firstValue("Retry-After").orElse("60");
                        Thread.sleep(1000L * Long.parseLong(wait));
                        continue;
                    }
                    if (response.statusCode() != 200)
                        throw new IllegalStateException(response.statusCode() + " " + url + " " + response.body());

                    JsonNode page = MAPPER.readTree(response.body());
                    page.path("data").forEach(found::add);
                    url = page.path("next").isTextual() ? page.path("next").asText() : null;
                }
                return found;
            }
            """,

        ("api", "py") => $$"""
            import time
            import requests

            s = requests.Session()
            s.headers["Authorization"] = "Bearer {{KeyText}}"

            # Up to 500 rows a page. `next` is the full URL of the next page: follow it as it is
            # until it is None. 600 requests a minute per key: a 429 is waited out for its
            # Retry-After and asked again, and any other failure raises, so a sweep is never cut
            # short in silence.
            def rows(url):
                while url:
                    r = s.get(url)
                    if r.status_code == 429:
                        time.sleep(int(r.headers.get("Retry-After", "60")))
                        continue
                    r.raise_for_status()

                    page = r.json()
                    yield from page["data"]
                    url = page["next"]

            # The players who shared with this tool, then each one's best scores by id.
            # A tool key has no "me" — that is a personal token's own scores.
            for player in rows("{{Base}}api/v2/players?limit=500"):
                for score in rows(f"{{Base}}api/v2/players/{player['userId']}/scores?mix={{Mix}}&limit=500"):
                    print(player["username"], score["chartId"], score["score"], score["letterGrade"])
            """,

        ("api", "ts") => $$"""
            const headers = { Authorization: "Bearer {{KeyText}}" };

            // Up to 500 rows a page. `next` is the full URL of the next page: follow it as it is
            // until it is null. 600 requests a minute per key: a 429 is waited out for its
            // Retry-After and asked again, and any other failure throws, so a sweep is never cut
            // short in silence.
            async function* rows(url: string | null): AsyncGenerator<any> {
              while (url) {
                const res = await fetch(url, { headers });
                if (res.status === 429) {
                  const wait = Number(res.headers.get("Retry-After") ?? 60);
                  await new Promise(resolve => setTimeout(resolve, 1000 * wait));
                  continue;
                }
                if (!res.ok) throw new Error(`${res.status} ${url}: ${await res.text()}`);

                const page = await res.json();
                yield* page.data;
                url = page.next;
              }
            }

            // The players who shared with this tool, then each one's best scores by id.
            // A tool key has no "me" — that is a personal token's own scores.
            for await (const player of rows("{{Base}}api/v2/players?limit=500"))
              for await (const score of rows(
                `{{Base}}api/v2/players/${player.userId}/scores?mix={{Mix}}&limit=500`))
                console.log(player.username, score.chartId, score.score, score.letterGrade);
            """,

        ("webhook", "cs") => $$"""
            [ApiController]
            [Route("{{Route.TrimStart('/')}}")]
            public sealed class PiuScoresController : ControllerBase
            {
                [HttpPost]
                public async Task<IActionResult> Receive([FromBody] JsonElement body)
                {
                    if (Request.Headers["{{Header}}"] != _config.Token)
                        return Unauthorized();

                    // The verification call. Answer with your secret, nothing else.
                    if (body.TryGetProperty("type", out var type)
                        && type.GetString() == "url_verification")
                        return Content(_config.VerificationSecret);

                    // X-PIU-Delivery-Id is stable across retries — dedupe on it.
                    if (!await _seen.Add(Request.Headers["X-PIU-Delivery-Id"]!))
                        return Ok();

                    foreach (var score in body.GetProperty("scores").EnumerateArray())
                        await _store.Upsert(score);

                    return Ok();
                }
            }
            """,

        ("webhook", "java") => $$"""
            @RestController
            public class PiuScoresController {

                @PostMapping("{{Route}}")
                public ResponseEntity<String> receive(
                        @RequestHeader("{{Header}}") String token,
                        @RequestHeader("X-PIU-Delivery-Id") String deliveryId,
                        @RequestBody JsonNode body) {

                    if (!config.token().equals(token))
                        return ResponseEntity.status(401).build();

                    // The verification call. Answer with your secret, nothing else.
                    if ("url_verification".equals(body.path("type").asText()))
                        return ResponseEntity.ok(config.verificationSecret());

                    // X-PIU-Delivery-Id is stable across retries — dedupe on it.
                    if (!seen.add(deliveryId))
                        return ResponseEntity.ok().build();

                    for (JsonNode score : body.path("scores"))
                        store.upsert(score);

                    return ResponseEntity.ok().build();
                }
            }
            """,

        ("webhook", "py") => $$"""
            @app.post("{{Route}}")
            async def piu(request: Request):
                if request.headers.get("{{Header}}") != PIU_TOKEN:
                    raise HTTPException(401)

                body = await request.json()

                # The verification call. Answer with your secret, nothing else.
                if body.get("type") == "url_verification":
                    return PlainTextResponse(PIU_VERIFICATION_SECRET)

                # X-PIU-Delivery-Id is stable across retries — dedupe on it.
                delivery_id = request.headers["X-PIU-Delivery-Id"]
                if delivery_id in seen:
                    return {"ok": True}
                seen.add(delivery_id)

                for score in body["scores"]:
                    upsert(score)

                return {"ok": True}
            """,

        _ => $$"""
            app.post("{{Route}}", express.json(), (req, res) => {
              if (req.header("{{Header}}") !== process.env.PIU_TOKEN)
                return res.sendStatus(401);

              // The verification call. Answer with your secret, nothing else.
              if (req.body.type === "url_verification")
                return res.type("text/plain").send(process.env.PIU_VERIFICATION_SECRET);

              // X-PIU-Delivery-Id is stable across retries — dedupe on it.
              const id = req.header("X-PIU-Delivery-Id")!;
              if (seen.has(id)) return res.sendStatus(200);
              seen.add(id);

              for (const score of req.body.scores) upsert(score);

              res.sendStatus(200);
            });
            """
    };
}
