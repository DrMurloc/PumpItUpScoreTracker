@page "/Developers/{ToolId:guid}"
@rendermode RenderModes.Interactive
@using MediatR
@using ScoreTracker.CommunityTools.Contracts
@using ScoreTracker.CommunityTools.Contracts.Queries
@using ScoreTracker.Web.Components.CommunityTools
@using ScoreTracker.Web.Services
<PageTitle>@L["Developers"]</PageTitle>

@* Is anything wrong, and what is this tool doing.

   There is deliberately no readiness checklist. A listing-only tool has no key and no endpoint and
   is not unfinished — presenting five steps would nag it forever about things it will never have.
   Groups appear when the thing they measure exists, and the amber strip appears only when something
   is genuinely broken. *@

<ToolConsoleFrame Section="overview" ToolId="ToolId" Context="tool">
    @if (!tool.CanBeSharedWithOthers)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-4">
            <div class="d-flex align-center gap-3 flex-wrap">
                <MudText Typo="Typo.body2" Class="flex-grow-1">
                    <b>@L["Only you can use this tool right now."]</b>
                    @L["Add a public source repository and your Discord handle, then check the link. Until then invite links and listing are closed."]
                </MudText>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           Href="@($"/Developers/{tool.Id}/tool")">@L["Fix it"]</MudButton>
            </div>
        </MudAlert>
    }
    else if (tool.WebhookMode != WebhookMode.None && tool.WebhookUrlVerifiedAt is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-4">
            <div class="d-flex align-center gap-3 flex-wrap">
                <MudText Typo="Typo.body2" Class="flex-grow-1">
                    <b>@L["Your endpoint hasn't answered yet."]</b>
                    @L["Nothing is delivered until it does."]
                </MudText>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           Href="@($"/Developers/{tool.Id}/webhooks")">@L["Set it up"]</MudButton>
            </div>
        </MudAlert>
    }

    <div class="ct-group">
        <MudText Typo="Typo.subtitle2">@L["Directory"]</MudText>
        <MudLink Href="@($"/Developers/{tool.Id}/tool")" Typo="Typo.caption">@L["Edit listing"]</MudLink>
    </div>
    <div class="ct-stats">
        @if (tool.Kind == ToolKind.Integrated)
        {
            <Stat N="@tool.ConnectedPlayers.ToString()" K="@L["Players"].Value"></Stat>
        }
        <Stat N="@_summary.Clicks.ToString()" K="@L["Clicks · 24h"].Value"></Stat>
        <Stat Small="true" K="@L["Listed since"].Value"
              N="@(tool.ApprovedAt?.LocalDateTime.ToString("d MMM") ?? L["Not listed"].Value)"></Stat>
    </div>

    @* Only when there is something to measure. A tool with no live key is not being told it is
       missing one — that is the maker's choice, not an unfinished step. *@
    @if (tool.HasKeys)
    {
        <div class="ct-group">
            <MudText Typo="Typo.subtitle2">@L["API"]</MudText>
            <MudLink Href="@($"/Developers/{tool.Id}/api")" Typo="Typo.caption">@L["Manage keys"]</MudLink>
        </div>
        <div class="ct-stats">
            <Stat N="@_summary.Calls.ToString("N0")" K="@L["Calls · 24h"].Value"></Stat>
            <Stat N="@_summary.RateLimited.ToString("N0")" K="@L["Rate limited · 24h"].Value"></Stat>
        </div>
    }

    @if (tool.WebhookConfigured)
    {
        <div class="ct-group">
            <MudText Typo="Typo.subtitle2">@L["Webhooks"]</MudText>
            <MudLink Href="@($"/Developers/{tool.Id}/webhooks")" Typo="Typo.caption">@L["Configure"]</MudLink>
        </div>
        <div class="ct-stats">
            <Stat N="@_summary.Deliveries.ToString("N0")" K="@L["Delivered · 24h"].Value"></Stat>
            <Stat N="@_summary.Failures.ToString("N0")" K="@L["Failed · 24h"].Value"></Stat>
        </div>
    }

    <div class="ct-group">
        <MudText Typo="Typo.subtitle2">@L["Latest"]</MudText>
        @if (tool.WebhookConfigured)
        {
            <MudLink Href="@($"/Developers/{tool.Id}/webhooks")" Typo="Typo.caption">@L["Full log"]</MudLink>
        }
    </div>
    @if (!_activity.Any())
    {
        <MudText Typo="Typo.body2" Style="opacity:.7;">@L["Nothing yet."]</MudText>
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-2">
            @foreach (var row in _activity.Take(6))
            {
                <div class="olb-rank-card">
                    <MudText Typo="Typo.caption" Style="opacity:.7;min-width:62px;">
                        @row.OccurredAt.LocalDateTime.ToString("HH:mm")
                    </MudText>
                    <MudText Typo="Typo.body2" Class="flex-grow-1">@ActivityLabel(row)</MudText>
                    <div class="olb-rank-tail">
                        @if (row.RemoteStatusCode is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="@(row.RemoteStatusCode < 300 ? Color.Success : Color.Error)">
                                @row.RemoteStatusCode
                            </MudChip>
                        }
                    </div>
                </div>
            }
        </MudPaper>
    }
</ToolConsoleFrame>

@inject IMediator Mediator
@code {
    [Parameter] public Guid ToolId { get; set; }

    private ToolActivitySummary _summary = new(0, 0, 0, 0, 0, 0);
    private IReadOnlyList<ToolActivityRecord> _activity = Array.Empty<ToolActivityRecord>();

    protected override async Task OnParametersSetAsync()
    {
        _summary = await Mediator.Send(new GetToolActivitySummaryQuery(ToolId));
        _activity = await Mediator.Send(new GetToolActivityQuery(ToolId, 25));
    }

    /// <summary>The console's closed vocabulary — never a framework string, never an exception.</summary>
    private string ActivityLabel(ToolActivityRecord row) => row.Kind switch
    {
        ToolActivityKind.DeliverySucceeded => L["Delivered"].Value,
        ToolActivityKind.DeliveryTimedOut => L["Delivery timed out"].Value,
        ToolActivityKind.DeliveryRejected => L["Delivery rejected"].Value,
        ToolActivityKind.DeliveryUnreachable => L["Couldn't reach your server"].Value,
        ToolActivityKind.RateLimited => L["Rate limited {0} times", row.Count].Value,
        ToolActivityKind.KeyUsed => L["{0} API calls", row.Count].Value,
        ToolActivityKind.KeyExpired => L["A key expired"].Value,
        ToolActivityKind.PlayerConnected => L["A player connected"].Value,
        ToolActivityKind.PlayerDisconnected => L["A player disconnected"].Value,
        ToolActivityKind.DirectoryClicked => L["{0} directory clicks", row.Count].Value,
        _ => string.Empty
    };
}
