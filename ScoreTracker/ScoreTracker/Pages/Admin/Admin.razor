@using MassTransit
@using ScoreTracker.ScoreLedger.Contracts.Messages
@using ScoreTracker.ChartIntelligence.Contracts.Messages
@page "/Admin"
@rendermode RenderModes.Interactive
@using MediatR
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.Communities.Contracts.Messages
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.Identity.Contracts.Commands
@using ScoreTracker.Identity.Contracts.Queries
@using ScoreTracker.PlayerProgress.Contracts.Messages
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Services.Contracts

<PageTitle>@L["Admin"]</PageTitle>

@* Recurring work is triggered from the Hangfire dashboard's "Trigger now", not from here.
   What is left is the handful of operations Hangfire cannot express: cache eviction,
   moderation, credential security, and one-off chart metadata. *@
<MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="ClearCache">@L["Clear Cache"]</MudButton>
<MudButton Color="Color.Warning" Variant="Variant.Outlined" Href="/Admin/PiuCenter">PIU Center</MudButton>
<MudButton Color="Color.Warning" Variant="Variant.Outlined" Href="/Admin/OfficialLeaderboards">Official Leaderboards</MudButton>
<MudButton Color="Color.Warning" Variant="Variant.Outlined" Href="/Admin/CommunityTools">@L["Community Tools"]</MudButton>
<MudButton Color="Color.Warning" Variant="Variant.Outlined" Href="/Admin/Comments">@L["Reported Comments"]</MudButton>
@* Scoped to one session per player on purpose: a rebuild computes against today's state, and
   the further back it reaches the less that resembles the state it is claiming to restore. *@
<MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="RebuildLatestSessions"
           data-testid="rebuild-latest-sessions">@L["Rebuild Latest Sessions"]</MudButton>
@* The manual trigger for the same sweep the five-minute job runs, for when a player reports a
   silent import before the next tick. Safe to press at any time, including while a sweep is
   already working: it touches only batches past their deadline and sessions that are stale,
   undrained and unprocessed, and the first pass's counts take those out of scope as it goes. *@
<MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="FlushStuckScoreBatches"
           data-testid="flush-stuck-score-batches">@L["Flush Stuck Score Batches"]</MudButton>
@* One-shot for the highlights cutover: copies pre-move win payloads into the player-keyed
   ledger so feeds keep their history instead of starting empty. Idempotent — a second run
   collides on every event id and changes nothing. *@
<MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="BackfillPlayerHighlights"
           data-testid="backfill-player-highlights">@L["Backfill Highlights"]</MudButton>
@* The exit path for a scoring-formula change. Every PUMBILITY figure a player can see is
   computed from raw scores at read time and is already correct on deploy; what a formula
   change leaves stale is the STORED ratings and per-chart values, which otherwise refresh
   only when that player next imports. Deliberately silent — no milestones, no history rows,
   no Discord — because a formula moving is not something a player did. Safe to re-run. *@
@foreach (var mix in RepriceableMixes)
{
    <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="@(() => RepriceRatings(mix))"
               data-testid="@($"reprice-ratings-{mix}")">@L["Re-price {0} ratings", mix.GetName()]</MudButton>
}

@* The PUMBILITY lens reads a nightly census, so a fresh deploy shows nothing until the job
   first runs — and locally PreventRecurringJobs parks it on a yearly cron, where the Hangfire
   dashboard cannot trigger it either. Safe to re-run: the job rewrites each folder wholesale. *@
@foreach (var mix in RepriceableMixes)
{
    <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="@(() => RebuildPumbilityCensus(mix))"
               data-testid="@($"rebuild-pumbility-census-{mix}")">@L["Rebuild {0} PUMBILITY tier lists", mix.GetName()]</MudButton>
}

<MudCard>
    <MudCardHeader>@L["Credential security"]</MudCardHeader>
    <MudCardContent>
        <MudText Typo="Typo.body2" Class="mb-2">@L["Deletes every saved import password on every device. Users re-enter on their next import. Use if you suspect a breach."]</MudText>
        @if (!_confirmingCycle)
        {
            <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="@(() => _confirmingCycle = true)">@L["Cycle all credential keys"]</MudButton>
        }
        else
        {
            <MudButton OnClick="@(() => _confirmingCycle = false)">@L["Cancel"]</MudButton>
            <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="_cycling" OnClick="CycleCredentialKeys">@L["Yes, cycle all keys"]</MudButton>
        }
    </MudCardContent>
</MudCard>
<MudCard>
    <MudCardHeader>@L["Content Lock"]</MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12">
                <MudAutocomplete T="ScoreTracker.Domain.Models.User"
                                 Value="_lockTargetUser"
                                 ValueChanged="SelectLockTarget"
                                 Label=@L["Search User (Name or UserId)"]
                                 SearchFunc="SearchLockUsers"
                                 ToStringFunc="@(u => u == null ? string.Empty : $"{u.Name} - {u.Id}")"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 MaxItems="25"
                                 DebounceInterval="300"></MudAutocomplete>
            </MudItem>
            @if (_lockTargetUser != null)
            {
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Id" Disabled="true" Value="@_lockTargetUser.Id.ToString()"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label=@L["Current Username"] Disabled="true" Value="@_lockTargetUser.Name.ToString()"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label=@L["GameTag"] Disabled="true" Value="@(_lockTargetUser.GameTag?.ToString() ?? string.Empty)"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label=@L["Lock Status"] Disabled="true" Value="@(_lockTargetUser.IsContentLocked ? L["Locked"].Value : L["Unlocked"].Value)"></MudTextField>
                </MudItem>
                <MudItem xs="12">
                    @if (_lockTargetUser.IsContentLocked)
                    {
                        <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="_isContentLockSaving" OnClick="UnlockUser">@L["Unlock User"]</MudButton>
                    }
                    else
                    {
                        <MudButton Color="Color.Warning" Variant="Variant.Filled" Disabled="_isContentLockSaving" OnClick="OpenLockDialog">@L["Lock User"]</MudButton>
                    }
                </MudItem>
            }
        </MudGrid>
    </MudCardContent>
</MudCard>

<MudDialog @bind-Visible="_showLockDialog">
    <DialogContent>
        @if (_lockTargetUser != null)
        {
            @if (_lockTargetUser.GameTag != null)
            {
                <MudText>@L["Locking will set this user's username to their GameTag."]</MudText>
                <br />
                <MudText Typo="Typo.body2">@($"{_lockTargetUser.Name} → {_lockTargetUser.GameTag}")</MudText>
            }
            else
            {
                <MudText>@L["This user has no GameTag. Choose a username to assign before locking."]</MudText>
                <br />
                <MudTextField T="string" Label=@L["New Username"] MaxLength="100" @bind-Value="_lockOverrideName"></MudTextField>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudSpacer></MudSpacer>
        <MudButton Variant="Variant.Text" OnClick="() => _showLockDialog = false" Color="Color.Default">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="_isContentLockSaving" OnClick="LockUser">@L["Lock User"]</MudButton>
    </DialogActions>
</MudDialog>

<MudCard>
    <MudCardHeader>@L["Update Chart"]</MudCardHeader>
    <MudCardContent>
        <MudItem xs="12">
            <MudAutocomplete T="string"
                             @ref="_autocomplete"
                             Value="@_songSearchString"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             ResetValueOnEmptyText="true"
                             CoerceText="true"
                             Label=@L["Song"]
                             SearchFunc="(s,c)=>Search(s)"
                             ValueChanged="@SelectSong" MaxItems="100">

            </MudAutocomplete>
        </MudItem>
        @if (Charts.Any())
        {


            <MudItem sm="4" xs="12">
                <MudSelect T="Chart" Label=@L["Chart"] Value="_selectedChart" ValueChanged="SelectChart">
                    @foreach (var chart in Charts)
                    {
                        <MudSelectItem Value="chart">@chart.DifficultyString</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }
        @if (_selectedChart != null)
        {
            <MudItem sm="4" xs="12">
                <MudTextField Label=@L["Video URL"] @bind-Value="_videoUrl"></MudTextField>
            </MudItem>
            <MudItem sm="4" xs="12">
                <MudTextField Label=@L["Channel Name"] @bind-Value="_videoChannel"></MudTextField>
            </MudItem>
            <MudItem sm="4" xs="12">
                <MudButton Variant="Variant.Filled" Disabled="_isSaving" Color="Color.Primary" OnClick="SaveChart">@L["Save"]</MudButton>
            </MudItem>
        }
        </MudCardContent>
</MudCard>
<MudCard>
    <MudCardHeader>@L["Create Song"]</MudCardHeader>
    <MudCardContent>
        @* Songs and charts are added by dropping the generated JSON batch on the bulk page —
           the hand-entry form it replaced only ever wrote to Phoenix. *@
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlaylistAdd"
                   Href="/Admin/BulkAddCharts">@L["Bulk Add Charts"]</MudButton>
    </MudCardContent>
</MudCard>

@inject ICurrentUserAccessor CurrentUser;
@inject IChartRepository _charts;
@inject IMediator Mediator;
@inject IUiSettingsAccessor UiSettings;
@inject ISnackbar Snackbar
@inject IBus Bus
@inject NavigationManager NavManager;
@code
{
    private MudAutocomplete<string> _autocomplete;
    private Chart? _selectedChart;
    private string _songSearchString = string.Empty;
    private Chart[] Charts = Array.Empty<Chart>();
    private IEnumerable<string> SongNames = Array.Empty<string>();
    private string _videoUrl = string.Empty;
    private string _videoChannel = string.Empty;
    private bool _isSaving = false;

    private Task<IEnumerable<string>> Search(string song) =>
        Task.FromResult(SongNames.Where(n => n.ToLower().Contains(song?.ToLower() ?? ""))
            .OrderBy(n => n.Equals(song, StringComparison.OrdinalIgnoreCase) ? 0 : 1).ToArray().AsEnumerable());

    private void ClearCache()
    {
        _charts.ClearCache();
    }

    private async Task RebuildLatestSessions()
    {
        await Bus.Publish(new RebuildLatestSessionsCommand());
        Snackbar.Add(L["Rebuilding the latest session for every player."].Value, Severity.Success);
    }

    private async Task FlushStuckScoreBatches()
    {
        await Bus.Publish(new FlushOverdueScoreBatchesCommand());
        Snackbar.Add(L["Announcing score batches that never fired, and replaying sessions whose batch is gone."].Value,
            Severity.Success);
    }

    private async Task BackfillPlayerHighlights()
    {
        await Bus.Publish(new BackfillPlayerHighlightsCommand());
        Snackbar.Add(L["Copying existing highlights into the new feed store."].Value, Severity.Success);
    }

    // The two mixes with a PUMBILITY formula. A legacy mix has no stored rating to re-price.
    private static readonly MixEnum[] RepriceableMixes = { MixEnum.Phoenix, MixEnum.Phoenix2 };

    private async Task RepriceRatings(MixEnum mix)
    {
        await Bus.Publish(new RecalculateMixRatingsCommand(mix));
        Snackbar.Add(L["Re-pricing stored {0} ratings. Nothing is announced.", mix.GetName()].Value,
            Severity.Success);
    }

    private async Task RebuildPumbilityCensus(MixEnum mix)
    {
        await Bus.Publish(new ProcessPumbilityCensusCommand(mix));
        Snackbar.Add(L["Rebuilding the {0} PUMBILITY census. It takes a few minutes.", mix.GetName()].Value,
            Severity.Success);
    }

    private bool _confirmingCycle;
    private bool _cycling;

    private async Task CycleCredentialKeys()
    {
        _cycling = true;
        await Mediator.Send(new CycleAllImportCredentialKeysCommand());
        _cycling = false;
        _confirmingCycle = false;
        Snackbar.Add(L["All saved credentials have been cleared."].Value, Severity.Success);
    }

    private async Task SelectChart(Chart chart)
    {
        var video = await Mediator.Send(new GetChartVideosQuery(new[] { chart.Id }));
        _selectedChart = chart;
        _videoUrl = video.FirstOrDefault()?.VideoUrl.ToString() ?? string.Empty;
        _videoChannel = video.FirstOrDefault()?.ChannelName.ToString() ?? string.Empty;
    }

    private async Task SaveChart()
    {
        if (_selectedChart==null || !Uri.TryCreate(_videoUrl, UriKind.Absolute, out var url) || !Name.TryParse(_videoChannel, out var channel))
        {
            Snackbar.Add(L["Video info is not formatted correctly"].Value, Severity.Error);
            return;
        }
        _isSaving = true;
        await _charts.SetChartVideo(_selectedChart.Id, url, channel);
        _isSaving = false;
        Snackbar.Add(L["Chart saved"].Value, Severity.Success);
    }

    private async Task SelectSong(string songName)
    {
        songName = songName ?? string.Empty;
        if (_autocomplete.Open)
        {
            await _autocomplete.ToggleMenuAsync();
        }
        _songSearchString = songName;
        _selectedChart = null;
        if (!Name.TryParse(songName, out var name))
        {
            Charts = Array.Empty<Chart>();
            return;
        }

        Charts = (await Mediator.Send(new GetChartsBySongQuery(await UiSettings.GetSelectedMix(), name))).ToArray();

    }

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.User.IsAdmin)
        {
            NavManager.NavigateTo("/");
            return;
        }
        SongNames = (await Mediator.Send(new GetChartsQuery(await UiSettings.GetSelectedMix()))).Select(c => c.Song.Name.ToString()).Distinct().ToArray();
    }

    private ScoreTracker.Domain.Models.User? _lockTargetUser;
    private bool _showLockDialog = false;
    private bool _isContentLockSaving = false;
    private string _lockOverrideName = string.Empty;

    private async Task<IEnumerable<ScoreTracker.Domain.Models.User>> SearchLockUsers(string searchText, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return Array.Empty<ScoreTracker.Domain.Models.User>();
        return await Mediator.Send(new AdminSearchUsersQuery(searchText), cancellationToken);
    }

    private void SelectLockTarget(ScoreTracker.Domain.Models.User? user)
    {
        _lockTargetUser = user;
        _lockOverrideName = string.Empty;
    }

    private void OpenLockDialog()
    {
        _lockOverrideName = string.Empty;
        _showLockDialog = true;
    }

    private async Task LockUser()
    {
        if (_lockTargetUser == null) return;
        Name? overrideName = null;
        if (_lockTargetUser.GameTag == null)
        {
            if (!Name.TryParse(_lockOverrideName, out var parsed))
            {
                Snackbar.Add(L["Invalid Name"].Value, Severity.Error);
                return;
            }
            overrideName = parsed;
        }
        _isContentLockSaving = true;
        try
        {
            await Mediator.Send(new SetUserContentLockCommand(_lockTargetUser.Id, true, overrideName));
            _lockTargetUser = await Mediator.Send(new GetUserByIdQuery(_lockTargetUser.Id));
            _showLockDialog = false;
            Snackbar.Add(L["User locked"].Value, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isContentLockSaving = false;
        }
    }

    private async Task UnlockUser()
    {
        if (_lockTargetUser == null) return;
        _isContentLockSaving = true;
        try
        {
            await Mediator.Send(new SetUserContentLockCommand(_lockTargetUser.Id, false, null));
            _lockTargetUser = await Mediator.Send(new GetUserByIdQuery(_lockTargetUser.Id));
            Snackbar.Add(L["User unlocked"].Value, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isContentLockSaving = false;
        }
    }
}
