@namespace ScoreTracker.Web.Components
@using Microsoft.JSInterop
@using ScoreTracker.ChartComments.Contracts
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.Web.Components.ChartComments
@using ScoreTracker.Web.Services
@inject IJSRuntime JS
@inject IStringLocalizer<App> L

@* The dialog's Steps tab (docs/design/step-chart-failure-map.md D14): the same shell the
   chart page renders, compact — tighter scales, and the whole-chart minimap sized to the
   compact strip (the dialog had dead space right of the rail; owner, 2026-08-31) — mounted
   by the same step-chart.js the moment the tab first becomes active, so a dialog that never
   shows the tab never fetches a timeline. The module reads everything from the data
   attributes and the strings block; this component owns no chart data at all. *@
<div class="stepchart-compact" data-stepchart data-chart-id="@Chart.Id" data-mix="@Mix"
     data-visibility="@Visibility" data-compact="1" data-level="@((int)Chart.Level)" @ref="_root" @key="Chart.Id">
    <script type="application/json" data-stepchart-strings>@StepChartStrings.For(L)</script>
    <div class="stepchart-caveat" data-stepchart-caveat hidden>@L["Where runs end isn't shown — this step file disagrees with the game's judged note count."]</div>
    <div class="stepchart-toolbar">
        <div class="stepchart-modes" role="group" aria-label="@L["Arrow coloring"]">
            <button type="button" data-stepchart-mode="arrow" aria-pressed="true">@L["Arrows"]</button>
            <button type="button" data-stepchart-mode="foot" aria-pressed="false">@L["Feet"]</button>
        </div>
        <div class="stepchart-av" role="group" aria-label="@L["Scroll speed"]">
            <button type="button" data-stepchart-av="-50">&minus;</button>
            <span class="stepchart-av-value" data-stepchart-av-value>AV</span>
            <button type="button" data-stepchart-av="50">+</button>
            <button type="button" data-stepchart-av="auto" aria-pressed="true">@L["Auto"]</button>
        </div>
    </div>
    <div class="stepchart-chips" data-stepchart-chips></div>
    <div class="stepchart-viewer">
        <div class="stepchart-scroll" data-stepchart-scroll tabindex="0" aria-label="@L["Step chart"]"></div>
        <div class="stepchart-minicol">
            <canvas class="stepchart-minimap" data-stepchart-minimap></canvas>
        </div>
        @if (CommentsVisible)
        {
            @* The same sticky panel the chart page carries (step-chart-comments D4); Open
               thread is the dialog's tab switch, so it raises to the host here. *@
            <StepChartCommentPanel ChartId="Chart.Id" Mix="Mix" Active="Active" OnOpenThread="OnOpenThread"
                                   @key="(Chart.Id, nameof(StepChartCommentPanel))"></StepChartCommentPanel>
        }
    </div>
    <div class="stepchart-legend" data-stepchart-legend></div>
</div>

@code {
    [Parameter] public Chart Chart { get; set; } = default!;
    [Parameter] public MixEnum Mix { get; set; }

    /// <summary>The mix's verdict as the dialog read it — "Full" or "StepsOnly".</summary>
    [Parameter] public string Visibility { get; set; } = "StepsOnly";

    /// <summary>Visible AND selected — the mount fires on the first true, never before.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>The comment gate, decided by the dialog; off, the strip carries no panel.</summary>
    [Parameter] public bool CommentsVisible { get; set; }

    /// <summary>The panel's Open thread: the comment and the scope it lives in, for the host's tab switch.</summary>
    [Parameter] public EventCallback<(Guid CommentId, CommentAudience Audience)> OnOpenThread { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module;
    private bool _mounted;
    private decimal? _pendingSecond;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Active || _mounted) return;
        _mounted = true;
        // The import map rewrites the specifier to the content-hashed asset; mount() guards
        // its own element, so a re-render after mounting is a no-op on the JS side too.
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/step-chart.js");
        await _module.InvokeVoidAsync("mount", _root);
        if (_pendingSecond is { } second)
        {
            _pendingSecond = null;
            await _module.InvokeVoidAsync("selectSecond", _root, second);
        }
    }

    /// <summary>
    ///     Lands the strip on a second — a time chip in the Comments tab was tapped
    ///     (step-chart-comments §3). Asked before the tab has ever been shown, it waits for the
    ///     mount; the module itself waits for the strip's own fetch.
    /// </summary>
    public async Task SelectSecond(decimal second)
    {
        if (_module == null)
        {
            _pendingSecond = second;
            return;
        }

        await _module.InvokeVoidAsync("selectSecond", _root, second);
    }
}
