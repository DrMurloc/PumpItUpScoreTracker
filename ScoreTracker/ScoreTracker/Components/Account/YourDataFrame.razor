@namespace ScoreTracker.Web.Components.Account

@* The shared chrome for the two Your Data routes. Undo comes first because it is the safer of
   the pair and the one most people actually want. *@
@* Same segmented control the folder picker uses for chart type: filled = active, outlined =
   not. Sat right-aligned across the header first and was easy to miss — it reads as a switch
   only when it is next to the thing it switches. *@
<div class="d-flex align-center flex-wrap gap-4 mb-4 pb-3 yourdata-head">
    <MudText Typo="Typo.h5" Class="mr-1">@L["Your Data"]</MudText>
    <MudButtonGroup OverrideStyles="false" Class="folder-picker-types">
        <MudButton Href="/Account/Data/Undo" Size="Size.Small" Color="Color.Primary"
                   Variant="@(Active == YourDataTab.Undo ? Variant.Filled : Variant.Outlined)">@L["Undo"]</MudButton>
        <MudButton Href="/Account/Data/Delete" Size="Size.Small" Color="Color.Primary"
                   Variant="@(Active == YourDataTab.Delete ? Variant.Filled : Variant.Outlined)">@L["Delete"]</MudButton>
    </MudButtonGroup>
</div>

@ChildContent

<style>
    .yourdata-head { border-bottom: 1px solid color-mix(in srgb, var(--mix-ink) 12%, transparent); }
</style>

@code {

    public enum YourDataTab
    {
        Undo,
        Delete
    }

    [Parameter] public YourDataTab Active { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

}
