@using ScoreTracker.Catalog.Contracts
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.CommunityTools.Contracts.Commands
@using ScoreTracker.CommunityTools.Contracts.Queries
@using System.Globalization
@using System.Web
@using CsvHelper
@using MediatR
@using ScoreTracker.Domain.Records
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.Identity.Contracts
@using ScoreTracker.Identity.Contracts.Commands
@using ScoreTracker.Identity.Contracts.Queries
@using ScoreTracker.ScoreLedger.Contracts
@using ScoreTracker.ScoreLedger.Contracts.Commands
@using ScoreTracker.ScoreLedger.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Dtos
@using ScoreTracker.Web.Services.Contracts
@using ScoreTracker.Web.Services.Theming
@using ScoreTracker.Domain.Models

@* The avatar leads the panel: it is the only field here you look at rather than read.
   Auto follows the official profile on every import; pinned is the player's own choice and
   imports leave it alone (docs/design/avatar-selection.md). *@
<div class="av-row">
    <div class="av-preview">
        @* Guarded, not defaulted: the avatar loads in OnInitializedAsync, and an img with no src
           paints a broken-image glyph for the first render. *@
        @if (_avatar is not null)
        {
            <img class="av-preview-big" src="@_avatar.ImageUrl" alt=""/>
            @* The same picture at the size the app bar shows it, because a 4:3 avatar cropped to
               a circle loses its edges and that is worth seeing before you commit to it. *@
            <img class="av-preview-small" src="@_avatar.ImageUrl" alt=""
                 title="@L["How it looks in the top bar"]"/>
        }
    </div>
    <div class="av-row-meta">
        <div class="av-cap">@L["Avatar"]</div>
        <div class="av-row-title">
            @if (_avatar?.IsPinned == true)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Tertiary">@L["Pinned"]</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@L["Auto"]</MudChip>
            }
        </div>
        <MudText Typo="Typo.body2" Style="opacity:.75;">
            @(_avatar?.IsPinned == true
                ? L["Imports refresh your scores and game tag but leave this avatar alone."]
                : L["Follows your PIUGAME profile — every import picks up whatever it wears."])
        </MudText>
    </div>
    <div class="av-row-actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isLoadingAvatars"
                   StartIcon="@Icons.Material.Filled.Face" OnClick="OpenAvatarPicker">@L["Change avatar"]</MudButton>
        @if (_avatar?.IsPinned == true)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="UnpinAvatar">@L["Back to Auto"]</MudButton>
        }
    </div>
</div>

<AvatarPickerDialog Avatars="_avatars" Current="_avatar?.ImageUrl"
                    @bind-Visible="_showAvatarPicker" OnPicked="PinAvatar"></AvatarPickerDialog>

<MudDivider Class="mb-6"></MudDivider>

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudTextField T="string"
                      Disabled="_isUpdatingUser || _isContentLocked"
                      Label=@L["Username"]
                      MaxLength="100"
                      Value="@_name"
                      ValueChanged="UpdateName"
                      HelperText="@(_isContentLocked ? L["Your account is content-locked. Message an admin if you have questions."].Value : null)"></MudTextField>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="string" Value="_countryName" ValueChanged="UpdateCountry" Label=@L["Country"] Clearable="true">
            @foreach (var country in _countries)
            {
                <MudSelectItem T="string" Value="country.Name">
                    <MudImage Height="15" ObjectFit="ObjectFit.ScaleDown" Src="@country.ImagePath.ToString()"></MudImage>
                    @country.Name
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="string" Disabled="_isUpdatingUser" Label="@L["Language"]" Value="_currentCulture" ValueChanged="UpdateCulture">
            @* First, and the value a player who has never chosen sits on: it is what they are
               already getting, and picking a real language from here is a genuine change — a
               preselected browser language would be one the picker could not act on. *@
            <MudSelectItem T="string" Value="@SupportedCultures.Automatic">@L["Automatic"]</MudSelectItem>
            @foreach (var culture in SupportedCultures.All)
            {
                <MudSelectItem T="string" Value="@culture.Code">@culture.NativeName</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        @* Perma-set the theme to one mix, overriding the theme-follows-mix default. *@
        <MudSelect T="string" Label=@L["Site Theme"] Value="_themeOverride" ValueChanged="UpdateThemeOverride">
            <MudSelectItem T="string" Value="@MixThemes.MatchMixValue">@L["Match Current Mix"]</MudSelectItem>
            @foreach (var mix in MixThemes.ThemedMixes)
            {
                <MudSelectItem T="string" Value="@mix.ToString()">@mix.GetName()</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12">
        <MudSwitch T="bool" Disabled="_isUpdatingUser" Label=@L["Public"] Value="_isPublic" ValueChanged="() => _showPublicConfirmDialog = true" Color="Color.Success"></MudSwitch>
    </MudItem>
    @* Sharing needs a public profile, so the switch is absent rather than disabled when private
       (owner call) — and the card below takes its place, because a lot of players don't know
       going public is an option at all. *@
    <MudItem xs="12">
        @if (_isPublic)
        {
            <MudSwitch T="bool" Disabled="_isUpdatingUser" Value="_shareWithAllTools"
                       ValueChanged="ToggleShareWithAllTools" Color="Color.Success"
                       Label=@L["Share my scores with community tools"]></MudSwitch>
            <MudText Typo="Typo.body2" Style="opacity:.75;" Class="ml-11">
                @L["Any tool that publishes its source code can read your scores. Mostly this powers score-analysis tools. Turning it off stops new access — tools may keep what they already collected."]
            </MudText>
            <div class="d-flex align-center gap-2 ml-11 mt-2 flex-wrap">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                    @L["{0} tools reading now", _connectedToolCount]
                </MudChip>
                <MudButton Size="Size.Small" Variant="Variant.Text" Href="/CommunityTools">@L["See which"]</MudButton>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true">
                <MudText Typo="Typo.body2"><b>@L["Nothing is shared with tools"]</b></MudText>
                <MudText Typo="Typo.body2">
                    @L["Sharing your scores with community tools needs a public profile. You can also connect to a single tool with an invite link from its maker — that works either way."]
                </MudText>
                <div class="d-flex gap-2 mt-2 flex-wrap">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="() => _showPublicConfirmDialog = true">@L["Go public"]</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Href="/CommunityTools">@L["Browse tools"]</MudButton>
                </div>
            </MudAlert>
        }
    </MudItem>
</MudGrid>

<MudDivider Class="my-6"></MudDivider>
@* Who your scores are measured against and how that paints them (docs/design/peers-abstraction.md
   D1). The card states the current choice in words; the dialog is the only place it changes. *@
<div class="pcd-card" data-testid="peers-card">
    <div>
        <MudText Typo="Typo.h6">@L["Peers & score colors"]</MudText>
        <MudText Typo="Typo.body2" Style="opacity:.75;" data-testid="peers-card-summary">@PeersSummary</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Groups"
               OnClick="() => _showPeersDialog = true" data-testid="peers-customize">@L["Customize"]</MudButton>
</div>
<PeersAndColorsDialog @bind-Visible="_showPeersDialog" OnSaved="RefreshPeersSummary"></PeersAndColorsDialog>

<MudDivider Class="my-6"></MudDivider>
<MudText Typo="Typo.h6" Class="mb-2">@L["Your Data"]</MudText>
<div class="d-flex flex-wrap gap-2">
    <MudButton StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Outlined" Color="Color.Primary" OnClick="DownloadScores">@L["Download Scores"]</MudButton>
    <MudButton Href="/UploadXXScores" StartIcon="@Icons.Material.Filled.UploadFile" Variant="Variant.Text">@L["Upload XX Scores"]</MudButton>
</div>

@if (_pendingDeletion is not null)
{
    @* Where the sign-in notice sends people, carrying the same countdown so the two surfaces
       never disagree about how long is left. *@
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-6">
        <div class="d-flex align-center justify-space-between flex-wrap gap-3">
            <div>
                <MudText Typo="Typo.body2">
                    <b>@L["Your account is scheduled for deletion on {0}.", _pendingDeletion.PurgeAfter.LocalDateTime.ToString("D")]</b>
                </MudText>
                <MudText Typo="Typo.body2" Style="opacity:.8;">
                    @L["Until then your profile is hidden and your game tag is cleared."]
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CancelDeletion">
                @L["Cancel deletion"]
            </MudButton>
        </div>
    </MudAlert>
}

<MudPaper Outlined="true" Class="pa-4 mt-6" Style="border-color: var(--mud-palette-error);">
    <MudText Typo="Typo.h6" Color="Color.Error">@L["Danger Zone"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        @L["Undo an import, delete scores for one mix or all of them, or delete your account."]
    </MudText>
    <MudButton StartIcon="@Icons.Material.Filled.DeleteForever" Variant="Variant.Outlined" Color="Color.Error"
               Href="/Account/Data/Delete">@L["Manage or delete my data"]</MudButton>
</MudPaper>

<div class="d-flex align-center gap-1 mt-6">
    <MudTooltip Text=@L["Used Primarily for debugging"]>
        <MudText Typo="Typo.caption" Style="opacity: .7;">Id: @_id</MudText>
    </MudTooltip>
    <MudIconButton Size="Size.Small" OnClick="CopyUserId" Icon="@Icons.Material.Filled.ContentCopy"></MudIconButton>
</div>

<MudDialog @bind-Visible="_showPublicConfirmDialog">
    <DialogContent>
        @* Both branches gained copy: going public switches tool sharing ON, and going private
           switches it off and disconnects whatever was reading. Neither is a surprise a player
           should discover afterwards. *@
        @if (_isPublic)
        {
            <MudText>@L["Make Not Public Disclaimer"]</MudText>
            @if (_shareWithAllTools && _connectedToolCount > 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    <MudText Typo="Typo.body2">
                        <b>@L["This also disconnects {0} community tools.", _connectedToolCount]</b>
                    </MudText>
                    <MudText Typo="Typo.body2">
                        @L["Sharing with community tools needs a public profile, so it will be turned off. Tools you connected individually stay connected."]
                    </MudText>
                </MudAlert>
            }
        }
        else
        {
            <MudText>@L["Make Public Disclaimer 1"]</MudText>
            <br/>
            <MudText>@L["Make Public Disclaimer 2"]</MudText>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                <MudText Typo="Typo.body2"><b>@L["This also turns on sharing with community tools."]</b></MudText>
                <MudText Typo="Typo.body2">
                    @L["Any tool that publishes its source code will be able to read your scores — that's what powers most score-analysis tools. It's a separate switch and you can turn it off right after, on this page."]
                </MudText>
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudSpacer></MudSpacer>
        <MudButton Variant="Variant.Text"
                   OnClick="()=>_showPublicConfirmDialog=false"
                   Color="Color.Primary">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled"
                   OnClick="ToggleIsPublic"
                   Color="Color.Primary">@(_isPublic?@L["Make Private"]:@L["Make Public"])</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .av-row { display: grid; grid-template-columns: auto 1fr auto; gap: 1.25rem; align-items: center;
        margin-bottom: 1.25rem; }
    .av-preview { position: relative; }
    .av-preview-big { width: 104px; height: 78px; border-radius: 12px; object-fit: cover; display: block;
        box-shadow: 0 0 0 1px var(--mud-palette-lines-default); }
    .av-preview-small { position: absolute; right: -10px; bottom: -10px; width: 36px; height: 36px;
        border-radius: 50%; object-fit: cover; border: 2px solid var(--mud-palette-surface); }
    .av-cap { font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; opacity: .7; }
    .av-row-title { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin: .15rem 0 .25rem; }
    .av-row-actions { display: flex; flex-direction: column; gap: .4rem; align-items: stretch; }
    @@media (max-width: 640px) {
        .av-row { grid-template-columns: auto 1fr; }
        .av-row-actions { grid-column: 1 / -1; flex-direction: row; }
    }
</style>

@inject NavigationManager NavManager
@inject ICurrentUserAccessor CurrentUser;
@inject IMediator Mediator;
@inject ISnackbar Snackbar;
@inject IUiSettingsAccessor UiSettings;
@inject IJSRuntime JSRuntime;
@inject IUserRepository Users;
@inject ScoreColorPreferences Preferences;
@code
{
    private MyAvatarRecord? _avatar;
    private IReadOnlyList<AvatarRecord> _avatars = Array.Empty<AvatarRecord>();
    private bool _avatarsLoaded;
    private bool _showAvatarPicker;
    private bool _isLoadingAvatars;

    /// <summary>
    ///     The catalog is 182 rows and a few hundred KB of markup, so it is fetched on the first
    ///     open rather than with the page. Cached in the handler, so a second open is free.
    /// </summary>
    private async Task OpenAvatarPicker()
    {
        // Tracked by a flag rather than by Count: an empty result is still an answer, and
        // re-asking on every open would query forever for the one case that returns nothing.
        if (!_avatarsLoaded)
        {
            _isLoadingAvatars = true;
            try
            {
                _avatars = await Mediator.Send(new GetAvatarCatalogQuery());
                _avatarsLoaded = true;
            }
            finally
            {
                _isLoadingAvatars = false;
            }
        }

        _showAvatarPicker = true;
    }

    private async Task PinAvatar(Uri imageUrl)
    {
        await Mediator.Send(new PinAvatarCommand(imageUrl));
        _showAvatarPicker = false;
        await RefreshAvatarClaims(L["Avatar updated"]);
    }

    private async Task UnpinAvatar()
    {
        await Mediator.Send(new UnpinAvatarCommand());
        await RefreshAvatarClaims(L["Back to the avatar from your last import"]);
    }

    /// <summary>
    ///     The avatar rides the auth cookie's claims, so the same refresh dance the name and
    ///     country fields do applies here — see UpdateUser for why javascript is involved. The
    ///     shell's copy needs no such thing: it reads a UI setting, and writing one evicts the
    ///     cached settings on its own.
    /// </summary>
    private async Task RefreshAvatarClaims(string message)
    {
        _avatar = await Mediator.Send(new GetMyAvatarQuery());
        Snackbar.Add(message, Severity.Success);
        var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/helpers.js");
        await module.InvokeVoidAsync("refreshLogin");
    }

    private string _id = string.Empty;
    private string _name = string.Empty;
    private bool _isPublic = false;
    private bool _isContentLocked = false;
    private bool _showPublicConfirmDialog = false;
    private bool _isUpdatingUser = false;
    private IEnumerable<CountryRecord> _countries = Array.Empty<CountryRecord>();
    private string _countryName = null;
    private string _currentCulture = "en-US";
    private string _themeOverride = MixThemes.MatchMixValue;
    private PendingAccountDeletion? _pendingDeletion;
    private bool _shareWithAllTools;
    private int _connectedToolCount;
    private bool _showPeersDialog;
    private PeerSourceSelection _peerSources = PeerSourceSelection.Default;
    private ScoreColorSettings _scoreColors = ScoreColorSettings.Default;

    private string PeersSummary
    {
        get
        {
            var parts = new List<string>();
            if (_peerSources.Rivals) parts.Add(L["Rivals"]);
            if (_peerSources.CompetitiveLevel) parts.Add(L["Competitive level"]);
            if (_peerSources.Pumbility) parts.Add(L["PUMBILITY peers"]);
            if (_peerSources.CommunityIds.Count == 1) parts.Add(L["One community"]);
            else if (_peerSources.CommunityIds.Count > 1) parts.Add(L["{0} communities", _peerSources.CommunityIds.Count]);
            var peers = parts.Count == 0 ? L["nobody yet"].Value : string.Join(" · ", parts);
            return $"{L["Your peers: {0}.", peers]} {L["Scores colored by {0}, glow {1}.", SystemWord, GlowWord]}";
        }
    }

    private string SystemWord => _scoreColors.System switch
    {
        ScoreColorSystem.JudgementSpectrum => L["the judgement spectrum"],
        ScoreColorSystem.Classic => L["the classic ladder"],
        ScoreColorSystem.GradeMetals => L["letter-grade metals"],
        ScoreColorSystem.Podium => L["the podium"],
        ScoreColorSystem.SingleHue => L["a single hue"],
        ScoreColorSystem.ResultScreen => L["the result screen"],
        ScoreColorSystem.ThreeSteps => L["three steps"],
        ScoreColorSystem.ActualGrade => L["the actual letter grade"],
        _ => L["nothing"]
    };

    private string GlowWord => _scoreColors.Glow switch
    {
        GlowRule.PerfectGames => L["on Perfect Games only"],
        GlowRule.TopPlaces => _scoreColors.GlowThreshold == 1
            ? L["on first place"]
            : L["on the top {0} places", _scoreColors.GlowThreshold],
        GlowRule.TopPercent => L["on the top {0}%", _scoreColors.GlowThreshold],
        _ => L["off"]
    };

    private async Task RefreshPeersSummary()
    {
        _peerSources = await Preferences.GetSources();
        _scoreColors = await Preferences.GetColors();
    }

    protected override async Task OnInitializedAsync()
    {
        // Resolved, not raw: a row written before the es → es-ES split still reads "es", which
        // matches no item and would render the field blank. No row at all means Automatic.
        _currentCulture = SupportedCultures.ResolveClosest(await UiSettings.GetSetting("Culture"))
                          ?? SupportedCultures.Automatic;
        _themeOverride = await UiSettings.GetSetting(MixThemes.OverrideSettingKey) ?? MixThemes.MatchMixValue;
        _id = CurrentUser.User.Id.ToString();
        _name = CurrentUser.User.Name;
        _countryName = CurrentUser.User.Country;
        _isPublic = CurrentUser.User.IsPublic;
        _isContentLocked = CurrentUser.User.IsContentLocked;
        _countries = (await Users.GetCountries()).OrderBy(c => c.Name);
        _avatar = await Mediator.Send(new GetMyAvatarQuery());
        _pendingDeletion = await Mediator.Send(new GetPendingAccountDeletionQuery(CurrentUser.User.Id));
        _shareWithAllTools = await Mediator.Send(new GetShareWithAllToolsQuery());
        await RefreshToolCount();
        await RefreshPeersSummary();
    }

    /// <summary>
    ///     A language cannot change inside a live circuit — IStringLocalizer reads the ambient
    ///     UI culture, which the localization middleware sets per request — so both paths end in
    ///     a real navigation and the page comes back in the new language.
    /// </summary>
    private async Task UpdateCulture(string newCulture)
    {
        _isUpdatingUser = true;
        var returnUrl = HttpUtility.UrlEncode("/Account");

        // Automatic is stored as absence, so it removes the setting rather than writing one, and
        // drops the cookie on the way out — otherwise the cached choice would answer for it.
        if (newCulture == SupportedCultures.Automatic)
        {
            await UiSettings.ClearSetting("Culture");
            NavManager.NavigateTo($"/Culture/Clear?redirectUrl={returnUrl}", forceLoad: true);
            return;
        }

        await UiSettings.SetSetting("Culture", newCulture);
        NavManager.NavigateTo($"/Culture/Set?culture={newCulture}&redirectUrl={returnUrl}", forceLoad: true);
    }

    private async Task UpdateThemeOverride(string newValue)
    {
        _themeOverride = newValue;
        await UiSettings.SetSetting(MixThemes.OverrideSettingKey, newValue);
        // Theme is resolved once at layout init — same full-reload pattern as mix switching.
        NavManager.NavigateTo("/Account", forceLoad: true);
    }

    private async Task CopyUserId()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _id);
        Snackbar.Add("Copied to Clipboard!", Severity.Success);
    }

    private async Task UpdateUser()
    {
        _isUpdatingUser = true;
        await Mediator.Send(new UpdateUserCommand(_name, _isPublic, string.IsNullOrWhiteSpace(_countryName) ? null : _countryName));
        /*
        Why does it always come back to javascript...
        Blazor interacts over WebSockets that close HTTP responses before it processes.
        This means we can't update a user's signed in information (stored in a cookie) utilizing standard Blazor back end interactions
        HttpClient interactions all happen via sockets in the back end, so does not contain cookie information for managing user claims.
        So the conclusion was to do a quick javascript fetch to a Refresh endpoint to log out and log back in a user when their claims
        are updated.
        See https://github.com/dotnet/aspnetcore/issues/34095#issuecomment-874012924 for Microsoft's stance on this.
        See: >:(  for my stance on this.*/
        var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/helpers.js");
        await module.InvokeVoidAsync("refreshLogin");
        _isUpdatingUser = false;
    }

    private async Task ToggleIsPublic()
    {
        _showPublicConfirmDialog = false;
        _isPublic = !_isPublic;

        // Sharing follows privacy in both directions (owner call): going public turns it on every
        // time, and going private turns it off because a private profile cannot carry the blanket
        // grant. Direct connections to a named tool survive either way — that is a deliberate
        // grant, not public visibility.
        _shareWithAllTools = _isPublic;
        // Profile visibility first. The all-tools pool is not joined on IsPublic, so committing the
        // preference first leaves the account shared-with-everyone while still private for as long as
        // the second call takes — and permanently if it throws.
        await UpdateUser();
        await Mediator.Send(new SetShareWithAllToolsCommand(_shareWithAllTools));
        await RefreshToolCount();

        var message = _isPublic ? "Public" : "Private";
        Snackbar.Add($"Account made {message}", Severity.Success);
    }

    private async Task ToggleShareWithAllTools(bool share)
    {
        _shareWithAllTools = share;
        await Mediator.Send(new SetShareWithAllToolsCommand(share));
        await RefreshToolCount();
        Snackbar.Add(share
            ? L["Community tools can read your scores"].Value
            : L["Community tools can no longer read your scores"].Value, Severity.Success);
    }

    private async Task RefreshToolCount()
    {
        _connectedToolCount = (await Mediator.Send(new GetMyToolConnectionsQuery())).Count;
    }

    private async Task UpdateCountry(string newCountry)
    {
        _countryName = newCountry;
        await UpdateUser();
    }

    private async Task UpdateName(string newName)
    {
        if (Name.TryParse(newName, out var name) || name.ToString().Length > 100)
        {
            _name = name;
            await UpdateUser();
            Snackbar.Add($"User Profile Up set to {_name}", Severity.Success);
        }
        else
        {
            Snackbar.Add("Invalid Name", Severity.Error);
        }
    }

    private async Task CancelDeletion()
    {
        await Mediator.Send(new CancelAccountDeletionCommand(CurrentUser.User.Id));
        _pendingDeletion = null;
        Snackbar.Add(L["Your account will not be deleted"], Severity.Success);
    }

    private async Task DownloadScores()
    {
        var result = Array.Empty<object>();
        if (await UiSettings.GetSelectedMix() == MixEnum.XX)
        {
            var scores = await Mediator.Send(new GetXXBestChartAttemptsQuery(CurrentUser.User.Id));
            result = scores.OrderBy(s => s.Chart.Level).ThenBy(s => s.Chart.Type).Select(s => new XXSpreadsheetScoreDto
            {
                Difficulty = s.Chart.DifficultyString,
                IsBroken = s.BestAttempt?.IsBroken.ToString() ?? "",
                LetterGrade = s.BestAttempt?.LetterGrade.ToString() ?? "",
                Score = s.BestAttempt?.Score?.ToString() ?? "",
                Song = s.Chart.Song.Name
            }).ToArray();
        }
        else
        {
            var currentMix = await UiSettings.GetSelectedMix();
            var scores = await Mediator.Send(new GetPhoenixRecordsQuery(CurrentUser.User.Id, currentMix));
            var charts = (await Mediator.Send(new GetChartsQuery(currentMix))).ToDictionary(c => c.Id);
            result = scores.OrderBy(s => charts[s.ChartId].Level).ThenBy(s => charts[s.ChartId].Type)
                .Select(s => new
                {
                    Difficulty = charts[s.ChartId].DifficultyString,
                    RecordedDate = s.RecordedDate.ToString("d"),
                    Song = charts[s.ChartId].Song.Name.ToString(),
                    IsBroken = s.IsBroken.ToString(),
                    LetterGrade = s.Score?.LetterGradeFor(currentMix).GetName(),
                    Score = s.Score?.ToString(),
                    Plate = s.Plate?.GetName()
                }).ToArray();
        }

        var stream = new MemoryStream();
        await using var writer = new StreamWriter(stream);
        await using var csv = new CsvWriter(writer, CultureInfo.InvariantCulture);
        await csv.WriteRecordsAsync(result);
        await writer.FlushAsync();
        await csv.FlushAsync();
        const string fileName = "scores.csv";

        using var streamRef = new DotNetStreamReference(stream: stream);
        stream.Seek(0, SeekOrigin.Begin);

        var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/helpers.js");
        await module.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
}
