@using MediatR
@using ScoreTracker.Domain.Models
@using ScoreTracker.Rivals.Contracts
@using ScoreTracker.Rivals.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Services.Contracts
@using ScoreTracker.Web.Services.Theming
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@namespace ScoreTracker.Web.Components.Account
@inject IMediator Mediator
@inject IUiSettingsAccessor UiSettings
@inject ScoreColorPreferences Preferences
@inject ISnackbar Snackbar

@* The one place the three peer settings live (docs/design/peers-abstraction.md D1, D14, D15):
   who your peers are, which color system paints your scores, and what lights the glow — its own
   tab on /Account (D35), not a dialog. Every change repaints the preview; nothing is written until
   Save, and leaving the tab discards the draft. The tally under the sources is the same union the
   standing reader will compute, because the catalog hands over the member sets. *@
<div class="pcd" data-testid="peers-panel">
    <MudText Typo="Typo.body2" Class="pcd-lede">@L["Who your scores are measured against on this site, and how that measurement paints them. Projections, personalized tier lists and Discord cards keep the peer groups they are calibrated on."]</MudText>
    <section class="pcd-section">
        <MudText Typo="Typo.subtitle1" Class="pcd-title">@L["Who are your peers"]</MudText>
        <MudText Typo="Typo.caption" Class="pcd-help">@L["Pick any of these. Your peers are everyone in the groups you tick, together. You are never one of your own peers."]</MudText>
        @if (_catalog == null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2"></MudProgressLinear>
        }
        else
        {
            @foreach (var option in _catalog.Options.Where(o => o.Kind != PeerSourceKind.Community))
            {
                var source = option;
                <label class="pcd-opt @(source.Available ? null : "pcd-opt-off")" data-testid="@($"pcd-source-{source.Kind}")">
                    <MudCheckBox T="bool" Value="IsTicked(source)" ValueChanged="v => Tick(source, v)"
                                 Disabled="!source.Available" Color="Color.Primary" Dense="true"></MudCheckBox>
                    <span class="pcd-opt-body">
                        <span class="pcd-opt-label">@SourceLabel(source.Kind)</span>
                        <span class="pcd-opt-help">@SourceHelp(source.Kind)</span>
                    </span>
                    <span class="pcd-opt-count">@SourceCount(source)</span>
                </label>
            }
            <div class="pcd-opt pcd-opt-head">
                <span></span>
                <span class="pcd-opt-body">
                    <span class="pcd-opt-label">@L["Communities"]</span>
                    <span class="pcd-opt-help">@L["Members of the communities you tick. Your country and World are communities too."]</span>
                </span>
            </div>
            <div class="pcd-sub">
                @foreach (var option in _catalog.Options.Where(o => o.Kind == PeerSourceKind.Community))
                {
                    var community = option;
                    <label class="pcd-opt" data-testid="pcd-community">
                        <MudCheckBox T="bool" Value="IsTicked(community)" ValueChanged="v => Tick(community, v)"
                                     Color="Color.Primary" Dense="true"></MudCheckBox>
                        <span class="pcd-opt-body">
                            <span class="pcd-opt-label">
                                @community.Name
                                @if (community.IsRegional)
                                {
                                    <span class="pcd-tag">@L["Region"]</span>
                                }
                            </span>
                        </span>
                        <span class="pcd-opt-count">@L["{0} members", community.SinglesMembers.Count]</span>
                    </label>
                }
            </div>
            <div class="pcd-tally" data-testid="pcd-tally">
                <span>@L["Your peers right now"]</span>
                <span><b>@SinglesUnion.ToString("N0")</b> @L["singles (peers tally)"]</span>
                <span><b>@DoublesUnion.ToString("N0")</b> @L["doubles (peers tally)"]</span>
                @if (!_sources.Any)
                {
                    <span class="pcd-muted">— @L["nothing ticked, so scores render plain"]</span>
                }
            </div>
        }
    </section>

    <section class="pcd-section">
        <MudText Typo="Typo.subtitle1" Class="pcd-title">@L["Color your scores by"]</MudText>
        <MudText Typo="Typo.caption" Class="pcd-help">@L["The standing (\"#6 of 94 peers\") always prints beside the score, whatever you pick here."]</MudText>
        <MudRadioGroup T="ScoreColorSystem" Value="_colors.System" ValueChanged="SetSystem">
            @foreach (var system in Systems)
            {
                var s = system;
                <div class="pcd-opt pcd-radio" data-testid="@($"pcd-system-{s}")">
                    <MudRadio T="ScoreColorSystem" Value="s" Color="Color.Primary" Dense="true">
                    <span class="pcd-opt-body">
                        <span class="pcd-opt-label">
                            @SystemLabel(s)
                            <span class="pcd-swatches" aria-hidden="true">
                                @foreach (var token in Swatches(s))
                                {
                                    <span class="pcd-swatch" style="background:@token"></span>
                                }
                            </span>
                        </span>
                        <span class="pcd-opt-help">@SystemHelp(s)</span>
                    </span>
                    </MudRadio>
                </div>
            }
        </MudRadioGroup>
    </section>

    <section class="pcd-section">
        <MudText Typo="Typo.subtitle1" Class="pcd-title">@L["Glow"]</MudText>
        <MudText Typo="Typo.caption" Class="pcd-help">@L["One rule, one glow. The color is the spectrum; the glow says a score crossed the line you set."]</MudText>
        <MudRadioGroup T="GlowRule" Value="_colors.Glow" ValueChanged="SetGlow">
            <div class="pcd-opt pcd-radio" data-testid="pcd-glow-PerfectGames">
                <MudRadio T="GlowRule" Value="GlowRule.PerfectGames" Color="Color.Primary" Dense="true">
                <span class="pcd-opt-body">
                    <span class="pcd-opt-label">@L["Perfect Games only"]</span>
                    <span class="pcd-opt-help">@L["A 1,000,000 glows; nothing else does."]</span>
                </span>
                </MudRadio>
            </div>
            <div class="pcd-opt pcd-radio" data-testid="pcd-glow-TopPlaces">
                <MudRadio T="GlowRule" Value="GlowRule.TopPlaces" Color="Color.Primary" Dense="true">
                <span class="pcd-opt-body">
                    <span class="pcd-opt-label pcd-opt-inline">
                        @L["Glow: Top"]
                        <MudNumericField T="int" Value="_places" ValueChanged="SetPlaces" Min="1" Max="50"
                                         Class="pcd-num" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         HideSpinButtons="true" aria-label="@L["places"]"></MudNumericField>
                        @(_places == 1 ? L["Glow: place"] : L["Glow: places"])
                    </span>
                    <span class="pcd-opt-help">@L["among your peers, by place — ties share a place."]</span>
                </span>
                </MudRadio>
            </div>
            <div class="pcd-opt pcd-radio" data-testid="pcd-glow-TopPercent">
                <MudRadio T="GlowRule" Value="GlowRule.TopPercent" Color="Color.Primary" Dense="true">
                <span class="pcd-opt-body">
                    <span class="pcd-opt-label pcd-opt-inline">
                        @L["Glow: Top"]
                        <MudNumericField T="int" Value="_percent" ValueChanged="SetPercent" Min="1" Max="50"
                                         Class="pcd-num" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         HideSpinButtons="true" aria-label="@L["percent"]"></MudNumericField>
                        %
                    </span>
                    <span class="pcd-opt-help">@L["of your peers."]</span>
                </span>
                </MudRadio>
            </div>
            <div class="pcd-opt pcd-radio" data-testid="pcd-glow-Off">
                <MudRadio T="GlowRule" Value="GlowRule.Off" Color="Color.Primary" Dense="true">
                <span class="pcd-opt-body">
                    <span class="pcd-opt-label">@L["Off"]</span>
                    <span class="pcd-opt-help">@L["No glow anywhere, Perfect Games included."]</span>
                </span>
                </MudRadio>
            </div>
        </MudRadioGroup>
    </section>

    <section class="pcd-section">
        <MudText Typo="Typo.subtitle1" Class="pcd-title">@L["Preview"]</MudText>
        <div class="pcd-preview" data-testid="pcd-preview">
            @foreach (var sample in Samples)
            {
                <div class="pcd-prow">
                    <DifficultyBubble Chart="sample.Chart" Small="true"></DifficultyBubble>
                    <span class="pcd-prow-song">@sample.Chart.Song.Name</span>
                    <PeerScore Score="sample.Score" Plate="sample.Plate" Mix="MixEnum.Phoenix" Standing="sample.Standing"
                               Interactive="false" ShowStanding="true" Settings="_colors" Height="12"
                               Class="sbd-score-stack"></PeerScore>
                </div>
            }
        </div>
    </section>
    <div class="pcd-actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_saving"
                   data-testid="pcd-save">@L["Save"]</MudButton>
    </div>
</div>

@code {
    private static readonly ScoreColorSystem[] Systems = Enum.GetValues<ScoreColorSystem>();

    private PeerSourceCatalog? _catalog;
    private PeerSourceSelection _sources = PeerSourceSelection.Default;
    private ScoreColorSettings _colors = ScoreColorSettings.Default;
    private int _places = 1;
    private int _percent = 10;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        // The draft is only ever what Save writes; leaving the tab discards it.
        _sources = await Preferences.GetSources();
        _colors = await Preferences.GetColors();
        _places = _colors.Glow == GlowRule.TopPlaces ? _colors.GlowThreshold : 1;
        _percent = _colors.Glow == GlowRule.TopPercent ? _colors.GlowThreshold : 10;
        _catalog = null;
        _catalog = await Mediator.Send(new GetPeerSourceCatalogQuery(await UiSettings.GetSelectedMix()));
        // A community you left, or were banned from, is still in the saved selection. The catalog
        // is the truth of what you can tick, so the draft keeps only the ids it lists and Save
        // writes the stale ones out (D29).
        var offered = _catalog.Options.Where(o => o.CommunityId != null).Select(o => o.CommunityId!.Value).ToHashSet();
        _sources = _sources with { CommunityIds = _sources.CommunityIds.Where(offered.Contains).ToHashSet() };
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            await Preferences.Save(_colors, _sources);
            Snackbar.Add(L["Peers and score colors saved"], Severity.Success);
        }
        finally
        {
            _saving = false;
        }
    }

    // ---------------------------------------------------------------- sources

    private bool IsTicked(PeerSourceOption option) => option.Kind switch
    {
        PeerSourceKind.Rivals => _sources.Rivals,
        PeerSourceKind.CompetitiveLevel => _sources.CompetitiveLevel,
        PeerSourceKind.Pumbility => _sources.Pumbility,
        _ => option.CommunityId is { } id && _sources.CommunityIds.Contains(id)
    };

    private void Tick(PeerSourceOption option, bool on)
    {
        _sources = option.Kind switch
        {
            PeerSourceKind.Rivals => _sources with { Rivals = on },
            PeerSourceKind.CompetitiveLevel => _sources with { CompetitiveLevel = on },
            PeerSourceKind.Pumbility => _sources with { Pumbility = on },
            _ => _sources with { CommunityIds = ToggleCommunity(option.CommunityId, on) }
        };
    }

    private IReadOnlySet<Guid> ToggleCommunity(Guid? id, bool on)
    {
        var set = new HashSet<Guid>(_sources.CommunityIds);
        if (id is { } community)
        {
            if (on) set.Add(community);
            else set.Remove(community);
        }

        return set;
    }

    private int SinglesUnion => Union(o => o.SinglesMembers);

    private int DoublesUnion => Union(o => o.DoublesMembers);

    private int Union(Func<PeerSourceOption, IReadOnlySet<Guid>> members)
    {
        if (_catalog == null) return 0;
        var union = new HashSet<Guid>();
        foreach (var option in _catalog.Options.Where(IsTicked)) union.UnionWith(members(option));
        return union.Count;
    }

    private string SourceLabel(PeerSourceKind kind) => kind switch
    {
        PeerSourceKind.Rivals => L["Rivals"],
        PeerSourceKind.CompetitiveLevel => L["Competitive level (peers)"],
        _ => L["PUMBILITY peers"]
    };

    private string SourceHelp(PeerSourceKind kind) => kind switch
    {
        PeerSourceKind.Rivals => L["Everyone on your rivals roster, board-only rivals included — their standings come from the weekly official board, so they only count on the charts it publishes."],
        PeerSourceKind.CompetitiveLevel => L["Players within half a level of you, per chart type — today's definition."],
        _ => L["Players whose pool of the type sits within 500 below and 250 above yours. Phoenix 2 only; on Phoenix 1 this group is empty."]
    };

    private string SourceCount(PeerSourceOption option) => option.Kind switch
    {
        PeerSourceKind.Rivals => option.BoardOnlyRivals > 0
            ? L["{0} players · {1} board-only", option.SinglesMembers.Count + option.BoardOnlyRivals, option.BoardOnlyRivals]
            : L["{0} players (rivals)", option.SinglesMembers.Count],
        PeerSourceKind.Pumbility when !option.Available => L["Phoenix 2 only"],
        _ => L["{0} singles · {1} doubles", option.SinglesMembers.Count, option.DoublesMembers.Count]
    };

    // ---------------------------------------------------------------- colors and glow

    private void SetSystem(ScoreColorSystem system) => _colors = _colors with { System = system };

    private void SetGlow(GlowRule glow) => _colors = _colors with
    {
        Glow = glow,
        GlowThreshold = ScoreColorSettings.Clamp(glow, glow == GlowRule.TopPlaces ? _places : _percent)
    };

    private void SetPlaces(int places)
    {
        _places = ScoreColorSettings.Clamp(GlowRule.TopPlaces, places);
        _colors = _colors with { Glow = GlowRule.TopPlaces, GlowThreshold = _places };
    }

    private void SetPercent(int percent)
    {
        _percent = ScoreColorSettings.Clamp(GlowRule.TopPercent, percent);
        _colors = _colors with { Glow = GlowRule.TopPercent, GlowThreshold = _percent };
    }

    private string SystemLabel(ScoreColorSystem system) => system switch
    {
        ScoreColorSystem.JudgementSpectrum => L["Peer standing · judgement spectrum"],
        ScoreColorSystem.Classic => L["Peer standing · classic"],
        ScoreColorSystem.GradeMetals => L["Peer standing · letter-grade metals"],
        ScoreColorSystem.Podium => L["Peer standing · podium"],
        ScoreColorSystem.SingleHue => L["Peer standing · single hue"],
        ScoreColorSystem.ResultScreen => L["Peer standing · result screen"],
        ScoreColorSystem.ThreeSteps => L["Peer standing · three steps"],
        ScoreColorSystem.ActualGrade => L["Actual letter grade"],
        _ => L["No color"]
    };

    private string SystemHelp(ScoreColorSystem system) => system switch
    {
        ScoreColorSystem.JudgementSpectrum => L["What the site uses today: grey → silver → green → gold → ice blue → prism, cut at 25 / 50 / 75 / 90 / 99 %."],
        ScoreColorSystem.Classic => L["The old Raider.io-style ladder, hues retuned for the dark themes: grey → white → green → blue → purple → orange → pink, cut at 10 / 25 / 50 / 75 / 90 / 99 %."],
        ScoreColorSystem.GradeMetals => L["Your standing painted in the grades' own colors: below-A green, A copper, AAA silver, S gold, SSS ice, SSS+ at the top 1 %. The letter you see is still your real grade."],
        ScoreColorSystem.Podium => L["Medals for a place, not a share: plain ink off the podium, copper #3, silver #2, gold #1. Reads best with small groups like a rivals roster, where a percentile is coarse."],
        ScoreColorSystem.SingleHue => L["One hue — the current mix's — from dark to bright. Ordered by lightness alone, so it reads the same for every kind of color vision."],
        ScoreColorSystem.ResultScreen => L["The game's own judgement colors, literally: Miss red at the bottom, then Bad violet, Good amber, Great green, Perfect ice at the top. The one ladder that starts red — opt-in only."],
        ScoreColorSystem.ThreeSteps => L["Below the middle plain, above it gold, top 10 % ice. For readers who find six bands noisy."],
        ScoreColorSystem.ActualGrade => L["The score wears its own grade's metal. Peers show only as the standing text."],
        _ => L["Plain ink. Peers show only as the standing text."]
    };

    /// <summary>The ladder's stops, low to high, as token references — never literals (UiColorTokenTests).</summary>
    private static IEnumerable<string> Swatches(ScoreColorSystem system) => system switch
    {
        ScoreColorSystem.JudgementSpectrum => new[] { "var(--rarity-common)", "var(--rarity-silver)", "var(--rarity-emerald)", "var(--rarity-gold)", "var(--rarity-sapphire)", "var(--rarity-prism)" },
        ScoreColorSystem.Classic => Enumerable.Range(1, 7).Select(i => $"var(--classic-{i})"),
        ScoreColorSystem.GradeMetals => new[] { "var(--grade-sub-a)", "var(--plate-fg)", "var(--plate-mg)", "var(--plate-eg)", "var(--plate-ug)", "var(--plate-pg)" },
        ScoreColorSystem.Podium => new[] { "var(--mix-ink)", "var(--plate-fg)", "var(--plate-mg)", "var(--plate-sg)" },
        ScoreColorSystem.SingleHue => Enumerable.Range(1, 6).Select(i => $"var(--hue-{i})"),
        ScoreColorSystem.ResultScreen => new[] { "var(--judg-miss)", "var(--judg-bad)", "var(--judg-good)", "var(--judg-great)", "var(--judg-perfect)" },
        ScoreColorSystem.ThreeSteps => new[] { "var(--mix-ink)", "var(--rarity-gold)", "var(--rarity-sapphire)" },
        ScoreColorSystem.ActualGrade => new[] { "var(--plate-rg)", "var(--plate-fg)", "var(--plate-tg)", "var(--plate-mg)", "var(--plate-sg)", "var(--plate-eg)", "var(--plate-ug)", "var(--plate-pg)" },
        _ => new[] { "var(--mix-ink)" }
    };

    // ---------------------------------------------------------------- preview

    private sealed record Sample(Chart Chart, PhoenixScore Score, PhoenixPlate? Plate, PeerStanding Standing);

    /// <summary>
    ///     A fixed spread of standings, so every system shows its whole ladder. Not the player's
    ///     data — the standing reader is for real charts, and a preview of "your Cleaner would be
    ///     silver" would be a promise this dialog cannot make.
    /// </summary>
    private static readonly IReadOnlyList<Sample> Samples = new[]
    {
        SampleOf("Cleaner", 20, 996_204, PhoenixPlate.MarvelousGame, passed: 91, better: 0),
        SampleOf("Elvis", 19, 1_000_000, PhoenixPlate.PerfectGame, passed: 88, better: 0, perfectGames: 12),
        SampleOf("Cross Over", 22, 993_105, PhoenixPlate.MarvelousGame, passed: 93, better: 5),
        SampleOf("Achluoias", 24, 971_240, PhoenixPlate.TalentedGame, passed: 87, better: 11),
        SampleOf("OVERNIGHT FLOWER", 22, 986_880, PhoenixPlate.TalentedGame, passed: 93, better: 39),
        SampleOf("Aragami", 21, 979_331, PhoenixPlate.TalentedGame, passed: 95, better: 60),
        SampleOf("Bad Apple!!", 17, 942_000, PhoenixPlate.FairGame, passed: 100, better: 84)
    };

    private static Sample SampleOf(string song, int level, int score, PhoenixPlate plate, int passed, int better,
        int perfectGames = 0)
    {
        var chart = new Chart(Guid.NewGuid(), MixEnum.Phoenix,
            new Song(Name.From(song), SongType.Arcade, new Uri("https://piuimages.arroweclip.se/songs/preview.png"),
                TimeSpan.Zero, Name.From("Preview"), null),
            ChartType.Single, DifficultyLevel.From(level), MixEnum.Phoenix, null, null);
        return new Sample(chart, PhoenixScore.From(score), plate,
            new PeerStanding(passed + 6, passed, better, perfectGames, 3, Array.Empty<PeerStandingSource>(), null));
    }
}
