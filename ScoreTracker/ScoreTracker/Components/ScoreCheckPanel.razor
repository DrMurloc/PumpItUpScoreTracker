@using MediatR
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.Domain.Events
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.Identity.Contracts.Queries
@using ScoreTracker.OfficialMirror.Contracts
@using ScoreTracker.OfficialMirror.Contracts.Commands
@using ScoreTracker.OfficialMirror.Contracts.Events
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.Web.Services.UiNotifications

@* Tells a player whether every score PIUGAME has actually reached us, and repairs what disagrees.
   Nothing is persisted: the verdict lives here until they navigate away, which is why the running
   states say so out loud (docs/design/import-completeness-check.md §6). *@

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudText Typo="Typo.overline">@L["Score check"]</MudText>

    @if (_running)
    {
        <div class="d-flex align-center gap-3 mt-1">
            <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
            <MudText Typo="Typo.body1">@(_status ?? L["Checking your scores"])</MudText>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-2">
            @L["Stay on this page — leaving loses the result."]
        </MudText>
    }
    else if (_report == null)
    {
        <MudText Typo="Typo.body1" Class="mt-1">
            @(_repaired > 0
                ? L["Added {0} scores. Everything matches now.", _repaired]
                : L["Check every score PIUGAME has against what's here."])
        </MudText>
        @if (_repaired == 0)
        {
            <div class="d-flex flex-wrap gap-2 align-center mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Disabled"
                           OnClick="@(() => Run())">
                    @L["Import and check"]
                </MudButton>
            </div>
            <MudText Typo="Typo.caption" Class="d-block mt-1">
                @L["Imports first, then compares. A few minutes."]
            </MudText>
        }
    }
    else
    {
        <MudText Typo="Typo.body1" Class="mt-1">@Headline</MudText>

        @* Missing and out-of-date share ONE list — an account can be short a chart and behind on
           another at once, and two views would make the player fix it twice. A row with a "was"
           is one they have beaten since their last import. *@
        @foreach (var chart in Found)
        {
            <div class="d-flex align-center gap-3 my-2">
                @if (_charts.TryGetValue(chart.ChartId, out var known))
                {
                    <SongImage Song="known.Song" Small="true"/>
                    <DifficultyBubble Chart="known" Small="true"/>
                    <MudText Typo="Typo.body2" Class="flex-grow-1 text-truncate">@known.Song.Name</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="flex-grow-1">@L["Unknown chart"]</MudText>
                }
                <div class="text-right">
                    <MudText Typo="Typo.body2">@chart.Score.ToString("N0")</MudText>
                    @if (chart.CurrentScore != null)
                    {
                        <MudText Typo="Typo.caption">@L["was {0}", chart.CurrentScore.Value.ToString("N0")]</MudText>
                    }
                </div>
            </div>
        }

        <div class="d-flex flex-wrap gap-2 align-center mt-3">
            @if (Found.Any())
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Disabled"
                           OnClick="Repair">
                    @L["Add these {0} scores", Found.Count]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Disabled="Disabled" OnClick="Dismiss">@L["Not now"]</MudButton>
            }
            else if (_report.Verdict == ImportCheckVerdict.InSync && _deepScansLeft > 0)
            {
                <MudLink Component="button" Disabled="Disabled" @onclick="@(() => Run(deepScan: true))">
                    @L["Still wrong? Run a deep scan"]
                </MudLink>
            }
        </div>

        @if (Found.Any())
        {
            <MudText Typo="Typo.caption" Class="d-block mt-1">
                @if (_report.PumbilityGap != null)
                {
                    @L["Worth {0} PUMBILITY.", ((int)_report.PumbilityGap.Value).ToString("N0")]
                    <text> </text>
                }
                @L["A row with a \"was\" is one you've beaten since your last import; the rest were never imported at all."]
            </MudText>
        }
        else if (_report.Verdict == ImportCheckVerdict.InSync)
        {
            <MudText Typo="Typo.caption" Class="d-block mt-1">
                @(_deepScansLeft > 0
                    ? L["Deep scan reads every page instead of counting. {0} left this month.", _deepScansLeft]
                    : L["You've used all your deep scans this month. The next unlock is {0}.", NextUnlock])
            </MudText>
        }
    }
</MudPaper>

@code {
    /// <summary>The mix the page is importing. A check is per mix — Phoenix 2 titles read Phoenix 2
    /// scores only, and so does its census.</summary>
    [Parameter] public MixEnum Mix { get; set; }

    /// <summary>Resolved by the page: the stored blob when there is one, otherwise what was typed.
    /// Null disables the buttons rather than hiding them — the page explains why.</summary>
    [Parameter] public Func<ImportCredentialSource?>? Credentials { get; set; }

    [Parameter] public string CardId { get; set; } = "";
    [Parameter] public string GameTag { get; set; } = "";

    /// <summary>True while the page's own import runs, so the two cannot start at once.</summary>
    [Parameter] public bool Busy { get; set; }

    private readonly List<IDisposable> _subscriptions = new();
    private IReadOnlyDictionary<Guid, Chart> _charts = new Dictionary<Guid, Chart>();
    private int _deepScansLeft;
    private int _repaired;
    private ImportCheckReport? _report;
    private bool _running;
    private string? _status;
    private Guid _userId;

    private bool Disabled => Busy || _running || Credentials?.Invoke() == null;

    private IReadOnlyList<ImportCheckChart> Found =>
        _report?.Repairable.SelectMany(d => d.Charts).ToArray() ?? Array.Empty<ImportCheckChart>();

    private string NextUnlock => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1)
        .AddMonths(1).ToString("d");

    private string Headline => _report?.Verdict == ImportCheckVerdict.InSync
        ? L["Everything matches — all {0} scores are here.", _report.LocalPasses.ToString("N0")]
        : L["{0} scores here don't match PIUGAME.", _report?.RepairableCount ?? 0];

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsLoggedIn) return;
        _userId = CurrentUser.User.Id;
        _subscriptions.Add(UiHub.Subscribe<ImportStatusUpdatedEvent>(UiTopics.User(_userId), OnStatus));
        _subscriptions.Add(UiHub.Subscribe<ImportStatusErrorEvent>(UiTopics.User(_userId), OnError));
        _subscriptions.Add(UiHub.Subscribe<ImportCheckCompletedEvent>(UiTopics.User(_userId), OnCompleted));
        _deepScansLeft = await Mediator.Send(new GetDeepScansRemainingQuery(_userId));
    }

    private Task Run(bool deepScan = false)
    {
        return Start(deepScan, Array.Empty<string>());
    }

    /// <summary>
    ///     Re-reads only the levels this verdict named. The panel holds the findings, so the client
    ///     says what it wants fixed — nothing on the server remembers the last run.
    /// </summary>
    private Task Repair()
    {
        return Start(false, _report?.Repairable.Select(d => d.Bucket).Distinct().ToArray()
                            ?? Array.Empty<string>());
    }

    private void Dismiss()
    {
        _report = null;
        _repaired = 0;
    }

    private async Task Start(bool deepScan, IReadOnlyCollection<string> repairBuckets)
    {
        var source = Credentials?.Invoke();
        if (source == null) return;

        // Paint the spinner before the slow sign-in: Blazor renders an async handler only after
        // its synchronous portion, so flipping this afterwards leaves the button inert for seconds.
        _running = true;
        _status = null;
        _repaired = 0;
        StateHasChanged();

        var result = await Mediator.Send(new StartImportCheckCommand(source, Mix, CardId, GameTag,
            deepScan, repairBuckets));
        _deepScansLeft = result.DeepScansLeft;
        if (result.Outcome == ImportCheckStartOutcome.Started) return;

        _running = false;
        Snackbar.Add(result.Outcome switch
        {
            ImportCheckStartOutcome.InvalidCredentials => L["Invalid Login Information"],
            ImportCheckStartOutcome.CredentialUnlockFailed => L["Saved credentials could not be unlocked."],
            ImportCheckStartOutcome.AlreadyRunning => L["An import is already running."],
            ImportCheckStartOutcome.NoDeepScansLeft =>
                L["You've used all your deep scans this month. The next unlock is {0}.", NextUnlock],
            _ => L["Something went wrong."]
        }, Severity.Warning);
    }

    private Task OnStatus(ImportStatusUpdatedEvent update)
    {
        if (update.Mix != Mix || !_running) return Task.CompletedTask;
        return InvokeAsync(() =>
        {
            _status = update.Status;
            StateHasChanged();
        });
    }

    private async Task OnCompleted(ImportCheckCompletedEvent completed)
    {
        if (completed.Mix != Mix) return;
        // Resolved once so the rows can carry real song art and a proper difficulty bubble; the
        // report itself only carries chart ids.
        var ids = completed.Report.Repairable.SelectMany(d => d.Charts).Select(c => c.ChartId).Distinct().ToArray();
        var charts = ids.Length == 0
            ? Array.Empty<Chart>()
            : (await Mediator.Send(new GetChartsQuery(Mix, ChartIds: ids))).ToArray();

        await InvokeAsync(() =>
        {
            _charts = charts.ToDictionary(c => c.Id);
            _repaired = completed.Repaired;
            // A repair that fixed everything shows its own acknowledgement instead of an empty list.
            _report = completed.Repaired > 0 && completed.Report.Verdict == ImportCheckVerdict.InSync
                ? null
                : completed.Report;
            _running = false;
            StateHasChanged();
        });
    }

    private Task OnError(ImportStatusErrorEvent error)
    {
        return InvokeAsync(() =>
        {
            _running = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        foreach (var subscription in _subscriptions) subscription.Dispose();
    }
}

@inject IMediator Mediator;
@inject ICurrentUserAccessor CurrentUser;
@inject IUiNotificationHub UiHub;
@inject ISnackbar Snackbar;
@implements IDisposable
