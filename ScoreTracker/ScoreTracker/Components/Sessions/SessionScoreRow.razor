@using ScoreTracker.Domain.Models
@using ScoreTracker.PlayerProgress.Contracts
@using ScoreTracker.ScoreLedger.Contracts
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Theming
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@namespace ScoreTracker.Web.Components

@* One score, with whatever capture learned about it. The score's colour is its percentile
   among players at the same competitive level, and the percentile always prints beside it —
   colour is never the only channel. A chart with no cohort (co-op, or far below competitive)
   renders in plain ink and says nothing about it. *@
<div class="sbd-row @ThreadClass" data-testid="session-score-row">
    @if (Score.Chart != null)
    {
        <SongImage Song="Score.Chart.Song" Small="true"></SongImage>
        <div class="sbd-row-body">
            <div class="sbd-row-line">
                <DifficultyBubble Chart="Score.Chart" Small="true"></DifficultyBubble>
                @* The name IS the affordance now. It used to navigate to the chart page while a
                   separate trophy opened a board; both did the same job badly, and the details
                   dialogue carries the board itself. *@
                <MudLink Href="javascript:void(0)" data-testid="session-row-chart"
                         @onclick="() => OnOpenChart.InvokeAsync(Score.Chart)">@Score.Chart.Song.Name</MudLink>
                @if (AttemptNumber is { } attempt)
                {
                    <span class="sbd-attempt" data-testid="session-row-attempt">@L["Attempt {0}", attempt]</span>
                }
                @foreach (var badge in Badges)
                {
                    <MudTooltip Text="@badge.Tooltip">
                        <span tabindex="0" class="@badge.Class">@badge.Text</span>
                    </MudTooltip>
                }
            </div>
            <div class="sbd-row-line">
                @if (Score.Row.IsStageBroken)
                {
                    @* The stage broke: no grade, no plate, no chart score. Where we know a Stage Pass
                       command ended it, the command's own art is the sentence and the phrase gives way
                       to it; where we do not, the phrase says what we know and no more. Either way the
                       line stays how far the run got (docs/design/pass-command-detection.md D33-D34). *@
                    @if (PassPlate != null || PassGrade != null)
                    {
                        <PassCommandBadge Plate="PassPlate" Grade="PassGrade"></PassCommandBadge>
                    }
                    <span class="sbd-stagebreak" data-testid="session-row-stage-break">@StageBreakText</span>
                }
                else
                {
                    <span class="sbd-score @GlowClass" style="@ScoreColor">
                        <ScoreBreakdown Score="Score.Row.Score == null ? null : PhoenixScore.From(Score.Row.Score.Value)"
                                        Mix="Score.Chart.Mix" IsBroken="Score.Row.IsBroken"
                                        Plate="PhoenixPlateHelperMethods.TryParse(Score.Row.Plate)"
                                        ShowScore="true" OneLine="true"></ScoreBreakdown>
                    </span>
                }
                @if (Score.Row.Judgements is { } judgements)
                {
                    @* The result screen's own readout, and the way into the breakdown dialog when
                       the play has a story to tell against 1,000,000 — a stage break does not,
                       so its strip is a plain readout (D43/D44). *@
                    <JudgementStrip Judgements="judgements" Small="true" OnOpen="StripOpen"></JudgementStrip>
                }
                @if (StandingText != null)
                {
                    <span class="sbd-peerpct">@StandingText</span>
                }
            </div>
        </div>
        <div class="sbd-row-tail">
            <ClassificationChip Classification="Score.Row.Classification"></ClassificationChip>
            @if (Score.Row.Classification == ScoreEventClassification.Upscore
                 && Score.Row.PreviousBest != null && Score.Row.Score != null)
            {
                <MudText Typo="Typo.caption" Color="Color.Success">
                    +@((Score.Row.Score.Value - Score.Row.PreviousBest.Value).ToString("N0"))
                </MudText>
            }
        </div>
    }
</div>

@code {
    [Parameter] [EditorRequired] public SessionScore Score { get; set; } = null!;
    [Parameter] public EventCallback<Chart> OnOpenChart { get; set; }

    /// <summary>Raised with this row's play when its strip is tapped; the host owns the dialog.</summary>
    [Parameter] public EventCallback<SessionScore> OnOpenBreakdown { get; set; }

    /// <summary>"Attempt N", only supplied by the host once a chart hits five plays (D49).</summary>
    [Parameter] public int? AttemptNumber { get; set; }

    /// <summary>The dotted rail joining adjacent plays of one chart — the host computes runs.</summary>
    [Parameter] public string? ThreadClass { get; set; }

    /// <summary>
    ///     A stage break has no story against 1,000,000, so its strip is a readout, not a way
    ///     in — the same line the calculator's own plays list draws (D44).
    /// </summary>
    private EventCallback StripOpen =>
        OnOpenBreakdown.HasDelegate && Score.Row.Score != null && !Score.Row.IsStageBroken
            ? EventCallback.Factory.Create(this, () => OnOpenBreakdown.InvokeAsync(Score))
            : default;

    // A Perfect Game is always prism (D46 reversed at the field test): the glow is the
    // achievement's own, so a PG below the capture floor glows too instead of reading broken.
    private string ScoreColor => Score.IsPerfectGame ? ThemeScales.RarityStyle(1.0)
        : Score.PeerPercentile == null ? string.Empty
        : ThemeScales.RarityStyle(Score.PeerPercentile.Value);

    private string GlowClass => Score.IsPerfectGame ? ThemeScales.RarityClass(RarityBand.Prism)
        : Score.PeerPercentile == null ? string.Empty
        : ThemeScales.RarityClass(ThemeScales.BandFor(Score.PeerPercentile.Value));

    /// <summary>Shared with the highlight card — one play, one set of marks (SessionBadges).</summary>
    private string? StandingText => SessionBadges.Standing(Score, L);

    private IEnumerable<SessionBadges.SessionBadge> Badges => SessionBadges.For(Score, L, includeGain: true);

    private PhoenixPlate? PassPlate => PhoenixPlateHelperMethods.TryParse(Score.Row.PassPlate);

    private PhoenixLetterGrade? PassGrade => PhoenixLetterGradeHelperMethods.TryParse(Score.Row.PassGrade);

    /// <summary>
    ///     What the line says beside the badge, or instead of one. A named command needs no phrase
    ///     — its art already said the run was cut short — so the line keeps only how far it got.
    ///     An unnamed non-lifebar break says what it can: on Singles the other pad is the common
    ///     explanation, since a Pass command applies to both sides of the cabinet and someone
    ///     else's side can end your run; on Doubles and CO-OP both pads are the player's own, so
    ///     that explanation is off the table and the row admits it. Everything else is the
    ///     original phrase, and the bare version of it when either side is unknown (a best-list
    ///     stage break carries no breakdown; a chart nobody has passed carries no count).
    /// </summary>
    private string StageBreakText
    {
        get
        {
            var percent = StageBreakProgress.PercentIn(Score.Row.JudgedNotes, Score.Chart?.NoteCount);
            if (PassPlate != null || PassGrade != null)
                return percent is { } named ? L["{0}% in", named] : string.Empty;

            if (Score.Row.IsNonLifebarBreak)
                return Score.Chart?.Type is ChartType.Single or ChartType.SinglePerformance
                    ? L["Stage break · likely a Pass command on the other pad"]
                    : L["Stage break · couldn't determine what caused stage break"];

            return percent is { } plain ? L["Stage break · {0}% in", plain] : L["Stage break"];
        }
    }
}
