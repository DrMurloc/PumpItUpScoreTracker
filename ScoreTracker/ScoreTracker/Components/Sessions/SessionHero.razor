@using ScoreTracker.Domain.Models
@using ScoreTracker.EventCompetition.Contracts
@using ScoreTracker.PlayerProgress.Contracts
@using ScoreTracker.ScoreLedger.Contracts
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.Web.Services
@namespace ScoreTracker.Web.Components

@* The most recent session, rendered big. Section order is the design's: header, the answer,
   what you earned, what mattered, who else played it, everything. *@
<MudPaper Elevation="3" Class="sbd-hero" data-testid="session-hero"
          Style="@($"border-top: 2px solid #{Breakdown.Group.Mix.GetAccentColor():X6}")">
    <div class="sbd-hero-head">
        <div class="sbd-hero-who">
            <span class="sbd-hero-title">@SourceLabel</span>
            <span class="sbd-hero-when">
                @Breakdown.Group.Mix.GetName() · @Breakdown.Group.End.ToLocalTime().ToString("g")@DurationSuffix
                @if (Breakdown.AccountTag != null)
                {
                    @* Which card this came from. The wrong-card case is exactly when a player
                       stares at a session thinking "these aren't my scores". *@
                    <span class="sbd-hero-tag">@L["imported from {0}", Breakdown.AccountTag]</span>
                }
            </span>
            @* The one-way door into March of Murlocs (D32). A night already on a board wears the
               chip; every other night gets the quiet link, because there is always a season. *@
            @if (MoM?.Recorded is { } recorded)
            {
                <a class="mom-recorded" href="@MoMText.SessionPath(recorded.SessionId)" data-testid="mom-onramp-recorded">
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Small"/>
                    <span>@L["March of Murlocs session"]</span>
                    <span class="l2">
                        <b>@L["{0} on {1}", MoMText.Ordinal(recorded.Place, L), TypeName(recorded.ChartType)]</b>
                        · @L["{0} points", recorded.TotalScore.ToString("N0")] →
                    </span>
                </a>
            }
            else if (MoM?.RecordBoardId is { } quietBoard)
            {
                <a class="mom-quiet" href="@MoMText.RecordPath(quietBoard)" data-testid="mom-onramp-link">
                    <MudIcon Icon="@Icons.Material.Filled.Alarm" Size="Size.Small"/>
                    @L["Record as a March of Murlocs session"]
                </a>
            }
        </div>
        <div class="sbd-tally">
            <div><span class="sbd-tally-v sbd-pass">@Breakdown.PassCount</span><span class="sbd-tally-k">@L["Passes"]</span></div>
            <div><span class="sbd-tally-v sbd-up">@Breakdown.UpscoreCount</span><span class="sbd-tally-k">@L["Upscores"]</span></div>
            <div><span class="sbd-tally-v">@Breakdown.PlayCount</span><span class="sbd-tally-k">@L["Plays"]</span></div>
        </div>
    </div>

    @* The loud half of D32: this night holds a window that would make a session, so it says so
       with the numbers that decide it and a button that opens Submit on the right board. *@
    @if (MoM?.Candidate is { } candidate)
    {
        <div class="mom-callout" data-testid="mom-onramp-callout">
            <div class="ico"><MudIcon Icon="@Icons.Material.Filled.Alarm"/></div>
            <div>
                <h3>@L["This looks like a March of Murlocs session."]</h3>
                <div class="facts">
                    <span class="fact">
                        <b>@TypeName(candidate.ChartType)</b>
                        <span>@candidate.From.ToLocalTime().ToString("t") – @candidate.To.ToLocalTime().ToString("t")</span>
                    </span>
                    <span class="fact"><b>@candidate.Charts</b><span>@L["Charts"]</span></span>
                    <span class="fact"><b>@MoMText.HoursMinutesSeconds(candidate.SongTime)</b><span>@L["of songs"]</span></span>
                    <span class="fact"><b>@MoMText.MinutesSeconds(candidate.Rest)</b><span>@L["rest in 1:45"]</span></span>
                    @if (candidate.StageBreaks > 0)
                    {
                        <span class="fact">
                            <b>@candidate.StageBreaks</b>
                            <span>@(candidate.StageBreaks == 1 ? L["Stage break"] : L["stage breaks"])</span>
                        </span>
                    }
                </div>
            </div>
            <div class="act">
                <MudButton Href="@MoMText.RecordPath(candidate.BoardId)" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit" data-testid="mom-onramp-record">@L["Record it"]</MudButton>
            </div>
        </div>
    }

    @* The band stays above the card on purpose. Its figures come from your stats row, not from
       capture, so they are true the moment the import lands — what it is missing is the deltas,
       and the card immediately below is what explains that absence. Hiding it too would take two
       real numbers away to avoid explaining one gap. *@
    <SessionCeremonyBand Ceremony="Breakdown.Ceremony"></SessionCeremonyBand>

    @if (Breakdown.CapturePending)
    {
        @* Rule 9: the card stands in for the WHOLE region it replaces — titles, milestones, the
           scores that mattered, the peer boards — rather than sitting inside one of them beside
           the others rendering empty. Everything below it reads live and needs no capture, so
           All plays carries on underneath. *@
        <div class="sbd-section" data-testid="session-capture-pending">
            <PatienceCard Explanation="@L["Working out what this session moved — your titles, your pool, and where each score stands among players at your level."]">
            </PatienceCard>
        </div>
    }
    else
    {
    <SessionTitleBars Bars="Breakdown.TitleBars"></SessionTitleBars>

    @if (Breakdown.Milestones.Count > 0)
    {
        <div class="sbd-section" data-testid="session-milestones">
            <div class="sbd-eyebrow sbd-section-head">@L["Titles you earned"]</div>
            @foreach (var milestone in Breakdown.Milestones.OrderBy(m => m.Kind))
            {
                <MilestoneStrip Milestone="milestone" LevelChange="LevelChange"></MilestoneStrip>
            }
        </div>
    }

    @if (HasFlagged)
    {
        @* Flagged scores render big — jacket cards, one per chart (D41). The boards that used
           to follow this section live in the chart details dialog now, which already pins you
           on every scope; a card click opens it exactly as a row's name does (D42). *@
        <div class="sbd-section" data-testid="session-highlights">
            <div class="sbd-section-head">
                <span class="sbd-eyebrow">@L["Highlights"]</span>
                <span class="sbd-section-note">@L["Colored by your standing among your peers"]</span>
            </div>
            <SessionHighlightCards Scores="Breakdown.Scores" Mix="Breakdown.Group.Mix"
                                   OnOpenChart="OnOpenChart" OnOpenBreakdown="OnOpenBreakdown"
                                   OnOpenBoard="OnOpenBoard">
            </SessionHighlightCards>
        </div>
    }
    else if (Notable.Count > 0)
    {
        @* Nothing flagged — most of the pre-capture back catalogue. The compact rows carry the
           hardest scores instead; cards with nothing to say would be manufactured ceremony. *@
        <div class="sbd-section" data-testid="session-notable">
            <div class="sbd-section-head">
                <span class="sbd-eyebrow">@L["Scores that mattered"]</span>
                <span class="sbd-section-note">@L["Colored by your standing among your peers"]</span>
            </div>
            @foreach (var score in Notable)
            {
                <SessionScoreRow Score="score" OnOpenChart="OnOpenChart"
                                 OnOpenBreakdown="OnOpenBreakdown" OnOpenBoard="OnOpenBoard"></SessionScoreRow>
            }
        </div>
    }
    }

    <div class="sbd-section" data-testid="session-all-plays">
        <div class="sbd-section-head">
            <span class="sbd-eyebrow">@L["All plays"]</span>
            <span class="sbd-section-note">@Breakdown.Scores.Count</span>
        </div>
        @* The record, not a highlight: breaks appear here as ordinary rows and are never
           counted anywhere else. Adjacent plays of one chart wear the dotted rail — an
           annotation over the flat log, never a grouping (D49). *@
        @foreach (var play in OrderedPlays.Take(_visiblePlays))
        {
            <SessionScoreRow Score="play.Score" OnOpenChart="OnOpenChart" OnOpenBreakdown="OnOpenBreakdown"
                             OnOpenBoard="OnOpenBoard"
                             ThreadClass="@play.ThreadClass" AttemptNumber="play.AttemptNumber">
            </SessionScoreRow>
        }
        @if (_visiblePlays < OrderedPlays.Count)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ShowAllPlays"
                       data-testid="session-show-all-plays">
                @L["Show all {0} plays", OrderedPlays.Count]
            </MudButton>
        }
    </div>
</MudPaper>

@code {
    private const int InitialPlays = 8;

    /// <summary>
    ///     Rows in "Scores that mattered". Flagged ones lead and keep their captions; the rest
    ///     of the slots fill with the hardest remaining scores carrying none. The section used
    ///     to gate purely on flags, which left every session predating capture showing nothing
    ///     — the same rule the Discord card already follows for its art rows.
    /// </summary>
    private const int NotableRows = 6;

    [Parameter] [EditorRequired] public SessionBreakdown Breakdown { get; set; } = null!;

    /// <summary>
    ///     What March of Murlocs makes of this night (D32). Null when the page did not ask, when
    ///     there is no live season, or when the viewer is looking at someone else's sessions — the
    ///     on-ramp is an offer to record your own play.
    /// </summary>
    [Parameter] public MoMOnRamp? MoM { get; set; }

    private string TypeName(ScoreTracker.SharedKernel.Enums.ChartType type) =>
        type == ScoreTracker.SharedKernel.Enums.ChartType.Single ? L["Singles"] : L["Doubles"];
    [Parameter] public EventCallback<Chart> OnOpenChart { get; set; }
    [Parameter] public EventCallback<SessionScore> OnOpenBreakdown { get; set; }

    /// <summary>A popover source line asking for that source's board (peers-abstraction.md D12).</summary>
    [Parameter] public EventCallback<PeerBoardRequest> OnOpenBoard { get; set; }

    /// <summary>One All-plays row with the thread annotations the hero computed for it.</summary>
    private sealed record OrderedPlay(SessionScore Score, string? ThreadClass, int? AttemptNumber);

    private int _visiblePlays = InitialPlays;
    private IReadOnlyList<SessionScore> Notable = Array.Empty<SessionScore>();
    private IReadOnlyList<OrderedPlay> OrderedPlays = Array.Empty<OrderedPlay>();

    /// <summary>An "Attempt N" caption starts meaning something at this many plays (D49).</summary>
    private const int AttemptCaptionFloor = 5;

    protected override void OnParametersSet()
    {
        // Cast to int BEFORE the coalesce: DifficultyLevel rejects 0, so a chart the page
        // could not resolve would throw out of here rather than sorting last.
        // Chart id between level and time: same-chart plays sit adjacent so the attempt
        // thread can join them — the log stays complete, only the shuffle changes (D49).
        var ordered = Breakdown.Scores
            .OrderByDescending(s => (int?)s.Chart?.Level ?? 0)
            .ThenBy(s => s.Row.ChartId)
            .ThenByDescending(s => s.Row.OccurredAt)
            .ToArray();
        OrderedPlays = Thread(ordered);
        // A break is never a score that mattered (D6). It used to reach this section as PADDING
        // — the list tops itself up with unflagged rows to fill six, and on a thin session the
        // highest-level row can be a stage break. Breaks belong in All plays, as the neutral
        // log they are, and nowhere else.
        var eligible = ordered.Where(s => !s.Row.IsBroken).ToArray();
        HasFlagged = eligible.Any(s => s.IsFlagged);
        Notable = eligible.Where(s => s.IsFlagged)
            .Concat(eligible.Where(s => !s.IsFlagged))
            .Take(NotableRows)
            .ToArray();
        _visiblePlays = InitialPlays;
    }

    /// <summary>Cards for flagged sessions, the compact rows for everything else (D41).</summary>
    private bool HasFlagged;

    /// <summary>
    ///     Runs of one chart get the rail; runs of five or more also get "Attempt N" captions
    ///     on every row but the newest — the newest is the one whose badges tell the ending,
    ///     and numbering it too would caption the punchline (D49). Attempts count from the
    ///     oldest play, so "Attempt 2" is the second time the player stepped on.
    /// </summary>
    private static IReadOnlyList<OrderedPlay> Thread(IReadOnlyList<SessionScore> ordered)
    {
        var plays = new OrderedPlay[ordered.Count];
        var start = 0;
        while (start < ordered.Count)
        {
            var end = start;
            while (end + 1 < ordered.Count && ordered[end + 1].Row.ChartId == ordered[start].Row.ChartId) end++;
            var length = end - start + 1;
            for (var i = start; i <= end; i++)
            {
                int? attempt = length >= AttemptCaptionFloor && i > start ? length - (i - start) : null;
                plays[i] = new OrderedPlay(ordered[i], RailFor(i, start, end), attempt);
            }

            start = end + 1;
        }

        return plays;
    }

    /// <summary>The rail's shape at one row of a run: half-height at the ends, absent alone.</summary>
    private static string? RailFor(int index, int start, int end)
    {
        if (end == start) return null;
        if (index == start) return "sbd-thread sbd-thread-start";
        if (index == end) return "sbd-thread sbd-thread-end";
        return "sbd-thread";
    }

    private void ShowAllPlays() => _visiblePlays = OrderedPlays.Count;

    private string SourceLabel => Breakdown.Group.Source switch
    {
        "officialImport" => L["Official Import"],
        "csv" => L["CSV Upload"],
        "backfill" => L["Backfill"],
        _ => L["Play Session"]
    };

    private string DurationSuffix
    {
        get
        {
            var duration = Breakdown.Group.End - Breakdown.Group.Start;
            return duration.TotalMinutes < 5 ? string.Empty : $" · {L["{0} min", (int)duration.TotalMinutes]}";
        }
    }

    /// <summary>
    ///     The batch's PUMBILITY level crossing, derived once for the whole milestone set —
    ///     suppression (a gem title completing beside it) is a batch-level fact no single strip
    ///     can see (docs/design/pumbility-levels.md §5).
    /// </summary>
    private PumbilityLevelChange? LevelChange =>
        PumbilityLevelChange.TryFrom(Breakdown.Group.Mix, Breakdown.Milestones);
}
