@using System.ComponentModel.DataAnnotations
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Domain.Records
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Services.Theming
@using Align = MudBlazor.Align
@namespace ScoreTracker.Web.Components
@* MudTooltip renders a popover, which throws in static SSR (no provider in the static tree).
   The tooltip only carries hover text, so a static render drops it and keeps the grade, plate
   and score; in a circuit it comes back. *@
@if (RendererInfo.IsInteractive && Tooltip)
{
    <MudTooltip Text=@(ShowTextAsTooltip?Text:ShowScore && string.IsNullOrWhiteSpace(Text)?RankingString:ScoreString) ShowOnFocus="true">
        @Body
    </MudTooltip>
}
else
{
    @Body
}
@code {
    private RenderFragment Body => @<text>
        @if (Score != null)
        {
            <MudImage tabindex="0" Src="@LetterGradeImage" Height="@Height" ObjectFit="ObjectFit.ScaleDown"></MudImage>
        }
        @if (ShownPlate != null)
        {
            <MudImage tabindex="0" Src="@PlateImage" Height="@Height" ObjectFit="ObjectFit.ScaleDown"></MudImage>
        }
        @if (ShowScore && Score != null && string.IsNullOrWhiteSpace(Text))
        {
            <MudText tabindex="0" Align="Align.Center" Style=@(OneLine?$"{RankingColor}display:inline;padding-left:5px;vertical-align:top;":$"{RankingColor}vertical-align:top;")>
                @ScoreString
            </MudText>
        }
        @if (!string.IsNullOrWhiteSpace(Text) && !ShowTextAsTooltip)
        {
            <MudText tabindex="0" Align="Align.Center" Style=@(OneLine?$"{RankingColor}display:inline;padding-left:5px;vertical-align:top;":$"{RankingColor}vertical-align:top;")>
                @Text
            </MudText>
        }
    </text>;

    [Parameter]
    public PhoenixScore? Score { get; set; }

    [Parameter]
    public bool IsBroken { get; set; } = false;

    [Parameter]
    public int Height { get; set; } = 20;

    [Parameter] public PhoenixPlate? Plate { get; set; }

    /// <summary>
    ///     Set false where a missing plate is the source's silence rather than missing data — the
    ///     mirrored official board records no plates at all, so drawing one there would be this
    ///     site asserting something piugame never said.
    /// </summary>
    [Parameter] public bool InferPlate { get; set; } = true;

    /// <summary>
    ///     A million is a Perfect Game by definition — every judgement was perfect, there is no
    ///     other way to reach it — so a stored plate is confirmation, not the source of the fact.
    ///     Sources that carry a score without one (older imports) would otherwise show the site's
    ///     best possible result as plateless next to a 994k that has a plate. Never inferred for a
    ///     broken run: 1,000,000 cannot be broken, so if both are somehow set the stored plate
    ///     wins and the data speaks for itself.
    /// </summary>
    private PhoenixPlate? ShownPlate =>
        Plate ?? (InferPlate && !IsBroken && Score == 1_000_000 ? PhoenixPlate.PerfectGame : null);

    [Parameter]
    public bool ShowScore { get; set; } = false;

    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public bool ShowTextAsTooltip { get; set; } = false;

    /// <summary>
    ///     Set false where the hover text would only repeat what is already on screen — a
    ///     leaderboard row prints the score right beside the icons. It also flattens the
    ///     markup to a bare img/img/p, which is what lets a caller lay the three out itself;
    ///     the tooltip wraps them in a container whose depth is MudBlazor's business, not the
    ///     caller's.
    /// </summary>
    [Parameter]
    public bool Tooltip { get; set; } = true;

    [Parameter]
    public bool OneLine { get; set; } = false;
    [Parameter]
    public ScoreRankingRecord? Ranking { get; set; }

    private string RankingColor => ThemeScales.RarityStyle(Ranking?.Ranking);

    private string RankingString => Ranking == null ? "" : L["X% of Y Comparable Players", (Ranking.Ranking * 100.0).ToString("N1"), Ranking.PlayerCount].Value;
    // The grade image depends on the mix's score→grade table (Phoenix 2 re-cut sub-AAA),
    // so every consumer names the mix its score was earned in.
    [Parameter]
    public MixEnum Mix { get; set; } = MixEnum.Phoenix;

    private string ScoreString => (Score == null ? "" : ((int)Score).ToString("N0"));
    private string BrokenPiece => IsBroken ? "_broken" : "";
    private string LetterGradeImage =>
        $"https://piuimages.arroweclip.se/letters/{Score?.LetterGradeFor(Mix).ToString().ToLower()}{BrokenPiece}.png";

    private string PlateImage => $"https://piuimages.arroweclip.se/plates/{ShownPlate?.GetShorthand().ToLower()}.png";

}
