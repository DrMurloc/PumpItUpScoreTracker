@using MediatR
@using ScoreTracker.Domain.Models
@using ScoreTracker.Domain.Records
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.Rivals.Contracts.Queries
@using ScoreTracker.ScoreLedger.Contracts.Commands
@using ScoreTracker.ScoreLedger.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.SharedKernel.ValueTypes
@namespace ScoreTracker.Web.Components
@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@inject IDateTimeOffsetAccessor Clock
@inject ISnackbar Snackbar

@* Your best + the cross-mix journey, with recording folded in behind an edit toggle
   (mock R2, the dialog's round-11 pattern — never EditChartGrid). It sits in the hero's
   nook under the jacket: your score is the first thing you look for, and a page-bottom
   form plus two "Record score" buttons that only scrolled you to it was three affordances
   for one job. Becomes the record island at Stage 3; everything here is personal, so none
   of it belongs in cached anonymous HTML anyway. *@
@if (CurrentUser.IsLoggedIn && Chart != null)
{
    <div class="chart-record" id="chart-record">
        <div class="chart-record-head">
            <span class="chart-overline">@(_editing ? L["Record Score"] : L["Your best"]) · @Mix.GetName()</span>
            <MudIconButton Icon="@(_editing ? Icons.Material.Filled.Close : Icons.Material.Filled.Edit)"
                           Size="Size.Small" Class="chart-record-edit"
                           aria-label="@(_editing ? L["Close"] : L["Record Score"])"
                           OnClick="@(() => _editing = !_editing)"></MudIconButton>
        </div>
        @if (_editing)
        {
            <RecordScoreForm Chart="Chart" Mix="Mix" OnSaved="OnRecordSaved"></RecordScoreForm>
        }
        else
        {
            @if (_isLegacy && _legacyBest != null)
            {
                @* A legacy best leads with its grade: the letter IS the score in every mix
                   before Phoenix. The era number rides along when the player supplied one,
                   and stays a plain figure — it is not out of 1,000,000 and there is no
                   plate or ranking to hang off it. *@
                <div class="chart-record-score">
                    <LetterGradeIcon LegacyGrade="_legacyBest.LetterGrade" IsBroken="_legacyBest.IsBroken"
                                     Height="26"></LetterGradeIcon>
                    @if (_legacyBest.Score is { } legacyScore)
                    {
                        <span class="chart-record-legacy-score">@(((int)legacyScore).ToString("N0"))</span>
                    }
                </div>
            }
            else if (!_isLegacy && _best?.Score != null)
            {
                <div class="chart-record-score">
                    @* No board callback: the chart page's own board sits further down this page. *@
                    <PeerScore Score="_best.Score.Value" IsBroken="_best.IsBroken" Mix="Mix" Plate="_best.Plate"
                               Standing="_standing" Chart="Chart"></PeerScore>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="chart-record-empty">@L["No score yet — record your first attempt and this lights up."]</MudText>
            }
            @* Only ever under a score. A Phoenix record can exist with a null score, and the age
               was rendering beneath "No score yet" for those. *@
            @if (_ageDays != null && (_legacyBest != null || _best?.Score != null))
            {
                <MudText Typo="Typo.caption" Class="chart-record-age">@L["Recorded {0} days ago", _ageDays]</MudText>
            }
            <ScoreJourneyList Entries="_journey" PageMix="Mix" NoteCount="Chart?.NoteCount"></ScoreJourneyList>
        }
    </div>
}

@code {
    // Serializable parameters only: a Chart record faults the circuit if passed to an island,
    // so the island takes the id and self-loads (docs/design/chart-details-overhaul.md).
    [Parameter]
    public Guid ChartId { get; set; }

    [Parameter]
    public MixEnum Mix { get; set; } = MixEnum.Phoenix;

    private Chart? Chart { get; set; }
    private RecordedPhoenixScore? _best;
    private XXChartAttempt? _legacyBest;
    private PeerStanding? _standing;
    private int? _ageDays;
    private IReadOnlyList<ScoreJournalEntry> _journey = Array.Empty<ScoreJournalEntry>();
    private bool _editing;
    private Guid _loadedFor;

    private bool _isLegacy => Mix.UsesLegacyScoring();

    protected override async Task OnParametersSetAsync()
    {
        // Everything here is personal, so anonymous renders nothing and skips the load.
        if (!CurrentUser.IsLoggedIn || ChartId == _loadedFor) return;
        _loadedFor = ChartId;
        Chart = (await Mediator.Send(new GetChartsQuery(Mix, ChartIds: new[] { ChartId }))).FirstOrDefault();
        if (Chart == null) return;
        await LoadBest();
        _journey = (await Mediator.Send(new GetChartScoreJourneyQuery(Chart.Id))).ToArray();
    }

    /// <summary>
    ///     Reads the best from the store that mix actually uses. A legacy record lives in
    ///     BestAttempt as a letter grade; only Phoenix-generation records live in the Phoenix
    ///     store. Asking the Phoenix store about a legacy mix is what made a real record read
    ///     as "No score yet" on this very panel.
    /// </summary>
    private async Task LoadBest()
    {
        if (Chart == null) return;
        if (_isLegacy)
        {
            _legacyBest = (await Mediator.Send(new GetXXBestChartAttemptQuery(Chart.Id, Mix))).BestAttempt;
            _best = null;
            // Standings are built from Phoenix scores, so there is no legacy percentile to
            // quote — era scores are note-count dependent and do not compare across charts.
            _standing = null;
            _ageDays = _legacyBest == null ? null : (int)(Clock.Now - _legacyBest.RecordedOn).TotalDays;
            return;
        }

        _best = await Mediator.Send(new GetPhoenixRecordQuery(Chart.Id, Mix));
        _legacyBest = null;
        _standing = (await Mediator.Send(new GetPeerStandingsQuery(Mix, new[] { Chart.Id })))
            .TryGetValue(Chart.Id, out var standing)
            ? standing
            : null;
        _ageDays = _best == null ? null : (int)(Clock.Now - _best.RecordedDate).TotalDays;
    }

    /// <summary>
    ///     The form owns the write and its own error reporting; the panel re-reads what
    ///     landed and returns to the score, which is the thing that just changed.
    /// </summary>
    private async Task OnRecordSaved(RecordScoreForm.Result result)
    {
        if (Chart == null) return;
        Snackbar.Add(L["Score recorded for {0}", Chart.Song.Name.ToString()].Value, Severity.Success);
        await LoadBest();
        _journey = (await Mediator.Send(new GetChartScoreJourneyQuery(Chart.Id))).ToArray();
        _editing = false;
    }
}
