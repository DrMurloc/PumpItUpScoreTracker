@namespace ScoreTracker.Web.Components.CommunityTools
@using MediatR
@using ScoreTracker.CommunityTools.Contracts.Queries
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.Web.Services.Contracts

@* The one-time rollout notice, shown once per signed-in player.

   The public-profile branch has to confess a setting that was turned on FOR them — the only
   sentence in this feature that could read as a bait-and-switch — so it leads with that and links
   straight to the toggle rather than burying the exit behind "Got it". A private player has
   nothing to confess to, and gets the short version.

   A render-nothing-until-relevant island, modelled on DeletionNoticeHost: MainLayout renders
   statically, so this cannot be a plain dialog sitting in it. *@
@* Gated on _relevant, never on _show — the flag bound to Visible must not also decide whether the
   dialog is rendered at all. Removing a MudDialog from the tree skips its close path and leaves the
   scrim behind, so "Got it" dismissed the notice onto a page that stayed dimmed and unclickable
   until the player reloaded. Same shape as DeletionNoticeHost, which gates on its own payload. *@
@if (_relevant)
{
    <MudDialog @bind-Visible="_show" Options="_options">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Community tools can now use your scores"]</MudText>
        </TitleContent>
        <DialogContent>
            <div class="d-flex flex-column gap-3">
                <MudText Typo="Typo.body2">
                    @L["Players in the PIU community build things on top of your scores — pumbility planners, pattern analysis, Discord rank bots. There's now a page where you can see them and choose who gets access."]
                </MudText>
                @if (_isPublic)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        <MudText Typo="Typo.body2"><b>@L["Your profile is public, so sharing is on."]</b></MudText>
                        <MudText Typo="Typo.body2">
                            @L["Public profiles default to sharing, so tools can read your scores until you turn it off — which you can do any time from your Account page."]
                        </MudText>
                    </MudAlert>
                    <MudText Typo="Typo.body2" Style="opacity:.75;">
                        @L["Turning it off doesn't touch your profile. Your scores stay visible on PIU Scores either way."]
                    </MudText>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        <MudText Typo="Typo.body2"><b>@L["Your profile is private, so nothing is shared."]</b></MudText>
                        <MudText Typo="Typo.body2">
                            @L["Nothing changed for you. You can still share with a single tool you trust using an invite link from its maker."]
                        </MudText>
                    </MudAlert>
                }
            </div>
        </DialogContent>
        <DialogActions>
            <MudSpacer></MudSpacer>
            @if (_isPublic)
            {
                <MudButton Variant="Variant.Text" OnClick="DismissToAccount">@L["Turn it off"]</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       OnClick="DismissToDirectory">@L["Browse tools"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DismissHere">@L["Got it"]</MudButton>
        </DialogActions>
    </MudDialog>
}

@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@inject IUiSettingsAccessor UiSettings
@inject NavigationManager NavManager
@code {
    /// <summary>Set once the player has seen the notice. Its presence is the whole "already shown" test.</summary>
    private const string SeenKey = "CommunityToolsAnnouncementSeen";

    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.False, FullWidth = true };

    /// <summary>Whether this player has a notice at all. Set once and never cleared.</summary>
    private bool _relevant;

    private bool _show;
    private bool _isPublic;

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsLoggedIn) return;

        if (await UiSettings.GetSetting(SeenKey) is not null) return;

        _isPublic = CurrentUser.User.IsPublic;
        // Reading the preference rather than assuming it: a player who already found the toggle
        // and turned it off should not be told it is on.
        if (_isPublic) _isPublic = await Mediator.Send(new GetShareWithAllToolsQuery());

        _relevant = true;
        _show = true;
    }

    private Task DismissToAccount() => Dismiss("/Account");

    private Task DismissToDirectory() => Dismiss("/CommunityTools");

    private Task DismissHere() => Dismiss(null);

    private async Task Dismiss(string? goTo)
    {
        _show = false;
        await UiSettings.SetSetting(SeenKey, "true");
        if (goTo is not null) NavManager.NavigateTo(goTo);
    }
}
