@namespace ScoreTracker.Web.Components.CommunityTools
@using MediatR
@using ScoreTracker.CommunityTools.Contracts
@using ScoreTracker.CommunityTools.Contracts.Queries

@* A checklist with live state, not a manual. The prose lives in docs/INTEGRATING.md on GitHub —
   zero localization cost, versioned with the code it documents, and makers already live there.
   What is on-site is the part that needs YOUR keys and YOUR tool.

   It doubles as the /Developers empty state, so a maker with no tools lands on the path rather
   than a blank box. *@

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.subtitle2" Class="mb-1">@L["Build a tool"]</MudText>
    <MudText Typo="Typo.body2" Style="opacity:.75;" Class="mb-3">
        @L["Seven steps from nothing to a listed tool."]
    </MudText>

    @foreach (var step in Steps())
    {
        <div class="d-flex gap-3 py-2" style="border-bottom:1px solid color-mix(in srgb, var(--mix-ink) 7%, transparent);">
            <MudIcon Size="Size.Small"
                     Color="@(step.Done ? Color.Success : Color.Default)"
                     Icon="@(step.Done ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)"></MudIcon>
            <div style="min-width:0;">
                <MudText Typo="Typo.body2"><b>@step.Title</b></MudText>
                <MudText Typo="Typo.caption" Style="opacity:.7;">@step.Detail</MudText>
            </div>
        </div>
    }

    <div class="d-flex gap-2 mt-3 flex-wrap">
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Href="/swagger/ui" Target="_blank"
                   EndIcon="@Icons.Material.Filled.OpenInNew">@L["Swagger"]</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Target="_blank"
                   Href="https://github.com/DrMurloc/PumpItUpScoreTracker/blob/main/docs/INTEGRATING.md"
                   EndIcon="@Icons.Material.Filled.OpenInNew">@L["Full reference"]</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Target="_blank"
                   Href="https://github.com/DrMurloc/PumpItUpScoreTracker/blob/main/docs/HOW-TO-RUN.md"
                   EndIcon="@Icons.Material.Filled.OpenInNew">@L["Run it locally"]</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Target="_blank"
                   Href="https://discord.gg/AvS5PxnvSN"
                   EndIcon="@Icons.Material.Filled.OpenInNew">@L["Ask on Discord"]</MudButton>
    </div>
</MudPaper>

@inject IMediator Mediator
@code {
    private sealed record Step(string Title, string Detail, bool Done);

    private IReadOnlyList<ApiKeyRecord> _keys = Array.Empty<ApiKeyRecord>();

    [Parameter] public ToolRecord? Tool { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _keys = Tool is null
            ? Array.Empty<ApiKeyRecord>()
            : await Mediator.Send(new GetToolApiKeysQuery(Tool.Id));
    }

    private IEnumerable<Step> Steps()
    {
        var hasKey = _keys.Any(k => !k.IsRevoked && !k.IsExpired(DateTimeOffset.Now));

        yield return new Step(L["Create your tool"].Value,
            L["It starts private and fully working. Listing only puts you in the directory."].Value,
            Tool is not null);

        yield return new Step(L["Create an API key"].Value,
            L["Send it as Authorization: Bearer. Shown once — we store a hash."].Value,
            hasKey);

        // Presented as a step rather than left as invisible magic: it is what makes the next step
        // possible, and a maker hunting for themselves in their own directory would be silly.
        yield return new Step(L["You're connected to your own tool"].Value,
            L["Done automatically when you created it, so you always have one real player to test against — yourself."].Value,
            Tool is not null);

        yield return new Step(L["Pull your scores"].Value,
            L["Open Swagger, press Authorize, paste your key, then try GET /api/v2/players/me/scores?mix=Phoenix."].Value,
            false);

        yield return new Step(L["Receive imports"].Value,
            L["Point us at a URL and we'll POST there whenever one of your players imports."].Value,
            Tool is { WebhookMode: not WebhookMode.None });

        yield return new Step(L["Invite a friend"].Value,
            L["Share an invite link. Anyone with it can connect, public profile or not."].Value,
            Tool is not null && Tool.ConnectedPlayers > 1);

        yield return new Step(L["Ask to be listed"].Value,
            L["A listed tool appears in the directory and can accept players who share with all tools. You keep working while it's reviewed."].Value,
            Tool is { Visibility: ToolVisibility.Public });
    }
}
