@namespace ScoreTracker.Web.Components.CommunityTools
@using MediatR
@using ScoreTracker.CommunityTools.Contracts
@using ScoreTracker.CommunityTools.Contracts.Commands
@using ScoreTracker.SharedKernel.Enums

@* Its own section rather than a block inside general settings: a maker sets a name once and comes
   back to the delivery config, and burying the second inside the first made them save both to
   change either.

   "Nothing" leads the list and collapses everything under it. A tool that receives nothing has no
   URL, no header, and no mixes to pick — showing those anyway asks the maker to decide things that
   do not apply to them. *@

<div class="ct-cards">
    <ConsoleCard Title=@L["Delivery"].Value Class="ct-card-wide"
                 Hint='@L["What arrives when one of your players imports. Nothing is a fine answer — plenty of tools just poll."].Value'>
        @* A button group with one line under it, the way the tier list picks its type. Four radios
           each carrying a sentence made the mode choice the loudest thing on the page. *@
        <MudButtonGroup OverrideStyles="false" Class="mb-2">
            @foreach (var option in Modes)
            {
                <MudButton Size="Size.Small" Color="@(option == WebhookMode.PiuGameSession ? Color.Warning : Color.Primary)"
                           Variant="@(_mode == option ? Variant.Filled : Variant.Outlined)"
                           Disabled="@(option == WebhookMode.PiuGameSession && SessionModeLocked)"
                           OnClick="() => _mode = option">@ModeName(option)</MudButton>
            }
        </MudButtonGroup>
        <MudText Typo="Typo.body2" Style="opacity:.75;">@ModeDescription(_mode)</MudText>
    </ConsoleCard>

    @if (_mode != WebhookMode.None)
    {
        @* Everything past this is about where a delivery goes, so none of it appears until there is
           somewhere for it to go. *@
        <ConsoleCard Title=@L["Your API"].Value Class="ct-card-wide"
                     Hint='@L["The endpoint PIU Scores POSTs to when one of your players imports."].Value'>
            <MudTextField T="string" @bind-Value="_url" Label=@L["Your API"] MaxLength="500"
                          Immediate="true" Placeholder="https://example.piutool.com/score"></MudTextField>

            @if (!string.IsNullOrWhiteSpace(_url))
            {
                <div class="d-flex align-center gap-3 mt-3 flex-wrap">
                    @* Verify uses the SAVED url, so an unsaved edit would check the old one and
                       report a pass for an endpoint the maker is no longer pointing at. *@
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               Disabled="@(!CanVerify)" OnClick="VerifyWebhook">@L["Verify"]</MudButton>
                    @if (!CanVerify && Tool.HasVerificationSecret && HasUnsavedUrl)
                    {
                        <MudText Typo="Typo.caption" Style="opacity:.7;">@L["Save first."]</MudText>
                    }
                    @if (Tool.WebhookUrlVerifiedAt is null)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                            @L["Not verified — nothing is being sent"]
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                            @L["Verified {0}", Tool.WebhookUrlVerifiedAt.Value.LocalDateTime.ToString("dd MMM yyyy")]
                        </MudChip>
                    }
                    @if (!Tool.HasVerificationSecret)
                    {
                        <MudText Typo="Typo.caption" Style="opacity:.7;">
                            @L["Save a verification secret first."]
                        </MudText>
                    }
                    @if (_verifyResult is not null)
                    {
                        <MudText Typo="Typo.body2">@_verifyResult</MudText>
                    }
                </div>
            }
        </ConsoleCard>
    }

    @if (_mode != WebhookMode.None && !string.IsNullOrWhiteSpace(_url))
    {
        @* Two secrets, opposite directions, and the reason they can never be one value: the header
           goes to their server on every call, so anyone who receives a delivery has read it. *@
        <ConsoleCard Title=@L["Request Header"].Value
                     Hint='@L["This header is sent verbatim on every delivery and on the verification call. Check it in your handler and reject anything without it. Stored encrypted, because it has to be sent."].Value'>
            @* The name is ours. A maker choosing it was a decision with no right answer standing
               between them and the one that matters. *@
            <MudText Typo="Typo.body2" Class="mb-2">
                <code>@WebhookContract.OutboundHeader</code>
            </MudText>

            @if (Tool.HasOutboundHeaderValue && !_changingHeader)
            {
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                        @L["Set"]
                    </MudChip>
                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               OnClick="() => _changingHeader = true">@L["Set a new one"]</MudButton>
                </div>
            }
            else
            {
                <div class="ct-reveal">
                    <MudTextField T="string" @bind-Value="_headerValue" Label=@L["Value"]
                                  MaxLength="128" InputType="InputType.Password"></MudTextField>
                </div>
            }

            @if (_mode == WebhookMode.PiuGameSession && !Tool.HasOutboundHeaderValue)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    @L["Header required for PIUGame session, so your server knows it is you receiving user sessions."]
                </MudAlert>
            }
        </ConsoleCard>

        <ConsoleCard Title=@L["Response Secret"].Value
                     Hint='@L["Your endpoint answers a verification request with this. It is never sent anywhere — that is what makes answering with it proof, and why a hijacked DNS record can't pass. Stored as a hash, so put it somewhere you can find it."].Value'>
            @if (Tool.HasVerificationSecret && !_changingSecret)
            {
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                        @L["Set"]
                    </MudChip>
                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               OnClick="() => _changingSecret = true">@L["Set a new one"]</MudButton>
                </div>
            }
            else
            {
                <div class="ct-reveal">
                    <MudTextField T="string" @bind-Value="_verificationSecret" Label=@L["Secret"]
                                  MaxLength="128" InputType="InputType.Password"></MudTextField>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1"
                               OnClick="GenerateSecret">@L["Generate one"]</MudButton>
                </div>
            }

            @if (_generated is not null)
            {
                <div class="ct-secret ct-secret-wrap mt-2">
                    <pre>@_generated</pre>
                    <MudIconButton Class="ct-secret-copy" Icon="@Icons.Material.Filled.ContentCopy"
                                   Size="Size.Small" Color="Color.Default" aria-label=@L["Copy"]
                                   OnClick="CopyGenerated"></MudIconButton>
                </div>
                <MudText Typo="Typo.caption" Class="d-block mt-1" Style="opacity:.7;">
                    @L["Copy it into your handler and press Save. Only a hash is kept, so this is the last time you'll see it here."]
                </MudText>
            }
        </ConsoleCard>

        <ConsoleCard Title=@L["Mixes"].Value Class="ct-card-wide"
                     Hint='@L["Only imports for the mixes you pick are sent. Older mixes score on letter grades rather than the 1M scale — the payload says which model it's using."].Value'>
            <div class="d-flex gap-2 flex-wrap">
                @foreach (var mix in PrimaryMixes)
                {
                    <MudChip T="string" Size="Size.Small" Color="@(_mixes.Contains(mix) ? Color.Info : Color.Default)"
                             Variant="Variant.Outlined" OnClick="() => ToggleMix(mix)">@mix.GetName()</MudChip>
                }
            </div>
            <MudExpansionPanels Class="mt-2" Elevation="0">
                <MudExpansionPanel Text='@L["Older mixes ({0})", OlderMixes.Length].Value'>
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var mix in OlderMixes)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(_mixes.Contains(mix) ? Color.Info : Color.Default)"
                                     Variant="Variant.Outlined" OnClick="() => ToggleMix(mix)">@mix.GetName()</MudChip>
                        }
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </ConsoleCard>
    }
</div>

<div class="d-flex gap-2 align-center flex-wrap mt-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@L["Save"]</MudButton>
</div>

@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@code {
    private static readonly MixEnum[] PrimaryMixes =
        Enum.GetValues<MixEnum>().Where(m => m.IsPrimary()).OrderByDescending(m => m.DisplayOrder()).ToArray();

    private static readonly MixEnum[] OlderMixes =
        Enum.GetValues<MixEnum>().Where(m => !m.IsPrimary()).OrderByDescending(m => m.DisplayOrder()).ToArray();

    private WebhookMode _mode = WebhookMode.None;
    private string _url = string.Empty;

    // Never populated from the record — neither secret's value travels. Blank means "keep stored".
    private string _headerValue = string.Empty;
    private string _verificationSecret = string.Empty;

    // Shown once, right after Generate, so it can be copied into a handler. Dropped on save.
    private string? _generated;
    private HashSet<MixEnum> _mixes = new();
    private bool _verifying;
    /// <summary>
    ///     A password box standing empty beside a value that already exists reads as "it is gone".
    ///     So a set secret shows as set, and changing it is a decision you make first.
    /// </summary>
    private bool _changingHeader;

    private bool _changingSecret;

    /// <summary>
    ///     Whether the box holds something the server has not been told about. Compared as URLs
    ///     rather than as text: the saved value has been through <see cref="Uri" />, which gives a
    ///     bare host the trailing slash the maker didn't type — and reading that back as an unsaved
    ///     edit would leave Verify permanently disabled for anyone whose endpoint is a bare host.
    /// </summary>
    private bool HasUnsavedUrl => !SameTarget(Tool.WebhookUrl, _url);

    /// <summary>Everything the request needs, on the server's side of the save.</summary>
    private bool CanVerify => !_verifying
                              && Tool.HasVerificationSecret
                              && !string.IsNullOrWhiteSpace(Tool.WebhookUrl)
                              && !HasUnsavedUrl;

    private static bool SameTarget(string? saved, string? typed)
    {
        saved = saved?.Trim() ?? string.Empty;
        typed = typed?.Trim() ?? string.Empty;
        if (string.Equals(saved, typed, StringComparison.OrdinalIgnoreCase)) return true;

        return Uri.TryCreate(saved, UriKind.Absolute, out var savedUri)
               && Uri.TryCreate(typed, UriKind.Absolute, out var typedUri)
               && savedUri == typedUri;
    }

    private static readonly WebhookMode[] Modes =
    {
        WebhookMode.None, WebhookMode.ScorePush, WebhookMode.PlayerPing, WebhookMode.PiuGameSession
    };

    private string ModeName(WebhookMode mode) => mode switch
    {
        WebhookMode.ScorePush => L["Score Push"].Value,
        WebhookMode.PlayerPing => L["Player ping"].Value,
        WebhookMode.PiuGameSession => L["PIUGame session"].Value,
        _ => L["Nothing"].Value
    };

    /// <summary>One line, under the group, for whichever is selected.</summary>
    private string ModeDescription(WebhookMode mode) => mode switch
    {
        WebhookMode.ScorePush => L["The scores themselves, 100 per delivery, with a next link when there are more."].Value,
        WebhookMode.PlayerPing => L["Just \"this player imported\". You pull what you need from the API."].Value,
        WebhookMode.PiuGameSession => SessionModeLocked
            ? L["Locked: every connected player must agree to it individually, so this can only be turned on while no one is connected."].Value
            : L["The piugame.com session key is forwarded so you run your own import."].Value,
        _ => L["Poll the API instead."].Value
    };
    private string? _verifyResult;
    private Guid _loadedFor;

    [Parameter] [EditorRequired] public ToolRecord Tool { get; set; } = default!;

    [Parameter] public EventCallback OnChanged { get; set; }

    private bool SessionModeLocked =>
        Tool.ConnectedPlayers > 0 && Tool.WebhookMode != WebhookMode.PiuGameSession;

    /// <summary>
    ///     Reloads the boxes from the record when the tool changes and after each save, not on every
    ///     re-render — re-seeding on every render would throw away anything typed since.
    ///     What it deliberately leaves alone is the two things on screen that came from a button
    ///     rather than from the record: the verify outcome and the generated secret. Both are shown
    ///     once, and both arrive alongside a save, so clearing them here erased them on sight.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_loadedFor == Tool.Id) return;

        _loadedFor = Tool.Id;
        _mode = Tool.WebhookMode;
        _url = Tool.WebhookUrl ?? string.Empty;
        _headerValue = string.Empty;
        _verificationSecret = string.Empty;
        _mixes = Tool.Mixes.ToHashSet();
    }

    /// <summary>
    ///     Fills the box and shows the value once, because a maker cannot put a secret in their
    ///     handler if they never see it — and we keep only a hash after Save.
    /// </summary>
    private void GenerateSecret()
    {
        _generated = WebhookVerificationSecret.New();
        _verificationSecret = _generated;
    }

    private async Task CopyGenerated()
    {
        if (_generated is null) return;

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _generated);
        Snackbar.Add(L["Copied"].Value, Severity.Success);
    }

    private void ToggleMix(MixEnum mix)
    {
        if (!_mixes.Add(mix)) _mixes.Remove(mix);
    }

    /// <summary>
    ///     Validates before sending anything: these are two commands, and a throw on the second
    ///     leaves the first committed.
    /// </summary>
    private async Task Save()
    {
        var problem = ValidationProblem();
        if (problem is not null)
        {
            Snackbar.Add(problem, Severity.Error);
            return;
        }

        // A save can withdraw the proof — changing the URL or the secret clears it — so last time's
        // "Verified" must not survive the thing that invalidated it.
        _verifyResult = null;

        try
        {
            // Before the webhook command, so entering session mode can see the header it requires.
            await Mediator.Send(new SetToolOutboundHeaderCommand(Tool.Id, _headerValue));
            // Only when they typed one: this command clears verification, and sending it on every
            // save would un-verify a working webhook every time the maker edits a mix chip.
            if (!string.IsNullOrWhiteSpace(_verificationSecret))
                await Mediator.Send(new SetToolVerificationSecretCommand(Tool.Id, _verificationSecret));
            await Mediator.Send(new SetToolWebhookCommand(Tool.Id, _mode,
                string.IsNullOrWhiteSpace(_url) ? null : _url, _mixes.ToArray()));
        }
        catch (Exception e)
        {
            // A domain exception's message is written for the person who tripped it.
            Snackbar.Add(e.Message, Severity.Error);
            await Refresh();
            return;
        }

        _changingHeader = false;
        _changingSecret = false;
        _headerValue = string.Empty;
        _verificationSecret = string.Empty;
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Refresh();
    }

    private string? ValidationProblem()
    {
        if (_mode != WebhookMode.None)
        {
            if (string.IsNullOrWhiteSpace(_url))
                return L["Pick where to deliver, or choose Nothing."].Value;

            if (!IsBrowsableUrl(_url))
                return L["\"{0}\" isn't a valid link. Include https://", _url].Value;
        }

        // Nothing to say about the header: its name is ours now, so a value can never be missing one.
        return null;
    }

    private static bool IsBrowsableUrl(string value)
    {
        return Uri.TryCreate(value, UriKind.Absolute, out var uri)
               && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp);
    }

    /// <summary>
    ///     Verifies the saved URL, not the one in the box — a maker who edits and presses Verify
    ///     without saving would otherwise get a green tick for a URL we are not going to use.
    /// </summary>
    private async Task VerifyWebhook()
    {
        _verifying = true;
        _verifyResult = null;
        try
        {
            var result = await Mediator.Send(new VerifyToolWebhookCommand(Tool.Id));
            _verifyResult = result.Verified
                ? L["Verified — deliveries are on."].Value
                // The remote's own words. Ours would tell them nothing they can act on.
                : L["Failed: {0}{1}", result.Reason ?? string.Empty,
                    result.StatusCode is null ? string.Empty : $" ({result.StatusCode})"].Value;
            await Refresh();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _verifying = false;
        }
    }

    private async Task Refresh()
    {
        _loadedFor = Guid.Empty;
        await OnChanged.InvokeAsync();
    }
}
