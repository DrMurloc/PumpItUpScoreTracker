@using System.ComponentModel.DataAnnotations
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Contracts
@using ScoreTracker.Web.Services.Theming
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@namespace ScoreTracker.Web.Components
@inject DifficultyGlow Glow
@if (Chart != null || (Type != null && Level != null))
{
    @* No tooltip and no tab stop: the picture's alt (or the chip's own text) names the
       difficulty, and a glowing bubble's title is its only hover text. *@
    @Bubble
}
@code {
    private RenderFragment Bubble => UseLegacyChip
        ? @<span class="legacy-chip difficulty-bubble" title="@GlowReason" style="border-color:@ThemeScales.SlotColor(Chart?.Slot);color:@ThemeScales.SlotColor(Chart?.Slot);font-size:@(Small ? ".62rem" : ".78rem");">@ChipText</span>
        @* Legacy chips are deliberately rendered, not image bubbles: pre-Exceed slots have no
           official art, and looking different from the modern bubbles IS the message — these
           numbers live on a different scale (docs/design/legacy-mixes.md). *@
        @* The glow is a drop-shadow filter on the image, so it traces the bubble art's own
           alpha and haloes the shape rather than boxing it (D24). Red for the week's Hardmode
           charts, mint for each folder's most held (D32). Never suppressed anywhere, the
           Hardmode page's own qualifying list included - a folder where every chart glows is
           the point there. The title names which end the glow marks, so the color never
           carries that meaning alone; it is null, and left off, on a bubble that doesn't glow. *@
        : @<MudImage Src="@DifficultyBubblePath" Height="Height ?? (Small ? 22 : 35)" Alt="@DiffString" ObjectFit="ObjectFit.ScaleDown" Class="@($"difficulty-bubble {GlowClass}".TrimEnd())" title="@GlowReason"></MudImage>;

    private DifficultyGlowKind _glow;

    private string? GlowClass => _glow switch
    {
        DifficultyGlowKind.Hard => "bubble-hardmode",
        DifficultyGlowKind.Easy => "bubble-easy",
        _ => null
    };

    private string? GlowReason => _glow switch
    {
        DifficultyGlowKind.Hard => L["Almost nobody holds this in a PUMBILITY top 50 — one of this week's Hardmode charts."].Value,
        DifficultyGlowKind.Easy => L["One of the most-held charts in this folder's PUMBILITY top 50s."].Value,
        _ => null
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Chart == null)
        {
            _glow = DifficultyGlowKind.None;
            return;
        }

        // Memoized per circuit, so forty bubbles on a page cost one read rather than forty.
        // The chart-less mode has no id to ask about and never glows.
        _glow = await Glow.GlowFor(Chart.Mix, Chart.Id);
    }

    [Parameter]
    public Chart? Chart { get; set; }

    // Chart-less mode (owner 2026-07-13): render a modern bubble straight from a type + level
    // (+ mix) when there's no full Chart — e.g. a folder label. No legacy/slot handling here.
    [Parameter]
    public ChartType? Type { get; set; }

    [Parameter]
    public DifficultyLevel? Level { get; set; }

    [Parameter]
    public MixEnum? Mix { get; set; }

    [Parameter]
    public bool Small { get; set; } = false;

    [Parameter]
    public int? Height { get; set; }

    private ChartType? EffectiveType => Chart?.Type ?? Type;
    private MixEnum? EffectiveMix => Chart?.Mix ?? Mix;

    private string DiffString => Chart?.DifficultyString
                                 ?? (Type != null && Level != null
                                     ? $"{Type.Value.GetShortHand()}{(int)Level.Value}"
                                     : string.Empty);

    // Chip cases: pre-Exceed slots, a Half-Double on a mix whose bubble set has no H. DOUBLE
    // stepball (Infinity's; the Phoenix 2 set has one, docs/design/rise.md D12), and legacy
    // co-ops that carry a real difficulty next to their player count. The chart-less path
    // only ever hits the Half-Double case.
    private bool UseLegacyChip =>
        (Chart != null &&
         (Chart.Slot != null ||
          (Chart.Type == ChartType.HalfDouble && !MixProfiles.For(Chart.Mix).Art.HasHalfDoubleBubble) ||
          (Chart.Type == ChartType.CoOp && Chart.Mix.UsesLegacyScoring() && Chart.Level != Chart.PlayerCount)))
        || (Chart == null && Type == ChartType.HalfDouble &&
            !(Mix is { } bubbleMix && MixProfiles.For(bubbleMix).Art.HasHalfDoubleBubble));

    private string ChipText => Chart != null
        ? Chart.Slot != null
            ? $"{Chart.Slot.Value.GetName().ToUpperInvariant()} {Chart.Level}"
            : Chart.Type == ChartType.CoOp
                ? $"CO-OP ×{Chart.PlayerCount} · {Chart.Level}"
                : $"HD {Chart.Level}"
        : Level != null
            ? $"HD {(int)Level.Value}"
            : DiffString;

    // Modern mixes keep their per-mix bubble art; every numbered legacy mix
    // (Exceed → Prime 2, Infinity, Pro) reuses the XX image set — same S/D notation,
    // zero new assets. SP/DP predate per-mix art and were always served flat. The rule lives
    // in ShareCardImages so a downloaded card and the page ask for the same picture.
    public string DifficultyBubblePath =>
        ShareCardImages.DifficultyBubble(EffectiveMix, EffectiveType ?? ChartType.Single, DiffString);

}
