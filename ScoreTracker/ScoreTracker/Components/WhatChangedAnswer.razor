@namespace ScoreTracker.Web.Components
@using ScoreTracker.Catalog.Contracts
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models

@* The answer to "what happened to Iolite Sky D20" — one sentence, then the moves that
   back it up. "Nothing moved" is a first-class answer here: the old page could only
   prove it by absence from three lists. *@
<div class="wc-answer wc-answer-@VerdictClass">
    <SongImage Song="Answer.Song" Height="64"></SongImage>
    <div class="wc-answer-body">
        <div class="wc-answer-id">
            <span class="wc-answer-song">@Answer.Song.Name</span>
            <span class="wc-answer-artist">@Answer.Song.Artist</span>
        </div>

        <p class="wc-verdict">@Verdict</p>

        @if (ShownCharts.Any())
        {
            <div class="wc-moves">
                @foreach (var chart in ShownCharts)
                {
                    <span class="wc-move">
                        <DifficultyBubble Chart="chart" Small="true"></DifficultyBubble>
                    </span>
                }
            </div>
        }
        else if (Answer.Moves.Any())
        {
            <div class="wc-moves">
                @foreach (var move in Answer.Moves)
                {
                    <span class="wc-move @(IsPinned(move) ? "wc-move-pinned" : "")">
                        <span class="wc-was"><DifficultyBubble Chart="move.Before" Small="true"></DifficultyBubble></span>
                        <span class="wc-arrow">→</span>
                        <DifficultyBubble Chart="move.After" Small="true"></DifficultyBubble>
                        <span class="wc-delta @(move.Delta > 0 ? "wc-up" : "wc-down")">
                            @(move.Delta > 0 ? "▲" : "▼")@Math.Abs(move.Delta)
                        </span>
                    </span>
                }
            </div>
        }

        @if (Answer.Gained.Any() || Answer.Lost.Any())
        {
            <div class="wc-quiet">
                @if (Answer.Gained.Any())
                {
                    <span>@L["{0} new charts", Answer.Gained.Count]</span>
                }
                @if (Answer.Gained.Any() && Answer.Lost.Any())
                {
                    <span> · </span>
                }
                @if (Answer.Lost.Any())
                {
                    <span>@L["{0} charts removed", Answer.Lost.Count]</span>
                }
            </div>
        }

        @if (Answer.Moves.Any() && Answer.Unchanged.Any())
        {
            <div class="wc-quiet">
                <button type="button" class="wc-linkish" @onclick="() => _showUnchanged = !_showUnchanged">
                    @L["{0} other charts unchanged", Answer.Unchanged.Count]
                </button>
            </div>
            @if (_showUnchanged)
            {
                <div class="wc-moves">
                    @foreach (var chart in Answer.Unchanged)
                    {
                        <span class="wc-move"><DifficultyBubble Chart="chart" Small="true"></DifficultyBubble></span>
                    }
                </div>
            }
        }

        @if (LinkTarget != null)
        {
            <a class="wc-linkish" href="@LinkTarget.CanonicalPath()">@L["Open the chart page"]</a>
        }
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public WhatChangedAnswerModel Answer { get; set; } = null!;
    [Parameter] public MixEnum From { get; set; }
    [Parameter] public MixEnum To { get; set; }

    private bool _showUnchanged;

    protected override void OnParametersSet()
    {
        _showUnchanged = false;
    }

    private string VerdictClass => Answer.Verdict switch
    {
        WhatChangedVerdict.Arrived => "new",
        WhatChangedVerdict.Departed => "gone",
        WhatChangedVerdict.Moved => Answer.PinnedAfter!.Level > Answer.PinnedBefore!.Level ? "up" : "down",
        WhatChangedVerdict.SongMoved => "up",
        _ => "same"
    };

    /// <summary>The whole-song cases list charts outright; the rest render before/after pairs.</summary>
    private IReadOnlyList<Chart> ShownCharts => Answer.Verdict switch
    {
        WhatChangedVerdict.Arrived => Answer.Gained.Count > 0 ? Answer.Gained : Answer.Unchanged,
        WhatChangedVerdict.Departed => Answer.Lost,
        WhatChangedVerdict.SongUnchanged => Answer.Unchanged,
        WhatChangedVerdict.Unchanged => Answer.PinnedAfter != null ? new[] { Answer.PinnedAfter } : Array.Empty<Chart>(),
        _ => Array.Empty<Chart>()
    };

    private Chart? LinkTarget => Answer.PinnedAfter ?? Answer.PinnedBefore;

    private bool IsPinned(MixDiffMoveRecord move)
    {
        return Answer.PinnedAfter != null && move.After.Id == Answer.PinnedAfter.Id;
    }

    private string Verdict => Answer.Verdict switch
    {
        WhatChangedVerdict.Arrived =>
            L["New in {0} — {1} charts.", To.GetName(), Answer.TotalCharts],
        WhatChangedVerdict.Departed => Answer.PinnedBefore != null
            ? L["{0} is not in {1} — the whole song left.", Answer.PinnedBefore.DifficultyDisplay, To.GetName()]
            : L["Not in {0} — all {1} charts left with the song.", To.GetName(), Answer.TotalCharts],
        WhatChangedVerdict.Moved => Answer.PinnedAfter!.Level > Answer.PinnedBefore!.Level
            ? L["Moved up — {0} is now {1}.", Answer.PinnedBefore.DifficultyDisplay, Answer.PinnedAfter.DifficultyDisplay]
            : L["Moved down — {0} is now {1}.", Answer.PinnedBefore.DifficultyDisplay, Answer.PinnedAfter.DifficultyDisplay],
        WhatChangedVerdict.Unchanged =>
            L["{0} didn't move.", Answer.PinnedAfter!.DifficultyDisplay],
        WhatChangedVerdict.SongMoved =>
            L["{0} of {1} charts moved.", Answer.Moves.Count, Answer.TotalCharts],
        _ => L["Nothing moved — all {0} charts kept their level.", Answer.TotalCharts]
    };
}
