@using ScoreTracker.ChartIntelligence.Contracts
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Web.Services.Theming
@namespace ScoreTracker.Web.Components

@* The hero's centerpiece (mock R2): the verdict sentences, what the chart IS, and the tier
   chips. The graphs below are evidence for these, never the other way around. Facets arrive
   salience-ordered from GetChartVerdictQuery.

   The identity chips live HERE (owner, 2026-08-26) rather than in a section further down the
   page: this block is what a reader looks at to find out what they are about to play, and it
   was answering with one sentence built from a different rule than the chips use. *@
@if (Facets is { Count: > 0 } || Identity is { Count: > 0 })
{
    <div class="chart-verdict">
        @if (Headlines.Count > 0)
        {
            <div class="chart-verdict-head"><VerdictSentence Facet="Headlines[0]"></VerdictSentence></div>
        }
        @if (Headlines.Count > 1)
        {
            <div class="chart-verdict-sub"><VerdictSentence Facet="Headlines[1]"></VerdictSentence></div>
        }
        <IdentityChipGroups Chips="Identity"></IdentityChipGroups>
        <div class="chart-verdict-chips">
            @if (PassVsScore != null)
            {
                <span class="chart-verdict-chip" style="color:@ThemeScales.DifficultyColor(PassVsScore.PassTier);border-color:@ThemeScales.DifficultyColor(PassVsScore.PassTier)">
                    @L["Pass Difficulty"] · @L[TierName(PassVsScore.PassTier)]
                </span>
                <span class="chart-verdict-chip" style="color:@ThemeScales.DifficultyColor(PassVsScore.ScoreTier);border-color:@ThemeScales.DifficultyColor(PassVsScore.ScoreTier)">
                    @L["Score Difficulty"] · @L[TierName(PassVsScore.ScoreTier)]
                </span>
            }
            @if (PlateResidual != null)
            {
                <span class="chart-verdict-chip chart-verdict-chip-muted">
                    @(PlateResidual.StepsVsExpected < 0 ? L["Plates · spiky"] : L["Plates · smooth"])
                </span>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<ChartVerdictFacet>? Facets { get; set; }

    /// <summary>Every chip the chart earned against its folder, in engine order. Never a capped list.</summary>
    [Parameter]
    public IReadOnlyList<TierListChartCard.CardSkillChip>? Identity { get; set; }

    /// <summary>
    ///     The sentences the chips do not already say. Style fingerprint and crux are both gone:
    ///     the fingerprint picked its two badges by a different rule than the chips do, so it
    ///     could contradict the row printed directly beneath it, and the crux line IS the
    ///     "Hardest Ns" chip in longer words. What is left is about difficulty, which no chip
    ///     claims.
    /// </summary>
    private IReadOnlyList<ChartVerdictFacet> Headlines => (Facets ?? Array.Empty<ChartVerdictFacet>())
        .Where(f => f is PassVsScoreVerdict or LetterWallVerdict or YieldKneeVerdict)
        .Take(2)
        .ToArray();

    private PassVsScoreVerdict? PassVsScore => Facets?.OfType<PassVsScoreVerdict>().FirstOrDefault();
    private PlateResidualVerdict? PlateResidual => Facets?.OfType<PlateResidualVerdict>().FirstOrDefault();

    // The tier vocabulary the dialog's placement chips established — same keys.
    private static string TierName(TierListCategory category)
    {
        return category switch
        {
            TierListCategory.Overrated => "1+ Level Easier",
            TierListCategory.VeryEasy => "Very Easy",
            TierListCategory.Easy => "Easy",
            TierListCategory.Medium => "Medium",
            TierListCategory.Hard => "Hard",
            TierListCategory.VeryHard => "Very Hard",
            TierListCategory.Underrated => "1+ Level Harder",
            _ => "Not Rated"
        };
    }
}
