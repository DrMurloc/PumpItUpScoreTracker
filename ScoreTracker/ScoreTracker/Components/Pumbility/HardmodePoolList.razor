@using MediatR
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.Domain.Models
@using ScoreTracker.Domain.Records
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.PlayerProgress.Contracts
@using ScoreTracker.Rivals.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Web.Enums
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Contracts
@using ScoreTracker.Web.Services.Theming
@using Microsoft.JSInterop
@using ScoreTracker.SharedKernel.Models
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@namespace ScoreTracker.Web.Components
@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@inject IUiSettingsAccessor UiSettings
@inject IJSRuntime JSRuntime
@inject IDateTimeOffsetAccessor Clock

@* Your Hardmode fifty, banded by what each chart is worth to you — the Breakdown page's own
   treatment of a pool, in the three densities, with the value on the card's nameline and your
   score coloured by where it stands among the peers you chose.

   A separate component from PumbilityPoolList rather than a parameter on it: that one reads a
   PumbilityPageRecord and bands with the shared tier processor's cuts over fifty charts, and a
   Hardmode pool is usually a handful. The bands here are the same names and the same ramp, cut
   by standard deviation over however many charts there are. *@
<div class="pmb-peers-controls">
    <span class="pmb-peers-controls-start"></span>
    <span class="pmb-peers-controls-end">
        @* Download beside the density trio, exactly where the Breakdown page's top 50 puts it
           (D34) - this list is the same object, priced over a different chart set. *@
        @if (_building)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2"></MudProgressCircular>
        }
        else if (Pool.Count > 0)
        {
            <MudTooltip Text="@L["Download"]">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.FileDownload" Color="Color.Primary"
                               OnClick="() => _downloadOpen = true" aria-label="@L["Download"]"
                               data-testid="hardmode-pool-download"></MudIconButton>
            </MudTooltip>
        }
        <MudButtonGroup OverrideStyles="false">
            <MudTooltip Text="@L["Comfortable"]">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ViewComfy"
                               Color="@(_density == UiDensity.Comfortable ? Color.Primary : Color.Default)"
                               OnClick="() => SetDensity(UiDensity.Comfortable)"
                               aria-label="@L["Comfortable"]"></MudIconButton>
            </MudTooltip>
            <MudTooltip Text="@L["Compact"]">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.GridView"
                               Color="@(_density == UiDensity.Compact ? Color.Primary : Color.Default)"
                               OnClick="() => SetDensity(UiDensity.Compact)"
                               aria-label="@L["Compact"]"></MudIconButton>
            </MudTooltip>
            <MudTooltip Text="@L["Table"]">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.TableRows"
                               Color="@(_density == UiDensity.Table ? Color.Primary : Color.Default)"
                               OnClick="() => SetDensity(UiDensity.Table)"
                               aria-label="@L["Table"]"></MudIconButton>
            </MudTooltip>
        </MudButtonGroup>
    </span>
</div>

<div class="pmb-list">
    @if (Pool.Count == 0)
    {
        <p class="pmb-empty">
            @L["Nothing in your Hardmode pool yet — every non-broken pass on a qualifying chart takes a slot."]
        </p>
    }
    @foreach (var section in Sections)
    {
        <TierSection Name="@section.Name" Color="@section.Color" Count="section.Rows.Count"
                     Collapsed="_collapsed.Contains(section.Key)"
                     CollapsedChanged="c => SetCollapsed(section.Key, c)">
            @if (_density == UiDensity.Table)
            {
                <div class="tier-table-wrap">
                    <table class="tier-table pmb-table">
                        <thead>
                        <tr>
                            <th class="tier-table-jacket-cell"></th>
                            <th>#</th>
                            <th>@L["Song Name"]</th>
                            <th>@L["Chart"]</th>
                            <th>@L["My Score"]</th>
                            <th class="pmb-r" title="@L["What the chart is worth in your pool right now"]">
                                @L["Value"]
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in section.Rows)
                        {
                            <tr class="pmb-row tier-row-pass">
                                <td class="tier-table-jacket-cell">
                                    <div class="tier-table-jacket" role="button" tabindex="0"
                                         @onclick="() => OnOpen.InvokeAsync(row.Chart)"
                                         style="background-image:url('@row.Chart.Song.ImagePath')"></div>
                                </td>
                                <td class="pmb-num pmb-muted">@row.Entry.Place</td>
                                <td>@row.Chart.Song.Name</td>
                                <td>@row.Chart.DifficultyString</td>
                                <td>
                                    <PeerScore Score="row.Entry.Score" IsBroken="row.Entry.IsBroken" Mix="Mix"
                                               Height="12" Plate="row.Entry.Plate" Standing="@StandingFor(row)"
                                               Chart="row.Chart" Class="sbd-score-stack" ShowStanding="false"
                                               OnOpenBoard="OnOpenBoard"></PeerScore>
                                </td>
                                <td class="pmb-r pmb-num pmb-val">@row.Entry.Value.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="@(_density == UiDensity.Compact ? "tier-card-grid tier-card-grid-compact" : "tier-card-grid")">
                    @foreach (var row in section.Rows)
                    {
                        @* The value is the card's reason for existing here, so it takes the corner
                           in both densities — the Breakdown list's own rule. *@
                        <TierListChartCard Chart="row.Chart"
                                           Density="_density"
                                           Score="@ScoreOf(row)"
                                           Standing="@StandingFor(row)"
                                           ShowStandingText="false"
                                           OnOpenBoard="OnOpenBoard"
                                           CustomStateClass="tier-chart-card-top50"
                                           CustomStateTitle="@L["In your Hardmode pool"]"
                                           Skills="@SkillsFor(row.Chart)"
                                           ShowToDo="false"
                                           CornerBadge="@row.Entry.Value.ToString("N2")"
                                           CornerBadgeClass="pmb-corner-gain"
                                           CornerBadgeStart="@(_density == UiDensity.Compact ? Grade(row) : null)"
                                           CornerBadgeStartClass="pmb-corner-gain"
                                           OnOpen="OpenById"></TierListChartCard>
                    }
                </div>
            }
        </TierSection>
    }
</div>

<ShareCardSettingsDialog @bind-Visible="_downloadOpen" SignedIn="true"
                         SampleBuilder="BuildSampleCard" OnDownload="Download"
                         FileName="@DownloadFileName"></ShareCardSettingsDialog>

@code {
    public const string DensitySettingKey = "Density__HardmodePool";

    public const string CollapsedSettingKey = "HardmodePool__CollapsedTiers";

    private sealed record Row(Chart Chart, PoolEntry Entry);

    private sealed record Section(string Key, string Name, string Color, IReadOnlyList<Row> Rows,
        RarityBand Band);

    [Parameter] [EditorRequired] public MixEnum Mix { get; set; }

    [Parameter] [EditorRequired] public IReadOnlyDictionary<Guid, Chart> Charts { get; set; } =
        new Dictionary<Guid, Chart>();

    [Parameter] public IReadOnlyList<PoolEntry> Pool { get; set; } = Array.Empty<PoolEntry>();

    /// <summary>Which pool the fifty are, for the card's header. Null = combined.</summary>
    [Parameter] public ChartType? Pool_ { get; set; }

    [Parameter] public EventCallback<Chart> OnOpen { get; set; }

    [Parameter] public EventCallback<PeerBoardRequest> OnOpenBoard { get; set; }

    /// <summary>A pool is fifty, which is what the card's "11 of 50" is counted against.</summary>
    private const int PoolSize = 50;

    /// <summary>Where the card points a reader who sees it in a Discord channel.</summary>
    private const string ShareUrl = "https://piuscores.arroweclip.se/Pumbility/Hardmode";

    private PumbilityShareCard _card = null!;
    private bool _downloadOpen;
    private bool _building;
    private UiDensity _density = UiDensity.Comfortable;
    private HashSet<string> _collapsed = new();
    private IReadOnlyDictionary<Guid, PeerStanding> _standings = new Dictionary<Guid, PeerStanding>();
    /// <summary>
    ///     What each chart IS (docs/design/chart-identity.md) - the same chips the Play tab and
    ///     the tier lists print, read through Catalog's contract rather than derived here.
    /// </summary>
    private IReadOnlyDictionary<Guid, IReadOnlyList<TierListChartCard.CardSkillChip>> _skills =
        new Dictionary<Guid, IReadOnlyList<TierListChartCard.CardSkillChip>>();

    private HashSet<Guid> _standingsFor = new();

    /// <summary>
    ///     The pool's own bands — the same names and the same rarity ramp the Breakdown list
    ///     uses, cut by standard deviation over however many charts the pool holds. Empty bands
    ///     are dropped rather than drawn: a Hardmode pool of eleven has no business showing
    ///     seven headings.
    /// </summary>
    private IReadOnlyList<Section> Sections
    {
        get
        {
            var rows = Pool.Where(e => Charts.ContainsKey(e.ChartId))
                .Select(e => new Row(Charts[e.ChartId], e)).ToArray();
            if (rows.Length == 0) return Array.Empty<Section>();

            var mean = rows.Average(r => r.Entry.Value);
            var deviation = Math.Sqrt(rows.Average(r => Math.Pow(r.Entry.Value - mean, 2)));
            // The band travels with the section so the download colours from the same ramp the
            // page does rather than re-deriving it from a CSS string.
            var bands = new (string Key, string Name, string Color, RarityBand Band)[]
            {
                ("highest", L["Highest"], "var(--rarity-prism)", RarityBand.Prism),
                ("high", L["High"], "var(--rarity-gold)", RarityBand.Gold),
                ("average", L["Average"], "var(--rarity-emerald)", RarityBand.Emerald),
                ("low", L["Low"], "var(--rarity-silver)", RarityBand.Silver),
                ("lowest", L["Lowest"], "var(--rarity-common)", RarityBand.Common)
            };

            return rows.GroupBy(r => Band(r.Entry.Value, mean, deviation))
                .OrderBy(g => g.Key)
                .Select(g => new Section(bands[g.Key].Key, bands[g.Key].Name, bands[g.Key].Color,
                    g.OrderByDescending(r => r.Entry.Value).ToArray(), bands[g.Key].Band))
                .ToArray();
        }
    }

    private static int Band(double value, double mean, double deviation)
    {
        if (deviation <= 0) return 2;
        var z = (value - mean) / deviation;
        return z >= 1.2 ? 0 : z >= .4 ? 1 : z >= -.4 ? 2 : z >= -1.2 ? 3 : 4;
    }

    // Your grade in Compact's other corner. Without this the printed value wins the one corner
    // Compact has and the card shows no grade at all - which is what the Breakdown list's own
    // pool solved the same way. A pool row is never broken: a broken run prices to zero and can
    // hold no slot.
    private RenderFragment Grade(Row row) => builder =>
    {
        builder.OpenComponent<LetterGradeIcon>(0);
        builder.AddComponentParameter(1, nameof(LetterGradeIcon.Grade), row.Entry.Score.LetterGradeFor(Mix));
        builder.AddComponentParameter(2, nameof(LetterGradeIcon.Height), 14);
        builder.CloseComponent();
    };

    /// <summary>
    ///     The sections as the card draws them. Same shape the Breakdown page's top 50 hands the
    ///     composer, so the picture says what the page says - including the value under each
    ///     tile, which is this list's whole reason for existing.
    /// </summary>
    public IReadOnlyList<PumbilityShareSection> ShareSections() =>
        Sections.Select(s => new PumbilityShareSection(s.Name, null,
                s.Rows.Select(r => new PumbilityShareTile(r.Chart, r.Entry.Score, r.Entry.Plate,
                    r.Entry.IsBroken, IsToDo: false, Carried: false, Gain: null, Expected: null,
                    r.Entry.Value)).ToArray(),
                s.Band))
            .ToArray();

    /// <summary>Which pool the card is of - said only where pools are per type.</summary>
    private string? SharePoolLabel => Mix != MixEnum.Phoenix2 ? null :
        Pool_ switch
        {
            ChartType.Single => L["Singles pool"],
            ChartType.Double => L["Doubles pool"],
            null => L["All pools"],
            var other => other.ToString()
        };

    private string DownloadFileName =>
        ShareCardTitles.HardmodeFileName(Mix, Pool_?.ToString() ?? "All", Clock.Now.ToString("yyyy-MM-dd"));

    private ShareCardTitles.Header ShareHeader => ShareCardTitles.Hardmode(SharePoolLabel, Mix.GetName(),
        Clock.Now.ToString("yyyy-MM-dd"), CurrentUser.User.GameTag ?? CurrentUser.User.Name,
        Pool.Count, PoolSize, key => L[key].Value);

    private Task<TierListShareCard?> BuildSampleCard(ShareCardOptions options)
    {
        var charts = ShareSections().SelectMany(s => s.Tiles).Select(t => t.Chart).DistinctBy(c => c.Id)
            .ToArray();
        return Task.FromResult(_card.Sample(charts, options, Mix, _skills, ShareHeader, ShareUrl));
    }

    private async Task Download(ShareCardDownloadRequest request)
    {
        _building = true;
        try
        {
            var rows = await _card.ComposeRows(ShareSections(), request.Options, Mix, _skills, request.Token);
            if (rows.Count == 0) return;
            await _card.Download(_card.Card(ShareHeader, ShareUrl, rows, request.Options, Mix), request,
                DownloadFileName);
        }
        catch (OperationCanceledException)
        {
            // The dialog's Cancel (or its close) stopped the download; nothing to deliver.
        }
        finally
        {
            _building = false;
        }
    }

    private static RecordedPhoenixScore ScoreOf(Row row)
    {
        return new RecordedPhoenixScore(row.Chart.Id, row.Entry.Score, row.Entry.Plate, row.Entry.IsBroken,
            row.Entry.RecordedDate);
    }

    private PeerStanding? StandingFor(Row row)
    {
        return _standings.GetValueOrDefault(row.Chart.Id);
    }

    private IReadOnlyList<TierListChartCard.CardSkillChip>? SkillsFor(Chart chart) =>
        _skills.TryGetValue(chart.Id, out var chips) && chips.Count > 0 ? chips : null;

    private Task OpenById(Guid chartId)
    {
        return Charts.TryGetValue(chartId, out var chart) ? OnOpen.InvokeAsync(chart) : Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        _card = new PumbilityShareCard(Mediator, JSRuntime, CurrentUser.User.Id, key => L[key].Value);
        if (Enum.TryParse<UiDensity>(await UiSettings.GetSetting(DensitySettingKey), out var density))
            _density = density;
        var collapsed = await UiSettings.GetSetting(CollapsedSettingKey);
        if (!string.IsNullOrWhiteSpace(collapsed))
            _collapsed = collapsed.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToHashSet();
    }

    /// <summary>
    ///     Where each of the pool's charts stands among the peers the viewer chose. Read for the
    ///     charts on screen, and again only when the pool changes — these are all scores the
    ///     viewer holds, so every one of them has a standing to show.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var ids = Pool.Select(e => e.ChartId).Where(Charts.ContainsKey).ToHashSet();
        if (ids.SetEquals(_standingsFor)) return;
        _standingsFor = ids;
        if (ids.Count == 0)
        {
            _standings = new Dictionary<Guid, PeerStanding>();
            _skills = new Dictionary<Guid, IReadOnlyList<TierListChartCard.CardSkillChip>>();
            return;
        }

        var identity = await Mediator.Send(new GetChartIdentityQuery(ids.ToArray(), Mix));
        _skills = identity.ToDictionary(kv => kv.Key, kv => IdentityChips.ToCardChips(kv.Value, false, L));
        _standings = CurrentUser.IsLoggedIn
            ? await Mediator.Send(new GetPeerStandingsQuery(Mix, ids.ToArray()))
            : new Dictionary<Guid, PeerStanding>();
    }

    private async Task SetDensity(UiDensity density)
    {
        _density = density;
        await UiSettings.SetSetting(DensitySettingKey, density.ToString());
    }

    private async Task SetCollapsed(string key, bool collapsed)
    {
        if (collapsed) _collapsed.Add(key);
        else _collapsed.Remove(key);
        await UiSettings.SetSetting(CollapsedSettingKey, string.Join(",", _collapsed));
    }
}
