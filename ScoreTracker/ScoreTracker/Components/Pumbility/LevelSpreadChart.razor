@using System.Globalization
@using ScoreTracker.Domain.Services
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@namespace ScoreTracker.Web.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Where the levels sit, as the spread of everyone holding your title (docs/design/pumbility-overhaul.md
   D68): a column per level of how many charts of it each of them holds in their fifty, and a diamond
   where your own fifty sits. Where the pool holds both types they draw as two tiles side by side, each
   in the card's own type colour — never interlaced into one plot, which reads as a single series
   striped rather than as two answers (owner, on the PR). It is HTML and CSS against one scale, positions
   in percent and glyphs at their own pixel sizes, so it scales with its tile and needs no script to draw.
   level-spread.js only reads the pointer: it opens a column's tooltip, marks the count under the pointer
   and writes that one line, which the circuit could only do by hearing every mouse move. The rest of each
   tooltip renders here, hidden, with the column it describes. *@
@if (_tiles.Count > 0)
{
    <div class="pmb-spread" @ref="_root" data-testid="level-spread"
         data-chart-one="@L["1 chart"]" data-charts="@L["{0} charts"]"
         data-peer-one="@L["· 1 peer ({0}%)"]" data-peers="@L["· {0} peers ({1}%)"]">
        <div class="pmb-spread-tiles">
            @foreach (var (type, columns) in _tiles)
            {
                var label = type == ChartType.Single ? L["Singles"].Value : L["Doubles"].Value;
                <div class="pmb-spread-tile" data-testid="@($"level-spread-{type}")">
                    @if (_tiles.Count > 1)
                    {
                        <div class="pmb-spread-head">
                            <span class="pmb-spread-label">@label</span>
                        </div>
                    }
                    <div class="pmb-spread-plot" data-top="@_top" role="group"
                         aria-label="@L["{0}: charts of each level the players holding your title keep in their top 50", label]">
                        <div class="pmb-spread-grid" aria-hidden="true">
                            @foreach (var tick in Ticks)
                            {
                                <span class="pmb-spread-gridline @(tick == 0 ? "is-base" : "")" style="bottom:@Css(Position(tick))%"><b>@tick</b></span>
                            }
                        </div>
                        <div class="pmb-spread-cols">
                            @foreach (var column in columns)
                            {
                                var name = Prefix(column.Type) + column.Level;
                                var widest = Widest(column);
                                <div class="pmb-spread-col @TypeClass(column.Type)" role="group" tabindex="0"
                                     data-level="@column.Level" data-type="@column.Type"
                                     data-bins="@Bins(column)" data-peers="@Spread.Peers"
                                     aria-label="@L["{0}: a median of {1}, middle half {2} to {3}; you hold {4}", name, Quantity(column.Median), Quantity(column.FirstQuartile), Quantity(column.ThirdQuartile), column.Mine]">
                                    <div class="pmb-spread-colplot" aria-hidden="true">
                                        @foreach (var (count, peers) in column.PeersByCount.Where(kv => kv.Key <= _top).OrderBy(kv => kv.Key))
                                        {
                                            <i class="pmb-spread-bin" data-k="@count"
                                               style="bottom:@Css(Position(count - 0.5))%;height:calc(@Css(Unit)% - 1px);width:@Css(84.0 * peers / widest)%"></i>
                                        }
                                        @if (Spread.Peers > 0)
                                        {
                                            <i class="pmb-spread-whisker"
                                               style="bottom:@Css(Position(Clip(column.Fewest)))%;height:@Css(Position(Clip(column.Most)) - Position(Clip(column.Fewest)))%"></i>
                                            @* A few holders past the top of the scale: the line runs off it and says so. *@
                                            @if (column.Most > _top)
                                            {
                                                <i class="pmb-spread-clip" style="bottom:calc(@Css(Position(_top))% - 4px)"></i>
                                            }
                                            <i class="pmb-spread-box"
                                               style="bottom:calc(@Css(Position(Clip(column.FirstQuartile)))% - 1.5px);height:calc(@Css(Position(Clip(column.ThirdQuartile)) - Position(Clip(column.FirstQuartile)))% + 3px)"></i>
                                            <i class="pmb-spread-median" style="bottom:calc(@Css(Position(Clip(column.Median)))% - 1.25px)"></i>
                                        }
                                        <i class="pmb-spread-you" style="bottom:calc(@Css(Position(column.Mine))% - 4.5px)"></i>
                                    </div>
                                    <span class="pmb-spread-level">@column.Level</span>
                                    <div class="pmb-spread-tipbody" hidden>
                                        <div class="pmb-spread-tiphead">@name</div>
                                        <div><strong>@Quantity(column.Median)</strong> <span>@L["median · middle half {0}–{1}", Quantity(column.FirstQuartile), Quantity(column.ThirdQuartile)]</span></div>
                                        <div><strong>@($"{column.Fewest}–{column.Most}")</strong> <span>@L["fewest to most"]</span></div>
                                        <div><strong>@($"{Percent(column.Holding, Spread.Peers)}%")</strong> <span>@L["hold at least one"]</span></div>
                                        <div class="pmb-spread-tipyou">
                                            <strong>@L["Level Spread You {0}", column.Mine]</strong>
                                            <span>@(column.Mine == 0
                                                      ? L["· like the {0}% who hold none", Percent(column.PeersLevelWithMine, Spread.Peers)]
                                                      : L["· more than {0}% of them", Percent(column.PeersBelowMine, Spread.Peers)])</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="pmb-spread-legend">
            <span><i class="pmb-spread-key pmb-spread-key-shape @TypeClass(_tiles[0].Type)"></i>@L["how many hold that many"]</span>
            <span><i class="pmb-spread-key pmb-spread-key-box"></i>@L["the middle half of them"]</span>
            <span><i class="pmb-spread-key pmb-spread-key-median"></i>@L["the median holder"]</span>
            <span><i class="pmb-spread-key pmb-spread-key-you"></i>@L["Level Spread You"]</span>
        </div>
        <div class="pmb-spread-tip" aria-hidden="true"></div>
    </div>
}

@code {
    /// <summary>
    ///     The cohort's spread for the pool in scope. A spread with no columns draws nothing at all.
    /// </summary>
    [Parameter] [EditorRequired] public PeerLevelSpread Spread { get; set; } = PeerLevelSpread.Empty;

    /// <summary>The shortest scale the chart draws, however little anyone holds.</summary>
    private const int MinimumTop = 10;

    /// <summary>One tile per chart type the pool holds, singles first, each with its own levels.</summary>
    private IReadOnlyList<(ChartType Type, IReadOnlyList<LevelSpreadColumn> Columns)> _tiles =
        Array.Empty<(ChartType, IReadOnlyList<LevelSpreadColumn>)>();

    private int _top = MinimumTop;
    private ElementReference _root;
    private IJSObjectReference? _module;

    /// <summary>
    ///     The script's handle on the element it listens to. It is released through the handle rather than
    ///     the element, which has usually left the page by the time this component is disposed.
    /// </summary>
    private IJSObjectReference? _mount;

    private string? _mountedId;

    protected override void OnParametersSet()
    {
        _tiles = Spread.Columns.GroupBy(c => c.Type).OrderBy(g => g.Key)
            .Select(g => (g.Key, (IReadOnlyList<LevelSpreadColumn>)g.OrderBy(c => c.Level).ToArray()))
            .ToArray();
        _top = Top(Spread);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The root comes and goes with the columns, so it is mounted whenever it is a new element; the
        // import map rewrites the specifier to the content-hashed asset.
        if (_tiles.Count == 0 || _root.Id == null || _root.Id == _mountedId) return;
        _mountedId = _root.Id;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/level-spread.js");
        await Unmount();
        _mount = await _module.InvokeAsync<IJSObjectReference>("mount", _root);
    }

    private async Task Unmount()
    {
        if (_mount == null) return;
        var mount = _mount;
        _mount = null;
        await mount.InvokeVoidAsync("dispose");
        await mount.DisposeAsync();
    }

    /// <summary>
    ///     One scale for every tile, so a singles column reads against the doubles one beside it. It
    ///     stops at the 99th percentile of what the cohort holds, or at your own highest if that is
    ///     higher, rounded up to the step the axis draws — a handful of one-folder pools would otherwise
    ///     flatten every box.
    /// </summary>
    private static int Top(PeerLevelSpread spread)
    {
        var counts = new List<int>();
        var yours = 0;
        foreach (var column in spread.Columns)
        {
            foreach (var (count, peers) in column.PeersByCount)
                if (count > 0)
                    counts.AddRange(Enumerable.Repeat(count, peers));
            yours = Math.Max(yours, column.Mine);
        }

        counts.Sort();
        var reach = Math.Max(Quantile(counts, 0.99), yours);
        // Rounded to the step the axis draws, so the top gridline always lands on the cap.
        var step = reach > 30 ? 10 : 5;
        return Math.Max(MinimumTop, (int)(Math.Ceiling(reach / step) * step));
    }

    private static double Quantile(IReadOnlyList<int> sorted, double q)
    {
        if (sorted.Count == 0) return 0;
        var position = (sorted.Count - 1) * q;
        var below = (int)Math.Floor(position);
        var above = (int)Math.Ceiling(position);
        return sorted[below] + (sorted[above] - sorted[below]) * (position - below);
    }

    private IEnumerable<int> Ticks
    {
        get
        {
            var step = _top > 30 ? 10 : 5;
            for (var tick = 0; tick <= _top; tick += step) yield return tick;
        }
    }

    /// <summary>Where a count sits up the column, in percent: the scale runs from half a chart below zero to half above the top.</summary>
    private double Position(double count) => (count + 0.5) / (_top + 1) * 100;

    /// <summary>The height of one count, in percent.</summary>
    private double Unit => 100.0 / (_top + 1);

    private double Clip(double count) => Math.Min(count, _top);

    private int Widest(LevelSpreadColumn column) =>
        Math.Max(1, column.PeersByCount.Where(kv => kv.Key <= _top).Select(kv => kv.Value).DefaultIfEmpty(0).Max());

    private static string Prefix(ChartType type) => type == ChartType.Single ? "S" : "D";

    /// <summary>The tone a tile draws in — the card's own type colours, never mixed in one plot.</summary>
    private static string TypeClass(ChartType type) => type == ChartType.Single ? "is-s" : "is-d";

    /// <summary>The bins the script reads the pointer line from: count:peers, comma separated.</summary>
    private static string Bins(LevelSpreadColumn column) =>
        string.Join(",", column.PeersByCount.OrderBy(kv => kv.Key)
            .Select(kv => $"{kv.Key.ToString(CultureInfo.InvariantCulture)}:{kv.Value.ToString(CultureInfo.InvariantCulture)}"));

    /// <summary>A quartile reads whole when it is whole and to a tenth when it falls between two counts.</summary>
    private static string Quantity(double value) =>
        Math.Abs(value - Math.Round(value)) < 1e-9 ? Math.Round(value).ToString("N0") : value.ToString("N1");

    private static int Percent(int part, int whole) =>
        whole <= 0 ? 0 : (int)Math.Round(100.0 * part / whole);

    /// <summary>A style value: always a full stop for the decimal, whatever the reader's culture.</summary>
    private static string Css(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Unmount();
            if (_module != null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit went first — the browser has already dropped the module with the page.
        }
    }

}
