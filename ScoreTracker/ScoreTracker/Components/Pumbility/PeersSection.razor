@using MediatR
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.PlayerProgress.Contracts
@using ScoreTracker.PlayerProgress.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using Microsoft.JSInterop
@using ScoreTracker.Application.Commands
@using ScoreTracker.Application.Queries
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.Domain.Models.Titles.Phoenix2
@using ScoreTracker.Domain.Records
@using ScoreTracker.Domain.Services.Contracts
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Enums
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Contracts
@using ScoreTracker.Web.Services.HomeDashboard
@using ScoreTracker.Web.Services.Theming
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@namespace ScoreTracker.Web.Components
@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@inject IUiSettingsAccessor UiSettings
@inject CommunityGlowReader Glow
@inject IJSRuntime JSRuntime
@inject IDateTimeOffsetAccessor Clock

@* The Play page's block (docs/design/pumbility-overhaul.md §3.10, D32, D43): what your peers
   build their number from, grouped by prevalence or by projected gain, and who they are —
   PUMBILITY peers on Phoenix 2 (the window on the pool of the type, D53), the competitive band on
   Phoenix 1, and the ledes say which. Held
   by a component rather than the page because the pool it is scoped to arrives
   from the section frame — a parameter, so a pool change re-fetches on its own — and because
   the page record the frame already loaded is where the gains come from (D38): the target
   list's own answer per chart, carried Phoenix 1 winning, so this page and the old one can
   never disagree about a number. With the Phoenix 1 switch off the peer-only projection stands
   in, read once and kept.

   The Energy select (D51) is the page's one read of the projection — Good, Great or Top of my game
   — and it belongs to the frame the way the pool does: the select raises the pick, the frame
   remembers it and reloads, and the new energy arrives back here as a parameter with a record
   already priced at it, so the peers' rows are read again at the same rung. It sits in the
   control row between Grouped by and the grouping's own switch (owner, field test of the build).

   A re-read holds its shape (D56). Only the first paint shows the patience card; after that a
   change of energy or pool keeps the previous list on screen under a pulse — its cards and rows
   blanked, its height and sections intact — with the controls in place and disabled for the
   moment the read takes, and everything flips once, when both halves are in: the peers read for
   the new pool and energy, and the frame's record priced at the same, which arrives on a render
   of its own and in no fixed order with the peers. Swapping the whole block for the card moved
   the controls a reader had just used and jumped the page twice (owner, field test round eight).
   Grouped by is a re-sort of what is already here and needs none of this.

   The controls: Grouped by — Prevalence, Projected gains, Your top 50 (D44) — then Energy, then, left-aligned
   beside it, the one switch that means something under that grouping — Project Phoenix 1 scores
   under Projected gains and only when the record holds carried rows; Only projected PUMBILITY
   gains under Prevalence; nothing under Your top 50 — then the density trio at the far end, right
   above the list (D34, D36). Every preference persists as a UiSetting. *@
<section class="pmb-block" data-testid="peers-section">
    <div class="pmb-block-head">
        <h2 class="pmb-block-title">@L["PUMBILITY Targets"]</h2>
    </div>
    <div class="pmb-peers-head">
        <p class="pmb-block-lede">@Lede</p>
        @if (_peers != null)
        {
            <PeerCompareStrip Page="_peers" Charts="Charts"></PeerCompareStrip>
        }
    </div>
    @if (ShortPool is { } short_)
    {
        @* The finish is the pool of the type (D48, D53), so it prints as a PUMBILITY total — two
           decimals, this being a PUMBILITY page — rather than as a gem. *@
        <p class="pmb-block-note" data-testid="peers-short-pool-note">
            @L["You have {0} of {1} charts, so your peers are drawn from where your pool of the type would finish — {2} — if you hold your current standard. This settles as your pool fills.",
                short_.PoolCount, PeerGroup.PumbilityPoolSize, short_.Center.ToString("N2")]
        </p>
    }
    @if (ThinBand is { } thin)
    {
        <p class="pmb-block-note" data-testid="peers-thin-note">
            @L["Players at your level with a full pool: {0}. Every row here is read off fewer than five scores, and will move as more peers fill their pools.", thin.Size]
        </p>
    }
    @if (Shown.Peers is { } peers)
    {
        <PumbilityPeerLine Peers="peers" Pool="ShownPool"></PumbilityPeerLine>
    }

    @if (_peers == null)
    {
        <PatienceCard Explanation="@L["Reading your peers' pools. This reads a few hundred players at your level, so it takes a moment."]"></PatienceCard>
    }
    else
    {
        <div class="pmb-peers-controls" data-testid="peers-controls" data-reloading="@(_reloading ? "true" : "false")">
            @* Two groups, not four items with margins between them: the select and its switch are
               one element of the row and the actions are the other, so nothing can drift into the
               middle however the free space is distributed (owner, field test rounds three–five). *@
            <span class="pmb-peers-controls-start">
            <MudSelect T="PeerGrouping" Class="pmb-peers-controls-select" Label="@L["Grouped by"]" Dense="true"
                       Disabled="_reloading" Value="_groupBy" ValueChanged="SetGrouping" data-testid="peers-groupby">
                <MudSelectItem T="PeerGrouping" Value="PeerGrouping.Prevalence">@L["Prevalence"]</MudSelectItem>
                <MudSelectItem T="PeerGrouping" Value="PeerGrouping.ProjectedGains">@L["Projected gains"]</MudSelectItem>
                <MudSelectItem T="PeerGrouping" Value="PeerGrouping.YourTop50">@L["Your top 50"]</MudSelectItem>
            </MudSelect>
            @* Energy (D51): how you're playing today, as the rung of your peers every projected score
               and gain on the page reads. The select explains itself on hover and each option says
               what its percentile means. *@
            <MudSelect T="Energy" Class="pmb-peers-controls-select" Label="@L["Energy"]" Dense="true"
                       Disabled="_reloading" Value="Energy" ValueChanged="OnEnergyChanged" data-testid="peers-energy"
                       title="@L["How you're playing today. Every projected score and gain on this page reads your peers at this level."]">
                @foreach (var option in EnergyLabels.Options)
                {
                    var o = option;
                    <MudSelectItem T="Energy" Value="o" title="@L[EnergyLabels.Hint(o)]" data-testid="@($"peers-energy-{o}")">@L[EnergyLabels.Label(o)]</MudSelectItem>
                }
            </MudSelect>
            <span class="pmb-peers-controls-switches">
                @if (_groupBy == PeerGrouping.ProjectedGains && HasCarried)
                {
                    <MudSwitch T="bool" Value="_projectPhoenix1" ValueChanged="SetProjectPhoenix1" Color="Color.Primary"
                               Disabled="_reloading" Label="@L["Project Phoenix 1 scores"]" data-testid="peers-p1-switch"></MudSwitch>
                }
                @if (_groupBy == PeerGrouping.Prevalence)
                {
                    <MudSwitch T="bool" Value="_gainsOnly" ValueChanged="SetGainsOnly" Color="Color.Primary"
                               Disabled="_reloading" Label="@L["Only projected PUMBILITY gains"]" data-testid="peers-gains-switch"></MudSwitch>
                }
            </span>
            </span>
            <span class="pmb-peers-controls-end">
                @* The tier list's Download, on the tier list's own share card: this page is the
                   same shape, so the picture is the same picture (owner, field test round three). *@
                @if (_building)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2"></MudProgressCircular>
                }
                else
                {
                    <MudTooltip Text="@L["Download"]">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.FileDownload" Color="Color.Primary"
                                       Disabled="_reloading" OnClick="() => _downloadOpen = true" aria-label="@L["Download"]" data-testid="peers-download"></MudIconButton>
                    </MudTooltip>
                }
                <MudButtonGroup OverrideStyles="false">
                    <MudTooltip Text="@L["Comfortable"]">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ViewComfy"
                                       Color="@(_density == UiDensity.Comfortable ? Color.Primary : Color.Default)"
                                       Disabled="_reloading" OnClick="() => SetDensity(UiDensity.Comfortable)" aria-label="@L["Comfortable"]"></MudIconButton>
                    </MudTooltip>
                    <MudTooltip Text="@L["Compact"]">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.GridView"
                                       Color="@(_density == UiDensity.Compact ? Color.Primary : Color.Default)"
                                       Disabled="_reloading" OnClick="() => SetDensity(UiDensity.Compact)" aria-label="@L["Compact"]"></MudIconButton>
                    </MudTooltip>
                    <MudTooltip Text="@L["Table"]">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.TableRows"
                                       Color="@(_density == UiDensity.Table ? Color.Primary : Color.Default)"
                                       Disabled="_reloading" OnClick="() => SetDensity(UiDensity.Table)" aria-label="@L["Table"]"></MudIconButton>
                    </MudTooltip>
                </MudButtonGroup>
            </span>
        </div>
        @* The list and its legend render from the record they were built with (Shown), never from
           a page record that has moved on under them — so while a re-read runs the shape on
           screen is exactly the previous shape, blanked by the pulse, and it flips once. *@
        <div class="pmb-list@(_reloading ? " pmb-list-reloading" : "")" aria-busy="@(_reloading ? "true" : "false")" data-testid="peers-list">
            <PeerPoolLegend Density="_density" HasCarried="HasCarried && _projectPhoenix1 && _groupBy == PeerGrouping.ProjectedGains"></PeerPoolLegend>
            <PeerPoolList @ref="_list" Page="_peers" Charts="Charts" Gains="Gains" Mix="Shown.Mix" Density="_density" PoolRecord="Shown" Skills="_skills"
                          GroupBy="_groupBy" GainsOnly="_gainsOnly"
                          ShowToDo="true" ToDos="ToDos" OnToDo="OnToDo" OnOpen="OnOpen" OnPlay="OnPlay"
                          Collapsed="_collapsed" CollapsedChanged="SetCollapsed"></PeerPoolList>
        </div>
    }
</section>

@if (_peers != null && (_peers.Roster.Count > 0 || _peers.PrivatePeers > 0))
{
    <section class="pmb-block" data-testid="peers-roster">
        <div class="pmb-block-head">
            <h2 class="pmb-block-title">@L["Who your peers are"]</h2>
        </div>
        <p class="pmb-block-lede">
            @(HasPumbilityPeers
                ? L["Players whose pool of the type sits within {0} below and {1} above yours, each holding a full pool of it. You are never one of your own peers; the highlighted row is where you would sit.", WindowBelow, WindowAbove]
                : L["Players within one competitive level of you for the type. You are never one of your own peers; the highlighted row is where you would sit."])
        </p>
        <PeerRoster Rows="_peers.Roster" You="_peers.You" PrivatePeers="_peers.PrivatePeers" ShowPeerFor="ShownPool == null"
                    Rivals="_rivals" Clubmates="_clubmates"></PeerRoster>
    </section>
}

<ShareCardSettingsDialog @bind-Visible="_downloadOpen" SignedIn="true"
                         SampleBuilder="BuildSampleCard" OnDownload="Download"
                         FileName="@DownloadFileName"></ShareCardSettingsDialog>

@code {
    /// <summary>The frame's page record — the totals, the bar, and the target list this block prices its gains from.</summary>
    [Parameter] [EditorRequired] public PumbilityPageRecord Page { get; set; } = null!;

    [Parameter] [EditorRequired] public IReadOnlyDictionary<Guid, Chart> Charts { get; set; } =
        new Dictionary<Guid, Chart>();

    [Parameter] public ChartType? Pool { get; set; }

    /// <summary>The rung the frame priced the record at (D51); the peers' rows are read at the same one.</summary>
    [Parameter] public Energy Energy { get; set; } = Energy.Great;

    /// <summary>The select's pick, for the frame to remember and reload on.</summary>
    [Parameter] public EventCallback<Energy> OnEnergyChanged { get; set; }

    [Parameter] public ISet<Guid> ToDos { get; set; } = new HashSet<Guid>();

    [Parameter] public EventCallback<Guid> OnToDo { get; set; }

    [Parameter] public EventCallback<Chart> OnOpen { get; set; }

    [Parameter] public EventCallback<Chart> OnPlay { get; set; }

    // Kept as the section's original key rather than a new one: the convention is per page,
    // and this IS the Play page — renaming would reset the preference for everyone holding one.
    public const string DensitySettingKey = "Density__Pumbility";

    public const string GroupBySettingKey = "Pumbility__GroupBy";

    public const string ProjectPhoenix1SettingKey = "Pumbility__ProjectPhoenix1";

    public const string GainsOnlySettingKey = "Pumbility__GainsOnly";

    public const string CollapsedSettingKey = "Pumbility__CollapsedTiers";

    private PumbilityPeersPageRecord? _peers;

    /// <summary>
    ///     The frame's record the list on screen was built from. It trails <see cref="Page" />
    ///     by exactly one read: the frame hands a re-priced record down before the peers for it
    ///     have arrived, and rendering the old peers against the new gains would move rows under
    ///     the pulse. Both advance together when the read lands (D56).
    /// </summary>
    private PumbilityPageRecord? _shownPage;

    /// <summary>The pool the list on screen was scoped to; trails <see cref="Pool" /> the same way.</summary>
    private ChartType? _shownPool;

    /// <summary>A re-read after the first paint: the controls disable and the list pulses in place.</summary>
    private bool _reloading;

    private ChartType? _loadedPool;
    private Energy _loadedEnergy = Energy.Great;
    private bool _loaded;
    private bool _settingsRead;

    private UiDensity _density = UiDensity.Comfortable;
    private PeerGrouping _groupBy = PeerGrouping.Prevalence;
    private bool _projectPhoenix1 = true;
    // The front page opens on what pays (D42); the whole prevalence list is one switch away.
    private bool _gainsOnly = true;
    private HashSet<string> _collapsed = new(PeerPoolList.DefaultCollapsed);

    /// <summary>The peer-only projection, read once when the Phoenix 1 switch first goes off.</summary>
    private IReadOnlyDictionary<Guid, PumbilityTarget>? _peerOnlyGains;

    // Who among the peers you already know. Both reads are the shared reader's, cached per
    // circuit, and neither gates the list — the roster simply renders unglowed until they land.
    private IReadOnlySet<Guid>? _rivals;
    private IReadOnlySet<Guid>? _clubmates;

    private PeerPoolList? _list;
    private bool _building;

    /// <summary>
    ///     What each chart IS, in the card vocabulary (docs/design/chart-identity.md §6). Always
    ///     shown here, with no switch to hide it (owner, 2026-08-26): this list exists to decide
    ///     what to play next, and what a chart is made of is exactly what that decision needs.
    ///     <para>
    ///         Read once for the whole page rather than per section — the sections are three
    ///         lenses over one set of charts, and the query walks folder baselines.
    ///     </para>
    /// </summary>
    private IReadOnlyDictionary<Guid, IReadOnlyList<TierListChartCard.CardSkillChip>> _skills =
        new Dictionary<Guid, IReadOnlyList<TierListChartCard.CardSkillChip>>();

    /// <summary>The record everything below the ledes renders from — the frame's, one read behind during a re-read.</summary>
    private PumbilityPageRecord Shown => _shownPage ?? Page;

    /// <summary>The pool everything below the ledes is scoped to — the frame's, one read behind during a re-read.</summary>
    private ChartType? ShownPool => _shownPage == null ? Pool : _shownPool;

    /// <summary>The Phoenix 1 switch only exists for a player whose Phoenix 1 record would change the list (D36).</summary>
    private bool HasCarried => Shown.Targets.Any(t => t.Source == TargetSource.Phoenix1);

    /// <summary>The target list's own gains, or the peer-only projection with the Phoenix 1 switch off.</summary>
    private IReadOnlyDictionary<Guid, PumbilityTarget> Gains =>
        !_projectPhoenix1 && _peerOnlyGains != null
            ? _peerOnlyGains
            : Shown.Targets.GroupBy(t => t.ChartId).ToDictionary(g => g.Key, g => g.First());

    /// <summary>Who a peer is: PUMBILITY peers on Phoenix 2 (D53), the competitive band on Phoenix 1 (D43). The ledes say which.</summary>
    private bool HasPumbilityPeers => Page.Mix == MixEnum.Phoenix2;

    /// <summary>The window's two reaches, whole, for the ledes that name it — a threshold, not a measurement.</summary>
    private static string WindowBelow => PeerGroup.PumbilityWindowBelow.ToString("N0");

    private static string WindowAbove => PeerGroup.PumbilityWindowAbove.ToString("N0");

    /// <summary>
    ///     A run that fell back below the five-peer floor (D47) has every row resting on fewer
    ///     than five scores, so the note says so once, under the lede, rather than a chip: the
    ///     per-row "Fewer than 5 peers scored it" already carries the detail, and what a player
    ///     needs here is why the whole list reads thin. Phoenix 1 has no floor and never shows it.
    ///     <para>
    ///         Read off the projector's own answer, never off the band's size. A band too small to
    ///         put five voices on any chart is only the obvious case; a band of nine whose charts
    ///         were each scored by two or three relaxes identically, and a size test stays silent
    ///         through exactly that. Whether the fallback ran is the only thing that decides it.
    ///     </para>
    ///     <para>
    ///         Under All the list merges both types, so the note only stands when EVERY lit type
    ///         relaxed — otherwise half the rows have real evidence and a blanket sentence would be
    ///         wrong about them. It then names the largest of those bands, which overstates none of
    ///         them.
    ///     </para>
    /// </summary>
    private PeerGroup? ThinBand => Lit.Length > 0 && Lit.All(g => g.AnsweredBelowFloor)
        ? Lit.MaxBy(g => g.Size)
        : null;

    /// <summary>
    ///     A group the projection placed by an extrapolated finish rather than by the player's
    ///     settled pool of the type (D48, D53), so the note names the estimate it leaned on. The
    ///     flag decides it, never the pool count — the projector knows which it did. Same All rule
    ///     as the thin-band note — every lit type has to qualify — and the largest count is the one
    ///     printed.
    /// </summary>
    private PeerGroup? ShortPool => Lit.Length > 0 && Lit.All(g => g.PlacedByEstimate)
        ? Lit.MaxBy(g => g.PoolCount)
        : null;

    /// <summary>The PUMBILITY peer groups actually serving this view — one per lit type in the pool's scope.</summary>
    private PeerGroup[] Lit => !HasPumbilityPeers || Shown.Peers is not { } groups
        ? Array.Empty<PeerGroup>()
        : (ShownPool is { } one ? new[] { one } : new[] { ChartType.Single, ChartType.Double })
        .Where(t => groups.TryGetValue(t, out var group) && group.IsLit && group.Size > 0)
        .Select(t => groups[t])
        .ToArray();

    private string Lede => _groupBy == PeerGrouping.YourTop50
        ? L["Your pool by place, with what your peers do on each chart — how many hold it, their median and how split they are — and the waiting room below the bar."]
        : _groupBy == PeerGrouping.ProjectedGains
        ? L["Ranked by what each chart would add if you played it to the standard your peers set — priced against your bar as it stands now, so every row means what the first one does. Everything here clears your bar."]
        : _gainsOnly
            ? HasPumbilityPeers
                ? L["What players whose pool of the type sits within {0} below and {1} above yours build their PUMBILITY from, cut to the charts that would clear your bar — each priced against the bar as it stands now, and grouped by how many of your peers hold it.", WindowBelow, WindowAbove]
                : L["What players within one competitive level of you build their PUMBILITY from, cut to the charts that would clear your bar — each priced against the bar as it stands now, and grouped by how many of your peers hold it."]
            : HasPumbilityPeers
                ? L["What players whose pool of the type sits within {0} below and {1} above yours build their PUMBILITY from: every chart your peers hold in their top 50, ranked by how high it sits in their pools, with how they score on it and where you stand.", WindowBelow, WindowAbove]
                : L["What players within one competitive level of you build their PUMBILITY from: every chart your peers hold in their top 50, ranked by how high it sits in their pools, with how they score on it and where you stand."];

    /// <summary>
    ///     The peers read for the pool and energy the frame last asked for, held back until the
    ///     frame's record priced at the same arrives — the other half of a flip (D56).
    /// </summary>
    private PumbilityPeersPageRecord? _pendingPeers;

    private IReadOnlyDictionary<Guid, PumbilityTarget>? _pendingPeerOnlyGains;

    /// <summary>
    ///     Whether the frame's record is the one for the pool and energy the peers were read at.
    ///     The record says what it was priced at, so this never has to guess from a reference.
    /// </summary>
    private bool PageIsCurrent => Page.Pool_ == _loadedPool && Page.Energy == _loadedEnergy;

    protected override async Task OnParametersSetAsync()
    {
        if (!_settingsRead)
        {
            _settingsRead = true;
            await ReadSettings();
        }

        if (_loaded && _loadedPool == Pool && _loadedEnergy == Energy)
        {
            // Nothing to read: the frame handed down a record. If it is the one the peers on
            // hold were waiting for, this is the flip.
            Flip();
            return;
        }

        var first = !_loaded;
        _loaded = true;
        _loadedPool = Pool;
        _loadedEnergy = Energy;
        // A change supersedes peers still waiting for a record that is now never coming.
        _pendingPeers = null;
        _pendingPeerOnlyGains = null;
        // The share card's top-50 reads are dropped on every re-read, so a membership never
        // outlives the list it was read for; the next dialog open re-fetches.
        _top50ByType.Clear();
        _top50Combined = null;

        // The first paint has no shape to hold, so the card stands in for the block. Every read
        // after it keeps what is on screen — the old peers against the old record — under the
        // pulse, and swaps the lot at once when both the new peers and the new record are in (D56).
        _reloading = !first;
        var pool = Pool;
        var energy = Energy;
        var peers = await Mediator.Send(new GetPumbilityPeersPageQuery(CurrentUser.User.Id, Page.Mix, pool, energy));
        // The chips are a property of the charts, not of the energy or the pool: one read per page.
        if (_skills.Count == 0) await ReadIdentity();
        var peerOnlyGains = _projectPhoenix1 ? null : await ReadPeerOnlyGains(pool, energy);
        if (_rivals == null)
        {
            _rivals = await Glow.GetMyRivalIds(Page.Mix);
            _clubmates = await Glow.GetMyCommunityMemberIds();
        }

        // A quicker second change superseded this read; its own read is in flight and will flip.
        if (pool != _loadedPool || energy != _loadedEnergy) return;

        _pendingPeers = peers;
        _pendingPeerOnlyGains = peerOnlyGains;
        Flip();
    }

    /// <summary>
    ///     The one flip (D56): the list, its record and its pool advance together, and only once
    ///     both halves are in hand — the peers read for the pool and energy the frame asked for,
    ///     and the frame's record priced at the same. The frame renders twice on a change, first
    ///     with the new pool or energy beside the record it still holds and again when the
    ///     re-priced record lands, and the peers read is the lighter of the two, so either half
    ///     can arrive first; whichever is second flips. Flipping on the peers alone captured the
    ///     old record and then ignored the new one, because by then nothing it keyed on had changed.
    /// </summary>
    private void Flip()
    {
        if (_pendingPeers == null || !PageIsCurrent) return;
        _peers = _pendingPeers;
        _peerOnlyGains = _pendingPeerOnlyGains;
        _pendingPeers = null;
        _pendingPeerOnlyGains = null;
        _shownPage = Page;
        _shownPool = _loadedPool;
        _reloading = false;
    }

    /// <summary>
    ///     Coverage percentages stay off: the number means nothing without the folder around it,
    ///     which is what the chip selection already accounts for. The chart page prints them.
    /// </summary>
    private async Task ReadIdentity()
    {
        var chartIds = Charts.Keys.ToArray();
        if (chartIds.Length == 0) return;
        var identity = await Mediator.Send(new GetChartIdentityQuery(chartIds, Page.Mix));
        _skills = identity.ToDictionary(kv => kv.Key,
            kv => IdentityChips.ToCardChips(kv.Value, false, L));
    }

    private async Task ReadSettings()
    {
        if (Enum.TryParse<UiDensity>(await UiSettings.GetSetting(DensitySettingKey), out var density)) _density = density;
        if (Enum.TryParse<PeerGrouping>(await UiSettings.GetSetting(GroupBySettingKey), out var grouping)) _groupBy = grouping;
        if (bool.TryParse(await UiSettings.GetSetting(ProjectPhoenix1SettingKey), out var project)) _projectPhoenix1 = project;
        if (bool.TryParse(await UiSettings.GetSetting(GainsOnlySettingKey), out var gainsOnly)) _gainsOnly = gainsOnly;
        var collapsed = await UiSettings.GetSetting(CollapsedSettingKey);
        if (!string.IsNullOrWhiteSpace(collapsed))
            _collapsed = collapsed.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet();
    }

    private async Task<IReadOnlyDictionary<Guid, PumbilityTarget>> ReadPeerOnlyGains(ChartType? pool, Energy energy)
    {
        var projection = await Mediator.Send(new ProjectPumbilityGainsQuery(CurrentUser.User.Id, Page.Mix, pool, energy));
        return projection.ProjectedGains.ToDictionary(kv => kv.Key,
            kv => new PumbilityTarget(kv.Key, projection.ExpectedScores[kv.Key], kv.Value, null, false, null));
    }

    private bool _downloadOpen;

    private string DownloadFileName => ShareCardTitles.TargetsFileName(Shown.Mix, _groupBy.ToString(),
        Shown.Energy.ToString(), ShownPool?.ToString() ?? "All", Clock.Now.ToString("yyyy-MM-dd"));

    /// <summary>Which pool the list is scoped to — said only on Phoenix 2, where pools are per type.</summary>
    private string? SharePoolLabel => Shown.Mix != MixEnum.Phoenix2 ? null :
        ShownPool switch
        {
            null => L["All pools"],
            ChartType.Single => L["Singles pool"],
            ChartType.Double => L["Doubles pool"],
            var other => other.ToString()
        };

    // The top-50 membership reads, fetched when the gold boundary first asks and dropped on a
    // pool change — the answer is per mix and per type.
    private readonly Dictionary<ChartType, IReadOnlySet<Guid>> _top50ByType = new();
    private IReadOnlySet<Guid>? _top50Combined;

    private async Task EnsureShareData(ShareCardOptions options, IReadOnlyList<PeerPoolList.ShareSection> sections,
        CancellationToken cancellationToken = default)
    {
        if (!options.BoundaryTop50) return;
        _top50Combined ??= (await Mediator.Send(
                new GetTop50ForPlayerQuery(CurrentUser.User.Id, null, 50, Shown.Mix), cancellationToken))
            .Select(s => s.ChartId).ToHashSet();
        foreach (var type in sections.SelectMany(s => s.Tiles).Select(t => t.Chart.Type).Distinct())
            if (!_top50ByType.ContainsKey(type))
                _top50ByType[type] = (await Mediator.Send(
                        new GetTop50ForPlayerQuery(CurrentUser.User.Id, type, 50, Shown.Mix), cancellationToken))
                    .Select(s => s.ChartId).ToHashSet();
    }

    private ShareCardComposer.TileFacts FactsFor(PeerPoolList.ShareTile tile, ShareCardOptions options)
    {
        // The pool's own value wins where the frame already computed it; anything else prices
        // through the same formula the pool page uses, so the chip never disagrees with it.
        var current = options.Pumbility && !options.ExpectedGains
            ? tile.PoolValue ?? ShareCardComposer.CurrentPumbility(tile.Chart, tile.Score, tile.Plate,
                tile.Broken, Shown.Mix)
            : null;
        return new ShareCardComposer.TileFacts(tile.Chart, tile.Score, tile.Plate,
            Passed: tile.Score != null && !tile.Broken,
            Broken: tile.Broken,
            IsToDo: tile.IsToDo,
            PassedInOtherMix: tile.Carried,
            InTop50Type: _top50ByType.TryGetValue(tile.Chart.Type, out var typed) && typed.Contains(tile.Chart.Id),
            InTop50Combined: _top50Combined?.Contains(tile.Chart.Id) ?? false,
            tile.Gain, tile.Expected, current,
            options.Skills && _skills.TryGetValue(tile.Chart.Id, out var chips) ? chips : null,
            // Every difficulty at once: without the bubble on the tile the picture cannot say
            // what any of it is (owner, field test round six; design doc §5).
            ShareCardImages.DifficultyBubble(tile.Chart));
    }

    private TierListShareCard BuildTargetsCard(IReadOnlyList<TierListShareCard.Row> rows, ShareCardOptions options)
    {
        var palette = MixThemes.PaletteFor(Shown.Mix);
        // The header rule (design doc §9): the grouping is what the rows are, so it rides the
        // title; the energy, the pool scope and the switches that cut or project the list are
        // how to read it, so they ride the subtitle — each only when it applies. The energy
        // travels on the picture because a Good card and a Great card show different grades
        // on the same charts, and a reader has to be able to tell which this was.
        var header = ShareCardTitles.Targets(_groupBy == PeerGrouping.YourTop50, GroupingName,
            L[EnergyLabels.Label(Energy)], SharePoolLabel,
            gainsOnly: _groupBy == PeerGrouping.Prevalence && _gainsOnly,
            phoenix1Projected: _groupBy == PeerGrouping.ProjectedGains && HasCarried && _projectPhoenix1,
            Shown.Mix.GetName(), Clock.Now.ToString("yyyy-MM-dd"),
            CurrentUser.User.GameTag ?? CurrentUser.User.Name, key => L[key].Value);
        return new TierListShareCard(
            header.Title,
            header.Subtitle,
            header.Stamp ?? string.Empty,
            palette.Primary, palette.Background, palette.Surface, palette.Ink, palette.InkMuted,
            "https://piuscores.arroweclip.se/Pumbility",
            null,
            rows,
            ShareCardComposer.Legend(options, Shown.Mix, palette, key => L[key].Value));
    }

    private TierListShareCard.Row ComposeRow(PeerPoolList.ShareSection section,
        IReadOnlyList<PeerPoolList.ShareTile> tiles, ShareCardOptions options, MixPalette palette)
    {
        return new TierListShareCard.Row(section.Name,
            section.Tier is { } tier ? MixThemes.PumbilityHex(Shown.Mix, tier) : palette.Primary,
            tiles.Select(t => ShareCardComposer.Compose(FactsFor(t, options), options, Shown.Mix, palette))
                .ToArray());
    }

    /// <summary>
    ///     The dialog's example: the list's first six jackets wearing the scripted states
    ///     (design doc §10) — stage props, so every option shows at once and no top-50 read
    ///     runs for a preview.
    /// </summary>
    private Task<TierListShareCard?> BuildSampleCard(ShareCardOptions options)
    {
        if (_list == null) return Task.FromResult<TierListShareCard?>(null);
        var charts = _list.ShareSections()
            .SelectMany(s => s.Tiles)
            .Select(t => t.Chart)
            .DistinctBy(c => c.Id)
            .Take(ShareCardSample.Size)
            .ToArray();
        if (charts.Length == 0) return Task.FromResult<TierListShareCard?>(null);
        var palette = MixThemes.PaletteFor(Shown.Mix);
        var facts = ShareCardSample.Facts(charts, Shown.Mix,
            c => options.Skills && _skills.TryGetValue(c.Id, out var chips) ? chips : null,
            ShareCardImages.DifficultyBubble);
        var rows = new[]
        {
            new TierListShareCard.Row(L["Example"], palette.Primary, facts
                .Select(f => ShareCardComposer.Compose(f, options, Shown.Mix, palette))
                .ToArray())
        };
        return Task.FromResult<TierListShareCard?>(BuildTargetsCard(rows, options));
    }

    /// <summary>
    ///     The list as a PNG, through the tier list's own share-card query, renderer and composer
    ///     — the same model and the same settings, so nothing here is a second layout to keep in
    ///     step. Sections and their colours come off the rendered list, so the image says what
    ///     the screen says.
    /// </summary>
    private async Task Download(ShareCardDownloadRequest request)
    {
        if (_list == null) return;
        _building = true;
        try
        {
            var options = request.Options;
            var sections = _list.ShareSections();
            await EnsureShareData(options, sections, request.Token);
            var palette = MixThemes.PaletteFor(Shown.Mix);
            var rows = sections
                .Where(s => s.Tiles.Count > 0)
                .Select(s => ComposeRow(s, s.Tiles, options, palette))
                .ToArray();
            if (rows.Length == 0) return;
            var card = BuildTargetsCard(rows, options);

            // The slow phase, driven from here so the dialog's bar counts real images
            // (design doc §8): warm the card's art in batches, then render against the
            // warm cache. The token is the dialog's Cancel — and any close of it.
            var urls = ShareCardArt.CollectUrls(card);
            var done = 0;
            request.Progress(new ShareCardFetchProgress(0, urls.Count, false));
            foreach (var batch in urls.Chunk(ShareCardArt.FetchBatch))
            {
                await Mediator.Send(new PrefetchShareCardArtCommand(batch), request.Token);
                done += batch.Length;
                request.Progress(new ShareCardFetchProgress(done, urls.Count, false));
            }

            request.Progress(new ShareCardFetchProgress(urls.Count, urls.Count, true));
            var bytes = await Mediator.Send(new GetTierListShareCardQuery(card), request.Token);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/helpers.js");
            await module.InvokeVoidAsync("downloadFileFromStream", DownloadFileName, streamRef);
        }
        catch (OperationCanceledException)
        {
            // The dialog's Cancel (or its close) stopped the download; nothing to deliver.
        }
        finally
        {
            _building = false;
        }
    }

    private string GroupingName => _groupBy switch
    {
        PeerGrouping.ProjectedGains => L["Projected gains"],
        PeerGrouping.YourTop50 => L["Your top 50"],
        _ => L["Prevalence"]
    };

    private async Task SetDensity(UiDensity density)
    {
        _density = density;
        await UiSettings.SetSetting(DensitySettingKey, density.ToString());
    }

    private async Task SetGrouping(PeerGrouping grouping)
    {
        _groupBy = grouping;
        await UiSettings.SetSetting(GroupBySettingKey, grouping.ToString());
    }

    private async Task SetProjectPhoenix1(bool on)
    {
        _projectPhoenix1 = on;
        await UiSettings.SetSetting(ProjectPhoenix1SettingKey, on.ToString());
        if (!on && _peerOnlyGains == null) _peerOnlyGains = await ReadPeerOnlyGains(_loadedPool, _loadedEnergy);
    }

    private async Task SetGainsOnly(bool on)
    {
        _gainsOnly = on;
        await UiSettings.SetSetting(GainsOnlySettingKey, on.ToString());
    }

    private async Task SetCollapsed(IReadOnlySet<string> collapsed)
    {
        _collapsed = collapsed.ToHashSet();
        await UiSettings.SetSetting(CollapsedSettingKey, string.Join(",", _collapsed));
    }
