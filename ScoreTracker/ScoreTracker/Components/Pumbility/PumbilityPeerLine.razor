@using ScoreTracker.Domain.Services.Contracts
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@namespace ScoreTracker.Web.Components

@* The section's one line about its evidence (docs/design/pumbility-overhaul.md §3.3, D27, D28,
   D43): a chip per chart type the selected pool covers — the peer count for a lit type, "N/50
   charts" for a Phoenix 2 type whose pool is not yet fifty — with the definition and the five-peer
   clause in the chip's title (a native tooltip) rather than on the line. The line is a count, not a
   paragraph (owner, 2026-08-16); nothing per row changes (D12 stands). A competitive band is
   always lit and names itself as one. *@
@if (Chips.Any())
{
    <p class="pmb-peer-line">
        @foreach (var (type, group) in Chips)
        {
            <span class="pmb-peer-chip" data-type="@type" data-lit="@(group.IsLit ? "true" : "false")"
                  title="@TooltipFor(type, group)">
                    @if (group.IsLit)
                    {
                        @(group.Kind == PeerGroupKind.PumbilityBand
                            ? Pool == null
                                ? type == ChartType.Single
                                    ? L["Singles: {0} PUMBILITY peers", group.Size]
                                    : L["Doubles: {0} PUMBILITY peers", group.Size]
                                : L["{0} PUMBILITY peers", group.Size]
                            : Pool == null
                                ? type == ChartType.Single
                                    ? L["Singles: {0} peers", group.Size]
                                    : L["Doubles: {0} peers", group.Size]
                                : L["{0} peers", group.Size])
                    }
                    else
                    {
                        @(type == ChartType.Single
                            ? L["Singles: {0}/{1} charts", group.PoolCount, group.PoolSize]
                            : L["Doubles: {0}/{1} charts", group.PoolCount, group.PoolSize])
                    }
            </span>
        }
    </p>
}

@code {
    /// <summary>Who the peer rows were drawn from, per chart type — the page record's Peers.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<ChartType, PeerGroup> Peers { get; set; } = new Dictionary<ChartType, PeerGroup>();

    /// <summary>The selected pool: one type, or null for All, which shows a chip per type.</summary>
    [Parameter]
    public ChartType? Pool { get; set; }

    private IEnumerable<(ChartType Type, PeerGroup Group)> Chips =>
        (Pool is { } one ? new[] { one } : new[] { ChartType.Single, ChartType.Double })
        .Where(Peers.ContainsKey)
        .Select(type => (type, Peers[type]));

    private string TooltipFor(ChartType type, PeerGroup group)
    {
        if (!group.IsLit)
            return type == ChartType.Single
                ? L["Peer projections show once your singles pool has {0} charts.", group.PoolSize]
                : L["Peer projections show once your doubles pool has {0} charts.", group.PoolSize];
        var who = group.Kind == PeerGroupKind.PumbilityBand
            ? L["within 3 levels of you with a full pool"]
            : L["within one competitive level of you"];
        return $"{who} — {L["Charts fewer than 5 of them have passed are not shown."]}";
    }
}
