@using ScoreTracker.Domain.Services.Contracts
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@namespace ScoreTracker.Web.Components

@* Why a chart type has no peers yet (docs/design/pumbility-overhaul.md §3.3, D28): "N/50 charts"
   for a Phoenix 2 type whose pool is not yet full, with the rule in the chip's title.

   A LIT type prints nothing here any more — its count said what the roster below says, and said it
   twice for a player with both pools (owner, field test round two). The dark chip stays because
   there is no roster to be redundant with: it is the only thing that explains the gate. *@
@if (Chips.Any())
{
    <p class="pmb-peer-line">
        @foreach (var (type, group) in Chips)
        {
            <span class="pmb-peer-chip" data-type="@type" data-lit="false"
                  title="@TooltipFor(type, group)">
                @(type == ChartType.Single
                    ? L["Singles: {0}/{1} charts", group.PoolCount, group.PoolSize]
                    : L["Doubles: {0}/{1} charts", group.PoolCount, group.PoolSize])
            </span>
        }
    </p>
}

@code {
    /// <summary>Who the peer rows were drawn from, per chart type — the page record's Peers.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<ChartType, PeerGroup> Peers { get; set; } = new Dictionary<ChartType, PeerGroup>();

    /// <summary>The selected pool: one type, or null for All, which shows a chip per type.</summary>
    [Parameter]
    public ChartType? Pool { get; set; }

    private IEnumerable<(ChartType Type, PeerGroup Group)> Chips =>
        (Pool is { } one ? new[] { one } : new[] { ChartType.Single, ChartType.Double })
        .Where(type => Peers.TryGetValue(type, out var group) && !group.IsLit)
        .Select(type => (type, Peers[type]));

    private string TooltipFor(ChartType type, PeerGroup group) =>
        type == ChartType.Single
            ? L["Peer projections show once your singles pool has {0} charts.", group.PoolSize]
            : L["Peer projections show once your doubles pool has {0} charts.", group.PoolSize];
}
