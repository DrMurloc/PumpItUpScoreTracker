@using ScoreTracker.Domain.Services.Contracts
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@namespace ScoreTracker.Web.Components

@* The section's one line about its evidence on Phoenix 2 (docs/design/pumbility-overhaul.md
   §3.3, D27, D28): how many PUMBILITY peers the estimates were drawn from, per chart type the
   selected pool covers, and — for a type whose pool is not yet fifty charts — how far the pool is
   from lighting up, in place of estimates that do not exist. Peer rows for a chart fewer than five
   of those peers have passed are simply absent, and the line says so in a clause rather than the
   rows carrying a caption (D12 stands).

   Renders nothing for a competitive band: Phoenix 1's list has no peer line. *@
@foreach (var type in TypesShown)
{
    if (!Peers.TryGetValue(type, out var group) || group.Kind != PeerGroupKind.PumbilityBand) continue;

    <p class="pmb-peer-line" data-type="@type" data-lit="@(group.IsLit ? "true" : "false")">
        @if (group.IsLit)
        {
            <span class="pmb-peer-count">
                @(type == ChartType.Single
                    ? L["{0} PUMBILITY peers — within 3 levels of you with a full singles pool", group.Size]
                    : L["{0} PUMBILITY peers — within 3 levels of you with a full doubles pool", group.Size])
            </span>
            <span class="pmb-peer-note">@L["Charts fewer than 5 of them have passed are not shown."]</span>
        }
        else
        {
            <span class="pmb-peer-dark">
                @(type == ChartType.Single
                    ? L["Singles: {0} of {1} charts before peer projections show", group.PoolCount, group.PoolSize]
                    : L["Doubles: {0} of {1} charts before peer projections show", group.PoolCount, group.PoolSize])
            </span>
        }
    </p>
}

@code {
    /// <summary>Who the peer rows were drawn from, per chart type — the page record's Peers.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<ChartType, PeerGroup> Peers { get; set; } = new Dictionary<ChartType, PeerGroup>();

    /// <summary>The selected pool: one type, or null for All, which shows a line per type.</summary>
    [Parameter]
    public ChartType? Pool { get; set; }

    private IEnumerable<ChartType> TypesShown =>
        Pool is { } one ? new[] { one } : new[] { ChartType.Single, ChartType.Double };
}
