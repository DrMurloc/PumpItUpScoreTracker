@using ScoreTracker.PlayerProgress.Contracts
@namespace ScoreTracker.Web.Components

@* The Energy chip (docs/design/pumbility-overhaul.md D51): how you are playing today, as the rung
   of your peers every projected score and gain on the page reads — Good, Great or Top of my game.
   A menu on a chip at the right of the block head, the slot the range-picker workshop measured
   free at 390px; the chosen option is the chip's own label, so nothing else on the page needs to
   restate the setting. The chip says what it is for on hover and each option says what its
   percentile means. *@
<MudMenu Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" AriaLabel="@L["Energy"]" Class="pmb-energy">
    <ActivatorContent>
        <span class="pmb-energy-chip" data-testid="energy-chip-label"
              title="@L["How you're playing today. Every projected score and gain on this page reads your peers at this level."]">
            <b>@L[Label(Value)]</b> <span class="pmb-energy-car">▾</span>
        </span>
    </ActivatorContent>
    <ChildContent>
        @foreach (var option in Options)
        {
            var o = option;
            <MudMenuItem OnClick="() => Pick(o)" title="@L[Hint(o)]" data-testid="@($"energy-{o}")">@L[Label(o)]</MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter] public Energy Value { get; set; } = Energy.Good;

    [Parameter] public EventCallback<Energy> ValueChanged { get; set; }

    /// <summary>The options in the order the chip offers them: the safe read first, the default.</summary>
    public static readonly Energy[] Options = { Energy.Good, Energy.Great, Energy.TopOfMyGame };

    /// <summary>
    ///     The option's label, as a localization key. Phrases rather than the bare words on purpose:
    ///     "Good" and "Great" are already the judgement names' keys, and reusing them would hand a
    ///     Korean or Japanese reader the judgement's translation for an energy level.
    /// </summary>
    public static string Label(Energy energy) => energy switch
    {
        Energy.Great => "Great energy",
        Energy.TopOfMyGame => "Top of my game",
        _ => "Good energy"
    };

    /// <summary>What the option's percentile means, as a localization key — the menu item's tooltip.</summary>
    public static string Hint(Energy energy) => energy switch
    {
        Energy.Great => "The middle of your peers.",
        Energy.TopOfMyGame => "A score only one in four of your peers beat.",
        _ => "A score three in four of your peers reach."
    };

    private async Task Pick(Energy energy)
    {
        if (energy == Value) return;
        await ValueChanged.InvokeAsync(energy);
    }
}
