@namespace ScoreTracker.Web.Components
@using System.Globalization
@using MediatR
@using ScoreTracker.Domain.Models.Titles.Phoenix2
@using ScoreTracker.PlayerProgress.Contracts
@using ScoreTracker.PlayerProgress.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Theming

@* Everything about one title. Absorbs what the old grid buried in a child row: the requirement,
   your standing, how rare it is, and who else holds it. Holders load on open, never with the
   page.

   The selected rung IS the open state — there is no second boolean to fall out of step with it,
   which is what let a scrim dismissal reopen itself on the page's next render. *@
<MudLayout>
    <MudDrawer Open="@(Rung != null)" OpenChanged="OpenChanged" Anchor="Anchor.Right"
               Variant="@DrawerVariant.Temporary" Width="400px">
        @if (Rung != null)
        {
            <div class="title-drawer">
                <div class="title-drawer-head">
                    <div class="title-drawer-eyebrow">@Rung.Title.Category</div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close"
                                   aria-label="@L["Close"]" Class="title-drawer-close"></MudIconButton>
                    <h3>@Rung.Title.Name</h3>
                </div>
                <div class="title-drawer-body">
                    <p class="title-req">@Rung.Title.Description</p>

                    @if (Rung.Official)
                    {
                        <p class="title-note">
                            @L["Progress tracked by the official piugame import, not by piuscores data."]
                        </p>
                    }
                    else if (IsLoggedIn)
                    {
                        <p class="title-label">@L["Your progress"]</p>
                        @* A gem title's bar spans one gem (LinkLadder floors it at the rung
                           below), so it wears that gem's level rungs — labelled, framed around
                           the bar (docs/design/pumbility-levels.md §8). *@
                        @if (IsGemRung)
                        {
                            <PumbilityLevelTicks Floor="Rung.Title.CompletionFloor"
                                                 Ceiling="Rung.Title.CompletionRequired"
                                                 Pool="Rung.Progress.CompletionCount">
                                <div class="title-bar @(Rung.State == RungState.Earned ? "done" : "")">
                                    <i style="width:@Percent"></i>
                                </div>
                            </PumbilityLevelTicks>
                        }
                        else
                        {
                            <div class="title-bar @(Rung.State == RungState.Earned ? "done" : "")">
                                <i style="width:@Percent"></i>
                            </div>
                        }
                        <div class="title-figures">
                            <span>@FloorText</span>
                            <span><b>@Have</b> / @Need</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Rung.Progress.AdditionalNote))
                        {
                            <p class="title-hint">@Rung.Progress.AdditionalNote</p>
                        }

                        @* A gem rung's progress IS the viewer's pool, so their exact rung and the
                           distance to the next cost nothing (docs/design/pumbility-levels.md §4). *@
                        @if (IsGemRung && ViewerLevel is { } standing)
                        {
                            <p class="title-label">@L["Where you stand"]</p>
                            <div class="title-stand">
                                <PumbilityLevelBadge Level="standing" Height="44"></PumbilityLevelBadge>
                                <div class="title-stand-id">
                                    <span class="title-stand-name">@LevelLabel(standing)</span>
                                    @if (standing.ToNext(Rung.Progress.CompletionCount) is { } toNext and > 0)
                                    {
                                        <span class="title-stand-next">@L["{0} to next level", PumbilityFormat.Gain(toNext)]</span>
                                    }
                                </div>
                                <span class="title-stand-range">@RangeText(standing)</span>
                            </div>
                        }
                    }

                    @if (Suggested != null)
                    {
                        @* How well you play moves this by up to eight levels, so it answers at
                           three grades rather than picking one. See SuggestedTitleLevel. *@
                        <p class="title-label">@L["Suggested level"]</p>
                        <div class="title-suggest">
                            <div class="title-suggest-rows">
                                @foreach (var rung in Suggested.Rungs)
                                {
                                    <div class="title-suggest-row @(rung.Reachable ? "" : "short")">
                                        <span class="title-suggest-folder">@string.Join(" · ", rung.Folders)</span>
                                        <span class="title-suggest-ask">@AskFor(rung)</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <p class="title-hint">@L["Fifty charts, {0} plate.", Suggested.Plate.GetShorthand()]</p>
                    }

                    <p class="title-label">@L["How rare"]</p>
                    <div class="title-rarity" style="--band:@ThemeScales.CssVar(Rung.Band)">
                        <span class="title-rarity-pct @ThemeScales.RarityClass(Rung.Band)">@RarityText</span>
                        <span class="title-hint">@RaritySubtext</span>
                    </div>

                    <p class="title-label">@L["Who has it"]</p>
                    @if (_loadingHolders)
                    {
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small"/>
                    }
                    else if (_holders == null || _holders.Holders.Count == 0)
                    {
                        <p class="title-hint">
                            @(_holders is { HiddenCount: > 0 }
                                ? L["Everyone who holds this keeps their profile private."]
                                : L["Nobody here holds this title yet."])
                        </p>
                    }
                    else if (IsGemRung)
                    {
                        @* Flat level groups, strongest first, every name visible. The rung rows stay
                           plain on purpose — the viewer's own holder row is the list's only marker,
                           and "Where you stand" above already carries their rung. *@
                        <div class="title-lvls">
                            @foreach (var level in GemLevels)
                            {
                                var members = MembersAt(level);
                                <div class="title-lvl @(members.Count == 0 ? "empty" : "")">
                                    <div class="title-lvl-head">
                                        <PumbilityLevelBadge Level="level" Height="28"></PumbilityLevelBadge>
                                        <span class="title-lvl-name">@(level.Level is { } lv ? $"LV.{lv}" : LevelLabel(level))</span>
                                        <span class="title-lvl-th">@($"{level.Threshold:N0}+")</span>
                                        <span class="title-lvl-n">@(members.Count == 0 ? "—" : members.Count.ToString("N0"))</span>
                                    </div>
                                    @if (members.Count > 0)
                                    {
                                        <div class="title-lvl-holders">
                                            @foreach (var holder in members)
                                            {
                                                <div class="olb-rank-card @(holder.User.Id == CurrentUserId ? "olb-row-me" : "")">
                                                    <UserLabel User="holder.User"></UserLabel>
                                                    <span class="title-lvl-pool">@holder.TotalPumbility?.ToString("N0")</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            @if (PoollessHolders.Count > 0)
                            {
                                @* A titles row can outlive its stats row; these holders are real but
                                   carry no pool to place them on a rung. *@
                                <div class="title-lvl-holders">
                                    @foreach (var holder in PoollessHolders)
                                    {
                                        <div class="olb-rank-card @(holder.User.Id == CurrentUserId ? "olb-row-me" : "")">
                                            <UserLabel User="holder.User"></UserLabel>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (_holders.HiddenCount > 0)
                        {
                            <p class="title-hint">@L["{0} more keep their profile private.", _holders.HiddenCount]</p>
                        }
                        @if (_holders.ClimbedPastCount > 0)
                        {
                            <p class="title-hint">@L["+{0} others have climbed higher on this ladder.", _holders.ClimbedPastCount]</p>
                        }
                    }
                    else
                    {
                        <div class="title-holders">
                            @foreach (var holder in _holders.Holders)
                            {
                                <div class="olb-rank-card @(holder.User.Id == CurrentUserId ? "olb-row-me" : "")">
                                    <UserLabel User="holder.User"></UserLabel>
                                </div>
                            }
                        </div>
                        @if (_holders.HiddenCount > 0)
                        {
                            <p class="title-hint">@L["{0} more keep their profile private.", _holders.HiddenCount]</p>
                        }
                        @if (_holders.ClimbedPastCount > 0)
                        {
                            <p class="title-hint">@L["+{0} others have climbed higher on this ladder.", _holders.ClimbedPastCount]</p>
                        }
                    }
                </div>
            </div>
        }
    </MudDrawer>
</MudLayout>

@inject IMediator Mediator
@code {
    [Parameter] public TitleRung? Rung { get; set; }

    /// <summary>Every title on the selected rung's ladder, weakest first. Empty off a ladder.</summary>
    [Parameter] public IReadOnlyList<Name> Ladder { get; set; } = Array.Empty<Name>();
    [Parameter] public MixEnum Mix { get; set; }
    [Parameter] public bool IsLoggedIn { get; set; }
    [Parameter] public Guid? CurrentUserId { get; set; }
    [Parameter] public int TrackedPlayers { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool _loadingHolders;
    private TitleHoldersRecord? _holders;
    private string? _loadedFor;

    private SuggestedLevel? Suggested => Rung == null ? null : SuggestedTitleLevel.For(Rung.Title);

    /// <summary>The eight total-pool [P.B] rungs — the only titles whose holders subdivide by level.</summary>
    private bool IsGemRung => Mix == MixEnum.Phoenix2 &&
                              Rung?.Title is Phoenix2PumbilityTitle { Pool: PumbilityPool.Total };

    /// <summary>
    ///     The viewer's own rung. A gem title's progress IS their total pool, so this reads what the
    ///     drawer already holds; zero means no Phoenix 2 pool at all, which renders nothing rather
    ///     than an UNRANKED badge on every gem drawer.
    /// </summary>
    private Phoenix2PumbilityLevel? ViewerLevel =>
        Rung is { Progress.CompletionCount: > 0 } ? Phoenix2PumbilityLevel.From(Rung.Progress.CompletionCount) : null;

    /// <summary>This gem's levels, strongest first — the order the groups render in.</summary>
    private IReadOnlyList<Phoenix2PumbilityLevel> GemLevels => Rung == null
        ? Array.Empty<Phoenix2PumbilityLevel>()
        : Phoenix2PumbilityLevel.LevelsOf(Rung.Title.Name).Reverse().ToArray();

    private IReadOnlyList<TitleHolder> PoollessHolders =>
        _holders?.Holders.Where(h => h.TotalPumbility == null).ToArray() ?? Array.Empty<TitleHolder>();

    /// <summary>
    ///     The holders standing on one level. A pool that has outrun the standing set (stats moved,
    ///     titles not yet recomputed) clamps into this gem's five — the standing set is the
    ///     authority for who appears at all.
    /// </summary>
    private List<TitleHolder> MembersAt(Phoenix2PumbilityLevel level)
    {
        if (_holders == null || Rung == null) return new List<TitleHolder>();
        var levels = Phoenix2PumbilityLevel.LevelsOf(Rung.Title.Name);
        return _holders.Holders
            .Where(h => h.TotalPumbility is { } pool &&
                        Math.Clamp(Phoenix2PumbilityLevel.From(pool).Index, levels[0].Index, levels[^1].Index) ==
                        level.Index)
            .ToList();
    }

    // Display strips the [P.B] prefix — inside this drawer the gem is already the headline.
    private string LevelLabel(Phoenix2PumbilityLevel level)
    {
        if (level.Gem is not { } gem) return L["Unranked"];
        var name = gem.ToString().Replace("[P.B] ", "");
        return level.Level is { } lv ? $"{name} LV.{lv}" : name;
    }

    private static string RangeText(Phoenix2PumbilityLevel level) => level.NextThreshold is { } next
        ? $"{level.Threshold:N0}–{next:N0}"
        : $"{level.Threshold:N0}+";

    /// <summary>What a suggested rung's folders are conditional on, in its own words.</summary>
    private string AskFor(SuggestedRung rung)
    {
        var grade = rung.Grade.GetName();
        if (!rung.Reachable) return L["still isn't enough at {0}", grade];

        return rung.OrBetter ? L["at {0} or better", grade] : L["at {0}", grade];
    }

    private string Percent =>
        Rung == null ? "0%"
            : (Rung.State == RungState.Earned ? 100 : Math.Round(Rung.Fraction * 100)).ToString(CultureInfo.InvariantCulture) + "%";

    private string Have => Rung == null ? "0" : ((int)Math.Min(Rung.Progress.CompletionCount, Rung.Title.CompletionRequired)).ToString("N0");
    private string Need => Rung?.Title.CompletionRequired.ToString("N0") ?? "0";

    private string FloorText => Rung is { Title.CompletionFloor: > 0 }
        ? L["From {0}", Rung.Title.CompletionFloor.ToString("N0")]
        : "0";

    private string RarityText => Rung == null ? "" : (Rung.Share * 100).ToString(Rung.Share >= 0.1 ? "N0" : "N1") + "%";

    private string RaritySubtext => Rung == null
        ? string.Empty
        : L["{0} of {1} tracked players", ((int)Math.Round(Rung.Share * TrackedPlayers)).ToString("N0"), TrackedPlayers.ToString("N0")];

    protected override async Task OnParametersSetAsync()
    {
        if (Rung == null) return;

        // Re-fetch only when the drawer actually changed title — reopening the same one keeps
        // what it already has.
        var key = $"{Mix}:{Rung.Title.Name}";
        if (_loadedFor == key) return;

        _loadedFor = key;
        _holders = null;
        _loadingHolders = true;
        StateHasChanged();
        _holders = await Mediator.Send(new GetTitleHoldersQuery(Mix, Rung.Title.Name, Ladder));
        _loadingHolders = false;
    }

    /// <summary>Every dismissal — the scrim, Escape, the close button — clears the selection.</summary>
    private async Task OpenChanged(bool open)
    {
        if (!open) await Close();
    }

    private async Task Close()
    {
        await OnClosed.InvokeAsync();
    }

}
