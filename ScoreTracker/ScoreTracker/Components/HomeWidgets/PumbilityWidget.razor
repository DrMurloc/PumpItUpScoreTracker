@using MediatR
@using ScoreTracker.Domain.Models
@using ScoreTracker.Domain.Models.Titles.Phoenix2
@using ScoreTracker.Domain.Records
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.HomePage.Contracts
@using ScoreTracker.PlayerProgress.Contracts
@using ScoreTracker.PlayerProgress.Contracts.Queries
@using ScoreTracker.Rivals.Contracts
@using ScoreTracker.Rivals.Contracts.Queries
@using ScoreTracker.Web.Services.Theming
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services.HomeDashboard
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType

@* Account Stats (TypeId stays "pumbility"): the glowy total Pumbility + S/D pools stay —
   competitive level joins them, and the projected-target list left for Suggested Charts'
   Pumbility Push goal. 1x2 and taller add YOUR PEERS — the union the player ticked on /Account
   (docs/design/peers-abstraction.md D18), nearest competitive level first, each row saying why
   they are a peer, board-only rivals closing the list. A pinned mix that differs from the
   current one shows as a pill in the title (via the header slot). *@

@if (!_hasContent)
{
    <div class="dash-widget-message">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
    </div>
}
else
{
    <div class="dash-refreshable @(_loaded ? "" : "dash-stale")">
    @if (_stats == null || (_stats.SkillRating <= 0 && _stats.ClearCount == 0))
    {
    <div class="dash-widget-message">
        <div>
            <MudText Typo="Typo.body2">@L["No scores yet — Pumbility starts with your first import."]</MudText>
            <MudLink Href="/UploadPhoenixScores" Typo="Typo.body2">@L["Import Scores"]</MudLink>
        </div>
    </div>
}
else
{
    <div class="dash-acct">
        <div class="dash-acct-stats">
            <div class="dash-acct-eyebrow">@L["PUMBILITY"]</div>
            <div class="dash-acct-hero">
                @if (_mix == MixEnum.Phoenix2)
                {
                    @* The P2 total-pool level gem (the ladder belongs to Phoenix 2 alone);
                       it self-hides on 404 until the art is mirrored, and the hover names
                       the rung. The weekly delta left for the Sessions page (owner,
                       2026-08-14) — this is the space it freed. *@
                    <PumbilityLevelBadge Level="Phoenix2PumbilityLevel.From(_stats.SkillRating)" Height="44"/>
                }
                <span class="dash-acct-total">
                    <span class="dash-stat-num rarity-glow-1">@_stats.SkillRating.ToString("N0")</span>
                </span>
                <div class="dash-acct-pools">
                    <div class="dash-acct-poolrow">
                        <span style="color:var(--chart-singles)">S</span>
                        <span class="dash-acct-poolnum">@_stats.SinglesRating.ToString("N0")</span>
                    </div>
                    <div class="dash-acct-poolrow">
                        <span style="color:var(--chart-doubles)">D</span>
                        <span class="dash-acct-poolnum">@_stats.DoublesRating.ToString("N0")</span>
                    </div>
                </div>
            </div>

            <div class="dash-acct-eyebrow dash-acct-cl-eyebrow">@L["Competitive Level"]</div>
            <div class="dash-pools">
                <span style="color:var(--chart-singles)">S</span>
                <span class="@(_dimension == ChartType.Single ? "dash-acct-active" : "")">
                    @_stats.SinglesCompetitiveLevel.ToString("N2")</span>
                <span style="color:var(--chart-doubles)">D</span>
                <span class="@(_dimension == ChartType.Double ? "dash-acct-active" : "")">
                    @_stats.DoublesCompetitiveLevel.ToString("N2")</span>
            </div>
        </div>

        @if (_showMatches)
        {
            <div class="dash-acct-matches" data-testid="acct-peers">
                <div class="dash-acct-mhead">
                    <span class="dash-acct-mlabel">@PeersLabel</span>
                    <span class="dash-acct-you">@L["You"] <b>@_myLevel.ToString("N2")</b></span>
                </div>
                @if (_roster.Players.Count > 0 || _roster.BoardOnlyRivals.Count > 0)
                {
                    <div class="dash-acct-mlist dash-scroll">
                        @foreach (var (row, i) in _roster.Players.Select((r, i) => (r, i)))
                        {
                            var r = row;
                            <div class="dash-lb-row @RowClass(r) @(EditMode ? "" : "dash-clickable")"
                                 data-testid="acct-peer" @onclick="() => OpenPlayer(r.User.Id)">
                                <span class="dash-lb-place">@(i + 1)</span>
                                <span class="dash-lb-who dash-acct-who">
                                    <span class="dash-acct-name"><UserLabel User="r.User" ShowAvatar="true"
                                                                            AvatarSize="24"></UserLabel></span>
                                </span>
                                <span class="dash-acct-trail">
                                    <span class="dash-acct-src">
                                        @foreach (var tag in Tags(r))
                                        {
                                            <span class="@tag.Class" title="@tag.Title">@tag.Text</span>
                                        }
                                    </span>
                                    <span class="dash-acct-lvl">@r.Level.ToString("N2")</span>
                                </span>
                            </div>
                        }
                        @* Board-only rivals have no site level to sit on the ladder with, so they close
                           the list rather than sort into it; their standings live on the official boards. *@
                        @foreach (var ghost in _roster.BoardOnlyRivals)
                        {
                            <div class="dash-lb-row is-rival" data-testid="acct-peer-ghost">
                                <span class="dash-lb-place">—</span>
                                <span class="dash-lb-who dash-acct-who">
                                    <span class="dash-acct-name">@ghost.DisplayName</span>
                                </span>
                                <span class="dash-acct-trail">
                                    <span class="dash-acct-src"><span class="dash-acct-tag dash-acct-tag-rival" title="@L["Board only"]">@L["Tag: BOARD"]</span></span>
                                    <span class="dash-acct-lvl dash-muted">—</span>
                                </span>
                            </div>
                        }
                    </div>
                }
                else if (!_sourcesChosen)
                {
                    <div class="dash-acct-empty">@L["Choose who your peers are on your Account page."]</div>
                }
                else
                {
                    <div class="dash-acct-empty">@L["No peers yet."]</div>
                }
            </div>
        }
    </div>
    }
    </div>
}

@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@inject ScoreColorPreferences Preferences
@inject NavigationManager Nav

@code {

    [Parameter] public HomePageWidgetRecord Widget { get; set; } = null!;
    [Parameter] public MixEnum EffectiveMix { get; set; }
    [Parameter] public bool EditMode { get; set; }

    /// <summary>Part of the five-param render contract (§2.2) — Account Stats rows link to
    /// player pages, not charts, so this stays declared but unused.</summary>
    [Parameter] public EventCallback<ChartClickContext> OnChartClick { get; set; }

    [Parameter] public int RefreshToken { get; set; }

    /// <summary>Title-bar slot (§2.3): a pinned mix that differs from the current one rides
    /// here as a pill, keeping the body clear of a mix chip (owner, 2026-07-13).</summary>
    [CascadingParameter] private WidgetHeaderSlot? HeaderSlot { get; set; }

    private const int MatchCount = 25;   // the closest N shown (owner)
    private static readonly MixEnum[] Supported = { MixEnum.Phoenix, MixEnum.Phoenix2 };

    private sealed record Tag(string Text, string Title, string Class);

    private bool _loaded;
    private bool _hasContent;
    private bool _showMatches;
    private string? _loadedFor;
    private MixEnum _mix;
    private ChartType? _dimension;
    private PlayerStatsRecord? _stats;
    private double _myLevel;
    private PeerList _roster = new(Array.Empty<PeerListEntry>(), Array.Empty<RivalSubject>(), 0, 0);
    private bool _sourcesChosen = true;
    private string? _headerSlotKey;

    private string PeersLabel => _roster.Total > 0
        ? L["Your peers · {0}", _roster.Total.ToString("N0")]
        : L["Your peers"];

    /// <summary>
    ///     Why this player is a peer, as the tags the row wears: RIVAL, the initials of each shared
    ///     community, ±0.5 for the competitive band, PMB for a PUMBILITY peer.
    /// </summary>
    private IEnumerable<Tag> Tags(PeerListEntry row)
    {
        if (row.IsRival) yield return new Tag(L["Tag: RIVAL"], L["On your rivals roster"], "dash-acct-tag dash-acct-tag-rival");
        foreach (var community in row.Communities)
            yield return new Tag(Initials(community), community, "dash-acct-tag dash-acct-tag-community");
        if (row.IsCompetitive) yield return new Tag("±0.5", L["Within half a competitive level of you"], "dash-acct-tag dash-acct-tag-competitive");
        if (row.IsPumbility) yield return new Tag("PMB", L["A PUMBILITY peer"], "dash-acct-tag dash-acct-tag-pumbility");
    }

    private static string Initials(string community)
    {
        var words = community.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (words.Length == 0) return string.Empty;
        return words.Length == 1
            ? community[..Math.Min(2, community.Length)].ToUpperInvariant()
            : string.Concat(words.Take(3).Select(w => char.ToUpperInvariant(w[0])));
    }

    /// <summary>The shared row ladder: a rival's red edge, a clubmate's green, both when both.</summary>
    private static string RowClass(PeerListEntry row) =>
        CommunityGlowReader.RowClass(false, row.IsRival, row.IsClubmate, "dash-lb-you", "dash-lb-community");

    protected override async Task OnParametersSetAsync()
    {
        var signature = $"{Widget.Id}|{Widget.ConfigJson}|{Widget.SizePreset}|{EffectiveMix}|{RefreshToken}";
        if (signature != _loadedFor)
        {
            _loadedFor = signature;
            _loaded = false;

            var size = SizePreset.TryParse(Widget.SizePreset) ?? SizePreset.OneByOne;
            _showMatches = size is { Columns: 1, Rows: > 1 };

            var config = WidgetConfigJson.Read<PumbilityConfig>(Widget.ConfigJson);
            // Follow current mix, but Phoenix-eras only — pre-Phoenix mixes fall to Phoenix 2.
            _mix = config.Mix != null && Supported.Contains(config.Mix.Value) ? config.Mix.Value
                : Supported.Contains(EffectiveMix) ? EffectiveMix : MixEnum.Phoenix2;
            _dimension = config.MatchDimension;

            var userId = CurrentUser.User.Id;
            var stats = await Mediator.Send(new GetPlayerStatsQuery(userId, _mix));

            var roster = _roster;
            var sourcesChosen = true;
            if (_showMatches && stats != null)
            {
                // The union the player ticked on /Account, nearest level first on the configured
                // dimension, visibility already applied by the reader (peers-abstraction.md D18).
                roster = await Mediator.Send(new GetMyPeerRosterQuery(_mix, _dimension, MatchCount));
                sourcesChosen = (await Preferences.GetSources()).Any;
            }

            // All of it lands together, after the last await (§2.3): a new total above the
            // previous mix's neighbours is a worse read than a moment of dimmed old numbers.
            _stats = stats;
            _myLevel = roster.MyLevel;
            _roster = roster;
            _sourcesChosen = sourcesChosen;
            _loaded = true;
            _hasContent = true;
        }

        UpdateHeaderSlot(WidgetConfigJson.Read<PumbilityConfig>(Widget.ConfigJson).Mix);
    }

    private void UpdateHeaderSlot(MixEnum? pinned)
    {
        if (HeaderSlot == null) return;
        // Pill only when a specific mix is pinned that isn't the current one (owner).
        var show = pinned is { } p && Supported.Contains(p) && p != EffectiveMix;
        var key = show ? pinned!.Value.ToString() : null;
        if (key == _headerSlotKey) return;
        _headerSlotKey = key;
        HeaderSlot.Set(show ? MixPill(pinned!.Value) : null);
    }

    private RenderFragment MixPill(MixEnum mix) =>@<span class="dash-acct-mixpill">@mix.GetName()</span>;

    private void OpenPlayer(Guid userId)
    {
        if (EditMode) return;
        Nav.NavigateTo($"/Player/{userId}/Sessions");
    }

}
