@using System.Globalization
@using MediatR
@using ScoreTracker.Communities.Contracts
@using ScoreTracker.Communities.Contracts.Queries
@using ScoreTracker.Domain.Models.Titles.Phoenix2
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.HomePage.Contracts
@using ScoreTracker.PlayerProgress.Contracts
@using ScoreTracker.Rivals.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.HomeDashboard

@* Highlights feed (docs/design/home-page-widgets.md §7, docs/design/rivals.md D35): recent big
   wins from the communities you pick and, optionally, the rivals you chose. This is the one place
   the two audiences MIX, which is why it is the only place all three row states can appear at
   once — the Rivals page and the community page are each single-audience, so each marks only the
   other's overlap. Membership is the consent boundary on the community half; a row's chart opens
   the shared ChartDetailsDialog; "See more" deep-links a public player's Sessions page. *@

@if (!_loaded)
{
    <div class="dash-widget-message">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
    </div>
}
else if (!_records.Any())
{
    <div class="dash-widget-message dash-ch-empty">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large"/>
        <MudText Typo="Typo.body2">@L["No big wins yet"]</MudText>
        <MudText Typo="Typo.caption" Class="dash-muted">
            @L["Rare PGs, big titles, and top scores from your communities show up here."]
        </MudText>
    </div>
}
else if (UseStrips)
{
    @* Horizontal sizes (2×1/3×1/4×1): a card strip grouped by person — reuses the Suggested
       Charts strip vocabulary (CSS + the dashboard-grid.js arrow pager, both class-based). *@
    <div class="dash-strip-wrap">
        <button type="button" class="dash-strip-arrow dash-strip-arrow-left" aria-label="@L["Scroll left"]">‹</button>
        <div class="dash-card-strip">
            @foreach (var record in _records)
            {
                <MudTooltip Text="@record.PlayerName" Arrow="true">
                    <div class="dash-strip-person @(IsMe(record) ? "you" : "")">
                        <MudAvatar Size="Size.Small" Class="dash-ch-avatar">
                            <MudImage Src="@record.Avatar.ToString()" Alt="@record.PlayerName"/>
                        </MudAvatar>
                        <span class="dash-strip-pname">@record.PlayerName</span>
                    </div>
                </MudTooltip>
                @foreach (var win in record.Wins)
                {
                    @WinCard(win)
                }
            }
        </div>
        <button type="button" class="dash-strip-arrow dash-strip-arrow-right" aria-label="@L["Scroll right"]">›</button>
    </div>
}
else
{
    <div class="dash-ch-feed dash-scroll">
        @foreach (var record in _records)
        {
            <div class="@RowClass(record)">
                <MudAvatar Size="Size.Small" Class="dash-ch-avatar">
                    <MudImage Src="@record.Avatar.ToString()" Alt="@record.PlayerName"/>
                </MudAvatar>
                <div class="dash-ch-body">
                    <div class="dash-ch-head">
                        @if (record.IsPublic)
                        {
                            <MudLink Href="@SessionsLink(record)" Typo="Typo.body2" Class="dash-ch-name">@record.PlayerName</MudLink>
                        }
                        else
                        {
                            <span class="dash-ch-name">@record.PlayerName</span>
                        }
                        <span class="dash-ch-time dash-muted">@Relative(record.OccurredAt)</span>
                    </div>
                    <div class="dash-ch-wins">
                        @foreach (var win in record.Wins)
                        {
                            @if (win.ChartId is { } chartId && _charts.TryGetValue(chartId, out var chart))
                            {
                                @* Wide = one line: image, bubble, song name (truncates), highlight, then a
                                   right-aligned grade/plate + score. On a 1-wide cell or mobile the highlight
                                   drops to a subtitle line and the song name hides (container/mobile CSS). *@
                                <div class="dash-ch-win dash-ch-win-scored">
                                    <span class="dash-ch-chart @(EditMode ? "" : "dash-clickable")"
                                          @onclick="() => OnChartClick.InvokeAsync(new ChartClickContext(chart))">
                                        <SongImage Song="chart.Song" Small="true"/>
                                        <DifficultyBubble Chart="chart" Small="true"></DifficultyBubble>
                                        <span class="dash-ch-song">@chart.Song.Name</span>
                                    </span>
                                    @* The chip states the fact; the sentence rides the hover (owner: lean
                                       hard on tooltips — the strips' rule, extended to the feed rows). *@
                                    <span class="dash-ch-why" title="@Caption(win)">@ShortCaption(win)</span>
                                    @if (win.Score is { } score)
                                    {
                                        <span class="dash-ch-score-right">
                                            @if (win.Kind == WinKind.NotablePg)
                                            {
                                                @* PG highlight → the PG plate stands in for the SSS+ grade. *@
                                                <ScoreBreakdown Plate="PhoenixPlate.PerfectGame" Height="16"/>
                                            }
                                            else
                                            {
                                                <LetterGradeIcon Grade="PhoenixScore.From(score).LetterGradeFor(_mix)" Height="16"/>
                                            }
                                            <span class="dash-ch-score">@score.ToString("N0")</span>
                                        </span>
                                    }
                                </div>
                            }
                            else if (win.Kind == WinKind.FolderComplete)
                            {
                                <div class="dash-ch-win">
                                    <span class="dash-ch-why">🎉 @L["Cleared {0}", win.Difficulty ?? ""]</span>
                                </div>
                            }
                            else if (win.Kind == WinKind.FolderProgress)
                            {
                                <div class="dash-ch-win">
                                    <span class="dash-ch-why">📈 @FolderProgressCaption(win)</span>
                                </div>
                            }
                            else if (win.Kind == WinKind.PumbilityLevelUp)
                            {
                                <div class="dash-ch-win">
                                    <span class="dash-ch-why dash-ch-lvlup" title="@($"{L["Reached {0}", LevelName(win)]}{PoolSuffix(win)}")">
                                        <PumbilityLevelBadge Level="LevelOf(win)" Height="18"></PumbilityLevelBadge>
                                        <b>@LevelName(win)</b>
                                    </span>
                                </div>
                            }
                            else if (win.TitleName != null)
                            {
                                @* Every title stands on its name — no "Completed", no rarity claim
                                   ("all titles are big titles"); a ladder span compacts to one row. *@
                                <div class="dash-ch-win">
                                    <span class="dash-ch-why">🏅 <b>@TitleLabel(win)</b></span>
                                </div>
                            }
                            else if (win.ChartName != null)
                            {
                                <div class="dash-ch-win">
                                    <span class="dash-ch-why">@win.Difficulty @win.ChartName · @Caption(win)</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@inject IDateTimeOffsetAccessor Clock
@inject ChartCatalogCache ChartCatalog

@code {

    [Parameter] public HomePageWidgetRecord Widget { get; set; } = null!;
    [Parameter] public MixEnum EffectiveMix { get; set; }
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public EventCallback<ChartClickContext> OnChartClick { get; set; }
    // Part of the widget render contract (§2.2) — the host bumps this to force a reload.
    [Parameter] public int RefreshToken { get; set; }

    private const int FeedTake = 30;
    private static readonly MixEnum[] Supported = { MixEnum.Phoenix, MixEnum.Phoenix2 };

    // Short + wide (2x1/3x1/4x1) → the horizontal card strip; everything else stays the vertical feed.
    private bool UseStrips => SizePreset.TryParse(Widget.SizePreset) is { Columns: > 1, Rows: 1 };

    private bool _loaded;
    private string? _loadedFor;
    private IReadOnlyList<PlayerHighlightRecord> _records = Array.Empty<PlayerHighlightRecord>();
    private IReadOnlySet<Guid> _communityUserIds = new HashSet<Guid>();
    private IReadOnlySet<Guid> _rivalUserIds = new HashSet<Guid>();
    private IReadOnlyDictionary<Guid, Chart> _charts = new Dictionary<Guid, Chart>();
    private MixEnum _mix = MixEnum.Phoenix;

    protected override async Task OnParametersSetAsync()
    {
        var signature = $"{Widget.Id}|{Widget.ConfigJson}|{Widget.SizePreset}|{EffectiveMix}|{RefreshToken}";
        if (signature == _loadedFor) return;
        _loadedFor = signature;
        _loaded = false;

        var config = WidgetConfigJson.Read<CommunityHighlightsConfig>(Widget.ConfigJson);
        _mix = config.Mix != null && Supported.Contains(config.Mix.Value) ? config.Mix.Value
            : Supported.Contains(EffectiveMix) ? EffectiveMix : MixEnum.Phoenix;

        // Empty config follows your non-regional crews (CH1) — World/country are opt-in.
        var communities = !config.IncludeCommunities
            ? new List<Name>()
            : config.Communities.Count > 0
                ? config.Communities.Select(Name.From).ToList()
                : (await Mediator.Send(new GetMyCommunitiesQuery()))
                    .Where(c => !c.IsRegional).Select(c => c.CommunityName).ToList();

        // Nothing to read from EITHER half is the only empty case now — a rivals-only feed has no
        // communities by design and must not bail here.
        if (communities.Count == 0 && !config.IncludeRivals)
        {
            _records = Array.Empty<PlayerHighlightRecord>();
            _charts = new Dictionary<Guid, Chart>();
            _loaded = true;
            return;
        }

        var community = communities.Count == 0
            ? Array.Empty<PlayerHighlightRecord>()
            : (await Mediator.Send(
                new GetMyCommunityHighlightsQuery(communities, _mix, config.IncludeOwnWins, FeedTake))).ToArray();
        _communityUserIds = community.Select(r => r.UserId).ToHashSet();

        if (config.IncludeRivals)
        {
            var rivals = (await Mediator.Send(new GetMyRivalHighlightsQuery(_mix, FeedTake))).ToArray();
            _rivalUserIds = rivals.Select(r => r.UserId).ToHashSet();
            // Deduped by event: somebody who is both a rival and a clubmate produced ONE win, and
            // the row wears both markers rather than appearing twice.
            _records = community.Concat(rivals)
                .GroupBy(r => r.EventId)
                .Select(g => g.First())
                .OrderByDescending(r => r.OccurredAt)
                .Take(FeedTake)
                .ToList();
        }
        else
        {
            _rivalUserIds = new HashSet<Guid>();
            _records = community.ToList();
        }
        _charts = await ChartCatalog.GetCharts(_mix);
        _loaded = true;
    }

    private static string SessionsLink(PlayerHighlightRecord r) =>
        r.SessionId == null ? $"/Player/{r.UserId}/Sessions" : $"/Player/{r.UserId}/Sessions?session={r.SessionId}";

    private string Relative(DateTimeOffset when)
    {
        var span = Clock.Now - when;
        if (span.TotalMinutes < 1) return L["now"];
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d";
        return $"{(int)(span.TotalDays / 7)}w";
    }

    private string Caption(SignificantWin win) => win.Kind switch
    {
        WinKind.NotablePg => $"💎 {L["only {0} have PG", Pct(win.RarityShare)]}",
        WinKind.TopPumbility => $"👑 {L["#{0} PUMBILITY", win.Rank ?? 0]}",
        WinKind.PeerElite => win.Rank == 1
            ? $"📊 {L["#1 of all peers"]}"
            : $"📊 {L["top {0}% of peers", PeerPct(win)]}",
        WinKind.FolderFirst => $"🆕 {L["{0} pass in this folder", Ordinal(win.Rank ?? 0)]}",
        _ => string.Empty
    };

    private static string Ordinal(int n) => n switch { 1 => "1st", 2 => "2nd", 3 => "3rd", _ => $"{n}th" };

    private static int PeerPct(SignificantWin win) => Math.Max(1, (int)Math.Ceiling((win.RarityShare ?? 0) * 100));

    // Spans compact to "[S] ADVANCED LV.6 → 9"; everything else is the bracketed name alone —
    // no "Completed", no rarity claim ("all titles are big titles", owner 2026-08-14).
    private static string TitleLabel(SignificantWin win) =>
        win.Kind == WinKind.PumbilityTitleSpan && win.Detail is { Length: > 0 }
            ? TitleSpans.Compact(Bracket(win.Detail), Bracket(win.TitleName ?? ""))
            : Bracket(win.TitleName ?? "");

    private static string Pct(double? share) =>
        share == null ? "" : (share.Value * 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private static string Bracket(string title) =>
        string.IsNullOrEmpty(title) ? "" : title.StartsWith('[') ? title : $"[{title}]";

    // Split a folder label ("D24") into type + level so a chart-less DifficultyBubble can render it.
    private static (ChartType? Type, DifficultyLevel? Level) ParseFolder(string? difficulty)
    {
        if (string.IsNullOrEmpty(difficulty)) return (null, null);
        foreach (var type in new[] { ChartType.Double, ChartType.Single, ChartType.CoOp, ChartType.HalfDouble })
        {
            var shorthand = type.GetShortHand();
            if (difficulty.StartsWith(shorthand, StringComparison.OrdinalIgnoreCase)
                && int.TryParse(difficulty[shorthand.Length..], out var level))
                return (type, DifficultyLevel.From(level));
        }
        return (null, null);
    }

    private bool IsMe(PlayerHighlightRecord record) =>
        CurrentUser.IsLoggedIn && CurrentUser.User.Id == record.UserId;

    // The only surface where all three states are meaningful, because it is the only one whose
    // population is genuinely mixed (docs/design/rivals.md D36).
    private string RowClass(PlayerHighlightRecord record)
    {
        return ("dash-ch-entry " + CommunityGlowReader.RowClass(false,
            _rivalUserIds.Contains(record.UserId), _communityUserIds.Contains(record.UserId),
            youClass: string.Empty)).TrimEnd();
    }

    // "80% of S22" when the completion tier is the news, "D21 now S" when the grade is. The
    // policy decides which by whether it sent a grade at all, so this never has to re-derive it.
    private string FolderProgressCaption(SignificantWin win) => win.Detail == null
        ? L["{0}% of {1}", win.Rank ?? 0, win.Difficulty ?? ""].Value
        : L["{0} now {1}", win.Difficulty ?? "", win.Detail].Value;

    private string NonChartTip(SignificantWin win) => win.Kind == WinKind.FolderComplete
        ? $"🎉 {L["Cleared {0}", win.Difficulty ?? ""].Value}"
        : $"🏅 {TitleLabel(win)}";

    // The shortest form — cards and feed rows alike; the full sentence lives in the tooltip
    // (owner: lean hard on tooltips).
    private string ShortCaption(SignificantWin win) => win.Kind switch
    {
        WinKind.NotablePg => $"💎 {L["Rare PG"]}",
        WinKind.TopPumbility => $"👑 #{win.Rank ?? 0} PUMB",
        WinKind.PeerElite => win.Rank == 1 ? "📊 #1" : $"📊 {L["Top {0}%", PeerPct(win)]}",
        WinKind.FolderFirst => $"🆕 {Ordinal(win.Rank ?? 0)} · {win.Difficulty}",
        _ => string.Empty
    };

    // A win as a strip card. Chart wins = art + grade/plate + score + the short caption; titles + folder
    // clears are text cards. The full detail + song name ride a MudTooltip on hover (owner).
    private RenderFragment<SignificantWin> WinCard => win =>
        @<text>
            @if (win.ChartId is { } cid && _charts.TryGetValue(cid, out var c))
            {
                <MudTooltip Text="@($"{c.Song.Name} ({c.DifficultyString}) · {Caption(win)}")" Arrow="true">
                    <div class="dash-chart-card @(EditMode ? "" : "dash-clickable")"
                         @onclick="() => OnChartClick.InvokeAsync(new ChartClickContext(c))">
                        <div class="dash-card-art">
                            <img src="@c.Song.ImagePath" alt="@c.Song.Name" loading="lazy"/>
                            <span class="dash-card-bubble"><DifficultyBubble Chart="c" Small="true"></DifficultyBubble></span>
                        </div>
                        <div class="dash-card-score">
                            @if (win.Score is { } sc)
                            {
                                @if (win.Kind == WinKind.NotablePg)
                                {
                                    <ScoreBreakdown Plate="PhoenixPlate.PerfectGame" Height="14"/>
                                }
                                else
                                {
                                    <LetterGradeIcon Grade="PhoenixScore.From(sc).LetterGradeFor(_mix)" Height="14"/>
                                }
                                <span>@sc.ToString("N0")</span>
                            }
                        </div>
                        <div class="dash-card-detail dash-muted">@ShortCaption(win)</div>
                    </div>
                </MudTooltip>
            }
            else if (win.Kind == WinKind.FolderComplete)
            {
                var folder = ParseFolder(win.Difficulty);
                <MudTooltip Text="@NonChartTip(win)" Arrow="true">
                    <div class="dash-chart-card dash-card-text">
                        <div class="dash-card-emoji">🎉</div>
                        @if (folder.Type != null && folder.Level != null)
                        {
                            <DifficultyBubble Type="folder.Type" Level="folder.Level" Mix="_mix" Small="true"></DifficultyBubble>
                        }
                        <div class="dash-card-name">@L["Folder Cleared"]</div>
                    </div>
                </MudTooltip>
            }
            else if (win.Kind == WinKind.FolderProgress)
            {
                var folder = ParseFolder(win.Difficulty);
                <MudTooltip Text="@NonChartTip(win)" Arrow="true">
                    <div class="dash-chart-card dash-card-text">
                        <div class="dash-card-emoji">📈</div>
                        @if (folder.Type != null && folder.Level != null)
                        {
                            <DifficultyBubble Type="folder.Type" Level="folder.Level" Mix="_mix" Small="true"></DifficultyBubble>
                        }
                        <div class="dash-card-name">@FolderProgressCaption(win)</div>
                    </div>
                </MudTooltip>
            }
            else if (win.Kind == WinKind.PumbilityLevelUp)
            {
                <MudTooltip Text="@($"{L["Reached {0}", LevelName(win)]}{PoolSuffix(win)}")" Arrow="true">
                    <div class="dash-chart-card dash-card-text">
                        <div class="dash-card-emoji">
                            <PumbilityLevelBadge Level="LevelOf(win)" Height="22"></PumbilityLevelBadge>
                        </div>
                        <div class="dash-card-name">@LevelName(win)</div>
                    </div>
                </MudTooltip>
            }
            else
            {
                @* Titles: the name alone (a ladder span compacts) — no tags, no "completed". *@
                <MudTooltip Text="@NonChartTip(win)" Arrow="true">
                    <div class="dash-chart-card dash-card-text">
                        <div class="dash-card-emoji">🏅</div>
                        <div class="dash-card-name">@TitleLabel(win)</div>
                    </div>
                </MudTooltip>
            }
        </text>;

    // ---- the PUMBILITY level-up row (docs/design/pumbility-levels.md §5) ----

    private static Phoenix2PumbilityLevel? LevelOf(SignificantWin win) =>
        win.Rank is { } index ? Phoenix2PumbilityLevel.FromIndex(index) : null;

    // The gem is the game's own proper noun; only a row whose index no longer resolves needs a
    // word of ours.
    private string LevelName(SignificantWin win) =>
        LevelOf(win) is { } level && PumbilityLevelChange.LabelFor(level) is { Length: > 0 } label
            ? label
            : L["Level Up"];

    private string PoolSuffix(SignificantWin win) =>
        win.PoolValue is { } pool ? $" · {pool.ToString("N0")}" : string.Empty;

}
