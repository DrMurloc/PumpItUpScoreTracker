@using ScoreTracker.HomePage.Contracts
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services.HomeDashboard
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType

<MudSelect T="MixEnum?" @bind-Value="_mix" Label="@L["Mix"]" Class="mb-3">
    <MudSelectItem T="MixEnum?" Value="null">@L["Follow current mix"]</MudSelectItem>
    <MudSelectItem T="MixEnum?" Value="MixEnum.Phoenix">Phoenix</MudSelectItem>
    <MudSelectItem T="MixEnum?" Value="MixEnum.Phoenix2">Phoenix 2</MudSelectItem>
</MudSelect>

@foreach (var folder in _folders)
{
    <div class="d-flex gap-2 align-center mb-2">
        <MudSelect T="ChartType" Value="folder.Type" Label="@L["Type"]"
                   ValueChanged="@(t => SetType(folder, t))">
            <MudSelectItem T="ChartType" Value="ChartType.Single">@L["Singles"]</MudSelectItem>
            <MudSelectItem T="ChartType" Value="ChartType.Double">@L["Doubles"]</MudSelectItem>
            <MudSelectItem T="ChartType" Value="ChartType.CoOp">CO-OP</MudSelectItem>
        </MudSelect>
        <MudSelect T="int" Value="folder.Level" Label="@LevelLabel(folder.Type)"
                   ValueChanged="@(l => { folder.Level = l; StateHasChanged(); })">
            @foreach (var level in FolderLevels.LevelsFor(folder.Type))
            {
                <MudSelectItem T="int" Value="level">@level</MudSelectItem>
            }
        </MudSelect>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                       OnClick="@(() => _folders.Remove(folder))"
                       aria-label="@L["Remove"]"></MudIconButton>
    </div>
}

@if (_folders.Count < MaxFolders)
{
    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddFolder" Variant="Variant.Outlined"
               Size="Size.Small">@L["Add folder"]</MudButton>
}

<div class="d-flex justify-end gap-2 mt-4">
    <MudButton OnClick="() => OnCancel.InvokeAsync()">@L["Cancel"]</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@L["Save"]</MudButton>
</div>

@code {

    [Parameter] public HomePageWidgetRecord Widget { get; set; } = null!;
    [Parameter] public EventCallback<(string ConfigJson, int ConfigVersion)> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    // Six rows fill a 4x2 comfortably and anything past that is a scroll, not a dashboard.
    private const int MaxFolders = 6;

    private MixEnum? _mix;
    private List<FolderLevelsTarget> _folders = new();

    protected override void OnParametersSet()
    {
        var config = WidgetConfigJson.Read<FolderLevelsConfig>(Widget.ConfigJson);
        _mix = config.Mix;
        _folders = config.Folders.Select(f => new FolderLevelsTarget { Type = f.Type, Level = f.Level }).ToList();
        if (_folders.Count == 0) AddFolder();
    }

    // Co-op "levels" are player counts 2–5, so a level carried over from singles would be
    // out of range — clamp into whatever the new type actually offers.
    private void SetType(FolderLevelsTarget folder, ChartType type)
    {
        var (min, max) = FolderLevels.Range(type);
        folder.Type = type;
        folder.Level = Math.Clamp(folder.Level, min, max);
        StateHasChanged();
    }

    private string LevelLabel(ChartType type) =>
        type == ChartType.CoOp ? L["Players"].Value : L["Level"].Value;

    private void AddFolder() => _folders.Add(new FolderLevelsTarget { Type = ChartType.Single, Level = 20 });

    private async Task Save()
    {
        var config = new FolderLevelsConfig { Mix = _mix, Folders = _folders.ToList() };
        await OnSave.InvokeAsync((WidgetConfigJson.Write(config), 1));
    }

}
