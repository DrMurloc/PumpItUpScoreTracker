@namespace ScoreTracker.Web.Components
@using MediatR
@using ScoreTracker.Application.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.Web.Services
@using Microsoft.AspNetCore.Mvc.ModelBinding.Validation
@using ScoreTracker.SharedKernel.ValueTypes
@using ChartType = ScoreTracker.SharedKernel.Enums.ChartType
@inject IMediator Mediator;
<MudAutocomplete @ref="_autocomplete" Dense="true" Disabled="Disabled" T="string" Value="_selected" ValueChanged="SetChart" MaxItems="15" CoerceValue="false" CoerceText="true" Label="@Label" Placeholder="@Placeholder" Variant="Variant" Margin="Margin" SearchFunc="(s,c)=>SearchSongs(s)">
    <ItemTemplate>
        <SongImage Song="_chartNames[context].Song" Small="true"></SongImage>
        <DifficultyBubble Chart="_chartNames[context]" Small="true"></DifficultyBubble> @_chartNames[context].Song.Name
        @* A host fed one mix's catalog has nothing to disambiguate. One fed several does:
           a rerated chart appears once per mix under different difficulties, and the mix
           is what says which of them is the one you remember. *@
        @if (ShowMix)
        {
            <span class="chart-selector-mix"> - @_chartNames[context].Mix.GetName()</span>
        }
    </ItemTemplate>
</MudAutocomplete>
@code {

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Text;

    [Parameter]
    public Margin Margin { get; set; } = Margin.None;

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public MixEnum Mix { get; set; } = MixEnum.Phoenix;

    [Parameter]
    public Func<Chart, Task> ChartIdSelected { get; set; } = c => Task.CompletedTask;
    [Parameter]
    public string Label { get; set; } = "Chart";

    /// <summary>
    ///     Appends " - {Mix}" to each suggestion. Off by default: it is noise when Charts
    ///     comes from a single mix, and identity when it comes from several.
    /// </summary>
    [Parameter]
    public bool ShowMix { get; set; } = false;

    private IEnumerable<Chart>? _charts = null;
    [Parameter]
    public IEnumerable<Chart>? Charts { get; set; } = null;

    private string _selected = string.Empty;
    private MudAutocomplete<string>? _autocomplete;

    /// <summary>Hosts opening this in a popover can put the cursor straight in the search box.</summary>
    public ValueTask FocusAsync()
    {
        return _autocomplete?.FocusAsync() ?? ValueTask.CompletedTask;
    }

    private Task<IEnumerable<string>> SearchSongs(string v)
    {
        // The chart-name search is shared with the site search (ChartSearchIndex): one answer to
        // what a term finds, including the trailing "S22" that narrows to a difficulty.
        return Task.FromResult(_index.SearchNames(v));
    }

    private async Task SetChart(string selected)
    {
        if (string.IsNullOrWhiteSpace(selected))
        {
            return;
        }
        _selected = selected;
        await ChartIdSelected(_chartNames[selected]);
    }

    private ChartSearchIndex _index = ChartSearchIndex.Empty;
    private IReadOnlyDictionary<string, Chart> _chartNames => _index.ByName;

    private async Task UpdateChartList()
    {
        var source = Charts ?? await Mediator.Send(new GetChartsQuery(Mix));
        _index = ChartSearchIndex.Build(source);
    }
    protected override void OnParametersSet()
    {
        // Latching the new list is what makes this a guard. Without it _charts kept the
        // value it was initialised with forever, so a host that passes a real catalog
        // rebuilt the whole name dictionary on every one of its own re-renders.
        if (_charts != Charts)
        {
            _charts = Charts;
            InvokeAsync(UpdateChartList);
        }
    }
    protected override async Task OnInitializedAsync()
    {
        _charts = Charts;
        await UpdateChartList();
    }
}
