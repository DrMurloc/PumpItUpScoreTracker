@using MediatR
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.Communities.Contracts.Queries
@using ScoreTracker.Domain.Records
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.PlayerProgress.Contracts.Queries

@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Services.Theming
@namespace ScoreTracker.Web.Components

@* One chart's boards at four scopes — the shared dialog any page can open on any chart.
   Rows, glows and place colouring are LeaderboardDialog's vocabulary (.weekly-lb-*), so the
   challenges board and this one read as one thing. The scope rail is the only new furniture,
   and its precedent is that dialog's own relevant-players switch: it re-ranks whatever it
   shows rather than filtering a fixed board. *@
<MudDialog Visible="Visible" VisibleChanged="VisibleChanged" Options="DialogSizing" Class="cld-dialog">
    <TitleContent>
        <div class="weekly-lb-title">
            @if (_chart != null)
            {
                <DifficultyBubble Chart="_chart" Small="true"></DifficultyBubble>
                <MudText Typo="Typo.h6">@_chart.Song.Name</MudText>
            }
        </div>
    </TitleContent>
    <DialogContent>
        <div class="cld-scopes">
            @foreach (var scope in Scopes)
            {
                <button type="button" class="@ScopeClass(scope)" disabled="@(!IsAvailable(scope))"
                        data-testid="@($"cld-scope-{scope}")"
                        @onclick="() => SelectScope(scope)">
                    @ScopeLabel(scope)
                </button>
            }
        </div>

        @* The picker is a control with one choice below two communities, so it only earns its
           row when there is actually something to pick. *@
        @if (_scope == LeaderboardScope.Community && _myCommunities.Count > 1)
        {
            <div class="cld-sub" data-testid="cld-community-picker">
                @foreach (var community in _myCommunities)
                {
                    <button type="button" class="@CommunityClass(community)"
                            @onclick="() => SelectCommunity(community)">@community</button>
                }
            </div>
        }

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2"></MudProgressLinear>
        }
        else if (!_rows.Any())
        {
            <div class="cld-empty" data-testid="cld-empty">@EmptyText</div>
        }
        else
        {
            @if (_myPlace != null)
            {
                <div class="cld-standing" data-testid="cld-standing">
                    <span class="cld-standing-place" style="@ThemeScales.RarityStyle(MyPercentile)">
                        @L["#{0} of {1}", _myPlace.Value, _rows.Count]
                    </span>
                    <span class="cld-standing-scope">@ScopeLabel(_scope)</span>
                </div>
            }
            <div class="cld-body">
                @foreach (var row in _rows)
                {
                    <div class="weekly-lb-row @RowClass(row)">
                        <span class="weekly-lb-place" style="@ThemeScales.RarityStyle(row.Percentile)">
                            #@row.Place
                        </span>
                        <span class="weekly-lb-user">@(row.IsMe ? L["You"] : row.Score.UserName.ToString())</span>
                        <ScoreBreakdown Score="row.Score.Score" Plate="row.Score.Plate" Mix="Mix"
                                        IsBroken="row.Score.IsBroken" OneLine="true" ShowScore="true">
                        </ScoreBreakdown>
                    </div>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudSpacer/>
        <MudButton OnClick="() => VisibleChanged.InvokeAsync(false)">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@code {
    public enum LeaderboardScope
    {
        World,
        Region,
        Community,
        CompetitivePeers
    }

    private static readonly LeaderboardScope[] Scopes =
    {
        LeaderboardScope.World, LeaderboardScope.Region, LeaderboardScope.Community,
        LeaderboardScope.CompetitivePeers
    };

    private static readonly DialogOptions DialogSizing = new()
        { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public Guid ChartId { get; set; }
    [Parameter] public MixEnum Mix { get; set; } = MixEnum.Phoenix;

    /// <summary>
    ///     Which board to open on. A session score row passes CompetitivePeers — that is the
    ///     cohort its colour came from, so opening there makes the colour auditable instead of
    ///     asserted. A chart page would pass World.
    /// </summary>
    [Parameter] public LeaderboardScope InitialScope { get; set; } = LeaderboardScope.World;

    private sealed record Row(int Place, double Percentile, UserPhoenixScore Score, bool IsMe, bool IsCommunity);

    private Chart? _chart;
    private bool _loading = true;
    private Guid? _loadedFor;
    private LeaderboardScope _scope;
    private Name? _community;
    private IReadOnlyList<Name> _myCommunities = Array.Empty<Name>();
    private IReadOnlySet<Name> _regionalCommunities = new HashSet<Name>();
    private UserPhoenixScore[] _world = Array.Empty<UserPhoenixScore>();
    private IReadOnlySet<Guid> _clubmates = new HashSet<Guid>();
    private IReadOnlySet<Guid> _communityUserIds = new HashSet<Guid>();
    private List<Row> _rows = new();
    private int? _myPlace;

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible || _loadedFor == ChartId) return;
        _loadedFor = ChartId;
        _scope = InitialScope;
        await LoadChartAsync();
    }

    private async Task LoadChartAsync()
    {
        _loading = true;
        _chart = (await Mediator.Send(new GetChartsQuery(Mix, ChartIds: new[] { ChartId }))).FirstOrDefault();
        // The World COMMUNITY, not every score on the chart. Every account joins it, and a
        // private player does not — so reading the board through it is what keeps a name that
        // its owner hid off every scope in this dialog, World and Competitive Peers included.
        _world = (await Mediator.Send(new GetPhoenixRecordsForCommunityQuery(WorldCommunity, ChartId, Mix)))
            .OrderByDescending(s => (int)s.Score)
            .ToArray();

        if (CurrentUser.IsLoggedIn)
        {
            var communities = (await Mediator.Send(new GetMyCommunitiesQuery())).ToArray();
            // World is a system community that carries IsRegional = 0, so the name check is
            // load-bearing: without it "your communities" means everybody.
            _myCommunities = communities
                .Where(c => !c.IsRegional && c.CommunityName != WorldCommunity)
                .Select(c => c.CommunityName).ToArray();
            _regionalCommunities = communities.Where(c => c.IsRegional).Select(c => c.CommunityName).ToHashSet();
            _community = _myCommunities.FirstOrDefault();

            // Who to glow green on the scopes that mix clubmates in with everyone else.
            var clubmates = new HashSet<Guid>();
            foreach (var community in _myCommunities)
                clubmates.UnionWith(await Mediator.Send(new GetCommunityMembersQuery(community)));
            _clubmates = clubmates;
        }

        if (!IsAvailable(_scope)) _scope = LeaderboardScope.World;
        await BuildRowsAsync();
    }

    private async Task SelectScope(LeaderboardScope scope)
    {
        if (_scope == scope || !IsAvailable(scope)) return;
        _scope = scope;
        await BuildRowsAsync();
    }

    private async Task SelectCommunity(Name community)
    {
        if (_community == community) return;
        _community = community;
        await BuildRowsAsync();
    }

    /// <summary>
    ///     Ranks whatever the scope contains. Places renumber per scope by design — a board of
    ///     seven clubmates is its own board, not a filtered view of the world one.
    /// </summary>
    private async Task BuildRowsAsync()
    {
        _loading = true;
        var scores = await ScoresForScopeAsync();
        var myId = CurrentUser.IsLoggedIn ? CurrentUser.User.Id : (Guid?)null;

        _rows = scores
            .OrderByDescending(s => (int)s.Score)
            .Select((s, i) => new Row(i + 1,
                scores.Count == 0 ? 0 : (scores.Count - i) / (double)scores.Count,
                s, s.UserId == myId, _communityUserIds.Contains(s.UserId)))
            .ToList();
        _myPlace = _rows.FirstOrDefault(r => r.IsMe)?.Place;
        _loading = false;
    }

    private async Task<IReadOnlyList<UserPhoenixScore>> ScoresForScopeAsync()
    {
        switch (_scope)
        {
            case LeaderboardScope.CompetitivePeers:
            {
                if (_chart == null) return Array.Empty<UserPhoenixScore>();
                var peers = (await Mediator.Send(new GetCompetitivePlayersQuery(_chart.Type, Mix))).ToHashSet();
                _communityUserIds = _clubmates;
                return _world.Where(s => peers.Contains(s.UserId)).ToArray();
            }
            case LeaderboardScope.Region:
            {
                if (_regionalCommunities.Count == 0) return Array.Empty<UserPhoenixScore>();
                // A country board is not one of your clubs, so a clubmate on it is still worth
                // marking — the glow only stops meaning something on the club's OWN board.
                _communityUserIds = _clubmates;
                return await CommunityScoresAsync(_regionalCommunities.First());
            }
            case LeaderboardScope.Community:
                // Here every row IS a member, so a glow would mark everything and therefore
                // nothing.
                _communityUserIds = new HashSet<Guid>();
                return _community == null
                    ? Array.Empty<UserPhoenixScore>()
                    : await CommunityScoresAsync(_community.Value);
            default:
                _communityUserIds = _clubmates;
                // The World board IS the World community's breakdown, so a player who hid
                // their profile is not on it. Competitive Peers deliberately keeps them: that
                // scope is a cohort rather than a roster, and dropping people would disagree
                // with the percentile the score row already printed.
                return _world.Where(s => s.IsPublic).ToArray();
        }
    }

    private async Task<IReadOnlyList<UserPhoenixScore>> CommunityScoresAsync(Name community)
    {
        return (await Mediator.Send(new GetPhoenixRecordsForCommunityQuery(community, ChartId, Mix))).ToArray();
    }

    /// <summary>
    ///     Every account joins this on creation, and unlike the country communities it is not
    ///     flagged regional — so "clubs you chose" has to name it, and the world board reads
    ///     through it to inherit its membership rather than the whole ledger.
    /// </summary>
    private const string WorldCommunity = "World";

    private bool IsAvailable(LeaderboardScope scope) => scope switch
    {
        LeaderboardScope.Region => _regionalCommunities.Count > 0,
        LeaderboardScope.Community => _myCommunities.Count > 0,
        // Competitive cohorts have no co-op side. The chip greys and says nothing further —
        // a sentence about cohorts costs more confusion than it buys (owner call).
        LeaderboardScope.CompetitivePeers => _chart is { Type: not ScoreTracker.SharedKernel.Enums.ChartType.CoOp },
        _ => true
    };

    private string ScopeClass(LeaderboardScope scope) =>
        _scope == scope ? "cld-chip cld-chip-on" : IsAvailable(scope) ? "cld-chip" : "cld-chip cld-chip-off";

    private string CommunityClass(Name community) =>
        _community == community ? "cld-chip cld-chip-on" : "cld-chip";

    private string RowClass(Row row) =>
        row.IsMe ? "weekly-lb-me" : row.IsCommunity ? "weekly-lb-community" : string.Empty;

    private double? MyPercentile =>
        _myPlace == null || _rows.Count == 0 ? null : (_rows.Count - _myPlace.Value + 1) / (double)_rows.Count;

    private string ScopeLabel(LeaderboardScope scope) => scope switch
    {
        LeaderboardScope.Region => L["Region"],
        LeaderboardScope.Community => L["Community"],
        LeaderboardScope.CompetitivePeers => L["Competitive Peers"],
        _ => L["World"]
    };

    private string EmptyText => L["Nobody here has played this yet."];
}
