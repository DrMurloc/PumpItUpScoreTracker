@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@namespace ScoreTracker.Web.Components

@* A MudDialog around ChartLeaderboardScopes, which owns the board itself. Kept as its own
   component because "open the leaderboard for this chart" is a gesture several pages make, and
   because the same board is about to appear on the chart details page without a dialog around
   it. *@
<MudDialog Visible="Visible" VisibleChanged="VisibleChanged" Options="DialogSizing" Class="cld-dialog">
    <TitleContent>
        <div class="weekly-lb-title">
            @if (_chart != null)
            {
                <DifficultyBubble Chart="_chart" Small="true"></DifficultyBubble>
                <MudText Typo="Typo.h6">@_chart.Song.Name</MudText>
            }
        </div>
    </TitleContent>
    <DialogContent>
        <ChartLeaderboardScopes ChartId="ChartId" Mix="Mix" InitialScope="InitialScope" Active="Visible"
                                ChartLoaded="OnChartLoaded"></ChartLeaderboardScopes>
    </DialogContent>
    <DialogActions>
        <MudSpacer/>
        <MudButton OnClick="() => VisibleChanged.InvokeAsync(false)">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly DialogOptions DialogSizing = new()
        { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public Guid ChartId { get; set; }
    [Parameter] public MixEnum Mix { get; set; } = MixEnum.Phoenix;

    /// <summary>
    ///     Which board to open on. A session score row passes CompetitivePeers — that is the
    ///     cohort its colour came from, so opening there makes the colour auditable instead of
    ///     asserted. A chart page would pass World.
    /// </summary>
    [Parameter]
    public ChartLeaderboardScopes.LeaderboardScope InitialScope { get; set; } =
        ChartLeaderboardScopes.LeaderboardScope.World;

    private Chart? _chart;

    // The board resolves the chart on its way to fetching; the title reads it back rather than
    // fetching the same row a second time.
    private void OnChartLoaded(Chart? chart)
    {
        _chart = chart;
        StateHasChanged();
    }
}
