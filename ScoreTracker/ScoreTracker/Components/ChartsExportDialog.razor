@using MediatR
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Contracts
@namespace ScoreTracker.Web.Components
@inject IUiSettingsAccessor UiSettings
@inject NavigationManager NavManager
@inject IMediator Mediator

@* The export dialog (docs/design/charts-srp.md §2 Export): full column freedom lives
   HERE, not on the page. Downloads the entire filtered set via the CSV endpoint, which
   reuses the page's own query-string contract. *@
<MudDialog Visible="Visible" VisibleChanged="VisibleChanged" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Export charts"]</MudText>
    </TitleContent>
    <DialogContent>
        <div class="srp-export">
            <MudText Typo="Typo.body2" Class="srp-export-count">@L["{0} charts · current filters", TotalCount.ToString("N0")]</MudText>
            @foreach (var (group, keys) in VisibleGroups)
            {
                <div class="srp-export-grp">
                    <MudText Typo="Typo.overline">@L[group]</MudText>
                    <button type="button" class="srp-export-all" @onclick="() => ToggleGroup(keys)">
                        @L["All {0}", keys.Count]
                    </button>
                </div>
                <div class="srp-export-columns">
                    @foreach (var key in keys)
                    {
                        var captured = key;
                        var selected = _columns.Contains(captured);
                        <span class="srp-badge-opt tier-chart-card-skill @(selected ? "srp-badge-opt-sel" : "")"
                              role="button" tabindex="0" @onclick="() => ToggleColumn(captured)">
                            @(selected ? "✓ " : string.Empty)@L[ColumnLabel(captured)]
                        </span>
                    }
                </div>
            }
            @if (_metricNames.Count > 0)
            {
                <div class="srp-export-grp">
                    <MudText Typo="Typo.overline">@L["piucenter columns"]</MudText>
                    <button type="button" class="srp-export-all" @onclick="ToggleAllBundles">
                        @L["All {0}", BundleColumnCount]
                    </button>
                </div>
                <div class="srp-export-columns">
                    @foreach (var bundle in ChartExport.Bundles)
                    {
                        var captured = bundle;
                        var count = captured.Expand(_metricNames).Count;
                        if (count == 0) continue;
                        var selected = _columns.Contains(captured.Key);
                        @* Same two classes as a column chip — tier-chart-card-skill is where the
                           rounding comes from, and omitting it left these square.
                           srp-export-bundle carries no styling; it is the hook the tests select on. *@
                        <span class="srp-badge-opt tier-chart-card-skill srp-export-bundle @(selected ? "srp-badge-opt-sel" : "")"
                              role="button" tabindex="0" @onclick="() => ToggleColumn(captured.Key)">
                            @(selected ? "✓ " : string.Empty)@L[BundleLabel(captured.Key)]
                            <span class="srp-export-mult">×@count</span>
                        </span>
                    }
                </div>
                <MudText Typo="Typo.caption" Class="srp-export-unstable">
                    @L["These come straight from piucenter. Header names can change when their data changes."]
                </MudText>
            }
            <MudText Typo="Typo.caption" Class="srp-export-file">@FileName · @L["{0} columns", _selectedCount]</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => VisibleChanged.InvokeAsync(false)">@L["Close"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                   Href="@ExportUrl" Target="_top" Disabled="_selectedCount == 0">@L["Download CSV"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string ColumnsSettingKey = "Charts__Export__Columns";

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public IReadOnlyDictionary<string, object?> FilterParameters { get; set; } = new Dictionary<string, object?>();
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public MixEnum Mix { get; set; }
    [Parameter] public bool SignedIn { get; set; }

    private HashSet<string> _columns = new(ChartExport.DefaultColumns, StringComparer.OrdinalIgnoreCase);

    /// <summary>
    ///     Group membership only — which of a group's keys are offered is
    ///     <see cref="ChartExport.ColumnsFor" />'s call, so the picker and the endpoint can
    ///     never disagree about what a mix carries.
    /// </summary>
    private static readonly (string Group, string[] Keys)[] Groups =
    {
        ("Chart columns", new[]
        {
            "ChartId", "Song", "ChartUrl", "Artist", "StepArtist", "Type", "PlayerCount", "Level",
            "Mix", "DebutMix", "LegacyDifficulty", "SongType", "BPM", "DurationSeconds", "NoteCount",
            "NPS", "Badges"
        }),
        ("Community columns", new[]
        {
            "PassDifficulty", "ScoreDifficulty", "CommunityVote", "ScoringLevel", "CommunityVoteRating",
            "ScoreCount", "PgCount"
        }),
        ("My columns", new[]
        {
            "Pumbility", "MyPhoenixScore", "MyPhoenixGrade", "MyPhoenixPlate", "MyLegacyGrade", "MyLegacyScore",
            "MyPerfects", "MyGreats", "MyGoods", "MyBads", "MyMisses", "MyMaxCombo", "MyPlayCount", "MyBroken", "MyRecordedOn"
        })
    };

    private IReadOnlyList<(string Group, IReadOnlyList<string> Keys)> VisibleGroups
    {
        get
        {
            var offered = ChartExport.ColumnsFor(Mix).Select(c => c.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
            return Groups
                .Where(g => g.Group != "My columns" || SignedIn)
                .Select(g => (g.Group, (IReadOnlyList<string>)g.Keys.Where(offered.Contains).ToArray()))
                .Where(g => g.Item2.Count > 0)
                .ToArray();
        }
    }

    /// <summary>Catalog metric names, for the family counts. Cached behind the query.</summary>
    private IReadOnlyList<string> _metricNames = Array.Empty<string>();

    private int BundleColumnCount => ChartExport.Bundles.Sum(b => b.Expand(_metricNames).Count);

    protected override async Task OnInitializedAsync()
    {
        _metricNames = ChartExport.ExportableMetricNames(
            await Mediator.Send(new GetChartMetricNamesQuery()));
        var savedColumns = await UiSettings.GetSetting(ColumnsSettingKey);
        if (!string.IsNullOrWhiteSpace(savedColumns))
            _columns = savedColumns.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private async Task ToggleColumn(string key)
    {
        if (!_columns.Remove(key)) _columns.Add(key);
        await UiSettings.SetSetting(ColumnsSettingKey, string.Join(',', _columns));
    }

    /// <summary>All-or-none for a group: anything unticked means the press ticks the rest.</summary>
    private async Task ToggleGroup(IReadOnlyList<string> keys)
    {
        if (keys.All(_columns.Contains)) _columns.ExceptWith(keys);
        else _columns.UnionWith(keys);
        await UiSettings.SetSetting(ColumnsSettingKey, string.Join(',', _columns));
    }

    private async Task ToggleAllBundles()
    {
        var keys = ChartExport.Bundles.Select(b => b.Key).ToArray();
        if (keys.All(_columns.Contains)) _columns.ExceptWith(keys);
        else _columns.UnionWith(keys);
        await UiSettings.SetSetting(ColumnsSettingKey, string.Join(',', _columns));
    }

    internal static string BundleLabel(string key)
    {
        return key switch
        {
            "ChartAnalysis" => "Chart analysis",
            "SkillEmphasis" => "Skill emphasis",
            "TopSkills" => "Top-3 skills",
            "PracticeRanks" => "Practice ranks",
            "ChartEnding" => "Chart ending",
            "RarePatterns" => "Rare patterns",
            _ => key
        };
    }

    private string FileName => $"charts_{ChartSlugs.MixSlug(Mix)}.csv";

    private string ExportUrl
    {
        get
        {
            var parameters = new Dictionary<string, object?>(FilterParameters)
            {
                ["Mix"] = Mix.ToString(),
                ["Columns"] = string.Join(',', OrderedColumns),
                ["Page"] = null
            };
            return NavManager.GetUriWithQueryParameters(NavManager.ToAbsoluteUri("/Charts/Export.csv").ToString(),
                parameters);
        }
    }

    /// <summary>What the file will actually carry — the picks this mix offers, not every pick held.</summary>
    private int _selectedCount =>
        ChartExport.ColumnsFor(Mix).Count(c => _columns.Contains(c.Key))
        + ChartExport.Bundles.Where(b => _columns.Contains(b.Key)).Sum(b => b.Expand(_metricNames).Count);

    /// <summary>Registry order, so the file's column order is stable regardless of click order.</summary>
    private IEnumerable<string> OrderedColumns =>
        ChartExport.ColumnsFor(Mix).Where(c => _columns.Contains(c.Key)).Select(c => c.Key)
            .Concat(ChartExport.Bundles.Where(b => _columns.Contains(b.Key)).Select(b => b.Key));

    internal static string ColumnLabel(string key)
    {
        return key switch
        {
            "ChartId" => "Chart ID",
            "ChartUrl" => "Chart URL",
            "PlayerCount" => "Player count",
            "StepArtist" => "Step Artist",
            "DebutMix" => "Debut mix",
            "LegacyDifficulty" => "Legacy Difficulty",
            "SongType" => "Song Type",
            "DurationSeconds" => "Duration (seconds)",
            "NoteCount" => "Note Count",
            "PassDifficulty" => "Pass Difficulty",
            "ScoreDifficulty" => "Score Difficulty",
            "CommunityVote" => "Community Vote",
            "ScoringLevel" => "Scoring level",
            "CommunityVoteRating" => "Community Vote rating",
            "ScoreCount" => "Score count",
            "PgCount" => "PG count",
            "Pumbility" => "PUMBILITY",
            "MyPhoenixScore" => "My Phoenix score",
            "MyPhoenixGrade" => "My Phoenix grade",
            "MyPhoenixPlate" => "My Phoenix plate",
            "MyLegacyGrade" => "My legacy grade",
            "MyLegacyScore" => "My legacy score",
            "MyPerfects" => "My Perfects",
            "MyGreats" => "My Greats",
            "MyGoods" => "My Goods",
            "MyBads" => "My Bads",
            "MyMisses" => "My Misses",
            "MyMaxCombo" => "My max combo",
            "MyPlayCount" => "My play count",
            "MyBroken" => "My broken flag",
            "MyRecordedOn" => "My recorded date",
            _ => key
        };
    }
}
