@namespace ScoreTracker.Web.Components.ChartComments
@using MediatR
@using ScoreTracker.ChartComments.Contracts
@using ScoreTracker.ChartComments.Contracts.Commands
@using ScoreTracker.ChartComments.Contracts.Queries
@using ScoreTracker.Communities.Contracts.Queries
@using ScoreTracker.Domain.Exceptions
@using ScoreTracker.Domain.SecondaryPorts
@using System.Globalization
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Services.Contracts
@inject IMediator Mediator
@inject IUiSettingsAccessor UiSettings
@inject ICurrentUserAccessor CurrentUser
@inject ISnackbar Snackbar

@* The Comments tab: scope rail, sort, composer, thread. The rail is the audience picker —
   it filters what you read AND decides what you post to, so "which community am I posting
   to" is answered by where you are standing rather than by a second control. *@

@if (_scopes.Count > 1)
{
    <div class="cld-scopes" role="tablist">
        @foreach (var scope in _scopes)
        {
            var s = scope;
            <button type="button" class="@ScopeClass(s)" data-testid="@($"cmt-scope-{s.Label}")"
                    @onclick="() => SelectScope(s)">@s.Label</button>
        }
    </div>
}

@* The tab is gated on `IsAdmin || ChartComments:Enabled`, so the site admin sees it while the
   flag is off and everyone else does not. That is easy to mistake for the flag being on — say so
   rather than leave it to be inferred from a config file. *@
@if (AdminPreview)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" data-testid="cmt-admin-preview">
        @L["Comments are switched off. You can see this tab because you're the site admin — nobody else has it."]
    </MudAlert>
}

<LinkInterstitial Url="@_pendingLink" OnDismiss="() => _pendingLink = null"></LinkInterstitial>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="my-2"></MudProgressLinear>
}
else
{
    @* No sort control on Notes: with no votes there is only one order. *@
    @if (!IsNotes && (_page.TotalRoots > 1 || ReadInLocales.Count > 0))
    {
        <div class="cmt-subbar">
            @if (_page.TotalRoots > 1)
            {
                <span>@L["Sort"]</span>
                <MudSelect T="CommentSort" Value="_sort" ValueChanged="SelectSort" Dense="true" Margin="Margin.Dense"
                           Variant="Variant.Outlined" Class="cmt-sort" data-testid="cmt-sort">
                    <MudSelectItem Value="CommentSort.Top">@L["Top"]</MudSelectItem>
                    <MudSelectItem Value="CommentSort.Newest">@L["Newest"]</MudSelectItem>
                </MudSelect>
            }
            @if (ReadInLocales.Count > 0)
            {
                @* The sticky pick, owner-worded: choosing a localization is remembered and
                   becomes this reader's default wherever a rendering exists; choosing Original
                   clears it. It replaces the language-mapping step only — a comment in the
                   reader's own language stays the original whatever is picked here. *@
                <span class="cmt-subbar-right">@L["Read in"]</span>
                <MudSelect T="string" Value="@(_preferredLocale ?? string.Empty)" ValueChanged="SelectReadIn"
                           Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="cmt-sort"
                           data-testid="cmt-read-in">
                    <MudSelectItem Value="@string.Empty">@L["Original"]</MudSelectItem>
                    @foreach (var locale in ReadInLocales)
                    {
                        <MudSelectItem Value="@locale">@RenderingLocaleName(locale)</MudSelectItem>
                    }
                </MudSelect>
            }
        </div>
    }

    @if (CurrentUser.IsLoggedIn)
    {
        @if (!CanPostHere)
        {
            @* A mute or the account lock. The chip stays and the thread reads normally —
               reading is never revoked — but the composer is a sentence, not a field. Which
               gate it is stays unsaid on purpose: the answer lives with whoever imposed it. *@
            <div class="cmt-cannot-post" data-testid="cmt-cannot-post">@L["You can't post here right now."]</div>
        }
        else if (_consent.NeedsAnything)
        {
            @* Rendered where the composer goes rather than as a dialog over this one: a
               MudDialog inside a MudDialog orphans its scrim and leaves the page unclickable. *@
            <CommentRulesCard NeedsTerms="_consent.NeedsTerms"
                              NeedsPublicIdentityConsent="_consent.NeedsPublicIdentityConsent"
                              OnAccepted="AcceptTerms"></CommentRulesCard>
        }
        else
        {
            <CommentComposer Placeholder="@(IsNotes ? L["Add a note…"] : L["Add a comment…"])"
                             SubmitLabel="@(IsNotes ? L["Save note"] : L["Comment"])"
                             AudienceNote="@AudienceNote" AvatarUrl="@AvatarUrl" ShowAvatar="!IsNotes"
                             TestId="cmt-root-composer" OnSubmit="Post"></CommentComposer>
        }
    }

    @if (_page.Roots.Count == 0)
    {
        <div class="cmt-empty">@EmptyText</div>
    }

    @foreach (var root in _page.Roots)
    {
        @if (_editing == root.Id)
        {
            @EditComposer(root)
        }
        else
        {
            <CommentRow Comment="root" IsNote="IsNotes" CanInteract="CurrentUser.IsLoggedIn"
                        CanWrite="CanPostHere"
                        IsFocused="@(FocusCommentId == root.Id)" Confirming="ConfirmingFor(root.Id)"
                        Reporting="@(_reporting == root.Id)"
                        OnVote="Vote" OnReply="StartReply" OnEdit="StartEdit" OnDelete="AskToDelete"
                        OnRemove="AskToRemove" OnConfirm="Confirmed" OnCancelConfirm="() => _confirming = null"
                        OnReport="StartReport" OnReportSubmit="SubmitReport"
                        OnCancelReport="() => _reporting = null"
                        OnUntrustedLink="ShowInterstitial" @key="root.Id"></CommentRow>
        }
        @if (_replyingTo == root.Id)
        {
            <CommentComposer Reply="true" StartOpen="true" Placeholder="@L["Reply…"]"
                             SubmitLabel="@L["Reply"]" AvatarUrl="@AvatarUrl"
                             TestId="cmt-reply-composer" OnSubmit="@(text => Reply(root.Id, text))"
                             OnCancel="() => _replyingTo = null"></CommentComposer>
        }
        @foreach (var reply in root.Replies)
        {
            @if (_editing == reply.Id)
            {
                @EditComposer(reply, true)
            }
            else
            {
                <CommentRow Comment="reply" IsReply="true" CanInteract="CurrentUser.IsLoggedIn"
                            CanWrite="CanPostHere"
                            IsFocused="@(FocusCommentId == reply.Id)" Confirming="ConfirmingFor(reply.Id)"
                            Reporting="@(_reporting == reply.Id)"
                            OnVote="Vote" OnEdit="StartEdit" OnDelete="AskToDelete" OnRemove="AskToRemove"
                            OnConfirm="Confirmed" OnCancelConfirm="() => _confirming = null"
                            OnReport="StartReport" OnReportSubmit="SubmitReport"
                            OnCancelReport="() => _reporting = null"
                            OnUntrustedLink="ShowInterstitial" @key="reply.Id"></CommentRow>
            }
        }
    }

    @* Not pagination — a bound on the first render. Replies are never truncated, because a
       conversation missing its answer is worse than a long page. *@
    @if (_page.HasMore)
    {
        <div class="cmt-more">
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ShowMore"
                       data-testid="cmt-show-more">@L["Show more comments"]</MudButton>
        </div>
    }
}

<style>
    /* Scoped to this render tree on purpose — everything below is rendered by this component
       or one of its children, so nothing else can pick these class names up unstyled. */
    .cmt-subbar {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .74rem;
        color: var(--mud-palette-text-secondary);
        padding: 4px 0 8px;
    }

    .cmt-sort {
        max-width: 130px;
    }

    /* The composer is a LINE, not a box. Its resting state is the field itself. */
    .cmt-compose {
        display: grid;
        grid-template-columns: 28px minmax(0, 1fr);
        gap: 10px;
        align-items: start;
        padding: 2px 0 10px;
    }

    .cmt-compose-reply {
        padding-left: 40px;
    }

    /* No avatar means no avatar column. Leaving the 28px track in place puts the field in it,
       which is what the Notes composer was doing — one character wide, buttons stacked. */
    .cmt-compose-bare {
        grid-template-columns: minmax(0, 1fr);
    }

    .cmt-compose-main {
        min-width: 0;
    }

    .cmt-line {
        width: 100%;
        border: none;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        background: none;
        color: var(--mud-palette-text-primary);
        font: inherit;
        font-size: .85rem;
        padding: 5px 2px;
        resize: none;
        outline: none;
    }

    .cmt-line-open {
        border-bottom-width: 2px;
        border-bottom-color: var(--mud-palette-text-primary);
    }

    .cmt-compose-foot {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
    }

    .cmt-count,
    .cmt-posting-as {
        font-size: .7rem;
        color: var(--mud-palette-text-secondary);
    }

    .cmt {
        display: grid;
        grid-template-columns: 34px minmax(0, 1fr);
        gap: 10px;
        padding: 11px 0;
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    /* A note has no author to show, so it drops the avatar column entirely. That is 44px back
       on a phone, and it makes a note unmistakable for a comment at a glance. */
    .cmt-note {
        grid-template-columns: minmax(0, 1fr);
    }

    /* Absolutely positioned rail: a static ::before inside a grid container becomes a THIRD
       grid item against two columns, which wraps the body onto its own row. */
    .cmt-reply {
        padding-left: 40px;
        position: relative;
    }

    .cmt-reply::before {
        content: "";
        position: absolute;
        left: 20px;
        top: 0;
        bottom: 0;
        width: 2px;
        border-radius: 1px;
        background: var(--mud-palette-lines-default);
    }

    .cmt-avatar,
    .cmt-avatar img {
        width: 34px;
        height: 34px;
        border-radius: 50%;
    }

    .cmt-avatar {
        display: grid;
        place-items: center;
        overflow: hidden;
        background: var(--mud-palette-background-gray);
    }

    .cmt-avatar-sm,
    .cmt-avatar-sm img {
        width: 28px;
        height: 28px;
    }

    .cmt-avatar img {
        object-fit: cover;
    }

    .cmt-avatar-gone {
        opacity: .35;
    }

    .cmt-main {
        min-width: 0;
    }

    .cmt-head {
        display: flex;
        align-items: baseline;
        gap: 7px;
        flex-wrap: wrap;
        margin-bottom: 3px;
    }

    .cmt-name {
        font-weight: 600;
        font-size: .82rem;
    }

    .cmt-badge {
        font-size: .62rem;
        letter-spacing: .04em;
        padding: 1px 7px;
        border-radius: 999px;
        border: 1px solid var(--mud-palette-lines-default);
        color: var(--mud-palette-text-secondary);
        white-space: nowrap;
    }

    .cmt-badge-tr {
        border-color: var(--mud-palette-info);
        color: var(--mud-palette-info);
    }

    .cmt-badge-q {
        border-color: var(--mud-palette-warning);
        color: var(--mud-palette-warning);
    }

    .cmt-subbar-right {
        margin-left: auto;
    }

    .cmt-meta {
        font-size: .7rem;
        color: var(--mud-palette-text-secondary);
    }

    /* A 500-character comment can be one 300-character URL. Without this it decides the
       dialog's width and the whole thing scrolls sideways on a phone. */
    .cmt-body {
        font-size: .85rem;
        overflow-wrap: anywhere;
    }

    .cmt-link {
        color: var(--mud-palette-primary);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    /* Marked before the click, not only on the way out. */
    .cmt-link-untrusted {
        color: var(--mud-palette-secondary);
    }

    .cmt-link-untrusted::after {
        content: " ⚠";
        font-size: .85em;
    }

    .cmt-foot {
        display: flex;
        align-items: center;
        gap: 2px;
        margin-top: 5px;
    }

    .cmt-act {
        appearance: none;
        background: none;
        border: none;
        font: inherit;
        font-size: .72rem;
        color: var(--mud-palette-text-secondary);
        padding: 3px 7px;
        border-radius: 5px;
        cursor: pointer;
    }

    .cmt-act:hover:not(:disabled) {
        color: var(--mud-palette-text-primary);
        background: var(--mud-palette-action-default-hover);
    }

    .cmt-act-on {
        color: var(--mud-palette-warning);
    }

    .cmt-act:disabled {
        cursor: default;
        opacity: .55;
    }

    /* The comment a moderation queue row named. A left bar rather than a background wash: it
       survives a theme that has no spare surface colour, and it does not fight the reply rail. */
    .cmt-focused {
        border-left: 3px solid var(--mud-palette-primary);
        padding-left: 10px;
    }

    /* Under the comment, not over it. Error-coloured because removal is the one thing on this
       surface that takes somebody else's words off the page. */
    .cmt-confirm {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 7px;
        padding: 7px 10px;
        border-radius: 6px;
        border: 1px solid var(--mud-palette-error);
        background: var(--mud-palette-error-hover);
        font-size: .78rem;
    }

    .cmt-confirm-sub {
        width: 100%;
        font-size: .7rem;
        color: var(--mud-palette-text-secondary);
    }

    .cmt-removed {
        font-size: .78rem;
        font-style: italic;
        color: var(--mud-palette-text-secondary);
    }

    .cmt-empty,
    .cmt-more {
        padding: 18px 4px;
        text-align: center;
        font-size: .78rem;
        color: var(--mud-palette-text-secondary);
    }

    /* Where the composer would be, when the reader cannot post here: a sentence, not a field. */
    .cmt-cannot-post {
        padding: 8px 2px 12px;
        font-size: .78rem;
        font-style: italic;
        color: var(--mud-palette-text-secondary);
    }

    .cmt-rules {
        border-top: 1px solid var(--mud-palette-lines-default);
        padding: 12px 0 4px;
    }

    .cmt-rules-preamble {
        color: var(--mud-palette-text-secondary);
        margin-bottom: 10px;
    }

    .cmt-rules ol {
        margin: 0;
        padding-left: 20px;
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .cmt-rules b {
        display: block;
    }

    .cmt-rules-foot {
        display: flex;
        justify-content: flex-end;
        margin-top: 12px;
    }
</style>

@code {
    private const int PageSize = 20;

    // Far past any plausible single-chart, single-scope volume — the whole site's steady state
    // is a few hundred comments a month. A bound, not pagination: the focus flow is
    // moderation-only and must land.
    private const int FocusTake = 500;

    private bool _initialScopeApplied;

    private CommentPageRecord _page = new(Array.Empty<CommentRecord>(), 0, false);
    private IReadOnlyList<CommentScopeRecord> _scopes = Array.Empty<CommentScopeRecord>();
    private CommentConsentRecord _consent = new(false, false);
    private CommentAudience _audience = CommentAudience.Public;
    private CommentSort _sort = CommentSort.Top;
    private Guid? _replyingTo;
    private Guid? _reporting;
    private (Guid Id, CommentRow.CommentAction Action)? _confirming;
    private Guid _editing = Guid.Empty;
    private string? _editingText;
    private int _take = PageSize;
    private bool _loading = true;
    private (Guid Chart, CommentAudience Audience, CommentSort Sort, int Take)? _loadedFor;

    [Parameter] public Guid ChartId { get; set; }

    /// <summary>False while this sits behind a tab nobody selected, so it issues no reads.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>
    ///     True when the only reason this tab exists is that the reader is the site admin — the
    ///     launch flag is still off and nobody else has it.
    /// </summary>
    [Parameter] public bool AdminPreview { get; set; }

    /// <summary>
    ///     Opens on the comment a moderation queue row named. Arriving with one also raises the
    ///     first page's root bound: the focused comment is typically fresh — few votes, sorted
    ///     last under Top — and a highlight that renders below the fold of a truncated page is a
    ///     highlight that does not exist.
    /// </summary>
    [Parameter] public Guid? FocusCommentId { get; set; }

    /// <summary>
    ///     The scope to open standing in. The moderation queue passes the reported comment's
    ///     community — every row there is a community comment by construction, and without this
    ///     the tab would open on Public, where the focused comment is not.
    /// </summary>
    [Parameter] public CommentAudience? InitialAudience { get; set; }

    private string? _pendingLink;

    /// <summary>The sticky Read-in pick. Empty-or-missing means default behavior.</summary>
    private const string ReadInSettingKey = "Comments__ReadIn";

    private string? _preferredLocale;
    private bool _readInLoaded;

    private bool IsNotes => _audience.IsPrivate;

    /// <summary>
    ///     The picker's vocabulary: every rendering the page actually holds. Empty threads and
    ///     all-own-language threads offer no picker, which is most of them.
    /// </summary>
    private IReadOnlyList<string> ReadInLocales => _page.Roots
        .SelectMany(root => root.Replies.Prepend(root))
        .Where(comment => comment.Translation != null)
        .SelectMany(comment => comment.Translation!.AvailableLocales)
        .Distinct()
        .OrderBy(locale => locale, StringComparer.Ordinal)
        .ToArray();

    private async Task SelectReadIn(string value)
    {
        var picked = string.IsNullOrEmpty(value) ? null : value;
        if (picked == _preferredLocale) return;

        _preferredLocale = picked;
        // Choosing the original clears the memory — back to default behavior; choosing a
        // localization is remembered sitewide (owner-worded, 2026-08-24).
        await UiSettings.SetSetting(ReadInSettingKey, picked ?? string.Empty);
        await Reload();
    }

    private static string RenderingLocaleName(string locale)
    {
        try
        {
            return CultureInfo.GetCultureInfo(locale).NativeName;
        }
        catch (CultureNotFoundException)
        {
            return locale;
        }
    }

    private void ShowInterstitial(string? url)
    {
        _pendingLink = url;
    }

    private string? AvatarUrl => CurrentUser.IsLoggedIn ? CurrentUser.User.ProfileImage.ToString() : null;

    private string AudienceNote => IsNotes
        ? L["Only you can see this"]
        : L["Posting to {0} as {1}", ScopeLabel, CurrentUser.User.Name.ToString()];

    /// <summary>
    ///     Three empty states, because three different things are true: your notes are private and
    ///     that is worth saying up front, a signed-in reader can do something about the silence, and
    ///     a signed-out one cannot.
    /// </summary>
    private string EmptyText
    {
        get
        {
            if (IsNotes) return L["Notes you write here are only ever visible to you."];

            return CurrentUser.IsLoggedIn
                ? L["Nothing here yet. Share what you know about this chart."]
                : L["Nothing here yet."];
        }
    }

    private string ScopeLabel =>
        _scopes.FirstOrDefault(s => s.Audience == _audience)?.Label.ToString() ?? L["Public"].Value;

    /// <summary>
    ///     Whether the reader may post where they are standing — a mute in this club, or the
    ///     account lock anywhere public. True for a scope we have no record of, which is the
    ///     signed-out reader who gets no composer anyway.
    /// </summary>
    private bool CanPostHere => _scopes.FirstOrDefault(s => s.Audience == _audience)?.CanPost ?? true;

    private string ScopeClass(CommentScopeRecord scope)
    {
        return scope.Audience == _audience ? "cld-chip cld-chip-on" : "cld-chip";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Active) return;
        if (!_initialScopeApplied)
        {
            _initialScopeApplied = true;
            if (InitialAudience is { } initial) _audience = initial;
            // A focus target must be on the first page or the anchor marks nothing.
            if (FocusCommentId != null) _take = FocusTake;
        }

        if (!_readInLoaded)
        {
            _readInLoaded = true;
            if (CurrentUser.IsLoggedIn)
            {
                var stored = await UiSettings.GetSetting(ReadInSettingKey);
                _preferredLocale = string.IsNullOrWhiteSpace(stored) ? null : stored;
            }
        }

        if (_scopes.Count == 0 && CurrentUser.IsLoggedIn)
        {
            _scopes = await Mediator.Send(new GetMyCommentScopesQuery());
            await AddModeratorScopeIfNeeded();
        }

        var key = (ChartId, _audience, _sort, _take);
        if (_loadedFor == key) return;
        _loadedFor = key;
        await Load();
    }

    /// <summary>
    ///     The moderator's chip. The site admin arrives from /Admin/Comments standing in a club they
    ///     need not belong to, so the rail has no chip for it — this adds one, read-only, labeled
    ///     with the club's name. Read-only because reading is what the open report grants; the
    ///     admin is not a member and does not post there. Anyone else handed a foreign audience
    ///     gets nothing extra: the read query already refuses what they may not see.
    /// </summary>
    private async Task AddModeratorScopeIfNeeded()
    {
        if (InitialAudience is not { Kind: CommentAudienceKind.Community, CommunityId: { } clubId })
            return;
        if (!CurrentUser.User.IsAdmin || _scopes.Any(s => s.Audience == InitialAudience)) return;

        var names = await Mediator.Send(new GetCommunityNamesQuery(new[] { clubId }));
        var label = names.TryGetValue(clubId, out var name) ? name : Name.From("Community");
        _scopes = _scopes.Append(new CommentScopeRecord(InitialAudience.Value, label, CanPost: false)).ToArray();
    }

    private async Task Load()
    {
        _loading = true;
        _consent = await Mediator.Send(new GetCommentConsentQuery(_audience));
        // The reader's language is the request's culture — the vertical judges by language and
        // never sees a region's difference; the sticky pick rides beside it.
        _page = await Mediator.Send(new GetChartCommentsQuery(ChartId, _audience, _sort, _take,
            CultureInfo.CurrentUICulture.Name, _preferredLocale));
        _loading = false;
    }

    private async Task SelectScope(CommentScopeRecord scope)
    {
        if (scope.Audience == _audience) return;
        _audience = scope.Audience;
        // A new audience is a new conversation: the reply box and the page bound both reset,
        // and Top is meaningless on Notes so it falls back to the only order there is.
        _replyingTo = null;
        _take = PageSize;
        if (_audience.IsPrivate) _sort = CommentSort.Newest;
        await Reload();
    }

    private async Task SelectSort(CommentSort sort)
    {
        if (_sort == sort) return;
        _sort = sort;
        await Reload();
    }

    private async Task ShowMore()
    {
        _take += PageSize;
        await Reload();
    }

    private async Task Reload()
    {
        _loadedFor = (ChartId, _audience, _sort, _take);
        await Load();
    }

    private Task Post(string text)
    {
        return Dispatch(new PostCommentCommand(ChartId, _audience, text));
    }

    private Task Reply(Guid rootId, string text)
    {
        _replyingTo = null;
        return Dispatch(new ReplyToCommentCommand(rootId, text));
    }

    private void StartReply(CommentRecord comment)
    {
        _replyingTo = _replyingTo == comment.Id ? null : comment.Id;
    }

    private void StartReport(CommentRecord comment)
    {
        _reporting = _reporting == comment.Id ? null : comment.Id;
    }

    /// <summary>
    ///     Reporting reloads nothing — the thread looks exactly the same afterwards, which is the
    ///     point: nothing about a report is advertised, including that one happened.
    /// </summary>
    private async Task SubmitReport((CommentRecord Comment, CommentReportReason Reason, string? ViewedLocale) request)
    {
        _reporting = null;
        try
        {
            await Mediator.Send(new ReportCommentCommand(request.Comment.Id, request.Reason,
                request.ViewedLocale));
        }
        catch (CommentNotAllowedException exception)
        {
            Snackbar.Add(exception.Message, Severity.Warning);
            return;
        }

        Snackbar.Add(L["Thanks — a moderator will take a look."].Value, Severity.Success);
    }

    /// <summary>
    ///     Swaps the row for a composer holding the words as they stand. The text comes back through
    ///     its own author-gated query rather than riding on the render record, so the only raw
    ///     comment string Web ever holds is one it asked for by name and is about to put in a
    ///     textarea.
    /// </summary>
    private async Task StartEdit(CommentRecord comment)
    {
        _editingText = await Mediator.Send(new GetMyCommentTextQuery(comment.Id));
        // Null means it is not yours, or no longer there. Either way there is nothing to open.
        _editing = _editingText == null ? Guid.Empty : comment.Id;
    }

    private RenderFragment EditComposer(CommentRecord comment, bool reply = false)
    {
        return @<CommentComposer Reply="reply" StartOpen="true" InitialText="@_editingText"
                                 Placeholder="@L["Add a comment…"]" SubmitLabel="@L["Save"]"
                                 AvatarUrl="@AvatarUrl" ShowAvatar="!IsNotes" TestId="cmt-edit-composer"
                                 OnSubmit="@(text => SaveEdit(comment.Id, text))"
                                 OnCancel="CancelEdit"></CommentComposer>;
    }

    private Task SaveEdit(Guid commentId, string text)
    {
        _editing = Guid.Empty;
        _editingText = null;

        return Dispatch(new EditCommentCommand(commentId, text));
    }

    private void CancelEdit()
    {
        _editing = Guid.Empty;
        _editingText = null;
    }

    private Task Vote(CommentRecord comment)
    {
        return Dispatch(new VoteOnCommentCommand(comment.Id, !comment.ViewerVoted));
    }

    /// <summary>
    ///     Both destructive actions ask first, and ask on the row rather than in a dialog over it.
    ///     Nothing is sent until the second tap.
    /// </summary>
    private void AskToDelete(CommentRecord comment)
    {
        _confirming = (comment.Id, CommentRow.CommentAction.Delete);
    }

    private void AskToRemove(CommentRecord comment)
    {
        _confirming = (comment.Id, CommentRow.CommentAction.Remove);
    }

    private Task Confirmed((CommentRecord Comment, CommentRow.CommentAction Action) request)
    {
        _confirming = null;

        return request.Action == CommentRow.CommentAction.Remove
            ? Dispatch(new RemoveCommentCommand(request.Comment.Id))
            : Dispatch(new DeleteCommentCommand(request.Comment.Id));
    }

    private CommentRow.CommentAction? ConfirmingFor(Guid commentId)
    {
        return _confirming is { } pending && pending.Id == commentId ? pending.Action : null;
    }

    private Task AcceptTerms(bool consentedToPublicIdentity)
    {
        return Dispatch(new AcceptCommentTermsCommand(consentedToPublicIdentity));
    }

    /// <summary>
    ///     One place that sends and reloads. A domain refusal is written to be read by a player,
    ///     so its message is the message — anything else would be an exception string on a
    ///     player's screen, which DiagnosticExposureTests exists to prevent.
    /// </summary>
    // Generic rather than taking IRequest: with the parameter typed as the interface, MediatR
    // binds Send<IRequest> and the concrete command type is erased at the call. The handler is
    // still resolved by runtime type either way, but nothing downstream can see what was sent.
    private async Task Dispatch<TRequest>(TRequest request) where TRequest : IRequest
    {
        try
        {
            await Mediator.Send(request);
        }
        catch (CommentNotAllowedException exception)
        {
            Snackbar.Add(exception.Message, Severity.Warning);
            return;
        }

        await Reload();
    }

    private async Task Dispatch<TResponse>(IRequest<TResponse> request)
    {
        try
        {
            await Mediator.Send(request);
        }
        catch (CommentNotAllowedException exception)
        {
            Snackbar.Add(exception.Message, Severity.Warning);
            return;
        }

        await Reload();
    }
}
