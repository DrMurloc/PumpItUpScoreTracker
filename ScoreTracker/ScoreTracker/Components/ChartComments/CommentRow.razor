@namespace ScoreTracker.Web.Components.ChartComments
@using System.Globalization
@using ScoreTracker.ChartComments.Contracts

@* One comment, reply or note. Which controls appear IS the permission model: ▲ and Reply for
   anyone signed in, ⋯ with Edit/Delete on your own and Report on everybody else's, 🛡 only
   for a moderator, and nothing at all on a stub. A note drops the avatar entirely — every one
   of them is yours, so the column is 44px of nothing, and losing it makes a note unmistakable
   for a comment at a glance. *@

<div class="cmt @(IsReply ? "cmt-reply" : null) @(IsNote ? "cmt-note" : null) @(IsFocused ? "cmt-focused" : null)"
     data-testid="@($"comment-{Comment.Id}")" id="@($"comment-{Comment.Id}")">
    @if (!IsNote)
    {
        <div class="cmt-avatar">
            @if (Comment.Deletion != null || Comment.AuthorImage == null)
            {
                <span class="cmt-avatar-gone">?</span>
            }
            else
            {
                <img src="@Comment.AuthorImage" alt="" loading="lazy"/>
            }
        </div>
    }
    <div class="cmt-main">
        @if (Comment.Deletion is { } deletion)
        {
            <span class="cmt-removed">@StubText(deletion)</span>
        }
        else
        {
            <div class="cmt-head">
                @if (!IsNote)
                {
                    <span class="cmt-name">@Comment.AuthorName</span>
                }
                <span class="cmt-meta">@Ago(Comment.CreatedAt)</span>
                @if (Comment.EditedAt != null)
                {
                    <span class="cmt-meta">@L["(edited)"]</span>
                }
                @if (Comment.Translation is { BodyIsTranslated: true } translated)
                {
                    <span class="cmt-badge cmt-badge-tr" data-testid="@($"translated-{Comment.Id}")">
                        @(_showOriginal
                            ? L["Original"]
                            : L["Translated from {0}", LanguageName(translated.SourceLanguage)])
                    </span>
                }
                else if (Comment.Translation is { Pending: true })
                {
                    <span class="cmt-badge cmt-badge-q" data-testid="@($"queued-{Comment.Id}")">@L["Queued for translation"]</span>
                }
                @if (IsNote)
                {
                    <MudSpacer></MudSpacer>
                    @Menu()
                }
            </div>
            <div class="cmt-body">
                <CommentTextView Body="DisplayBody" OnUntrustedLink="OnUntrustedLink"></CommentTextView>
            </div>
            @* Asked in place, under the comment rather than over it: the whole question is
               whether THIS is the one you meant, and a modal that covers it cannot answer that.
               Inline also keeps us out of the dialog-inside-a-dialog scrim trap. *@
            @if (Confirming is { } confirming)
            {
                <div class="cmt-confirm" data-testid="@($"confirm-{Comment.Id}")">
                    <span>@(confirming == CommentAction.Remove ? L["Remove this comment?"] : L["Delete this comment?"])</span>
                    <MudSpacer></MudSpacer>
                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               OnClick="() => OnCancelConfirm.InvokeAsync()">@L["Cancel"]</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                               data-testid="@($"confirm-go-{Comment.Id}")"
                               OnClick="() => OnConfirm.InvokeAsync((Comment, confirming))">
                        @(confirming == CommentAction.Remove ? L["Remove"] : L["Delete"])
                    </MudButton>
                    <span class="cmt-confirm-sub">
                        @(confirming == CommentAction.Remove
                            ? L["It stops showing, and the thread keeps its shape. The author is not told."]
                            : L["It stops showing. Anyone who replied keeps their reply."])
                    </span>
                </div>
            }
            else if (Reporting)
            {
                <CommentReportPanel CommentId="Comment.Id"
                                    OnSubmit="reason => OnReportSubmit.InvokeAsync((Comment, reason, ViewedLocale))"
                                    OnCancel="() => OnCancelReport.InvokeAsync()"></CommentReportPanel>
            }
            else if (!IsNote)
            {
                <div class="cmt-foot">
                    @* Your own count is inert rather than a button: you cannot vote on your own,
                       and a control that refuses every click is worse than a number. *@
                    <button type="button" class="cmt-act @(Comment.ViewerVoted ? "cmt-act-on" : null)"
                            disabled="@(!CanVote)" data-testid="@($"vote-{Comment.Id}")"
                            aria-label="@L["Helpful"]" @onclick="() => OnVote.InvokeAsync(Comment)">
                        ▲ @Comment.Votes
                    </button>
                    @if (CanReply)
                    {
                        <button type="button" class="cmt-act" data-testid="@($"reply-{Comment.Id}")"
                                @onclick="() => OnReply.InvokeAsync(Comment)">@L["Reply"]</button>
                    }
                    @if (Comment.Translation is { BodyIsTranslated: true })
                    {
                        @* Transient by design: the flip lasts as long as the render. The sticky
                           choice is the thread's Read-in picker, never this. *@
                        <button type="button" class="cmt-act" data-testid="@($"show-original-{Comment.Id}")"
                                @onclick="() => _showOriginal = !_showOriginal">
                            @(_showOriginal ? L["Show translation"] : L["Show original"])
                        </button>
                    }
                    <MudSpacer></MudSpacer>
                    @if (Comment.ViewerMayModerate)
                    {
                        @* The shield IS the permission — nobody without it renders one, and it is
                           computed per comment now: the site admin everywhere, a creator over
                           admins and members, a flag-holding admin over members. Remove and only
                           remove: there is no moderator edit, deliberately. *@
                        <MudMenu Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Dense="true"
                                 Color="Color.Primary" AriaLabel="@L["Moderate"]">
                            <MudMenuItem OnClick="() => OnRemove.InvokeAsync(Comment)">@L["Remove comment"]</MudMenuItem>
                        </MudMenu>
                    }
                    @if (Comment.ViewerIsAuthor)
                    {
                        @Menu()
                    }
                    else if (CanInteract)
                    {
                        @* Somebody else's words: the ⋯ carries Report and nothing else. *@
                        <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Dense="true"
                                 AriaLabel="@L["More"]" data-testid="@($"other-{Comment.Id}")">
                            <MudMenuItem OnClick="() => OnReport.InvokeAsync(Comment)">@L["Report"]</MudMenuItem>
                        </MudMenu>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    /// <summary>
    ///     The two destructive actions, and the only two that confirm. Voting, replying and editing
    ///     are reversible in one tap; asking about those would train the reflex that makes a confirm
    ///     useless by the time it matters.
    /// </summary>
    public enum CommentAction
    {
        Delete,
        Remove
    }

    [Parameter] [EditorRequired] public CommentRecord Comment { get; set; } = default;

    /// <summary>Set while this row is asking. The comment stays visible underneath it.</summary>
    [Parameter] public CommentAction? Confirming { get; set; }

    [Parameter] public EventCallback<(CommentRecord Comment, CommentAction Action)> OnConfirm { get; set; }

    [Parameter] public EventCallback OnCancelConfirm { get; set; }

    /// <summary>Set while this row's report panel is open — same in-place shape as the confirm.</summary>
    [Parameter] public bool Reporting { get; set; }

    [Parameter] public EventCallback<CommentRecord> OnReport { get; set; }

    [Parameter] public EventCallback<(CommentRecord Comment, CommentReportReason Reason, string? ViewedLocale)> OnReportSubmit { get; set; }

    [Parameter] public EventCallback OnCancelReport { get; set; }

    /// <summary>A reply is indented and cannot itself be replied to — threads are one level.</summary>
    [Parameter] public bool IsReply { get; set; }

    /// <summary>A personal note: no author, no vote, no reply, no shield.</summary>
    [Parameter] public bool IsNote { get; set; }

    /// <summary>
    ///     The comment a moderation queue row named. Marked rather than scrolled to: an anchor is
    ///     what the row's id is for, and moving somebody's viewport is a bigger promise than
    ///     "this is the one".
    /// </summary>
    [Parameter] public bool IsFocused { get; set; }

    [Parameter] public bool CanInteract { get; set; }

    /// <summary>
    ///     Whether the reader may WRITE in this scope — false under a mute or the lock. Gates
    ///     Reply and the own-menu Edit, and only those: voting rides <see cref="CanInteract" />
    ///     (a vote is not content) and Delete always works. The server enforces the same line;
    ///     this keeps the row from offering a composer the submit would refuse.
    /// </summary>
    [Parameter] public bool CanWrite { get; set; } = true;

    [Parameter] public EventCallback<CommentRecord> OnVote { get; set; }
    [Parameter] public EventCallback<CommentRecord> OnReply { get; set; }
    [Parameter] public EventCallback<CommentRecord> OnEdit { get; set; }
    [Parameter] public EventCallback<CommentRecord> OnDelete { get; set; }
    [Parameter] public EventCallback<CommentRecord> OnRemove { get; set; }
    [Parameter] public EventCallback<string?> OnUntrustedLink { get; set; }

    private bool _showOriginal;

    private IReadOnlyList<CommentSpan> DisplayBody =>
        _showOriginal && Comment.Translation is { BodyIsTranslated: true } translation
            ? translation.OriginalBody
            : Comment.Body;

    /// <summary>
    ///     What this reader was actually looking at when they reported — the rendering's locale,
    ///     or null for the original (including a translated row they flipped back). Stamped on
    ///     the report because a moderator cannot judge a report against words they never saw.
    /// </summary>
    private string? ViewedLocale =>
        Comment.Translation is { BodyIsTranslated: true } viewed && !_showOriginal ? viewed.BodyLocale : null;

    /// <summary>
    ///     The badge names the language in itself — 한국어, not "Korean" — because the reader it
    ///     matters to is the one who recognises it. An unknown tag falls back to itself.
    /// </summary>
    private static string LanguageName(string? tag)
    {
        if (string.IsNullOrWhiteSpace(tag)) return string.Empty;
        try
        {
            return CultureInfo.GetCultureInfo(tag).NativeName;
        }
        catch (CultureNotFoundException)
        {
            return tag;
        }
    }

    private bool CanVote => CanInteract && !IsNote && !Comment.ViewerIsAuthor;

    private bool CanReply => CanInteract && CanWrite && !IsNote && !IsReply;

    private RenderFragment Menu()
    {
        return @<MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Dense="true"
                         AriaLabel="@L["More"]" data-testid="@($"own-{Comment.Id}")">
                   @if (CanWrite)
                   {
                       <MudMenuItem OnClick="() => OnEdit.InvokeAsync(Comment)">@L["Edit"]</MudMenuItem>
                   }
                   <MudMenuItem OnClick="() => OnDelete.InvokeAsync(Comment)">@L["Delete"]</MudMenuItem>
               </MudMenu>;
    }

    private string StubText(CommentDeletion deletion)
    {
        return deletion switch
        {
            // "a moderator" rather than naming the tier: the row cannot tell the site admin's
            // removal from a community admin's, and the author is not told either way.
            CommentDeletion.ByModerator => L["Removed by a moderator"],
            CommentDeletion.ByDeletedAccount => L["Comment from a deleted user"],
            _ => L["Deleted"]
        };
    }

    // Relative rather than absolute: "3 days ago" is what a reader wants from a conversation,
    // and it dodges having to decide whose timezone a comment happened in.
    private string Ago(DateTimeOffset at)
    {
        var elapsed = DateTimeOffset.UtcNow - at;
        if (elapsed < TimeSpan.FromMinutes(1)) return L["just now"];
        if (elapsed < TimeSpan.FromHours(1)) return L["{0}m ago", (int)elapsed.TotalMinutes];
        if (elapsed < TimeSpan.FromDays(1)) return L["{0}h ago", (int)elapsed.TotalHours];
        if (elapsed < TimeSpan.FromDays(30)) return L["{0}d ago", (int)elapsed.TotalDays];

        return at.ToString("yyyy-MM-dd");
    }
}
