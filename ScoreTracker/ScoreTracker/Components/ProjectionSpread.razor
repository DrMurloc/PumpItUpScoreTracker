@using ScoreTracker.Domain.Services
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Services.Theming
@namespace ScoreTracker.Web.Components

@* The folder laid out on what a player at this level would score, with the tier bands drawn
   behind it. The bands were always cut from a spread; this is the first surface that shows the
   spread they were cut from — which is the whole reason the breakdown page exists.

   The cuts come from TierListProcessor.StdDev, the same function the bucketing itself uses, so
   a band edge here can never sit somewhere the tier list disagrees with. *@
@if (Rows.Count == 0)
{
    return;
}

<div class="spread-scroll">
    <div class="spread">
        <div class="spread-regions" aria-hidden="true">
            @foreach (var band in Bands)
            {
                <span class="spread-region" style="left:@Pct(band.From)%;width:@(Pct(band.To) - Pct(band.From))%">
                    <i style="background:@ThemeScales.DifficultyColor(band.Category)"></i>
                    <b style="color:@ThemeScales.DifficultyColor(band.Category)">@L[TierNames[band.Category]]</b>
                </span>
                @if (band.To < High)
                {
                    <span class="spread-edge" style="left:@Pct(band.To)%"></span>
                }
            }
        </div>
        @foreach (var row in Rows)
        {
            var band = BandFor(row.Projected);
            <div class="spread-row">
                <span class="spread-name" role="button" tabindex="0" @onclick="() => Select(row.Chart)">
                    <span class="spread-jacket" style="background-image:url('@row.Chart.Song.ImagePath')"></span>
                    <span class="spread-title @(row.Mine == null ? "spread-unplayed" : "")">@row.Chart.Song.Name</span>
                </span>
                <span class="spread-track">
                    @* Unplayed keeps its position and colour and loses only its fill: the
                       projection is exactly as real there, and what is missing is the player's
                       marker, not the number. *@
                    @Marker(Pct(row.Projected), null,
                        @<span class="spread-shape @(row.Mine == null ? "spread-unplayed" : "")"
                               style="background:@ThemeScales.DifficultyColor(band);border-color:@ThemeScales.DifficultyColor(band)"></span>,
                        @<span class="spread-readout">
                            <span>@row.Projected.ToString("N0")</span>
                            <LetterGradeIcon Grade="@GradeOf(row.Projected)" Height="15"></LetterGradeIcon>
                            <span style="color:@ThemeScales.DifficultyColor(band)">@L[TierNames[band]]</span>
                        </span>)
                    @if (row.Mine != null)
                    {
                        var mine = (int)row.Mine.Value;
                        @* A score outside the projections' range keeps its row and loses its
                           position: the axis is the spread being explained, and letting one bad
                           score stretch it squashes every chart into a corner of the track. The
                           marker becomes an arrow at the edge so the row still reads as "off the
                           bottom" rather than "at the bottom". *@
                        var side = mine < Low ? "spread-off spread-off-left"
                            : mine > High ? "spread-off spread-off-right" : null;
                        @Marker(Math.Clamp(Pct(mine), 0, 100), "spread-mine " + side,
                            @<span class="spread-shape"></span>,
                            @<span class="spread-readout">
                                <span>@L["you {0}", mine.ToString("N0")]</span>
                                <LetterGradeIcon Grade="@GradeOf(mine)" Height="15"></LetterGradeIcon>
                                @if (side != null)
                                {
                                    <span class="spread-offnote">@L["off the scale"]</span>
                                }
                            </span>)
                    }
                </span>
            </div>
        }
    </div>
</div>

@code {

    /// <summary>One chart on the spread: what this level scores there, and what the player did.</summary>
    public sealed record SpreadRow(Chart Chart, int Projected, PhoenixScore? Mine);

    /// <summary>
    ///     Charts with a projection, hardest first. A chart no peer has played has no position on
    ///     this axis and belongs in the page's own not-enough-data list, not here.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<SpreadRow> Rows { get; set; } = Array.Empty<SpreadRow>();

    /// <summary>
    ///     The mix the scores were set in. Required because a score resolves to different letters
    ///     under Phoenix 2's floors, and there is deliberately no mix-less way to ask.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public MixEnum Mix { get; set; } = MixEnum.Phoenix;

    /// <summary>Raised when a row's jacket or title is clicked. The page owns the dialog.</summary>
    [Parameter]
    public EventCallback<Chart> ChartSelected { get; set; }

    private static readonly IReadOnlyDictionary<TierListCategory, string> TierNames =
        new Dictionary<TierListCategory, string>
        {
            [TierListCategory.Overrated] = "1+ Level Easier",
            [TierListCategory.VeryEasy] = "Very Easy",
            [TierListCategory.Easy] = "Easy",
            [TierListCategory.Medium] = "Medium",
            [TierListCategory.Hard] = "Hard",
            [TierListCategory.VeryHard] = "Very Hard",
            [TierListCategory.Underrated] = "1+ Level Harder"
        };

    private sealed record Band(TierListCategory Category, double From, double To);

    /// <summary>
    ///     The axis spans the PROJECTIONS and nothing else. It is the spread of those numbers
    ///     being explained, so a player's own score — which can sit a hundred thousand points
    ///     below the folder's floor — does not get to stretch it.
    /// </summary>
    private double Min => Rows.Min(r => (double)r.Projected);

    private double Max => Rows.Max(r => (double)r.Projected);

    // A little air at both ends so a dot at the extreme is not half off the track.
    private double Low => Min - (Max - Min) * 0.06;
    private double High => Max + (Max - Min) * 0.06;

    /// <summary>
    ///     The same cuts the tier list makes: mean ± ½σ, σ, 1½σ over the projections, via the
    ///     shared StdDev so the two cannot drift.
    /// </summary>
    private IReadOnlyList<Band> Bands
    {
        get
        {
            var values = Rows.Select(r => (double)r.Projected).ToArray();
            var mean = values.Average();
            var sd = TierListProcessor.StdDev(values, false);
            return new[]
            {
                new Band(TierListCategory.Underrated, Low, mean - 1.5 * sd),
                new Band(TierListCategory.VeryHard, mean - 1.5 * sd, mean - sd),
                new Band(TierListCategory.Hard, mean - sd, mean - sd / 2),
                new Band(TierListCategory.Medium, mean - sd / 2, mean + sd / 2),
                new Band(TierListCategory.Easy, mean + sd / 2, mean + sd),
                new Band(TierListCategory.VeryEasy, mean + sd, mean + 1.5 * sd),
                new Band(TierListCategory.Overrated, mean + 1.5 * sd, High)
            }.Where(b => b.To > Low && b.From < High)
                .Select(b => new Band(b.Category, Math.Max(b.From, Low), Math.Min(b.To, High)))
                .ToArray();
        }
    }

    private TierListCategory BandFor(int projected) =>
        Bands.FirstOrDefault(b => projected < b.To)?.Category ?? TierListCategory.Overrated;

    private double Pct(double value) => High - Low < 0.0001 ? 0 : (value - Low) / (High - Low) * 100.0;

    private PhoenixLetterGrade GradeOf(int score) => ((PhoenixScore)score).LetterGradeFor(Mix);

    private Task Select(Chart chart) =>
        ChartSelected.HasDelegate ? ChartSelected.InvokeAsync(chart) : Task.CompletedTask;

    /// <summary>
    ///     A marker and its readout. ShowOnClick as well as hover, because a phone has no hover
    ///     and the number is the only place the score lives now the value column is gone — a tap
    ///     opens it and it stays open.
    ///     <para>
    ///         MudTooltip renders through the popover provider, which does not exist in a static
    ///         render; the shape is the data and the readout is an affordance, so a static render
    ///         keeps the first and drops the second (same gate as DifficultyBubble).
    ///     </para>
    /// </summary>
    private RenderFragment Marker(double left, string? extraClass, RenderFragment shape, RenderFragment readout)
    {
        var css = string.IsNullOrEmpty(extraClass) ? "spread-marker" : "spread-marker " + extraClass;
        if (!RendererInfo.IsInteractive)
        {
            return @<span class="@css" style="left:@left%">@shape</span>;
        }

        // The wrapper is ours and the tooltip sits INSIDE it. Putting spread-marker on
        // MudTooltip's own root instead lands it on an element already carrying
        // .mud-tooltip-root{width:auto} and .mud-tooltip-inline{display:inline-block} — same
        // specificity, so the framework's width and display win and the marker collapses.
        return @<span class="@css" style="left:@left%">
                   <MudTooltip ShowOnClick="true" ShowOnFocus="true" Placement="Placement.Top">
                       <ChildContent>@shape</ChildContent>
                       <TooltipContent>@readout</TooltipContent>
                   </MudTooltip>
               </span>;
    }

}
