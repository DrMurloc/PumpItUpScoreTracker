@namespace ScoreTracker.Web.Components
@using ScoreTracker.Domain.Models
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.Domain.Records
@using ScoreTracker.SharedKernel.ValueTypes
@using ScoreTracker.Web.Enums

@* The tier list's chart card. Border language is owner-locked (design doc §4): solid
   success = passed, dashed info-blue = To-Do, dashed success = passed in another mix;
   precedence passed > To-Do > other-mix. Hue always pairs with the dash pattern or a
   printed value (rule 8). Compact is the jacket "sticker sheet" (rule 5); Table
   density is the page's job, not the card's. *@
@if (Density == UiDensity.Compact)
{
    <MudTooltip Text="@CompactTooltip" ShowOnFocus="true">
        <div class="tier-chart-card tier-chart-card-compact @StateClass" role="button" tabindex="0"
             @onclick="() => OnOpen.InvokeAsync(Chart.Id)">
            @* Single quotes on purpose: Blazor sets attributes via the DOM, so HTML
               entities like &quot; are never decoded and would corrupt the CSS. *@
            <div class="tier-chart-card-jacket tier-chart-card-compact-jacket"
                 style="background-image:url('@Chart.Song.ImagePath')">
                <div class="tier-chart-card-bubble">
                    <DifficultyBubble Chart="Chart" Height="18"></DifficultyBubble>
                </div>
                @if (TopRightDotColor != null)
                {
                    @* A caller-supplied mark in the lens dot's place, with its own word. *@
                    <span class="tier-chart-card-lens-dot" style="background:@TopRightDotColor" title="@TopRightDotTitle"></span>
                }
                else if (TierLabel != null)
                {
                    @* Lens tier when the section grouping isn't the lens; the tooltip
                       prints the word so the hue never travels alone (rule 8). *@
                    <span class="tier-chart-card-lens-dot" style="background:@TierColor"></span>
                }
                @if (CornerBadgeStart != null)
                {
                    <div class="tier-chart-card-corner-start tier-chart-card-corner @CornerBadgeStartClass">@CornerBadgeStart</div>
                }
                @if (CornerBadge != null)
                {
                    @* A printed value wins the corner over the grade icon: a caller that
                       supplies one is saying the number IS the card's reason for existing. *@
                    <div class="tier-chart-card-compact-grade tier-chart-card-corner @CornerBadgeClass">@CornerBadge</div>
                }
                else if (Score?.Score != null)
                {
                    <div class="tier-chart-card-compact-grade">
                        <LetterGradeIcon Grade="Score.Score.Value.LetterGradeFor(Chart.Mix)" IsBroken="Score.IsBroken" Height="16"></LetterGradeIcon>
                    </div>
                }
                else if (LegacyGrade != null)
                {
                    <div class="tier-chart-card-compact-grade">
                        <LetterGradeIcon LegacyGrade="LegacyGrade" IsBroken="Score?.IsBroken ?? false" Height="16"></LetterGradeIcon>
                    </div>
                }
            </div>
        </div>
    </MudTooltip>
}
else
{
<div class="tier-chart-card @StateClass" title="@StateTitle">
    <div class="tier-chart-card-jacket @(ShowPlay ? "tier-chart-card-jacket-playable" : null)" role="button" tabindex="0"
         @onclick="() => OnOpen.InvokeAsync(Chart.Id)"
         style="background-image:url('@Chart.Song.ImagePath')">
        <div class="tier-chart-card-bubble">
            <DifficultyBubble Chart="Chart" Small="true"></DifficultyBubble>
        </div>
        @if (ShowPlay)
        {
            @* Its own button, stacked over the jacket: opening details and watching the
               chart are different intents, and the video one has to be reachable by
               keyboard without going through the card. *@
            <button type="button" class="tier-chart-card-play" @onclick:stopPropagation="true"
                    @onclick="() => OnPlay.InvokeAsync(Chart.Id)"
                    aria-label="@L["Watch {0}", Chart.Song.Name]">
                <span class="tier-chart-card-play-glyph" aria-hidden="true"></span>
            </button>
        }
        @if (CornerBadge != null)
        {
            <div class="tier-chart-card-compact-grade tier-chart-card-corner @CornerBadgeClass">@CornerBadge</div>
        }
    </div>
    @* The strip that rides up onto the jacket, and the ONLY things allowed on it: what the
       chart is called and how you did on it. It reserves its height whether or not it has
       either, so a folder of cards stays aligned — and so that nothing else inherits the
       overlap by being first. It did: with song names switched off, the chip row and a lone
       tier word were landing on the album art, which says nothing at all over a picture
       (field test, 2026-08-26).
       Clickable for the same reason the jacket is, and for the 30px of jacket it covers —
       removing the info button left the art as the only way in, and a strip that swallowed
       clicks would have made a dead zone of its bottom edge. Deliberately NOT a button and
       not a tab stop: the jacket beside it already announces and operates this exact action,
       so a second one would be an unoperable duplicate in the reading order. *@
    <div class="tier-chart-card-head" @onclick="() => OnOpen.InvokeAsync(Chart.Id)">
        @if (ShowName)
        {
            <MudTooltip Text="@Chart.Song.Name.ToString()" ShowOnFocus="true">
                <MudText Typo="Typo.subtitle1" Class="tier-chart-card-name">@Chart.Song.Name</MudText>
            </MudTooltip>
        }
        @if (Score?.Score != null)
        {
            @* Own line always — short song names left the tooltip-wrapped name and the
               score sharing a row (owner, piucenter round 3).
               Grade over plate in one column with the number beside them, the treatment the
               player page's tables use: two 12px icons stack inside the height one 20px icon
               needed, so the line costs the card a third of what it did. Tooltip="false" is
               structural, not a preference — the stack lays out its direct children, and
               MudTooltip's wrapper would hide them from the grid. *@
            <div class="tier-chart-card-scoreline">
                <span class="sbd-score-stack">
                    <ScoreBreakdown Score="Score.Score.Value" IsBroken="Score.IsBroken" Mix="Chart.Mix" OneLine="true"
                                    ShowScore="true" Tooltip="false" Height="12"
                                    Plate="Score.Plate" Ranking="Ranking"></ScoreBreakdown>
                </span>
            </div>
        }
        else if (LegacyGrade != null)
        {
            @* A legacy best is its letter and nothing else: no plate, no percentile, and no
               number, because an era score is note-count dependent and means nothing beside
               another chart's. ScoreBreakdown is built around the 1,000,000 scale. *@
            <div class="tier-chart-card-scoreline">
                <LetterGradeIcon LegacyGrade="LegacyGrade" IsBroken="Score?.IsBroken ?? false" Height="20"></LetterGradeIcon>
            </div>
        }
    </div>
    <div class="tier-chart-card-body">
        @if (TierLabel != null)
        {
            <MudText Typo="Typo.caption" Class="tier-chart-card-tier" Style="@($"color:{TierColor}")">@TierLabel</MudText>
        }
        @if (StepArtist != null)
        {
            <MudText Typo="Typo.caption" Class="tier-chart-card-meta">@StepArtist</MudText>
        }
        @if (AgeDays != null)
        {
            <MudText Typo="Typo.caption" Class="tier-chart-card-meta">@L["{0} days ago", AgeDays]</MudText>
        }
        @if (ShowProjectedScore)
        {
            @* Says whose number it is, because a bare score beside your own reads as a target
               somebody set for you. Null is printed as such — a chart nobody near your level has
               played has no projection, and filling that in would be inventing one. *@
            <MudText Typo="Typo.caption" Class="tier-chart-card-meta">
                @(ProjectedScore != null ? L["projected: {0}", ((int)ProjectedScore.Value).ToString("N0")] : L["projected: no data"])
            </MudText>
        }
        @if (Body != null)
        {
            <div class="tier-chart-card-extra">@Body</div>
        }
        @if (IdentityChipsOnly.Count > 0)
        {
            @* One row, no group headings and no cap (owner, 2026-08-26): two words of scaffolding
               around three chips cost more than they explained, and a "+2" told a player there was
               something else without telling them what. Every chip here is now a claim the chart
               earned against its own folder, so there is nothing left worth hiding behind a count;
               the named groups live on the chart page and dialog, where there is room to say which
               is which. *@
            <div class="tier-chart-card-skills">
                @foreach (var skill in IdentityChipsOnly)
                {
                    <span class="tier-chart-card-skill @skill.CategoryClass @(skill.IsIdentity ? "chip-identity" : null)">
                        @skill.Label@(skill.Metric == null ? null : $" {skill.Metric}")@if (skill.Parts is { Count: > 0 })
                        {
                            @* Each badge keeps its own family inside the shared chip, so merging
                               the hard-section pair costs no information. *@
                            <text>&#32;</text>
                            @for (var i = 0; i < skill.Parts.Count; i++)
                            {
                                @(i > 0 ? ", " : null)<span class="chip-part @skill.Parts[i].CategoryClass">@skill.Parts[i].Label</span>
                            }
                        }
                    </span>
                }
            </div>
        }
    </div>
    @* The info button went (owner, 2026-08-26): the jacket already opens details and now looks
       like it does, so the icon was a second control for the one thing the card mostly is. To-Do
       stays, because it is the one action the jacket does NOT do. *@
    @if (ShowToDo)
    {
        <div class="tier-chart-card-actions">
            <MudTooltip Text="@(IsToDo ? L["Remove from ToDo List"] : L["Add to ToDo List"])">
                <MudIconButton Size="Size.Small"
                               Icon="@(IsToDo ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                               Color="@(IsToDo ? Color.Info : Color.Default)"
                               OnClick="() => OnToDo.InvokeAsync(Chart.Id)"
                               aria-label="@L["To Do"]"></MudIconButton>
            </MudTooltip>
        </div>
    }
</div>
}

@code {

    [Parameter] public Chart Chart { get; set; } = null!;

    [Parameter] public RecordedPhoenixScore? Score { get; set; }

    /// <summary>
    ///     The best on a legacy mix, where the letter grade IS the score. Supplied instead of
    ///     a numeric Score, never alongside one — the two scoring models never share a mix.
    /// </summary>
    [Parameter] public XXLetterGrade? LegacyGrade { get; set; }

    [Parameter] public ScoreRankingRecord? Ranking { get; set; }

    [Parameter] public bool Passed { get; set; }

    [Parameter] public bool IsToDo { get; set; }

    [Parameter] public bool PassedInAnotherMix { get; set; }

    [Parameter] public bool ShowName { get; set; } = true;

    [Parameter] public bool ShowToDo { get; set; } = true;

    [Parameter] public UiDensity Density { get; set; } = UiDensity.Comfortable;

    // The active lens tier ("Hard", "Very Easy", …) when the page's grouping isn't the
    // lens itself; null hides the annotation. Color is a theme token reference.
    [Parameter] public string? TierLabel { get; set; }

    [Parameter] public string? TierColor { get; set; }

    /// <summary>
    ///     Compact only: a mark in the top-right corner with its word, for a caller whose
    ///     grouping is neither the lens nor nothing — the peers page's variability dot. Wins
    ///     the corner over the lens dot; a token reference, never a literal.
    /// </summary>
    [Parameter] public string? TopRightDotColor { get; set; }

    [Parameter] public string? TopRightDotTitle { get; set; }

    // Optional column info (the drawer's Display switches) — Comfortable only; the page
    // passes null in other densities.
    [Parameter] public string? StepArtist { get; set; }

    [Parameter] public IReadOnlyList<CardSkillChip>? Skills { get; set; }

    /// <summary>
    ///     CategoryClass carries the chip's badge family and its identity kind as site.css
    ///     classes; Metric is preformatted or null. <see cref="Parts" /> is set only for a chip
    ///     that names several badges at once — the hard-section chip — so each can keep its own
    ///     family colour inside the one chip.
    /// </summary>
    public sealed record CardSkillChip(string Label, string CategoryClass, string? Metric,
        bool IsIdentity = false, IReadOnlyList<CardSkillChipPart>? Parts = null);

    public sealed record CardSkillChipPart(string Label, string CategoryClass);

    /// <summary>
    ///     What the chart IS, and nothing else — all of it, uncapped. Features come off the card
    ///     entirely (owner, 2026-08-26): what a chart merely also has buys nothing a player
    ///     deciding what to play can use, and once they are gone the identity claims that remain
    ///     are few enough to print in full. The chart page and its dialog carry the full set,
    ///     named and grouped.
    ///     <para>
    ///         A chart with no identity therefore shows no chips at all, which is the honest
    ///         answer rather than a gap: plenty of charts are just charts.
    ///     </para>
    /// </summary>
    private IReadOnlyList<CardSkillChip> IdentityChipsOnly =>
        (Skills ?? Array.Empty<CardSkillChip>()).Where(s => s.IsIdentity).ToArray();

    [Parameter] public int? AgeDays { get; set; }

    /// <summary>
    ///     What players near this one's competitive level score here. Separate from the value so
    ///     "no projection" can render as a stated absence rather than the line vanishing, which
    ///     would read as the chart having no data at all.
    /// </summary>
    [Parameter]
    public bool ShowProjectedScore { get; set; }

    [Parameter] public PhoenixScore? ProjectedScore { get; set; }

    [Parameter] public EventCallback<Guid> OnToDo { get; set; }

    [Parameter] public EventCallback<Guid> OnOpen { get; set; }

    // A printed value in the jacket's bottom-right corner. Wins that slot over the grade
    // icon in Compact, and is the only thing a Compact card can say in words — so it is for
    // the number the list is RANKED by, not decoration.
    // The jacket's other bottom corner. Content rather than text, because what goes here is a
    // picture — the difficulty bubble owns the top edge, so the two badges share the bottom.
    [Parameter] public RenderFragment? CornerBadgeStart { get; set; }

    [Parameter] public string? CornerBadgeStartClass { get; set; }

    [Parameter] public string? CornerBadge { get; set; }

    /// <summary>A site.css modifier on the corner badge; the caller owns its meaning and its legend.</summary>
    [Parameter] public string? CornerBadgeClass { get; set; }

    // Extra body content under the name, above the skill chips. Comfortable only —
    // Compact renders no body at all.
    [Parameter] public RenderFragment? Body { get; set; }

    [Parameter] public bool ShowPlay { get; set; }

    [Parameter] public EventCallback<Guid> OnPlay { get; set; }

    // Appended to the Compact tooltip. Compact hides the body, so anything the card says
    // only in Comfortable has to be reachable here or it is lost (rule 7).
    [Parameter] public string? TooltipNote { get; set; }

    // A page that means something else by a border turns this off and paints nothing, rather
    // than fighting the class: PUMBILITY reads a border as which evidence a suggestion rests
    // on, so a To-Do ring there would be a fourth meaning competing with three.
    [Parameter] public bool ShowStateBorder { get; set; } = true;

    // A run that broke. Ranked below the two pass states on purpose: where a chart is both
    // attempted here and passed elsewhere, where the number came from is the more useful
    // thing to say. It earns a state of its own because the alternative is no border at all,
    // which reads as a chart nobody has ever seen the player touch.
    [Parameter] public bool Broke { get; set; }

    private string StateClass => !ShowStateBorder ? string.Empty :
        Passed ? "tier-chart-card-pass" :
        IsToDo ? "tier-chart-card-todo" :
        PassedInAnotherMix ? "tier-chart-card-other-mix" :
        Broke ? "tier-chart-card-broken" : string.Empty;

    private string? StateTitle => Passed ? L["Passed"] :
        IsToDo ? L["To Do"] :
        PassedInAnotherMix ? L["Passed in other mixes"] :
        Broke ? L["Played, not passed"] : null;

    // Compact hides the name, so the tooltip carries the identity (rule 7: no
    // truncation without a tooltip) plus the state and lens-tier words (rule 8).
    private string CompactTooltip
    {
        get
        {
            var suffix = string.Join(" — ", new[] { StateTitle, TierLabel, TooltipNote }.Where(p => p != null));
            return suffix.Length == 0
                ? $"{Chart.Song.Name} {Chart.DifficultyString}"
                : $"{Chart.Song.Name} {Chart.DifficultyString} — {suffix}";
        }
    }
}
