@using ScoreTracker.Catalog.Contracts
@using ScoreTracker.SharedKernel.Enums
@namespace ScoreTracker.Web.Components

@* The badge coverage bars — extracted from ChartDetailsDialog (one concept, one component)
   so the chart page and the dialog can never drift. These read the granular piucenter
   badges, the same vocabulary the similar-charts algorithm compares on: "Staggered
   Brackets 40%", not five kinds of twist averaged into one "Twists" bar
   (docs/design/nuke-old-skill-categories.md). Null coverage = a whole-chart quality
   (bursty, sustained): full bar, no number. No category tint — those buckets went with the
   rollup, and the printed name carries the meaning (rule 8). *@
@if (Chips != null && Chips.Count > 0)
{
    <div class="chart-details-skill-bars">
        @foreach (var chip in Chips.Take(Take))
        {
            var percent = chip.Coverage == null
                ? (int?)null
                : (int)Math.Round(chip.Coverage.Value * 100);
            <div class="chart-details-skill-bar">
                <span class="chart-details-skill-bar-label">@L[chip.DisplayName]</span>
                <span class="chart-details-skill-bar-track"><span class="chart-details-skill-bar-fill" style="width:@(percent ?? 100)%"></span></span>
                <span class="chart-details-skill-bar-value">@(percent == null ? "" : $"{percent}%")</span>
            </div>
        }
    </div>
    @if (ShowNote)
    {
        <MudText Typo="Typo.caption" Class="chart-details-skill-note">@L["Share of chart sections featuring each skill"]</MudText>
    }
}

<style>
    .chart-details-skill-bars {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 4px 16px;
        margin: 2px 0 8px;
    }

    .chart-details-skill-bar {
        display: grid;
        grid-template-columns: 92px 1fr 38px;
        align-items: center;
        gap: 8px;
        font-size: .75rem;
    }

    .chart-details-skill-bar-label {
        color: color-mix(in srgb, var(--skill-chip) 60%, var(--mix-ink));
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .chart-details-skill-bar-track {
        height: 5px;
        border-radius: 3px;
        background: color-mix(in srgb, var(--skill-chip) 14%, transparent);
        overflow: hidden;
    }

    .chart-details-skill-bar-fill {
        display: block;
        height: 100%;
        border-radius: 3px;
        background: var(--skill-chip);
    }

    .chart-details-skill-bar-value {
        text-align: right;
        color: var(--mix-ink-muted);
        font-variant-numeric: tabular-nums;
    }

    .chart-details-skill-note {
        display: block;
        color: var(--mix-ink-muted);
        margin-top: 2px;
    }
</style>

@code {
    [Parameter]
    public IReadOnlyList<ChartBadgeChipRecord>? Chips { get; set; }

    [Parameter]
    public int Take { get; set; } = 6;

    [Parameter]
    public bool ShowNote { get; set; } = true;
}
