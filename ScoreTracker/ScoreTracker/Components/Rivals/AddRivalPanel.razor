@using MediatR
@using ScoreTracker.Domain.Exceptions
@using ScoreTracker.Rivals.Contracts
@using ScoreTracker.Rivals.Contracts.Commands
@using ScoreTracker.Rivals.Contracts.Queries
@using ScoreTracker.SharedKernel.Enums
@namespace ScoreTracker.Web.Components.Rivals

@* TWO search fields, not one merged autocomplete. The site index and the board index are
   different populations with different rules, and merging them hides which one failed you
   (docs/design/rivals.md D19). *@
<MudCard Class="mt-3">
    <MudCardContent>
        <div class="sbd-section-head"><span class="sbd-eyebrow">@L["Add a rival"]</span></div>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="RivalCandidateRecord" Label="@L["Search players…"]"
                                 SearchFunc="SearchPlayers" ToStringFunc="@(c => c?.PlayerName ?? "")"
                                 ValueChanged="AddPlayer" ResetValueOnEmptyText="true"
                                 Clearable="true" Dense="true"/>
                <MudText Typo="Typo.caption" Class="dash-muted">
                    @L["Public players and your community members."]
                </MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="string" Label="@L["Search board tags…"]"
                                 SearchFunc="SearchTags" ValueChanged="AddTag"
                                 ResetValueOnEmptyText="true" Clearable="true" Dense="true"/>
                @* Departed tags are filtered out of the picker: offering one hands somebody a
                   permanently empty rivalry (D21). *@
                <MudText Typo="Typo.caption" Class="dash-muted">
                    @L["Tags on the current boards. Departed tags aren't listed."]
                </MudText>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@inject IMediator Mediator
@inject ISnackbar Snackbar
@code {
    [Parameter] public EventCallback OnAdded { get; set; }

    /// <summary>
    ///     Supplied by the host. This was a [CascadingParameter(Name = "Mix")] that nothing in
    ///     the app ever provided, so tag search always ran against Phoenix.
    /// </summary>
    [Parameter] public MixEnum CurrentMix { get; set; } = MixEnum.Phoenix;

    private Task<IEnumerable<RivalCandidateRecord>> SearchPlayers(string term, CancellationToken token) =>
        Abandonable<RivalCandidateRecord>(
            async () => await Mediator.Send(new SearchRivalCandidatesQuery(term), token), term, token);

    private Task<IEnumerable<string>> SearchTags(string term, CancellationToken token) =>
        Abandonable<string>(
            async () => await Mediator.Send(new SearchRivalTagsQuery(CurrentMix, term), token), term, token);

    // MudAutocomplete cancels the in-flight search the moment the next character arrives, so an
    // abandoned search is the normal case here, not a failure. It does not always arrive as an
    // OperationCanceledException: a cancelled SqlCommand surfaces as a provider error instead, and
    // catching by exception type would miss that and tear the circuit down mid-keystroke. The token
    // is the reliable signal — swallow only what this component already abandoned, and let a real
    // failure through to be reported.
    private static async Task<IEnumerable<T>> Abandonable<T>(Func<Task<IEnumerable<T>>> search,
        string term, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(term)) return Array.Empty<T>();
        try
        {
            return await search();
        }
        catch (Exception) when (token.IsCancellationRequested)
        {
            return Array.Empty<T>();
        }
    }

    private Task AddPlayer(RivalCandidateRecord? candidate) =>
        candidate == null ? Task.CompletedTask : Add(new AddRivalCommand(candidate.UserId, null),
            candidate.PlayerName);

    private Task AddTag(string? tag) =>
        string.IsNullOrWhiteSpace(tag) ? Task.CompletedTask : Add(new AddRivalCommand(null, tag), tag);

    private async Task Add(AddRivalCommand command, string name)
    {
        try
        {
            await Mediator.Send(command);
            Snackbar.Add(L["{0} added as a rival.", name].Value, Severity.Success);
            await OnAdded.InvokeAsync();
        }
        catch (RivalNotAvailableException e)
        {
            // Deliberately generic. A private stranger and somebody who blocked you look identical
            // from here, and both should — naming a block turns a quiet control into a
            // confrontation.
            Snackbar.Add(e.Message, Severity.Warning);
        }
    }
}
