@using ScoreTracker.Domain.SecondaryPorts
@using Microsoft.JSInterop
@namespace ScoreTracker.Web.Components
@implements IAsyncDisposable

@* The other half of rule 9. A skeleton says a shape is coming; this says what is being
   worked out and why it takes a moment, for the waits a page cannot shorten. It stands in
   for a whole region rather than one slot inside it — a card beside a pulsing block reads
   as a second thing still loading, next to the thing that is telling you so.

   Two lines with two owners, and that split is what makes it reusable: the flavour line
   knows nothing about the page, so it can never be wrong somewhere it was not written for,
   and the explanation comes from the page, so it is always specific. *@
<div class="patience-card">
    <div class="patience-pad @_pattern" aria-hidden="true" @ref="_pad">
        <i class="patience-panel patience-ul"></i>
        <i class="patience-panel patience-ur"></i>
        <i class="patience-panel patience-ct"></i>
        <i class="patience-panel patience-dl"></i>
        <i class="patience-panel patience-dr"></i>
    </div>
    <p class="patience-line">@_phrase</p>
    <p class="patience-sub">@Explanation</p>
</div>

@inject IRandomNumberGenerator Random
@inject IJSRuntime JSRuntime

@code {

    /// <summary>
    ///     What this page is working out, and why it takes a moment. Page-supplied, because
    ///     only the page can say it truthfully.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public string Explanation { get; set; } = string.Empty;

    // Arcade rather than software, and deliberately silent about what is computing — nothing
    // here claims a step that is happening, so the same twelve work on a tier list, an import,
    // or anything else that has to make somebody wait.
    private static readonly string[] Phrases =
    {
        "Applying baby powder",
        "Applying Gorilla Tape to the sensors",
        "Counting perfects",
        "Cueing the next song",
        "Feeding it another credit",
        "Finding the beat",
        "Reading the step chart",
        "Searching for Molex connectors",
        "Stretching first",
        "Waiting on the sensors",
        "Warming up the pad",
        "Wiping off the baby powder"
    };

    // Real step patterns rather than a decorative sweep (owner, 2026-08-08). Each begins and
    // ends on the bottom-left arrow, so the next one picks up mid-stride — which is what lets
    // js/patience.js swap them at the cycle boundary without the pad appearing to stop.
    //
    // This picks the FIRST one, on the server. That is not just an initial value: a pad whose
    // script never arrives keeps stepping a real chart, it simply repeats the one it was given.
    private static readonly string[] Patterns =
    {
        "patience-mrun", // up the left, through the middle, down the right, and back
        "patience-spin", // back to the centre between every corner
        "patience-run", // the ordinary way round
        "patience-cross" // every step lands on the far side
    };

    private string _phrase = string.Empty;
    private string _pattern = string.Empty;
    private ElementReference _pad;
    private IJSObjectReference? _module;

    // The phrase is drawn once per load and stays put: one that rotates while you wait pulls
    // your eye back to the thing you are waiting on. The pad is the opposite case — it is
    // already motion, so a new pattern every cycle is what it is for.
    protected override void OnInitialized()
    {
        _phrase = L[Phrases[Random.Next(Phrases.Length)]];
        _pattern = Patterns[Random.Next(Patterns.Length)];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/patience.js");
            await _module.InvokeVoidAsync("shuffleEachCycle", _pad);
        }
        catch (JSException)
        {
            // The pad keeps the pattern the server gave it and repeats that one. A loader is
            // not worth failing a render over.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module == null) return;

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit went first — the browser has already dropped the module with the page.
        }
    }

}
