@namespace ScoreTracker.Web.Components
@using System.Globalization
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Theming

@*
    One rung. Colour is never the only channel (UX rule 8): the state carries the fill, and a
    dashed edge marks a title only the official import can award.
*@
<button type="button"
        class="@CssClass"
        style="@Style"
        title="@Rung.Title.Name"
        aria-label="@Rung.Title.Name"
        @onclick="OnSelect">
    <span>@Label</span>
</button>

@code {
    [Parameter] [EditorRequired] public TitleRung Rung { get; set; } = default!;

    /// <summary>Wide rungs carry a name instead of a number — a capstone, a plate tier, a gem.</summary>
    [Parameter] public string? WideLabel { get; set; }

    /// <summary>
    ///     Filtered out. The rung stays in place rather than disappearing: a ladder with holes
    ///     punched through it stops reading as a ladder, and where your earned rungs sit on the
    ///     climb is the thing worth seeing.
    /// </summary>
    [Parameter] public bool Dimmed { get; set; }

    [Parameter] public EventCallback<TitleRung> OnSelected { get; set; }

    private string Label => WideLabel ?? Rung.Rung.ToString();

    private string CssClass
    {
        get
        {
            var state = Rung.State switch
            {
                RungState.Earned => "earned",
                RungState.Active => "active",
                _ => "locked"
            };
            var classes = $"title-pip {state}";
            if (WideLabel != null) classes += " wide";
            if (Rung.Official) classes += " official";
            if (Dimmed) classes += " dim";
            return classes;
        }
    }

    private string Style
    {
        get
        {
            var band = $"--band:{ThemeScales.CssVar(Rung.Band)};";
            // The fill height is the rung's own progress, measured from the rung below it.
            return Rung.State == RungState.Active
                ? band + $"--fill:{Math.Clamp(Math.Round(Rung.Fraction * 100), 6, 100).ToString(CultureInfo.InvariantCulture)}%;"
                : band;
        }
    }

    private async Task OnSelect()
    {
        await OnSelected.InvokeAsync(Rung);
    }

}
