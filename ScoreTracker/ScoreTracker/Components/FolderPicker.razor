@namespace ScoreTracker.Web.Components
@using ScoreTracker.SharedKernel.Enums

@* One control for one domain concept: a folder is (category, level). Picking both in a
   single gesture is what kills the S14→D18 double-load (design doc §4). Owns its
   popover deliberately — MudMenu closes on any interior click, but switching the
   folder must keep the panel open. *@
<div class="folder-picker">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="@(Disabled || !CanStep(-1))"
                   OnClick="() => Step(-1)" aria-label="@L["Previous Folder"]"></MudIconButton>
    <div class="folder-picker-anchor">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="Disabled"
                   StartIcon="@Icons.Material.Filled.Folder" OnClick="ToggleOpen"
                   aria-haspopup="true" aria-expanded="@(_open ? "true" : "false")">@FolderLabel</MudButton>
        <MudPopover Open="_open" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            <div class="folder-picker-pop">
                @* Re-created per open so the grid re-anchors on the current folder. *@
                @if (_open)
                {
                    <FolderGrid InitialCategory="Category" Mix="Mix" ShowCoOp="ShowCoOp"
                                IsSelected="(c, l) => c == Category && l == Level"
                                IsMissing="IsMissing"
                                LevelPicked="Pick"></FolderGrid>
                }
            </div>
        </MudPopover>
    </div>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="@(Disabled || !CanStep(1))"
                   OnClick="() => Step(1)" aria-label="@L["Next Folder"]"></MudIconButton>
</div>
@* Transparent click-away layer: below the popover (1200), above page content. *@
<MudOverlay Visible="_open" OnClick="() => _open = false" ZIndex="1199"></MudOverlay>

@code {
    private bool _open;

    [Parameter] public ChartTypeCategory Category { get; set; } = ChartTypeCategory.Double;

    /// <summary>Which mix's folders these are — it decides the tabs and what each one is called.</summary>
    [Parameter] public MixEnum Mix { get; set; } = MixEnum.Phoenix;

    // A null level is the unfiltered state ("All Folders") — only pages that filter
    // optionally pass it; the tier list always has a folder. Clearing back to null is
    // the caller's control, not this picker's.
    [Parameter] public int? Level { get; set; } = 18;

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Passed through to the grid — hosts without co-op data hide that tab.</summary>
    [Parameter] public bool ShowCoOp { get; set; } = true;

    /// <summary>
    ///     Which folders this host has nothing for (default: none of them). The steppers
    ///     respect it too — ◄ ► walk to the next folder that has something in it rather than
    ///     marching one level at a time through folders the grid greys out.
    /// </summary>
    [Parameter] public Func<ChartTypeCategory, int, bool> IsMissing { get; set; } = (_, _) => false;

    [Parameter] public EventCallback<(ChartTypeCategory Category, int Level)> FolderChanged { get; set; }

    private string FolderLabel => Level == null
        ? L["All Folders"]
        : FolderLabels.WithLevel(L, Category, Mix, Level.Value);

    private void ToggleOpen()
    {
        _open = !_open;
    }

    // Shared with the grid (FolderLevels): singles stop at 26, so ◄ ► can't step onto a
    // folder the grid won't show, and a deep-linked S27+ clamps back to 26.
    private static (int Min, int Max) Bounds(ChartTypeCategory category) => FolderLevels.Range(category);

    private int? NextEnabled(int direction)
    {
        if (Level == null) return null;
        var (min, max) = Bounds(Category);
        for (var target = Level.Value + direction; target >= min && target <= max; target += direction)
            if (!IsMissing(Category, target))
                return target;
        return null;
    }

    private bool CanStep(int direction)
    {
        return NextEnabled(direction) != null;
    }

    private async Task Step(int direction)
    {
        if (NextEnabled(direction) is not { } target) return;
        await FolderChanged.InvokeAsync((Category, target));
    }

    private async Task Pick((ChartTypeCategory Category, int Level) folder)
    {
        _open = false;
        var (min, max) = Bounds(folder.Category);
        await FolderChanged.InvokeAsync((folder.Category, Math.Clamp(folder.Level, min, max)));
    }
}
