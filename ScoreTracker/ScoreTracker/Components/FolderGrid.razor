@namespace ScoreTracker.Web.Components
@using ScoreTracker.SharedKernel.Enums

@* The difficulty selector's shared guts (one concept, one component): the folder tab row +
   the level grid. Tabs are internal state — the panel stays open across tab switches in
   every host.

   A folder is a category, not a chart type (docs/design/rise.md §3.1), and which folders a
   mix offers comes from its profile: RISE has singles and half-doubles, so it shows two tabs
   and the second one says H. DOUBLE.

   THIS IS A POPOVER CONTROL, like a date picker: it is opened from a button, it takes
   the picks, it closes. It is never chrome plopped onto a page — three tabs over a
   thirty-cell grid is a whole screen of controls, and inline it drowns whatever it was
   meant to help you configure. FolderPicker wraps it for single-pick navigation (tier
   lists); FolderLevelsConfigPanel wraps it behind "Select Folders" for multi-toggle.

   The randomizer's inline render predates the rule and is the one exception; it should
   move behind a button the next time that page is touched. *@
<div class="folder-grid">
    <MudButtonGroup OverrideStyles="false" Class="folder-picker-types">
        @foreach (var category in Categories)
        {
            var captured = category;
            <MudButton Variant="@TypeVariant(captured)" Color="Color.Primary" Size="Size.Small"
                       Disabled="@(!HasAny(captured))"
                       OnClick="() => _pendingCategory = captured">@FolderLabels.For(L, captured, Mix)</MudButton>
        }
    </MudButtonGroup>
    <div class="folder-picker-levels">
        @foreach (var level in LevelsFor(_pendingCategory))
        {
            var captured = level;
            var missing = IsMissing(_pendingCategory, captured);
            <button type="button" disabled="@(missing || IsDisabled(_pendingCategory, captured))"
                    class="folder-picker-level @(IsSelected(_pendingCategory, captured) ? "folder-picker-current" : null) @(missing ? "folder-picker-level-off" : null)"
                    @onclick="() => LevelPicked.InvokeAsync((_pendingCategory, captured))">@captured</button>
        }
    </div>
</div>

@code {
    private ChartTypeCategory _pendingCategory;

    /// <summary>The tab shown on first render (and after a host re-anchor).</summary>
    [Parameter] public ChartTypeCategory InitialCategory { get; set; } = ChartTypeCategory.Single;

    /// <summary>Which mix's folders these are — it decides the tabs and what each one is called.</summary>
    [Parameter] public MixEnum Mix { get; set; } = MixEnum.Phoenix;

    /// <summary>Hosts without co-op data (e.g. the popularity board) hide the CoOp tab.</summary>
    [Parameter] public bool ShowCoOp { get; set; } = true;

    /// <summary>Which (folder, level) cells render highlighted.</summary>
    [Parameter] public Func<ChartTypeCategory, int, bool> IsSelected { get; set; } = (_, _) => false;

    /// <summary>
    ///     Which folders this host has nothing for — the mix diff, where most folders
    ///     changed nothing. Distinct from <see cref="IsDisabled" /> on purpose: that is a
    ///     transient refusal and every cell can be refused at once, so it must never take a
    ///     tab away (you would be locked out of switching tabs to get back under the cap).
    ///     This one is structural, so a folder with nothing in it loses its tab and the grid
    ///     never opens onto a wall of dead cells.
    /// </summary>
    [Parameter] public Func<ChartTypeCategory, int, bool> IsMissing { get; set; } = (_, _) => false;

    /// <summary>Fired per tap; the host decides toggle-and-stay (multi) or pick-and-close (single).</summary>
    [Parameter] public EventCallback<(ChartTypeCategory Category, int Level)> LevelPicked { get; set; }

    /// <summary>
    ///     Which cells refuse a tap. A multi-select host at its cap greys the rest rather than
    ///     swallowing the click — a dead button that still looks live reads as a broken grid.
    /// </summary>
    [Parameter] public Func<ChartTypeCategory, int, bool> IsDisabled { get; set; } = (_, _) => false;

    private IReadOnlyList<ChartTypeCategory> Categories => ChartTypeCategories.CategoriesFor(Mix)
        .Where(c => ShowCoOp || c != ChartTypeCategory.CoOp).ToArray();

    private bool HasAny(ChartTypeCategory category)
    {
        return LevelsFor(category).Any(level => !IsMissing(category, level));
    }

    protected override void OnInitialized()
    {
        // Opening on a tab whose every level is disabled shows nothing pickable, so a
        // sparse host anchors on the first folder that actually has something in it. A mix
        // that does not have the requested folder at all (co-op on RISE) anchors too.
        var offered = Categories;
        _pendingCategory = offered.Contains(InitialCategory) && HasAny(InitialCategory)
            ? InitialCategory
            : offered.FirstOrDefault(HasAny, offered.FirstOrDefault(InitialCategory));
    }

    private Variant TypeVariant(ChartTypeCategory category)
    {
        return _pendingCategory == category ? Variant.Filled : Variant.Outlined;
    }

    // Singles cap at 26, doubles at the game ceiling, co-op at player counts — FolderLevels
    // is the shared source so this grid and the picker's stepper never disagree.
    private static IEnumerable<int> LevelsFor(ChartTypeCategory category) => FolderLevels.LevelsFor(category);
}
