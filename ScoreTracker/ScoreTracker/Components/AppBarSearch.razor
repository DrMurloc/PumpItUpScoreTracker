@namespace ScoreTracker.Web.Components
@using ScoreTracker.SharedKernel.Enums

@* The site search. An island: the shell around it is static HTML, but an autocomplete needs
   a circuit. Mounted twice — the app bar on desktop, the search sheet on mobile — because it
   is the same question in two places and the answer must not drift; the caller supplies the
   frame, SiteSearch owns the behaviour (charts, then players, then board players). *@
<div class="@Class" style="@Style">
    <SiteSearch Mix="Mix" Placeholder="@L["Find a chart or player"].Value"></SiteSearch>
</div>

@code {
    [Parameter] public MixEnum Mix { get; set; } = MixEnum.Phoenix;

    /// <summary>The frame is the caller's — an app-bar slot and a sheet want different boxes.</summary>
    [Parameter] public string Class { get; set; } = "d-flex align-center appbar-search mr-3 shell-desktop-only";

    /// <summary>
    ///     The desktop pill's width: elastic between the 170px it always had and 340px. It grew
    ///     when players joined the list — a name, a game tag and a row state need room — but the
    ///     app bar between 960px and about 1120px has no room to give: the nav's buttons cannot
    ///     shrink, so a hard floor above 170px pushed the mix pill and the avatar off the edge.
    ///     Grow into spare width, give it all back when the nav needs it.
    /// </summary>
    [Parameter] public string? Style { get; set; } = "flex: 1 1 200px; min-width: 170px; max-width: 340px;";
}
