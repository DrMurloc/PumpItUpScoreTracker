@using System.ComponentModel.DataAnnotations
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.Domain.Models
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.Domain.SecondaryPorts
@using ScoreTracker.SharedKernel.ValueTypes
@using Align = MudBlazor.Align
@namespace ScoreTracker.Web.Components

@* MudTooltip renders a popover, which throws in static SSR (no provider in the static tree).
   A static render falls back to a title attribute and keeps the avatar, the wash and the
   name; in a circuit the tooltip comes back. *@
@* The country is a faded underlay behind the avatar and the name, not an image in front of
   them. A 15px flag plus its gap cost ~26px of the name's room, which on a phone is most of
   it: the community rankings' Player column resolves to ~96px there, so a flagged player
   printed four letters and an ellipsis. The flag rides --label-flag as a background and the
   name keeps every pixel. The country's NAME moves into the tooltip beside the game tag,
   which is where it was always readable anyway — a 15px picture of a flag is not a label. *@
@* The avatar belongs to the label because the wash has to run under both, and a board that
   drew its own could not be washed without every caller re-deriving the same background.
   Size and shape stay the caller's: the challenge boards run 20px circles, the widgets 24px,
   and the community rankings a 26px square. *@
@* The label is a flex row that never outgrows its container, with the avatar pinned and the
   name the only part allowed to shrink. Left as loose inline content it truncates as one
   atomic box in any bounded row — the avatar takes the width and the name prints as a bare
   "…" for everyone who has one. *@
@if (User != null)
{
    <span class="@LabelClass" style="@FlagStyle">
        @if (ShowAvatar)
        {
            <img class="@AvatarClass" src="@User.ProfileImage" alt=""
                 loading="lazy" style="@($"--label-avatar-size:{AvatarSize}px")"/>
        }
        @if (RendererInfo.IsInteractive)
        {
            <MudTooltip Text="@Tooltip">
                <span class="user-label-name">@User.Name</span>
            </MudTooltip>
        }
        else
        {
            <span class="user-label-name" title="@(Tooltip.Length == 0 ? null : Tooltip)">@User.Name</span>
        }
    </span>
}
@inject IUserRepository Users
@code {
    [Parameter]
    [Required]
    public User? User { get; set; }

    /// <summary>Draw the player's avatar inside the label, so the country wash covers both.</summary>
    [Parameter]
    public bool ShowAvatar { get; set; }

    /// <summary>Avatar edge in px. Deliberately per-caller — the boards are not one size yet.</summary>
    [Parameter]
    public int AvatarSize { get; set; } = 20;

    /// <summary>The community rankings' avatar is a square; every other caller's is a circle.</summary>
    [Parameter]
    public bool SquareAvatar { get; set; }

    private string _countryImage = string.Empty;
    private Name? _loadedCountry;

    private string? FlagStyle => _countryImage.Length == 0 ? null : $"--label-flag:url('{_countryImage}')";

    private string LabelClass =>
        "user-label" + (_countryImage.Length == 0 ? "" : " has-flag") + (ShowAvatar ? " has-avatar" : "");

    private string AvatarClass => SquareAvatar ? "user-label-avatar square" : "user-label-avatar";

    // Game tag and country, joined. Either half can be missing: an account with no tag and no
    // country carries no tooltip at all, which is what it carried before the flag moved here.
    private string Tooltip
    {
        get
        {
            if (User == null) return string.Empty;
            var who = User.GameTag == null
                ? null
                : User.Name == "CLEARALL18SORQUIT"
                    ? L["Wouldn't You Like To Know"].Value
                    : User.GameTag.Value.ToString();
            var parts = new[] { who, User.Country?.ToString() }
                .Where(p => !string.IsNullOrWhiteSpace(p));
            return string.Join(" · ", parts);
        }
    }

    // Rendered in reused positions (board dialogs swap their row sets in place), so the wash
    // follows the CURRENT user: reload when the country changes, clear when it goes away.
    protected override async Task OnParametersSetAsync()
    {
        var country = User?.Country;
        if (Nullable.Equals(country, _loadedCountry)) return;
        _loadedCountry = country;
        // The port is nullable — a country without a flag image just renders no wash.
        _countryImage = country == null
            ? string.Empty
            : (await Users.GetCountryImage(country.Value))?.ToString() ?? string.Empty;
    }
}
