@namespace ScoreTracker.Web.Components
@using MediatR
@using ScoreTracker.Catalog.Contracts
@using ScoreTracker.Catalog.Contracts.Queries
@using ScoreTracker.ChartIntelligence.Contracts
@using ScoreTracker.ChartIntelligence.Contracts.Queries
@using ScoreTracker.Web.Services
@using ScoreTracker.SharedKernel.Enums
@using ScoreTracker.SharedKernel.Models
@using ScoreTracker.Web.Services.Theming
@inject IMediator Mediator

@* What the chart IS, extracted from ChartDetailsDialog: its history and its channel as rows,
   where the tier lists place it, what it is made of, and the way out to PIU Center. The
   identity — type, artists, BPM, notes — reads under the title in the dialog's header instead
   (docs/design/song-channels.md D10). It owns the reads that feed those — the verdict's
   history, placements, the alias key, and the badge chips — so a host that never shows this
   block never pays for them. *@
@if (Chart != null)
{
    <div class="chart-details-rows">
        @* The chart page's timeline as lines, in its words: the debut, every rerate with its
           mark, and the mix in view, each with the patch and date its row names. A mix where
           nothing changed is skipped, so a chart alive since 2000 is a few lines, not twenty-five. *@
        <div class="chart-details-row chart-details-row-history">
            <span class="chart-details-row-label">@L["History"]</span>
            <span class="chart-details-row-value">
                @foreach (var line in HistoryLines())
                {
                    <span class="chart-details-line">
                        <span class="chart-details-line-mix">@line.Mix.GetName()</span>
                        @if (line.Stamp != null)
                        {
                            <span class="chart-details-sep">·</span>@VersionStampText.Short(line.Stamp)
                        }
                        <span class="chart-details-sep">·</span>
                        @if (line.Kind == HistoryKind.Debut)
                        {
                            @L["debuted at {0}", Label(line.Level)]
                        }
                        else if (line.Kind == HistoryKind.Rerated)
                        {
                            @L["rerated {0}", Label(line.Level)]
                            <span class="chart-details-delta">@(line.Delta > 0 ? "▲" : "▼") @(line.Delta > 0 ? "+" : "")@line.Delta</span>
                        }
                        else
                        {
                            @L["unchanged · {0}", Label(line.Level)]
                        }
                    </span>
                }
            </span>
        </div>
        @* A filter as much as a fact, so the chip opens the chart search on it. Nothing when the
           mix has no row for the song. *@
        @if (Chart.Song.Channel is { } channel)
        {
            <div class="chart-details-row chart-details-row-channel">
                <span class="chart-details-row-label">@L["Channel"]</span>
                <span class="chart-details-row-value">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                             Href="@($"/Charts?Channel={channel}")">@L[channel.GetLabelKey()]</MudChip>
                </span>
            </div>
        }
        @* Two separate facts, because they answer different questions: how played this
           chart is across the whole mix, and how played it is against its own folder —
           a chart four hundredth overall can still be the most played thing in its
           folder. Both are piugame's play ranking, not this site's score counts. *@
        @if (OfficialPlace != null || OfficialFolderPlace != null)
        {
            <div class="chart-details-row chart-details-row-played">
                <span class="chart-details-row-label">@L["Played"]</span>
                <span class="chart-details-row-value">
                    @if (OfficialPlace != null)
                    {
                        <span class="chart-details-line">@L["Popularity overall"]<span class="chart-details-sep">·</span>@L["#{0}", OfficialPlace.Value.ToString("N0")]</span>
                    }
                    @if (OfficialFolderPlace != null)
                    {
                        <span class="chart-details-line">@L["Popularity in {0}", Chart.DifficultyString]<span class="chart-details-sep">·</span>@L["#{0}", OfficialFolderPlace.Value.ToString("N0")]</span>
                    }
                </span>
            </div>
        }
    </div>
    @if (_placements.Any())
    {
        <div class="chart-details-placements">
            @foreach (var placement in _placements)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Style="@($"color:{placement.Color};border-color:{placement.Color}")">@placement.Label</MudChip>
            }
        </div>
    }
    @* The same chips the chart page and the tier-list cards show, at dialog scale — one concept,
       one component, so a chart cannot look like a different chart depending on where you opened
       it. Coverage bars used to stand here; a percentage only reads against the folder the reader
       cannot see from a dialog, which is the comparison the chips have already done (owner,
       2026-08-26). The crux line went with them: it is the "Hardest Ns" chip in longer words.
       A pre-crawl chart shows nothing rather than falling back to the rollup tags — an arbitrary
       "Technical" is worse than silence (docs/design/nuke-old-skill-categories.md). *@
    <IdentityChipGroups Chips="_identityChips"></IdentityChipGroups>
    <MudText Typo="Typo.overline">@L["Charts like this"]</MudText>
    <SimilarChartsCompactGrid ChartId="Chart.Id" Mix="Mix" Active="Active"
                              OnChartSelected="OnSimilarChartSelected"></SimilarChartsCompactGrid>
    <MudLink Href="@PiuCenterUrl" Target="_blank" Typo="Typo.caption" Class="chart-details-piucenter">@L["View full chart on PIU Center"]</MudLink>
}

<style>
    /* Rows, not tiles: a short label column and one run of values per row, hairlines between.
       Eight labelled tiles read as a wall and stacked sixteen lines deep inside a phone's dialog
       (owner, round 3); the label column stays narrow enough for the 278px a phone leaves. */
    .chart-details-rows {
        display: flex;
        flex-direction: column;
        margin-bottom: 8px;
    }

    .chart-details-row {
        display: grid;
        grid-template-columns: 64px minmax(0, 1fr);
        gap: 10px;
        padding: 6px 0;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        align-items: baseline;
    }

    .chart-details-row:first-child {
        padding-top: 2px;
    }

    .chart-details-row:last-child {
        border-bottom: 0;
    }

    .chart-details-row-label {
        color: var(--mud-palette-text-secondary);
        font-size: .68rem;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .chart-details-row-value {
        font-size: .88rem;
        min-width: 0;
    }

    .chart-details-line {
        display: block;
    }

    .chart-details-line-mix {
        font-weight: 500;
    }

    .chart-details-sep {
        opacity: .55;
        margin: 0 5px;
    }

    /* The page's timeline mark, in the ramp's hard color whichever way the level moved. */
    .chart-details-delta {
        margin-left: 4px;
        color: var(--diff-hard);
        font-weight: 800;
        font-size: .8rem;
        white-space: nowrap;
    }

    .chart-details-placements, .chart-details-skills {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin: 8px 0;
    }

    .chart-details-piucenter {
        display: inline-block;
        margin-top: 8px;
    }

    .chart-details-crux {
        display: block;
        color: var(--mud-palette-text-secondary);
        margin: 4px 0 2px;
    }
</style>

@code {
    private enum HistoryKind
    {
        Debut,
        Rerated,
        Unchanged
    }

    /// <summary>One line of the History row: a mix, the patch its row names, and what the level did there.</summary>
    private sealed record HistoryLine(MixEnum Mix, VersionStamp? Stamp, HistoryKind Kind, int Level, int Delta);

    [Parameter] public Chart? Chart { get; set; }

    [Parameter] public MixEnum Mix { get; set; } = MixEnum.Phoenix;

    /// <summary>
    ///     The chart's place on piugame's play ranking for the whole mix, and its place among
    ///     the charts of its own folder. Optional: a caller that has not fetched the official
    ///     board leaves both null and neither line renders. Not this site's Popularity sort,
    ///     which counts scores recorded here.
    /// </summary>
    [Parameter] public int? OfficialPlace { get; set; }

    [Parameter] public int? OfficialFolderPlace { get; set; }

    /// <summary>
    ///     Set false by a host that renders this behind a tab nobody has selected, so a panel
    ///     out of sight issues none of its reads.
    /// </summary>
    [Parameter] public bool Active { get; set; } = true;

    /// <summary>
    ///     Raised when a similar chart is tapped. Passed straight through from the grid — this
    ///     panel has no opinion about what opening one means, and its host does.
    /// </summary>
    [Parameter] public EventCallback<Chart> OnSimilarChartSelected { get; set; }

    private Guid _loadedChartId = Guid.Empty;
    private string? _externalKey;
    private HistoryVerdict? _history;
    private IReadOnlyList<(string Label, string Color)> _placements = Array.Empty<(string, string)>();
    private IReadOnlyList<TierListChartCard.CardSkillChip> _identityChips =
        Array.Empty<TierListChartCard.CardSkillChip>();

    protected override async Task OnParametersSetAsync()
    {
        if (!Active || Chart == null || Chart.Id == _loadedChartId) return;
        _loadedChartId = Chart.Id;
        // The same verdict the chart page draws its timeline from, cached per (chart, mix) by
        // its handler, so the dialog and the page can never disagree about a rerate.
        _history = (await Mediator.Send(new GetChartVerdictQuery(Chart.Id, Mix))).OfType<HistoryVerdict>().FirstOrDefault();
        _placements = await LoadPlacements(Chart.Id);
        // The alias table's key beats the guessed one (crawler project hardening).
        _externalKey = (await Mediator.Send(new GetChartStepAnalysisQuery(Chart.Id)))?.ExternalKey;
        // Every chip the chart earned against its folder, plus which of the five speed bands it
        // landed in — the identity query is cached per (chart, mix), so the page dispatching the
        // same one makes this a shared read rather than a second cost.
        var identity = await Mediator.Send(new GetChartIdentityQuery(new[] { Chart.Id }, Mix));
        _identityChips = IdentityChips.WithSpeedBand(
            IdentityChips.ToCardChips(identity.GetValueOrDefault(Chart.Id), false, L),
            await SpeedBand(Chart.Id), L);
    }

    /// <summary>
    ///     The debut, every rerate, and the mix in view, in era order. A mix where the level held
    ///     is skipped unless it is the one in view. Without a history facet — a debut with no
    ///     rerate, for which the page shows no History section — the chart's own row still says
    ///     when it arrived.
    /// </summary>
    private IReadOnlyList<HistoryLine> HistoryLines()
    {
        if (Chart == null) return Array.Empty<HistoryLine>();
        var levels = _history?.Levels;
        if (levels == null || levels.Count == 0)
        {
            var own = new List<HistoryLine>
                { new(Chart.OriginalMix, Chart.Debut, HistoryKind.Debut, (int)Chart.Level, 0) };
            if (Chart.Mix != Chart.OriginalMix)
                own.Add(new HistoryLine(Chart.Mix, Chart.AddedIn, HistoryKind.Unchanged, (int)Chart.Level, 0));
            return own;
        }

        var lines = new List<HistoryLine>();
        for (var i = 0; i < levels.Count; i++)
        {
            var entry = levels[i];
            var delta = i == 0 ? 0 : entry.Level - levels[i - 1].Level;
            var kind = i == 0 ? HistoryKind.Debut : delta != 0 ? HistoryKind.Rerated : HistoryKind.Unchanged;
            if (kind == HistoryKind.Unchanged && entry.Mix != Chart.Mix) continue;
            // The facet's stamp first; the chart's own stamps cover the two mixes it knows.
            var stamp = entry.AddedIn
                        ?? (entry.Mix == Chart.OriginalMix ? Chart.Debut : entry.Mix == Chart.Mix ? Chart.AddedIn : null);
            lines.Add(new HistoryLine(entry.Mix, stamp, kind, entry.Level, delta));
        }

        return lines;
    }

    /// <summary>The timeline's label for a level: the type's shorthand and the number, <c>D23</c>.</summary>
    private string Label(int level)
    {
        return $"{Chart!.Type.GetShortHand()}{level}";
    }

    /// <summary>
    ///     Which of the five speed bands the chart landed in, or null where the folder has none.
    ///     The fallback is read and then refused: a band is a chart's speed relative to the folder
    ///     it was banded in, and a chart's folder changes between mixes.
    /// </summary>
    private async Task<TierListCategory?> SpeedBand(Guid chartId)
    {
        var speed = await Mediator.Send(new GetTierListWithFallbackQuery(SpeedBandLabels.ListName, Mix));
        return speed.IsProvisionalFallback
            ? null
            : speed.Entries.FirstOrDefault(e => e.ChartId == chartId)?.Category;
    }

    private async Task<IReadOnlyList<(string, string)>> LoadPlacements(Guid chartId)
    {
        var placements = new List<(string, string)>();
        foreach (var (listName, label) in new (string, string)[]
                 {
                     ("Pass Count", L["Pass Difficulty"].ToString()),
                     ("Scores", L["Score Difficulty"].ToString())
                 })
        {
            var result = await Mediator.Send(new GetTierListWithFallbackQuery(listName, Mix));
            var entry = result.Entries.FirstOrDefault(e => e.ChartId == chartId);
            if (entry == null || entry.Category == TierListCategory.Unrecorded) continue;
            placements.Add(($"{label}: {DifficultyName(entry.Category)}",
                ThemeScales.DifficultyColor(entry.Category)));
        }

        return placements;
    }

    private string DifficultyName(TierListCategory category)
    {
        return category switch
        {
            TierListCategory.Overrated => L["1+ Level Easier"],
            TierListCategory.VeryEasy => L["Very Easy"],
            TierListCategory.Easy => L["Easy"],
            TierListCategory.Medium => L["Medium"],
            TierListCategory.Hard => L["Hard"],
            TierListCategory.VeryHard => L["Very Hard"],
            TierListCategory.Underrated => L["1+ Level Harder"],
            _ => L["Not Rated"]
        };
    }

    // The resolved alias key when the crawler has one; otherwise a best-effort guess
    // in the current key format ("<Song>_-_<Artist>_<S|D><level>_<SONGTYPE>").
    private string PiuCenterUrl
    {
        get
        {
            if (_externalKey != null)
                return $"https://www.piucenter.com/chart/{Uri.EscapeDataString(_externalKey)}";
            if (Chart == null) return "https://www.piucenter.com/chart";
            var suffix = Chart.Song.Type switch
            {
                SongType.Remix => "REMIX",
                SongType.ShortCut => "SHORTCUT",
                SongType.FullSong => "FULLSONG",
                _ => "ARCADE"
            };
            var key =
                $"{Chart.Song.Name}_-_{Chart.Song.Artist}_{Chart.Type.GetShortHand()}{(int)Chart.Level}_{suffix}"
                    .Replace(' ', '_');
            return $"https://www.piucenter.com/chart/{Uri.EscapeDataString(key)}";
        }
    }
}
