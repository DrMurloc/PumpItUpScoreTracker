@using System.Globalization
@using Microsoft.AspNetCore.Localization
@using ScoreTracker.Web.Components
@using ScoreTracker.Web.Services
@using ScoreTracker.Web.Services.Localization
@using ScoreTracker.Web.Services.Theming
@inject ShellModelFactory ShellFactory
@inject StaticHeadResolver HeadResolver
@inject IWebHostEnvironment Env

@* The document root, rendered statically: the shell paints as real HTML and the app boots into
   the content region under it (docs/design/static-shell.md). Nothing here prerenders. *@
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    @* @Assets resolves each one to its content-hashed name (css/site.<hash>.css), so a release
       that changes a file changes its URL and no browser can serve the old one back. A raw
       "/css/site.css" here would be cached across the deploy and paint the previous release's
       styles over this one's markup. *@
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <link href="@Assets["css/site.css"]" rel="stylesheet" />
    <link href="@Assets["css/charts.css"]" rel="stylesheet" />
    @* The active palette's --mix-* tokens. Server-side: the shell paints before any circuit, and
       MudThemeProvider's own vars only arrive with one. *@
    <style>@((MarkupString)MixThemes.CssVariablesFor(_shell.ThemeMix))</style>
    @* A real head for readers that run no JS, resolved from the route (StaticHeadResolver):
       chart routes get their name, description and jacket; unmatched routes get the bare site
       title and no meta. Blazor removes the title on boot and HeadOutlet takes over, so
       <PageTitle> keeps working unchanged. The brand suffix rides the document title only —
       og:title stays the bare page name because og:site_name already carries the brand. *@
    <title>@(_head != null ? $"{_head.Title} | PIU Scores" : L["PIU Scores"].Value)</title>
    @if (_head != null)
    {
        <meta name="description" content="@_head.Description" />
        <meta property="og:site_name" content="PIU Scores" />
        <meta property="og:title" content="@_head.Title" />
        <meta property="og:description" content="@_head.Description" />
        <meta property="og:type" content="website" />
        @if (_head.OgImage != null)
        {
            <meta property="og:image" content="@_head.OgImage" />
            <meta property="og:image:alt" content="@($"{_head.SongName ?? _head.Title} jacket art")" />
            @* The jacket banner is landscape (~16:9), which is what the large-card format wants. *@
            <meta name="twitter:card" content="summary_large_image" />
        }
        @if (_head.Canonical != null)
        {
            @* Charts self-canonicalize; the weekly hub folds its ?week/?type variants here. *@
            <link rel="canonical" href="@_head.Canonical" />
            <meta property="og:url" content="@_head.Canonical" />
        }
        @if (_head.SongName != null)
        {
            @* Chart-page structured data (a MusicRecording needs a song). The whole element
               rides one MarkupString: the static renderer silently drops a <script> element
               whose content is a component expression, and a raw markup frame is what actually
               reaches the document. JSON string values escape "<", so a song title can't close
               the script early. The weekly hub emits its own ItemList in the page body. *@
            @((MarkupString)$"<script type=\"application/ld+json\">{JsonLd(_head)}</script>")
        }
        else if (_head.MixDiff != null)
        {
            @* The mix diff is a tabulation, so it marks up as a Dataset — the type that tells a
               reader "this page IS the table of chart changes" rather than an article about
               them. Head-level on purpose: the page runs in a circuit, so its body is not what
               a crawler reads. *@
            @((MarkupString)$"<script type=\"application/ld+json\">{MixDiffJsonLd(_head)}</script>")
        }
    }
    @* The other half of the cache story. Three scripts are ES modules the circuit pulls in by
       name at runtime (JSRuntime "import" of ./js/helpers.js, ./js/life-calculator.js,
       ./js/phoenix-recap.js) — there is no tag to hang @Assets on. The import map rewrites those
       specifiers to the hashed names in the browser, so the C# call sites keep asking for the
       plain path and still never get a stale module. Ahead of anything that imports. *@
    <ImportMap />
    @* Interactive, and not prerendered — matching every <PageTitle> in the app. Static, it would
       only ever see static components and every page's title would read "PIU Scores". *@
    <HeadOutlet @rendermode="RenderModes.Interactive" />
    <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "d2n3fzq6v8");
    </script>
    <style>
        .apexcharts-legend-text {
            color: #ffffff !important
        }

        .apexcharts-tooltip-text-y-value {
            color: #000000 !important;
        }

        .apexcharts-tooltip-text-y-label {
            color: #000000 !important;
        }

        .apexcharts-text tspan {
            fill: #FFFFFF
        }
    </style>
</head>
@* Enhanced navigation off: blazor.web.js turns it on by default, and it fetches and patches the
   DOM instead of loading a page — which the dock's scroll watcher, ApexCharts and Clarity have
   never been asked to survive. The attribute is read through closest(), so one here covers every
   link. Turning it on is its own change, with its own field test. *@
<body data-enhance-nav="false" class="@MixThemes.CssClassFor(_shell.ThemeMix)">
@* Ahead of every island, deliberately. There is one popover provider per circuit and roots
   activate in render order, so an island that asks for a popover before this rendered would get
   "Missing <MudPopoverProvider />". *@
<MudProviders @rendermode="RenderModes.Interactive" ThemeMix="_shell.ThemeMix" />

<header class="shell-appbar">
    <ShellNav Model="_shell" />
    <span class="shell-spacer"></span>
    <AppBarSearch @rendermode="RenderModes.Interactive" Mix="_shell.CurrentMix" />
    <ShellMixMenu Model="_shell" />
    <ShellUserMenu Model="_shell" />
</header>
<ShellMoreSheet Model="_shell" />
<ShellSearchSheet Model="_shell" />
<ShellBottomNav Model="_shell" />
@* Renders nothing; it drives the hidden pulse dot the shell put in the avatar. *@
<ShellImportPulse @rendermode="RenderModes.Interactive" />
@* Renders nothing; it seeds the circuit's ShellContext with the request-resolved mix
   before any page root initializes (roots activate in document order). *@
<ShellMixSeed @rendermode="RenderModes.Interactive" CurrentMix="_shell.CurrentMix" />

<main class="shell-main">
    @* Static: pages declare their own circuits (@rendermode RenderModes.Interactive) and
       every navigation is a full document load. A page converts to static SSR by deleting
       its own line (docs/design/seo-friendly-site.md §7). *@
    <Routes />
</main>

@* Blazor builds its own reconnect overlay — framework markup, framework light styling — but
   only when the document has none of its own. Supplying the element switches it to toggling
   state classes on ours instead (components-reconnect-show / -hide / -failed / -rejected), so
   the overlay is site chrome. Reads --mix-* only: every --mud-* var is emitted by
   MudThemeProvider inside the circuit, which is the thing this overlay exists to report on. *@
<div id="components-reconnect-modal" data-nosnippet aria-live="assertive">
    <div class="reconnect-card">
        <div class="reconnect-state reconnect-on-show">
            <span class="reconnect-spinner" aria-hidden="true"></span>
            <p class="reconnect-title">@L["Reconnecting…"]</p>
        </div>
        @* Reconnect ran out of attempts — the server may still be there, so offer another go. *@
        <div class="reconnect-state reconnect-on-failed">
            <p class="reconnect-title">@L["Couldn't reconnect."]</p>
            <button type="button" class="reconnect-btn" onclick="Blazor.reconnect()">@L["Try again"]</button>
        </div>
        @* The server answered and refused: that circuit is gone, and only a fresh load builds one. *@
        <div class="reconnect-state reconnect-on-rejected">
            <p class="reconnect-title">@L["Your session ended."]</p>
            <button type="button" class="reconnect-btn" onclick="location.reload()">@L["Reload the page"]</button>
        </div>
    </div>
</div>

<div id="blazor-error-ui">
    @if (Env.IsDevelopment())
    {
        <text>An unhandled exception has occurred. See browser dev tools for details.</text>
    }
    else
    {
        <text>An error has occurred. This application may no longer respond until reloaded.</text>
    }
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@* blazor.web.js stays on its plain name: the framework versions and caches its own boot script,
   and the manifest entry for it is not ours to redirect. *@
<script src="_framework/blazor.web.js"></script>
<script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
<script src="@Assets["js/page-dock.js"]"></script>
<script src="@Assets["js/nav.js"]"></script>
<script src="@Assets["js/dashboard-grid.js"]"></script>
<script src="@Assets["js/credential-storage.js"]"></script>
<script src="@Assets["js/challenge-board.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    private ShellViewModel _shell = null!;
    private StaticHeadModel? _head;

    // Chart-page structured data: MusicRecording names the song, its artist and jacket for
    // rich results; BreadcrumbList is what a search result shows as its trail in place of
    // raw URL slugs. System.Text.Json escapes the values, so a song title can't break out.
    private static string JsonLd(StaticHeadModel head)
    {
        var recording = new Dictionary<string, object?>
        {
            ["@type"] = "MusicRecording",
            ["name"] = head.SongName ?? head.Title,
            ["description"] = head.Description,
            ["url"] = head.Canonical,
            ["image"] = head.OgImage
        };
        if (head.Artist != null)
            recording["byArtist"] = new Dictionary<string, object?>
            {
                ["@type"] = "MusicGroup",
                ["name"] = head.Artist
            };
        return System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@graph"] = new object[]
            {
                recording,
                new Dictionary<string, object?>
                {
                    ["@type"] = "BreadcrumbList",
                    ["itemListElement"] = new object[]
                    {
                        new Dictionary<string, object?>
                        {
                            ["@type"] = "ListItem",
                            ["position"] = 1,
                            ["name"] = "Charts",
                            ["item"] = "https://piuscores.arroweclip.se/Charts"
                        },
                        new Dictionary<string, object?>
                        {
                            ["@type"] = "ListItem",
                            ["position"] = 2,
                            ["name"] = head.Title,
                            ["item"] = head.Canonical
                        }
                    }
                }
            }
        });
    }

    // What variables the table actually measures, named the way a reader would ask for them.
    // No temporalCoverage: mixes have no release date in the catalog, and inventing one would
    // be worse than omitting the field.
    private static string MixDiffJsonLd(StaticHeadModel head)
    {
        var diff = head.MixDiff!;
        var dataset = new Dictionary<string, object?>
        {
            ["@type"] = "Dataset",
            ["name"] = head.Title,
            ["description"] = head.Description,
            ["url"] = head.Canonical,
            ["creator"] = new Dictionary<string, object?>
            {
                ["@type"] = "Organization",
                ["name"] = "PIU Scores",
                ["url"] = "https://piuscores.arroweclip.se"
            },
            ["variableMeasured"] = new object?[]
                {
                    Measured("Charts re-rated", diff.Rerated),
                    Measured("Songs added", diff.SongsArrived),
                    Measured("Songs removed", diff.SongsDeparted),
                    diff.Restepped is { } restepped ? Measured("Charts re-stepped", restepped) : null
                }.Where(v => v != null).ToArray(),
            ["about"] = new object[]
            {
                new Dictionary<string, object?> { ["@type"] = "VideoGame", ["name"] = $"Pump It Up {diff.FromMix}" },
                new Dictionary<string, object?> { ["@type"] = "VideoGame", ["name"] = $"Pump It Up {diff.ToMix}" }
            }
        };
        return System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@graph"] = new object[]
            {
                dataset,
                new Dictionary<string, object?>
                {
                    ["@type"] = "BreadcrumbList",
                    ["itemListElement"] = new object[]
                    {
                        new Dictionary<string, object?>
                        {
                            ["@type"] = "ListItem",
                            ["position"] = 1,
                            ["name"] = "Charts",
                            ["item"] = "https://piuscores.arroweclip.se/Charts"
                        },
                        new Dictionary<string, object?>
                        {
                            ["@type"] = "ListItem",
                            ["position"] = 2,
                            ["name"] = head.Title,
                            ["item"] = head.Canonical
                        }
                    }
                }
            }
        });
    }

    private static Dictionary<string, object?> Measured(string name, int value)
    {
        return new Dictionary<string, object?>
        {
            ["@type"] = "PropertyValue",
            ["name"] = name,
            ["value"] = value
        };
    }

    // Resolved here rather than in OnInitializedAsync: an async init renders once at its first
    // await, before it has assigned anything. A page can show a spinner through that render —
    // the document cannot, because every line of it reads the model.
    public override async Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        await Resolve();
        await base.SetParametersAsync(ParameterView.Empty);
    }

    private async Task Resolve()
    {
        _shell = await ShellFactory.BuildAsync(HttpContext);
        _head = await HeadResolver.Resolve(HttpContext.Request.Path, _shell.CurrentMix,
            HttpContext.RequestAborted);
        // The cookie is a cache, and only an anonymous visitor depends on it — a signed-in
        // player's language comes from their saved setting, which nothing here can outrank
        // (docs/design/culture-resolution.md).
        if (HttpContext.User.Identity?.IsAuthenticated == true) return;
        // A ?culture= preview lasts exactly one request by design. Writing it down is how a
        // shared "?culture=en-ZW" link used to change the recipient's language for their whole
        // browser session.
        if (HttpContext.Features.Get<IRequestCultureFeature>()?.Provider is QueryStringRequestCultureProvider) return;

        // Only when it is missing or stale: an unconditional Set-Cookie makes every response
        // uncacheable. An anonymous visitor's explicit change is written by /Culture/Set — which
        // writes the cookie and nothing else, so it is the picker's job, not the endpoint's, to
        // persist a signed-in player's choice to their settings.
        var resolved = CultureCookie.ValueFor(CultureInfo.CurrentCulture, CultureInfo.CurrentUICulture);
        if (HttpContext.Request.Cookies[CultureCookie.Name] != resolved)
            CultureCookie.Write(HttpContext.Response, resolved);
    }
}
